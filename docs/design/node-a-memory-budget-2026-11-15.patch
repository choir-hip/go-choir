--- a/infra/node-a/memory-budget.nix
+++ b/infra/node-a/memory-budget.nix
@@ -0,0 +1,134 @@
+# node-a memory budget (Choir owner, 2026-11-14, after the 06:42Z kill of the
+# agents VM; go-choir docs/problems/node-a-oom-killed-the-agents-build-vm-2026-11-14.md).
+#
+# What a guest costs here. Guest RAM is a shared memfd (chv-shared-memory.nix),
+# so every page a guest touches is host shmem: with no swap the host cannot
+# reclaim it, and a Linux guest touches all of its RAM as page cache within one
+# heavy run and never gives it back (no balloon). A guest's configured size is
+# therefore a commitment, not an average, and the only safe rule is
+#
+#   sum of the configured memory of every VM that starts + host reserve <= RAM.
+#
+# The assertion below makes that rule part of the build: a configuration that
+# would overcommit the host does not evaluate. The reserve is what node-a runs
+# outside the guests (measured in the kernel's report at the 06:42Z kill: 2.5 GiB
+# anonymous, about 0.6 GiB kernel, 0.8 GiB tmpfs), plus about 1 GiB of page cache
+# so the host does not thrash.
+#
+# Two backstops for what the reserve does not cover (Node B's remote builds,
+# Mike's container builds): a small zram swap as a cushion, so a burst becomes
+# slowness instead of a kill (the Choir VMs' guest pages become swappable, so
+# under pressure their vCPUs can stall on swap-in), and an OOM order, so that if
+# the kernel must still kill, it kills the agents VM, then the runner, and never
+# one of Mike's workstations. Mike's workstations are also kept out of swap.
+#
+# The order holds for any resident size. The kernel's badness is about
+# 1000 x (resident + swap) / RAM + oom_score_adj. A guest is capped at its
+# configured size, so the runner (adj 0, at most 10 GiB of 31.1) scores at
+# most 329, and the agents VM (adj 900) scores at least 900. -1000 exempts
+# Mike's VMs entirely. Node B's remote builds run as `nix-daemon --stdio` in a
+# root ssh session, not in nix-daemon.service, so they get no adj here.
+#
+# The guard runs every minute: after a VM restarts, it is unprotected for up to
+# a minute until the next run.
+#
+# Rollback: drop ./memory-budget.nix from configuration.nix and rebuild
+# (test, fresh login, switch). The guard's runtime settings last until the next
+# reboot or until `systemctl revert` of the units named below; nothing in a
+# guest changes.
+{ config, lib, pkgs, ... }:
+
+let
+  # MemTotal on node-a, 32630604 kB.
+  hostMiB = 31865;
+  reserveMiB = 5120;
+
+  vms = config.microvm.vms;
+  started = lib.filter (n: vms.${n}.autostart) (lib.attrNames vms);
+  memOf = n: vms.${n}.config.config.microvm.mem;
+  guestMiB = lib.foldl' (sum: n: sum + memOf n) 0 started;
+  budgetLine = lib.concatMapStringsSep ", " (n: "${n} ${toString (memOf n)}") started;
+
+  # Mike's workstations: never the OOM victim, never swapped.
+  mikeVms = lib.filter (n: lib.hasPrefix "ws-" n) started;
+  # Choir's VMs: the victims, agents first (see the arithmetic above).
+  choirOom = { agents = 900; runner = 0; };
+
+  guard = pkgs.writeShellApplication {
+    name = "node-a-memory-guard";
+    runtimeInputs = [ pkgs.systemd pkgs.coreutils ];
+    text = ''
+      # Idempotent; runs at boot and every minute, so a VM that restarts gets
+      # its settings back within a minute. Prints only what it changes. Every
+      # step is allowed to fail on its own: one dead pid or failed call never
+      # skips the remaining units.
+      adj() { # unit value: every process in the unit's cgroup
+        local cg procs pid cur
+        cg=$(systemctl show -p ControlGroup --value "$1" 2>/dev/null || true)
+        procs="/sys/fs/cgroup$cg/cgroup.procs"
+        if [ -z "$cg" ] || [ ! -r "$procs" ]; then return 0; fi
+        while read -r pid; do
+          cur=$(cat "/proc/$pid/oom_score_adj" 2>/dev/null || true)
+          if [ -z "$cur" ] || [ "$cur" = "$2" ]; then continue; fi
+          if echo "$2" >"/proc/$pid/oom_score_adj" 2>/dev/null; then
+            echo "$1 pid $pid ($(cat "/proc/$pid/comm" 2>/dev/null || true)): oom_score_adj $cur -> $2"
+          else
+            echo "$1 pid $pid: could not set oom_score_adj" >&2
+          fi
+        done <"$procs"
+        return 0
+      }
+      noswap() { # unit
+        if ! systemctl is-active -q "$1"; then return 0; fi
+        if [ "$(systemctl show -p MemorySwapMax --value "$1" 2>/dev/null || true)" = 0 ]; then return 0; fi
+        if systemctl set-property --runtime "$1" MemorySwapMax=0; then
+          echo "$1: MemorySwapMax=0"
+        else
+          echo "$1: could not set MemorySwapMax=0" >&2
+        fi
+        return 0
+      }
+      for vm in ${lib.escapeShellArgs mikeVms}; do
+        adj "microvm@$vm.service" -1000
+        noswap "microvm@$vm.service"
+      done
+      ${lib.concatStrings (lib.mapAttrsToList (vm: v: lib.optionalString (lib.elem vm started) ''
+        adj "microvm@${vm}.service" ${toString v}
+      '') choirOom)}
+    '';
+  };
+in
+{
+  assertions = [{
+    assertion = guestMiB + reserveMiB <= hostMiB;
+    message = ''
+      node-a memory budget: the VMs that start are configured for ${toString guestMiB} MiB
+      (${budgetLine}); with the ${toString reserveMiB} MiB host reserve that is more than
+      the host's ${toString hostMiB} MiB. Guest memory is never given back, so this would
+      end in an out-of-memory kill (memory-budget.nix). Shrink or park a VM.
+    '';
+  }];
+
+  # A cushion, not capacity: at most about 4.7 GiB of compressed pages, used only
+  # under pressure. Mike's workstations are excluded by the guard (swap max 0).
+  zramSwap = {
+    enable = true;
+    algorithm = "zstd";
+    memoryPercent = 15;
+  };
+
+  systemd.services.node-a-memory-guard = {
+    description = "OOM order and swap exclusion for the microVMs (memory-budget.nix)";
+    after = [ "microvms.target" ];
+    wantedBy = [ "multi-user.target" ];
+    serviceConfig = {
+      Type = "oneshot";
+      ExecStart = "${guard}/bin/node-a-memory-guard";
+    };
+  };
+  systemd.timers.node-a-memory-guard = {
+    description = "Re-apply the memory guard after any VM restart";
+    wantedBy = [ "timers.target" ];
+    timerConfig = { OnBootSec = "1min"; OnUnitActiveSec = "1min"; AccuracySec = "10s"; };
+  };
+}
