{
  "schema": "choir.package/v2",
  "name": "settings",
  "version": "1.0.0",
  "display": {
    "title": "Settings",
    "icon": "\u2699\ufe0f",
    "description": "Desktop settings"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "requires_sdk": "^2.3",
    "aliases": [],
    "launcher": {
      "menu": true,
      "desktopIcon": true,
      "order": 150
    },
    "window": {
      "singleton": true,
      "heavy": false,
      "desktop": {
        "width": 940,
        "height": 720
      }
    },
    "auth": {
      "preview": "public-readonly"
    },
    "theme": {
      "surface": "standard",
      "shellDataAttr": "data-settings-window",
      "contentClass": "settings-content"
    }
  },
  "kinds": [],
  "uses_kinds": [],
  "contributes": {
    "desks": [],
    "settings": [
      {
        "section": "Desktop background",
        "fields": [
          {
            "key": "background",
            "type": "string",
            "default": "",
            "label": "Background image (a Files path; empty uses the theme colour)"
          },
          {
            "key": "background_fit",
            "type": "string",
            "default": "cover",
            "label": "Background fit",
            "enum": [
              "cover",
              "contain",
              "center",
              "tile"
            ]
          }
        ]
      }
    ]
  },
  "capabilities": [
    {
      "grant": "ui.shell"
    }
  ]
}
