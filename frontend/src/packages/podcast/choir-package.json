{
  "schema": "choir.package/v2",
  "name": "podcast",
  "version": "1.0.0",
  "display": {
    "title": "Podcast",
    "icon": "📡",
    "description": "Podcast feed player"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "requires_sdk": "^1.2",
    "aliases": [],
    "launcher": {
      "menu": true,
      "desktopIcon": true,
      "order": 70
    },
    "window": {
      "singleton": false,
      "heavy": true,
      "desktop": {
        "width": 900,
        "height": 660
      },
      "compact": {
        "minWidth": 280,
        "minHeight": 420
      }
    },
    "auth": {
      "preview": "public-preview"
    },
    "theme": {
      "surface": "media",
      "shellDataAttr": "data-podcast-window",
      "contentClass": "podcast-content"
    }
  },
  "opens": [],
  "kinds": [],
  "uses_kinds": [],
  "contributes": {
    "desks": []
  },
  "capabilities": []
}
