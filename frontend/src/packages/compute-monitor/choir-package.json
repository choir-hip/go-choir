{
  "schema": "choir.package/v2",
  "name": "compute-monitor",
  "version": "1.0.0",
  "display": {
    "title": "Compute Monitor",
    "icon": "📊",
    "description": "User computer health and recovery"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "aliases": [],
    "launcher": {
      "menu": true,
      "desktopIcon": true,
      "order": 40
    },
    "window": {
      "singleton": true,
      "heavy": false,
      "desktop": {
        "width": 980,
        "height": 700,
        "minWidth": 700,
        "minHeight": 520
      },
      "compact": {
        "minWidth": 280,
        "minHeight": 420
      }
    },
    "auth": {
      "preview": "public-preview"
    },
    "theme": {
      "surface": "standard",
      "shellDataAttr": "data-compute-monitor-window",
      "contentClass": "compute-monitor-content"
    }
  },
  "opens": [],
  "kinds": [],
  "uses_kinds": [],
  "contributes": {
    "desks": []
  },
  "capabilities": [{ "grant": "ui.shell" }]
}
