{
  "schema": "choir.package/v2",
  "name": "slides",
  "version": "1.0.0",
  "display": {
    "title": "Slides",
    "icon": "🖥️",
    "description": "Slide player for PPTX, PDF, and HTML"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "requires_sdk": "^1.2",
    "aliases": [],
    "launcher": {
      "menu": true,
      "desktopIcon": false,
      "order": 125
    },
    "window": {
      "singleton": false,
      "heavy": true,
      "desktop": {
        "width": 1024,
        "height": 768,
        "minWidth": 640,
        "minHeight": 480
      },
      "compact": {
        "minWidth": 280,
        "minHeight": 420
      }
    },
    "auth": {
      "preview": "public-preview"
    },
    "theme": {
      "surface": "media",
      "shellDataAttr": "data-slides-window",
      "contentClass": "slides-content"
    }
  },
  "opens": [
    {
      "media_type": "application/vnd.openxmlformats-officedocument.presentationml.presentation",
      "extensions": [
        "pptx",
        "html",
        "htm"
      ]
    },
    {
      "media_type": "application/pdf",
      "extensions": [
        "pdf"
      ],
      "default": false
    }
  ],
  "kinds": [],
  "uses_kinds": [],
  "contributes": {
    "desks": []
  },
  "capabilities": []
}
