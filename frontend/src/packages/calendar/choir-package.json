{
  "schema": "choir.package/v2",
  "name": "calendar",
  "version": "1.0.0",
  "display": {
    "title": "Calendar",
    "icon": "📅",
    "description": "Calendar with ICS import"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "requires_sdk": "^2.0",
    "aliases": [],
    "launcher": {
      "menu": true,
      "desktopIcon": true,
      "order": 115
    },
    "window": {
      "singleton": true,
      "heavy": false,
      "desktop": {
        "width": 960,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480
      },
      "compact": {
        "minWidth": 280,
        "minHeight": 420
      }
    },
    "auth": {
      "preview": "public-preview"
    },
    "theme": {
      "surface": "standard",
      "shellDataAttr": "data-calendar-window",
      "contentClass": "calendar-content"
    }
  },
  "kinds": [],
  "uses_kinds": [],
  "contributes": {
    "opens": [
      {
        "media_type": "text/calendar",
        "extensions": [
          "ics"
        ]
      }
    ],
    "desks": []
  },
  "capabilities": []
}
