{
  "schema": "choir.app-package/v1",
  "name": "reader",
  "version": "1.0.1",
  "origin": "first_party",
  "display": {
    "title": "Reader",
    "icon": "📖",
    "description": "Read PDFs and EPUBs in one quiet reader"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "aliases": [],
    "launcher": { "menu": true, "desktopIcon": false, "order": 110 },
    "window": {
      "singleton": false,
      "heavy": true,
      "desktop": { "width": 960, "height": 740 },
      "compact": { "minWidth": 280, "minHeight": 420 }
    },
    "auth": { "preview": "public-preview" },
    "theme": {
      "surface": "document",
      "shellDataAttr": "data-reader-window",
      "contentClass": "reader-content"
    }
  },
  "opens": [
    { "media_type": "application/pdf", "extensions": ["pdf"] },
    { "media_type": "application/epub+zip", "extensions": ["epub"] }
  ],
  "kinds": [],
  "uses_kinds": [],
  "desk": null,
  "backend": null,
  "grants": []
}
