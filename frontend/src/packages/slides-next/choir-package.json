{
  "schema": "choir.app-package/v1",
  "name": "slides-next",
  "version": "1.0.0",
  "origin": "first_party",
  "display": {
    "title": "Slides (new)",
    "icon": "🎞️",
    "description": "Present PDF, PPTX and HTML decks"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "aliases": [],
    "launcher": { "menu": true, "desktopIcon": false, "order": 126 },
    "window": {
      "singleton": false,
      "heavy": true,
      "desktop": { "width": 1024, "height": 768, "minWidth": 640, "minHeight": 480 },
      "compact": { "minWidth": 280, "minHeight": 420 }
    },
    "auth": { "preview": "public-preview" },
    "theme": {
      "surface": "media",
      "shellDataAttr": "data-slides-next-window",
      "contentClass": "slides-next-content"
    }
  },
  "opens": [],
  "kinds": [],
  "uses_kinds": [],
  "desk": null,
  "backend": null,
  "grants": []
}
