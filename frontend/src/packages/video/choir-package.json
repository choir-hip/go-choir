{
  "schema": "choir.package/v2",
  "name": "video",
  "version": "1.0.0",
  "display": {
    "title": "Video",
    "icon": "🎬",
    "description": "Video and YouTube player"
  },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "aliases": [],
    "launcher": {
      "menu": true,
      "desktopIcon": false,
      "order": 100
    },
    "window": {
      "singleton": false,
      "heavy": true,
      "desktop": {
        "width": 980,
        "height": 720
      },
      "compact": {
        "minWidth": 280,
        "minHeight": 420
      }
    },
    "auth": {
      "preview": "public-preview"
    },
    "theme": {
      "surface": "media",
      "shellDataAttr": "data-video-window",
      "contentClass": "video-content"
    }
  },
  "opens": [
    {
      "media_type": "video/mp4",
      "extensions": [
        "mp4",
        "m4v",
        "webm",
        "mov",
        "avi",
        "mkv"
      ]
    }
  ],
  "kinds": [],
  "uses_kinds": [],
  "contributes": {
    "desks": []
  },
  "capabilities": []
}
