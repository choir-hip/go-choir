#!/usr/bin/env bash
# Tests for scripts/node-b-ci-gate, the forced command behind Node B's
# choir-deploy user (SDC SEC-14; docs/problems/ci-deploys-to-node-b-as-root-2026-10-21.md).
#
# Ways the gate could fail, written before the gate:
#  1. It runs a program the caller sent (stdin, or a shell word in the request).
#  2. It passes a shell metacharacter, a newline or a glob through to bash.
#  3. It accepts an unknown verb or key, so the caller picks paths or scripts.
#  4. It accepts a short, upper-case or non-hex commit, which git resolves as
#     a ref or abbreviation the caller controls.
#  5. It accepts a duplicate key, the last one silently winning.
#  6. It runs with a required key missing, so the script sees an unset value.
#  7. It accepts HOST_SERVICES that leave the flake attribute namespace
#     (".#a b", "../x", "x;y").
#  8. It deploys a commit that GitHub serves by SHA but that is not on main
#     (a fork's pull request head). Checked on Node B by FP0; the parser
#     cannot see it.
#  9. It treats --print-plan as anything but a dry parse.
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
gate="$root/scripts/node-b-ci-gate"

sha=0123456789abcdef0123456789abcdef01234567
prebuild_ok="prebuild DEPLOY_COMMIT=$sha DEPLOY_FRONTEND=true DEPLOY_HOST=false DEPLOY_HOST_OS=false HOST_SERVICES=autoputer,vmctl"
deploy_ok="deploy DEPLOY_COMMIT=$sha DEPLOY_RUN_ID=18712345678 DEPLOY_RUN_ATTEMPT=1 DEPLOY_HOST=true DEPLOY_FRONTEND=false DEPLOY_VMCTL_RESTART=true DEPLOY_ACTIVE_VM_REFRESH=false REFRESH_ACTIVE_COMPUTERS=false DEPLOY_HOST_OS=true HOST_SERVICES="

fail() {
  echo "node-b-ci-gate-test: $*" >&2
  exit 1
}

accept() {
  local request="$1"
  local expected="$2"
  local out
  out=$("$gate" --print-plan "$request" 2>&1) || fail "refused a valid request: $request ($out)"
  [ "$out" = "$expected" ] || fail "plan mismatch for: $request
--- got
$out
--- want
$expected"
}

refuse() {
  local request="$1"
  local out status=0
  out=$("$gate" --print-plan "$request" 2>&1) || status=$?
  [ "$status" -eq 2 ] || fail "status $status (want 2) for: $(printf '%q' "$request") ($out)"
  case "$out" in
    "node-b-ci-gate: refused: "*) ;;
    *) fail "refusal without the refusal prefix for: $(printf '%q' "$request") ($out)" ;;
  esac
}

accept "receipt" "verb=receipt"

# 10: the host floor (bunch 4b B1; re-review F1, F2). After step 3 an
# ancestor deploy would restore root's CI key, so the gate refuses any commit
# that does not descend from the floor. The floor is the floor file; with no
# file, the one-time bootstrap marker (written only by a NixOS activation,
# consumed by the first deploy); with neither, everything is refused. A
# deploy advances the floor by compare-and-swap under an exclusive flock.
# Throwaway history: c0 - c1 - c2 on main, s1 a side commit off c1.
floor_dir=$(mktemp -d)
lock_pid=
trap '[ -n "$lock_pid" ] && kill "$lock_pid" 2>/dev/null; rm -rf "$floor_dir"' EXIT
frepo="$floor_dir/repo"
git init -q "$frepo"
fcommit() {
  git -C "$frepo" -c user.name=t -c user.email=t@t commit -q --allow-empty -m "$1"
  git -C "$frepo" rev-parse HEAD
}
c0=$(fcommit c0)
c1=$(fcommit c1)
git -C "$frepo" branch -q side
c2=$(fcommit c2)
git -C "$frepo" checkout -q side
s1=$(fcommit s1)
ffile="$floor_dir/ci-gate-floor"
bfile="$floor_dir/ci-gate-floor-bootstrap"

gate_floor() {
  "$gate" "$1" "$frepo" "$ffile" "$bfile" "${@:2}"
}
floor_ok() {
  local out
  out=$(gate_floor "$@" 2>&1) ||
    fail "$* refused (floor $(cat "$ffile" 2>/dev/null || echo none), bootstrap $(cat "$bfile" 2>/dev/null || echo none)): $out"
}
floor_refused() {
  local want="${*: -1}" out status=0
  out=$(gate_floor "${@:1:$#-1}" 2>&1) || status=$?
  [ "$status" -eq 2 ] || fail "${*:1:$#-1}: status $status (want 2): $out"
  [[ "$out" == "node-b-ci-gate: refused: "*"$want"* ]] || fail "${*:1:$#-1}: want refusal '$want', got: $out"
}
floor_is() {
  [ "$(cat "$ffile" 2>/dev/null)" = "$1" ] || fail "$2: floor is $(cat "$ffile" 2>/dev/null || echo none), want $1"
}

# F2: no floor and no bootstrap refuses every commit, for check and deploy.
rm -f "$ffile" "$bfile"
for c in "$c0" "$c1" "$c2" "$s1"; do
  floor_refused --test-floor "$c" "no floor"
  floor_refused --test-advance "$c" "no floor"
done
[ ! -e "$ffile" ] || fail "a refused advance created the floor"

# The bootstrap marker stands in for a missing floor, once.
printf '%s\n' "$c1" >"$bfile"
floor_refused --test-floor "$c0" "below the floor"
floor_ok --test-floor "$c1"
floor_ok --test-floor "$s1"
floor_refused --test-advance "$c0" "below the floor"
[ -e "$bfile" ] && [ ! -e "$ffile" ] || fail "a refused advance consumed the bootstrap"
floor_ok --test-advance "$c1"
floor_is "$c1" "bootstrap advance"
[ ! -e "$bfile" ] || fail "the first deploy did not consume the bootstrap marker"
rm -f "$ffile"
floor_refused --test-advance "$c2" "no floor"

# A floor file wins over a bootstrap marker.
printf '%s\n' "$c2" >"$ffile"
printf '%s\n' "$c0" >"$bfile"
floor_refused --test-floor "$c1" "below the floor"
floor_refused --test-floor "$s1" "below the floor"
floor_ok --test-floor "$c2"
rm -f "$bfile"

# Malformed floors and markers refuse.
for bad in "" "main" "${c1^^}" "${c1:0:39}" "0123456789abcdef0123456789abcdef01234567" "$c1"$'\n'"$c2"; do
  printf '%s\n' "$bad" >"$ffile"
  floor_refused --test-floor "$c2" "floor"
  rm -f "$ffile"
  printf '%s\n' "$bad" >"$bfile"
  floor_refused --test-floor "$c2" "floor"
  rm -f "$bfile"
done

# A deploy raises the floor; a refused deploy leaves it alone.
printf '%s\n' "$c0" >"$ffile"
floor_ok --test-advance "$c1"
floor_is "$c1" "advance to c1"
floor_refused --test-advance "$c0" "below the floor"
floor_is "$c1" "refused advance"
floor_ok --test-advance "$c2"
floor_is "$c2" "advance to c2"
floor_refused --test-advance "$s1" "below the floor"
floor_refused --test-advance "$c1" "below the floor"
floor_is "$c2" "the floor never goes down"

# F1, compare-and-swap: the swap needs the floor that was checked, and the
# new floor must descend from the floor on disk.
printf '%s\n' "$c2" >"$ffile"
floor_refused --test-cas "$c1" "$c2" "floor moved"
floor_refused --test-cas "$c2" "$c1" "below the floor"
floor_refused --test-cas "$c2" "$s1" "below the floor"
floor_is "$c2" "refused swaps"
printf '%s\n' "$c1" >"$ffile"
floor_ok --test-cas "$c1" "$c2"
floor_is "$c2" "swap c1 -> c2"

# F1, the lock: while another holder has the gate's lock, an advance does
# not run (the test modes do not wait; the live gate waits).
printf '%s\n' "$c1" >"$ffile"
(
  exec 8>>"${ffile}.lock"
  flock -x 8
  touch "$floor_dir/held"
  exec sleep 30
) &
lock_pid=$!
for _ in $(seq 1 100); do
  [ -e "$floor_dir/held" ] && break
  sleep 0.05
done
[ -e "$floor_dir/held" ] || fail "the test could not take the lock"
floor_refused --test-advance "$c2" "busy"
floor_refused --test-cas "$c1" "$c2" "busy"
floor_is "$c1" "advance while locked"
kill "$lock_pid" 2>/dev/null
wait "$lock_pid" 2>/dev/null || true
lock_pid=
floor_ok --test-advance "$c2"
floor_is "$c2" "advance after the lock is free"

# Argument forms.
status=0
"$gate" --test-floor "$frepo" "$ffile" "$bfile" >/dev/null 2>&1 || status=$?
[ "$status" -eq 2 ] || fail "--test-floor with three arguments: status $status, want 2"
floor_refused --test-floor "main" "invalid commit"
floor_refused --test-cas "main" "$c2" "invalid commit"

# The live path: no seed fallback; a deploy locks before it checks the floor,
# swaps the checked floor, runs the program with stdin closed and the lock
# fd closed for the child; the gate never writes the bootstrap marker.
grep -Eq '^seed_floor=' "$gate" && fail "the gate still has a seed floor"
grep -Fq 'floor_file=/var/lib/go-choir/ci-gate-floor' "$gate" || fail "the gate's floor file moved"
grep -Fq 'bootstrap_file=/var/lib/go-choir/ci-gate-floor-bootstrap' "$gate" || fail "the gate's bootstrap marker moved"
run_body=$(sed -n '/^run() {/,/^}/p' "$gate")
lock_line=$(grep -n 'lock_gate' <<<"$run_body" | head -n 1 | cut -d: -f1 || true)
check_line=$(grep -nF 'check_floor "$repo" "$commit"' <<<"$run_body" | head -n 1 | cut -d: -f1 || true)
advance_line=$(grep -nF 'advance_floor "$repo" "$commit" "$checked_floor"' <<<"$run_body" | head -n 1 | cut -d: -f1 || true)
exec_line=$(grep -nF '<"/dev/null"' <<<"$run_body" | head -n 1 | cut -d: -f1 || true)
[ -n "$lock_line" ] && [ -n "$check_line" ] && [ -n "$advance_line" ] && [ -n "$exec_line" ] ||
  fail "run() lacks the lock, check, swap or closed-stdin run (lock=${lock_line} check=${check_line} swap=${advance_line} run=${exec_line})"
[ "$lock_line" -lt "$check_line" ] && [ "$check_line" -lt "$advance_line" ] && [ "$advance_line" -lt "$exec_line" ] ||
  fail "run() order must be lock, check, swap, run"
# A deploy takes the lock before its first git command (bunch 33 item 3). A
# running deploy's program fetches, resets and cleans /opt/go-choir under
# the lock, so a second deploy's clone, set-url or fetch there must wait for
# it rather than race it.
first_git_line=$(grep -vE '^[[:space:]]*#' <<<"$run_body" | grep -nE '(^|[[:space:]!])git ' | head -n 1 | cut -d: -f1 || true)
lock_line_nc=$(grep -vE '^[[:space:]]*#' <<<"$run_body" | grep -n 'lock_gate' | head -n 1 | cut -d: -f1 || true)
[ -n "$first_git_line" ] && [ -n "$lock_line_nc" ] || fail "run() lacks a git command or the lock"
[ "$lock_line_nc" -lt "$first_git_line" ] ||
  fail "a deploy must take the lock before its first git command (lock=${lock_line_nc} git=${first_git_line})"
grep -Fq '[ "$verb" = deploy ] && lock_gate' <<<"$run_body" || fail "only a deploy takes the gate lock in run()"
# Under the lock, the clone and the fetch close the lock fd, as the program
# does: an automatic gc that git detaches after them must not hold the lock.
grep -F 'git clone' <<<"$run_body" | grep -Fq '9>&-' || fail "the gate's clone inherits the lock fd"
grep -A1 -F 'fetch --quiet' <<<"$run_body" | grep -Fq '9>&-' || fail "the gate's fetch inherits the lock fd"
grep -Fq '9>&-' <<<"$run_body" || fail "the program inherits the lock fd"
grep -Fq 'bash -s' <<<"$run_body" && fail "the program still reads itself from stdin"
grep -Eq '>[^&]*"?\$bootstrap_file' "$gate" && fail "the gate writes the bootstrap marker"
grep -Fq 'ci-gate-floor-bootstrap' "$root/nix/node-b.nix" || fail "nix/node-b.nix has no bootstrap activation"

accept "$prebuild_ok" "verb=prebuild
repo=/opt/go-choir-prebuild
script=.github/scripts/node-b-ci-prebuild
env=DEPLOY_COMMIT=$sha
env=DEPLOY_FRONTEND=true
env=DEPLOY_HOST=false
env=DEPLOY_HOST_OS=false
env=HOST_SERVICES=autoputer,vmctl"

# Keys in any order; the plan lists them in the gate's fixed order.
accept "prebuild HOST_SERVICES=autoputer,vmctl DEPLOY_HOST_OS=false DEPLOY_HOST=false DEPLOY_FRONTEND=true DEPLOY_COMMIT=$sha" "verb=prebuild
repo=/opt/go-choir-prebuild
script=.github/scripts/node-b-ci-prebuild
env=DEPLOY_COMMIT=$sha
env=DEPLOY_FRONTEND=true
env=DEPLOY_HOST=false
env=DEPLOY_HOST_OS=false
env=HOST_SERVICES=autoputer,vmctl"

accept "$deploy_ok" "verb=deploy
repo=/opt/go-choir
script=.github/scripts/node-b-ci-deploy
env=DEPLOY_COMMIT=$sha
env=DEPLOY_RUN_ID=18712345678
env=DEPLOY_RUN_ATTEMPT=1
env=DEPLOY_HOST=true
env=DEPLOY_FRONTEND=false
env=DEPLOY_VMCTL_RESTART=true
env=DEPLOY_ACTIVE_VM_REFRESH=false
env=REFRESH_ACTIVE_COMPUTERS=false
env=DEPLOY_HOST_OS=true
env=HOST_SERVICES="

# 1, 3: no verb, unknown verbs, a shell, arguments on receipt.
refuse ""
refuse "bash -s"
refuse "sh"
refuse "cat /var/lib/go-choir/deploy-receipt.json"
refuse "DEPLOY_COMMIT=$sha bash -s"
refuse "rollback DEPLOY_COMMIT=$sha"
refuse "receipt DEPLOY_COMMIT=$sha"
refuse "Receipt"
refuse "receipt "
refuse " receipt"

# 2: metacharacters, whitespace and newlines.
refuse "${deploy_ok/DEPLOY_RUN_ATTEMPT=1/DEPLOY_RUN_ATTEMPT=\$(id)}"
refuse "${deploy_ok/HOST_SERVICES=/HOST_SERVICES=a;id}"
refuse "${deploy_ok/HOST_SERVICES=/HOST_SERVICES=a|id}"
refuse "${deploy_ok/HOST_SERVICES=/HOST_SERVICES=*}"
refuse "${deploy_ok/DEPLOY_HOST=true/DEPLOY_HOST=true  }"
refuse "${deploy_ok/ DEPLOY_HOST=true/$'\t'DEPLOY_HOST=true}"
refuse "$deploy_ok"$'\n'"id"
refuse "receipt"$'\n'
refuse "${deploy_ok/DEPLOY_HOST=true/DEPLOY_HOST=\`id\`}"

# 3: unknown keys, keys from the other verb, environment the gate owns.
refuse "$deploy_ok PATH=/tmp"
refuse "$deploy_ok HOME=/tmp"
refuse "$deploy_ok BASH_ENV=x"
refuse "$prebuild_ok DEPLOY_RUN_ID=1"
refuse "${deploy_ok/DEPLOY_HOST=/deploy_host=}"

# 4: commits.
refuse "${deploy_ok/$sha/${sha:0:39}}"
refuse "${deploy_ok/$sha/${sha}0}"
refuse "${deploy_ok/$sha/0123456789ABCDEF0123456789abcdef01234567}"
refuse "${deploy_ok/$sha/main}"
refuse "${deploy_ok/$sha/0123456789abcdef0123456789abcdef0123456g}"
refuse "${deploy_ok/DEPLOY_COMMIT=$sha/DEPLOY_COMMIT=}"

# 5: duplicates.
refuse "$deploy_ok DEPLOY_HOST=false"
refuse "$prebuild_ok DEPLOY_COMMIT=$sha"

# 6: missing keys.
refuse "${deploy_ok/ REFRESH_ACTIVE_COMPUTERS=false/}"
refuse "${prebuild_ok/ HOST_SERVICES=autoputer,vmctl/}"
refuse "deploy"
refuse "prebuild"

# Booleans and numbers.
refuse "${deploy_ok/DEPLOY_HOST=true/DEPLOY_HOST=yes}"
refuse "${deploy_ok/DEPLOY_HOST=true/DEPLOY_HOST=}"
refuse "${deploy_ok/DEPLOY_HOST=true/DEPLOY_HOST=TRUE}"
refuse "${deploy_ok/DEPLOY_RUN_ATTEMPT=1/DEPLOY_RUN_ATTEMPT=}"
refuse "${deploy_ok/DEPLOY_RUN_ATTEMPT=1/DEPLOY_RUN_ATTEMPT=0}"
refuse "${deploy_ok/DEPLOY_RUN_ATTEMPT=1/DEPLOY_RUN_ATTEMPT=-1}"
refuse "${deploy_ok/DEPLOY_RUN_ID=18712345678/DEPLOY_RUN_ID=123456789012345678901}"

# 7: HOST_SERVICES stays a comma list of plain names.
accept "${prebuild_ok/HOST_SERVICES=autoputer,vmctl/HOST_SERVICES=corpusd}" "verb=prebuild
repo=/opt/go-choir-prebuild
script=.github/scripts/node-b-ci-prebuild
env=DEPLOY_COMMIT=$sha
env=DEPLOY_FRONTEND=true
env=DEPLOY_HOST=false
env=DEPLOY_HOST_OS=false
env=HOST_SERVICES=corpusd"
refuse "${prebuild_ok/autoputer,vmctl/autoputer,}"
refuse "${prebuild_ok/autoputer,vmctl/,autoputer}"
refuse "${prebuild_ok/autoputer,vmctl/autoputer,,vmctl}"
refuse "${prebuild_ok/autoputer,vmctl/..}"
refuse "${prebuild_ok/autoputer,vmctl/a.b}"
refuse "${prebuild_ok/autoputer,vmctl/-x}"
refuse "${prebuild_ok/autoputer,vmctl/Auth}"

# Length bound.
refuse "$deploy_ok$(printf ' X=%.0s' $(seq 1 600))"

# 9: the gate's own argument forms.
status=0
"$gate" >/dev/null 2>&1 || status=$?
[ "$status" -eq 2 ] || fail "no arguments: status $status, want 2"
status=0
"$gate" --print-plan >/dev/null 2>&1 || status=$?
[ "$status" -eq 2 ] || fail "--print-plan without a request: status $status, want 2"
status=0
"$gate" --run "$deploy_ok" >/dev/null 2>&1 || status=$?
[ "$status" -eq 2 ] || fail "unknown mode: status $status, want 2"
status=0
"$gate" -- "receipt" extra >/dev/null 2>&1 || status=$?
[ "$status" -eq 2 ] || fail "extra argument: status $status, want 2"

# The workflow's request templates, filled with sample values, parse.
workflow="$root/.github/workflows/ci.yml"
DEPLOY_COMMIT=$sha DEPLOY_FRONTEND=true DEPLOY_HOST=true DEPLOY_HOST_OS=false HOST_SERVICES=autoputer,proxy
DEPLOY_RUN_ID=18712345678 DEPLOY_RUN_ATTEMPT=2 DEPLOY_VMCTL_RESTART=true DEPLOY_ACTIVE_VM_REFRESH=true REFRESH_ACTIVE_COMPUTERS=false
for verb in prebuild deploy; do
  template=$(sed -n "s/^ *request=\"\(${verb} [^\"]*\)\"\$/\1/p" "$workflow")
  [ -n "$template" ] || fail "ci.yml has no ${verb} request template"
  request=$(eval "printf '%s' \"$template\"")
  "$gate" --print-plan "$request" >/dev/null || fail "ci.yml ${verb} request does not parse: $request"
done

# The host wiring (nix/node-b.nix): the key is forced to the gate through
# sudo with the request as one argument after "--", and the gate is the
# deploy user's only sudo rule.
nix_file="$root/nix/node-b.nix"
for pattern in \
  '(builtins.readFile ../scripts/node-b-ci-gate);' \
  'exec /run/wrappers/bin/sudo -n ${ciDeployGate} -- "'"''"'${SSH_ORIGINAL_COMMAND:-}"' \
  "''restrict,command=\"\${ciDeployForcedCommand}\" \${ciDeployKey}''" \
  'users = [ "choir-deploy" ];' \
  'runAs = "root";' \
  'command = "${ciDeployGate}";'; do
  grep -Fq -- "$pattern" "$nix_file" || fail "nix/node-b.nix lacks: $pattern"
done
[ "$(grep -c 'command = ' "$nix_file")" -eq 1 ] || fail "nix/node-b.nix has more than one sudo command rule"
grep -Eq 'choir-deploy.*(ALL|NOPASSWD: *ALL)' "$nix_file" && fail "choir-deploy has a broad sudo rule"

echo "node-b-ci-gate tests passed"
