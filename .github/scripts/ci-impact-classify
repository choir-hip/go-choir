#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<'EOF'
ci-impact-classify reads changed file paths from stdin and writes a CI plan.

Usage:
  git diff --name-only <base>..<head> | ci-impact-classify --sha <commit> [output-file]

Set CI_FORCE_ALL=true for manual or recovery runs where every lane must run.
EOF
}

sha=""
output_file=""
while (($# > 0)); do
  case "$1" in
    --sha)
      [[ $# -ge 2 ]] || { usage; exit 2; }
      sha="$2"
      shift 2
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      if [[ -n "$output_file" ]]; then
        usage
        exit 2
      fi
      output_file="$1"
      shift
      ;;
  esac
done

if [[ -t 0 ]]; then
  usage
  exit 1
fi

if [[ -n "$sha" && ! "$sha" =~ ^[0-9a-fA-F]{8,40}$ ]]; then
  echo "--sha must be 8-40 hexadecimal characters, got: $sha" >&2
  exit 2
fi

declare -a changed=()
declare -a explanations=()
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  changed+=("$path")
done

non_docs=false
go=false
frontend=false
sbom=false
flakehub=false
high_risk_race=false
ci=false
receipts_swap=false

# is_docs_like_path: docs, skill text and developer-side scripts need no CI
# lane (owner, 2026-11-12); they ship with the next push that does run.
# shellcheck source=ci-docs-like-paths
source "$(dirname "${BASH_SOURCE[0]}")/ci-docs-like-paths"

is_docs_path() {
  is_docs_like_path "$1"
}

mark() {
  local variable="$1"
  local reason="$2"
  printf -v "$variable" true
  explanations+=("$reason")
}

if [[ "${CI_FORCE_ALL:-false}" == "true" ]]; then
  non_docs=true
  go=true
  frontend=true
  sbom=true
  flakehub=true
  high_risk_race=true
  ci=true
  receipts_swap=true
  explanations+=("manual/recovery run -> all CI lanes")
else
  for path in "${changed[@]}"; do
    if ! is_docs_path "$path"; then
      non_docs=true
    fi

    if ! is_docs_path "$path" && [[ "$path" != .github/* ]]; then
      flakehub=true
    fi

    # The operator's index-swap script runs DDL on the live receipt table; its
    # self-test (a throwaway PostgreSQL) runs whenever it, its test, the workflow
    # that wires it or the receipt index definitions it mirrors change.
    case "$path" in
      scripts/receipts-index-swap|scripts/receipts-index-swap-test|.github/workflows/ci.yml|internal/platform/receipt_indexes.go|internal/platform/computer_events.go)
        mark receipts_swap "$path -> receipts index swap script self-test"
        ;;
    esac

    case "$path" in
      .github/*|scripts/ci-find-green-pr-run)
        mark ci "$path -> CI tooling verification"
        ;;
    esac

    case "$path" in
      .github/workflows/ci.yml|.github/scripts/*sbom*)
        mark sbom "$path -> differential SBOM implementation verification"
        ;;
    esac

    case "$path" in
      .github/workflows/ci.yml|.github/actions/setup-go-build-cache/*)
        mark go "$path -> exercise changed Go-test topology"
        mark high_risk_race "$path -> exercise changed Race topology"
        ;;
    esac

    case "$path" in
      cmd/*|internal/*|configs/*|scripts/*.go|skills/*.go|skills/*/go.mod|skills/*/go.sum|go.mod|go.sum|scripts/go-test-*)
        mark go "$path -> Go verification"
        ;;
    esac

    # Scripts that Go code names run the Go lane (ci-docs-like-paths).
    if ci_go_script_path "$path"; then
      mark go "$path -> Go verification (a Go test reads or runs this script)"
    fi

    # internal/pkgruntime embeds a byte copy of the boundary plugin; its Go test
    # (TestEmbeddedBoundaryPluginIsTheFrontends) must run when the frontend copy changes.
    case "$path" in
      frontend/scripts/package-boundary-plugin.mjs)
        mark go "$path -> pkgruntime embeds a byte copy"
        ;;
    esac

    case "$path" in
      frontend/src/*|frontend/public/*|frontend/package.json|frontend/package-lock.json|frontend/pnpm-lock.yaml|frontend/svelte.config.js|frontend/vite.config.js|frontend/index.html)
        mark frontend "$path -> frontend build"
        ;;
    esac

    # The package modularity gate (docs/design/modularity-check-build-2026-11-04.md)
    # also reads the frontend's build scripts, its own spec and the computer's
    # module build; a change to any of them reruns the frontend lane. So does a
    # change to the workflow or this classifier, which could otherwise switch
    # the gate off on a run that does not select it.
    case "$path" in
      frontend/scripts/*|frontend/tests/package-modularity.spec.js|frontend/playwright.config.js|internal/pkgruntime/*.mjs|.github/workflows/ci.yml|.github/scripts/ci-impact-classify)
        mark frontend "$path -> package modularity gate"
        ;;
    esac

    case "$path" in
      flake.nix|flake.lock|go.mod|go.sum|frontend/src/*|frontend/public/*|frontend/package.json|frontend/package-lock.json|frontend/svelte.config.js|frontend/vite.config.js|frontend/index.html)
        mark sbom "$path -> SBOM derivation input"
        ;;
      cmd/*|internal/*)
        if [[ "$path" != *_test.go && "$path" != internal/*/testdata/* ]]; then
          mark sbom "$path -> service SBOM derivation input"
        fi
        ;;
    esac

    case "$path" in
      internal/agentcore/*|internal/textureowner/*|internal/actor/*|internal/actorruntime/*|internal/events/*|internal/store/*)
        mark high_risk_race "$path -> always-on race-sensitive substrate"
        ;;
    esac
  done
fi

docs_only=false
if ((${#changed[@]} > 0)) && [[ "$non_docs" == "false" ]]; then
  docs_only=true
fi

sample_bucket=-1
sampled_race=false
if [[ -n "$sha" ]]; then
  sample_bucket=$((16#${sha:0:8} % 20))
  if ((sample_bucket == 0)); then
    sampled_race=true
  fi
fi

emit() {
  cat <<EOF
docs_only=${docs_only}
non_docs=${non_docs}
go=${go}
frontend=${frontend}
sbom=${sbom}
flakehub=${flakehub}
high_risk_race=${high_risk_race}
ci=${ci}
receipts_swap=${receipts_swap}
sampled_race=${sampled_race}
sample_bucket=${sample_bucket}
EOF
}

if [[ -n "$output_file" ]]; then
  emit >> "$output_file"
fi

emit
printf '%s\n' "${explanations[@]}"
echo "SHA sample bucket ${sample_bucket}/20 (bucket 0 runs the 5% sampled race lane)"
