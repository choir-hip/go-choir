#!/usr/bin/env bash
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
ci="$root/.github/workflows/ci.yml"
race="$root/.github/workflows/race.yml"

require() {
  local file="$1"
  local pattern="$2"
  if ! grep -Fq -- "$pattern" "$file"; then
    echo "CI workflow contract missing from ${file#$root/}: $pattern" >&2
    exit 1
  fi
}

reject() {
  local file="$1"
  local pattern="$2"
  if grep -Fq -- "$pattern" "$file"; then
    echo "CI workflow contract forbids in ${file#$root/}: $pattern" >&2
    exit 1
  fi
}

require "$ci" 'race_selected: ${{ steps.select-race.outputs.race_selected }}'
require "$ci" 'HIGH_RISK_RACE: ${{ steps.classify.outputs.high_risk_race }}'
require "$ci" 'SAMPLED_RACE: ${{ steps.classify.outputs.sampled_race }}'
require "$ci" 'RACE_SELECTED: ${{ needs.plan.outputs.race_selected }}'
require "$ci" 'scripts/go-test-non-runtime-shards -race'
# The guest-token scanner runs with the script gates on every non-docs change
# (docs/problems/host-internal-token-sent-to-guests-by-fp0-probes-2026-10-22.md).
require "$ci" 'run: python3 -I scripts/selftest-guest-token'
# Main pushes plan against the live staging commit, so a docs push that
# superseded a queued code run cannot skip testing and deploying that code.
require "$ci" 'Plan base: live staging commit'
require "$ci" 'before="$deployed"'
require "$ci" 'scripts/go-test-runtime-shards -race'
require "$ci" 'scripts/go-test-integration -race'
require "$ci" 'go-test-scale:'
require "$ci" 'scripts/go-test-scale-tests'
require "$ci" 'go-test-scale "${{ needs.go-test-scale.result }}"'
reject "$ci" 'Run regression intentionally excluded by Race instrumentation'
reject "$ci" 'uses: ./.github/workflows/race.yml'
reject "$ci" 'needs.plan.outputs.high_risk_race'
reject "$ci" 'needs.plan.outputs.sampled_race'
require "$ci" 'case "${{ needs.plan.outputs.race_selected }}" in'
require "$ci" 'sbom-semantic-fingerprint-test'

require "$race" 'pull_request:'
require "$race" '      - .github/workflows/race.yml'
require "$race" 'name: Go Test (non-runtime race shard ${{ matrix.shard }})'
require "$race" 'shard: [0, 1, 2, 3]'
require "$race" 'run: scripts/go-test-non-runtime-shards -race'
reject "$race" 'go list ./...'

candidate_segment="$(sed -n '/^  sbom-candidate:/,/^  sbom:/p' "$ci")"
finalizer_segment="$(sed -n '/^  sbom:/,/^  build-frontend:/p' "$ci")"
check_segment="$(sed -n '/^  check:/,/^  sbom-candidate:/p' "$ci")"

for pattern in \
  'needs: plan' \
  'Reuse semantic inventories or build changed packages' \
  'Bind candidate to this workflow run' \
  'uses: actions/setup-go@' \
  'Upload unaccepted SBOM candidate' \
  'name: sbom-candidate-${{ github.run_id }}-${{ github.sha }}' \
  'overwrite: true' \
  'retention-days: 1'; do
  grep -Fq -- "$pattern" <<<"$candidate_segment" || {
    echo "SBOM candidate contract missing: $pattern" >&2
    exit 1
  }
done
if grep -Fq -- 'actions/cache/save' <<<"$candidate_segment" || grep -Fq -- 'Upload accepted SBOM artifact' <<<"$candidate_segment"; then
  echo "SBOM candidate must not publish accepted state" >&2
  exit 1
fi
if grep -Fq -- 'GITHUB_RUN_ATTEMPT' <<<"$candidate_segment"; then
  echo "SBOM candidate identity must not depend on rerun attempt" >&2
  exit 1
fi

for pattern in \
  'needs: [plan, check, sbom-candidate]' \
  "needs.check.result == 'success'" \
  "needs.sbom-candidate.result == 'success'" \
  'uses: actions/download-artifact@' \
  'Download SBOM candidate from this workflow run' \
  'name: sbom-candidate-${{ github.run_id }}-${{ github.sha }}' \
  'Restore accepted baseline for differential verification' \
  'uses: actions/setup-go@' \
  'uses: DeterminateSystems/nix-installer-action@' \
  'verify-sbom-candidate sboms "$GITHUB_SHA" "$GITHUB_RUN_ID" "$RUNNER_TEMP/sbom-baseline"' \
  'uses: actions/cache/save@' \
  'Upload accepted SBOM artifact'; do
  grep -Fq -- "$pattern" <<<"$finalizer_segment" || {
    echo "SBOM finalizer contract missing: $pattern" >&2
    exit 1
  }
done

verify_line="$(grep -nF 'verify-sbom-candidate sboms' <<<"$finalizer_segment" | cut -d: -f1)"
cache_line="$(grep -nF 'uses: actions/cache/save@' <<<"$finalizer_segment" | cut -d: -f1)"
upload_line="$(grep -nF 'Upload accepted SBOM artifact' <<<"$finalizer_segment" | cut -d: -f1)"
if [[ -z "$verify_line" || -z "$cache_line" || -z "$upload_line" || "$cache_line" -le "$verify_line" || "$upload_line" -le "$verify_line" ]]; then
  echo "SBOM accepted cache and artifact must follow candidate verification" >&2
  exit 1
fi

if grep -Eq '(^|, )race(,|])' <<<"$check_segment"; then
  echo "parent check must not depend on the duplicate reusable Race horn" >&2
  exit 1
fi

require "$ci" 'needs: [plan, check]'

# The job, and the program it runs on Node B (.github/scripts/node-b-ci-prebuild,
# read from the prebuilt commit; SEC-14). Each required pattern is checked in
# the part that must hold it (bunch 33 item 4); the forbidden ones in both.
prebuild_job="$(sed -n '/^  prebuild-staging:/,/^  deploy-staging:/p' "$ci")"
prebuild_program="$(cat "$root/.github/scripts/node-b-ci-prebuild")"
prebuild_segment="${prebuild_job}
${prebuild_program}"
for pattern in \
  'continue-on-error: true' \
  'group: staging-prebuild-node-b' \
  'needs: [plan, deploy-impact]' \
  "needs.deploy-impact.outputs.deploy_needed == 'true'"; do
  grep -Fq -- "$pattern" <<<"$prebuild_job" || {
    echo "prebuild job contract missing: $pattern" >&2
    exit 1
  }
done
for pattern in \
  'prebuild_repo=/opt/go-choir-prebuild' \
  'results_dir=/var/lib/go-choir/prebuild-results' \
  'git reset --hard "$DEPLOY_COMMIT"' \
  'nix build "$attr" -o "$out"'; do
  grep -Fq -- "$pattern" <<<"$prebuild_program" || {
    echo "prebuild program contract missing: $pattern" >&2
    exit 1
  }
done
for pattern in \
  'switch-to-configuration' \
  'systemctl restart' \
  'install_service_pointer' \
  'install_frontend_pointer' \
  'deploy-receipt' \
  'vmctl/refresh'; do
  if grep -Fq -- "$pattern" <<<"$prebuild_segment"; then
    echo "prebuild must never activate or mutate deploy state: $pattern" >&2
    exit 1
  fi
done
if grep -Eq 'prebuild' <<<"$check_segment"; then
  echo "check must not depend on the latency-hiding prebuild job" >&2
  exit 1
fi

# Heavy caches must have independent workloads and a refreshable source key.
cache_action="$root/.github/actions/setup-go-build-cache/action.yml"
require "$cache_action" 'cache: false'
require "$cache_action" 'uses: actions/cache@'
require "$cache_action" '${{ steps.go.outputs.go-version }}-${{ inputs.lane }}'
require "$cache_action" "hashFiles('**/*.go'"
require "$cache_action" 'restore-keys:'
reject "$cache_action" 'cache-hit'
require "$ci" '.github/scripts/go-shard-discovery-test'
require "$ci" 'lane: vet-build'
require "$ci" 'lane: runtime-${{ needs.plan.outputs.race_selected'
require "$ci" 'lane: non-runtime-${{ needs.plan.outputs.race_selected'
require "$ci" 'lane: scale-standard'
require "$race" 'lane: runtime-race'
require "$race" 'lane: non-runtime-race-'
reject "$race" 'go-build-v2-'

# Every third-party action is pinned by full commit SHA with its release tag
# in a comment (docs/reports/patch-lanes-plan-2026-10-15.md, slice 6). A tag
# or branch ref updates without review; on a job that holds a deploy key or
# can mint OIDC tokens, that is code reaching Node B unreviewed. Local
# actions (./...) are part of this repository and exempt.
unpinned="$(grep -nE '^[[:space:]]*(-[[:space:]]+)?uses:[[:space:]]' \
    "$root"/.github/workflows/*.yml "$root"/.github/actions/*/action.yml |
  grep -vE 'uses:[[:space:]]+\./' |
  grep -vE 'uses:[[:space:]]+[A-Za-z0-9_.-]+/[A-Za-z0-9_./-]+@[0-9a-f]{40}[[:space:]]+#[[:space:]]+v[0-9][^[:space:]]*[[:space:]]*$' || true)"
if [[ -n "$unpinned" ]]; then
  echo "third-party actions must be pinned by commit SHA with the tag in a comment (uses: owner/repo@<40-hex> # vX.Y.Z):" >&2
  echo "${unpinned//$root\//}" >&2
  exit 1
fi

echo "ci-workflow-contract: all tests passed"
