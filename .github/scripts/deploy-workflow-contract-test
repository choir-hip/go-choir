#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
workflow="$root/.github/workflows/ci.yml"
# The programs Node B runs for prebuild and deploy live beside the workflow
# and are read from the deployed commit (SEC-14); the contract covers both.
# Every required pattern names the file that must hold it (require_in), so
# program text can never satisfy a workflow pattern or the other way round
# (bunch 33 item 4). A forbidden pattern (reject) is forbidden in all three.
prebuild_program="$root/.github/scripts/node-b-ci-prebuild"
deploy_program="$root/.github/scripts/node-b-ci-deploy"
sources=("$workflow" "$prebuild_program" "$deploy_program")

reject() {
  local pattern="$1"
  if grep -Fq -- "$pattern" "${sources[@]}"; then
    echo "deploy workflow contract forbids: $pattern" >&2
    exit 1
  fi
}

require_in() {
  local file="$1"
  local pattern="$2"
  if ! grep -Fq -- "$pattern" "$file"; then
    echo "deploy workflow contract missing from ${file#$root/}: $pattern" >&2
    exit 1
  fi
}

reject_in() {
  local file="$1"
  local pattern="$2"
  if grep -Fq -- "$pattern" "$file"; then
    echo "deploy workflow contract forbids in ${file#$root/}: $pattern" >&2
    exit 1
  fi
}

# SEC-14: every ssh to Node B checks the pinned host keys, and the workflow
# carries no remote program of its own.
require_in "$workflow" 'HostKeyAlias go-choir-node-b'
require_in "$workflow" 'StrictHostKeyChecking yes'
reject_in "$workflow" 'StrictHostKeyChecking=no'
reject_in "$workflow" 'StrictHostKeyChecking no'
reject_in "$workflow" 'ssh-keyscan'
reject_in "$workflow" "<<'REMOTE_DEPLOY'"
reject_in "$workflow" "<<'REMOTE_PREBUILD'"
require_in "$deploy_program" 'echo "==> Staging deploy complete"'
require_in "$prebuild_program" 'exit "$prebuild_status"'
# SEC-14 deploy 2: CI logs in as choir-deploy, whose forced command is the
# gate (scripts/node-b-ci-gate); it sends a verb and typed values, never a
# program, and never logs in as root.
require_in "$workflow" 'User choir-deploy'
reject_in "$workflow" 'User root'
reject_in "$workflow" 'root@'
reject_in "$workflow" 'bash -s'
reject_in "$workflow" 'remote_env_q'
require_in "$workflow" 'request="prebuild DEPLOY_COMMIT=${DEPLOY_COMMIT} DEPLOY_FRONTEND=${DEPLOY_FRONTEND} DEPLOY_HOST=${DEPLOY_HOST} DEPLOY_HOST_OS=${DEPLOY_HOST_OS} HOST_SERVICES=${HOST_SERVICES}"'
require_in "$workflow" 'request="deploy DEPLOY_COMMIT=${DEPLOY_COMMIT} DEPLOY_RUN_ID=${DEPLOY_RUN_ID} DEPLOY_RUN_ATTEMPT=${DEPLOY_RUN_ATTEMPT} DEPLOY_HOST=${DEPLOY_HOST} DEPLOY_FRONTEND=${DEPLOY_FRONTEND} DEPLOY_VMCTL_RESTART=${DEPLOY_VMCTL_RESTART} DEPLOY_ACTIVE_VM_REFRESH=${DEPLOY_ACTIVE_VM_REFRESH} REFRESH_ACTIVE_COMPUTERS=${REFRESH_ACTIVE_COMPUTERS} DEPLOY_HOST_OS=${DEPLOY_HOST_OS} HOST_SERVICES=${HOST_SERVICES}"'
[ "$(grep -cF 'ssh -n go-choir-node-b "$request"' "$workflow")" -eq 2 ] || {
  echo "deploy workflow contract: prebuild and deploy each send one gate request" >&2
  exit 1
}

require_in "$workflow" 'DEPLOY_COMMIT: ${{ github.sha }}'
require_in "$prebuild_program" 'git fetch --no-tags origin "$DEPLOY_COMMIT"'
require_in "$deploy_program" 'git fetch --no-tags origin "$DEPLOY_COMMIT"'
require_in "$prebuild_program" 'git reset --hard "$DEPLOY_COMMIT"'
require_in "$deploy_program" 'git reset --hard "$DEPLOY_COMMIT"'
require_in "$workflow" 'x-choir-build-commit:'
require_in "$deploy_program" 'x-choir-build-commit:'
require_in "$deploy_program" 'deploy-receipt.json'
# A partial deploy merges into the previous receipt instead of replacing it,
# and deploy decisions never diff from the push before-SHA (docs/problems/
# partial-deploy-receipt-blanks-deployed-commit-2026-10-14.md).
require_in "$deploy_program" '.github/scripts/deploy-receipt-merge /var/lib/go-choir/deploy-receipt.json < "${receipt_tmp}.new" > "$receipt_tmp"'
require_in "$workflow" 'selection="$(.github/scripts/deploy-base-select --after "$after" --health "$health_json" --receipt "$RUNNER_TEMP/deployed-receipt.json")"'
require_in "$workflow" '"choir-deploy@${{ secrets.OVH_NODE_B_HOST }}" receipt >"$receipt_json"'
# The receipt records whether the activated kernel is booted, and the
# detector can never fail a deploy (docs/reports/patch-lanes-plan-2026-10-15.md).
require_in "$deploy_program" "boot_state=\$(python3 scripts/verify-host-hardening.py --boot-state-json 2>/dev/null) || boot_state=''"
require_in "$deploy_program" 'boot_state: $boot_state'
require_in "$workflow" 'Staging deploy forced: no trustworthy deployed base'
require_in "$workflow" 'selection="$(.github/scripts/deploy-base-select --after "$AFTER" --health "$health_json")"'
reject 'before="${{ github.event.before }}"'
reject 'git diff-tree --no-commit-id --name-only -r "$after"'
reject "jq -r '.build.deployed_commit // empty'"
# The deploy never rewrites a unit's env file. Its rename of deploy.env put a
# new file under every running unit's hidden mount (docs/problems/
# host-containment-gaps-after-fp3-cut-2-2026-10-22.md); the env files now
# live in /var/lib/go-choir/unit-env, which every unit hides as a directory.
reject 'deploy.env'
require_in "$deploy_program" 'Refusing to publish an activation receipt with no verified artifacts'
require_in "$deploy_program" 'deploy-failures'
require_in "$deploy_program" 'verify_artifact_manifest'
require_in "$deploy_program" 'autoputer_commit=$(verify_artifact_manifest /var/lib/go-choir/services/autoputer/share/go-choir/build.json autoputer)'
require_in "$deploy_program" 'source scripts/node-b-sync-service-pointers'
require_in "$deploy_program" 'active_path="/var/lib/go-choir/services/${service}"'
require_in "$deploy_program" 'active_commit=$(artifact_manifest_commit "$active_path/share/go-choir/build.json" "$service")'
require_in "$deploy_program" 'active_digest=$(nix hash path --type sha256 "$active_path")'
require_in "$deploy_program" 'candidate_digest=$(nix hash path --type sha256 "$candidate_path" 2>/dev/null || true)'
require_in "$deploy_program" 'if [ "$candidate_commit" = "$active_commit" ] && [ "$candidate_digest" = "$active_digest" ]; then'
require_in "$deploy_program" 'fallback_path=$(resolve_service_package_from_unit "$service")'
require_in "$deploy_program" 'if [ "$fallback_commit" = "$active_commit" ] && [ "$fallback_digest" = "$active_digest" ]; then'
require_in "$deploy_program" 'package_commit="$active_commit"'
require_in "$deploy_program" 'for identity_service in "${identity_services[@]}"; do'
require_in "$deploy_program" 'if [ "$package_commit" != "$DEPLOY_COMMIT" ] || [ "$service_commit" != "$DEPLOY_COMMIT" ]; then'
require_in "$deploy_program" 'jq --arg service "$service" --arg path "$package_path" --arg digest "$package_digest" --arg commit "$package_commit"'
reject 'if [ "$candidate_commit" = "$DEPLOY_COMMIT" ]; then'
reject 'package_commit=$(verify_artifact_manifest "$package_path/share/go-choir/build.json" "$service")'
reject 'jq --arg service "$service" --arg path "$package_path" --arg digest "$package_digest" --arg commit "$service_commit"'
reject 'service_commit=$(curl -fsS --max-time 5 "http://127.0.0.1:${port}/health" | jq -er '\''.build.commit'\'')'
reject 'package_path=$(readlink -f "/var/lib/go-choir/services/${service}")'
require_in "$deploy_program" 'wait_for_autoputer_commit "$refresh_computer_url" "$refresh_vm_id" "$refresh_expected_commit"'
require_in "$deploy_program" 'refresh_health_commit=$(curl -fsS --max-time 10 "${refresh_computer_url}/health"'
require_in "$deploy_program" 'refresh_expected_commit="$refresh_health_commit"'
require_in "$deploy_program" 'if [ -n "$refresh_health_commit" ] && [ "$refresh_health_commit" = "$autoputer_runtime_commit" ]; then'
require_in "$deploy_program" 'expecting served commit ${refresh_expected_commit} or ${autoputer_runtime_commit} after refresh'
require_in "$deploy_program" 'Autoputer runtime selected without canonical guest boot refresh; refusing an undeployable service-pointer-only artifact'
reject 'DEPLOY_APP_LAYER'
reject 'App-layer release push'
require_in "$workflow" 'echo "host_services=autoputer"'
reject '/internal/runtime/refresh'
# Deploys keep active computers current through the guest's planned-restart
# marker and never restart a busy one: vmctl selects (constructed and
# always-on computers included, held ones skipped), the guest refuses while
# busy, and the deferred computer waits for the next deploy
# (docs/problems/deploy-restarts-busy-computers-2026-10-09.md,
# docs/problems/owner-computer-pinned-as-canary-2026-10-13.md).
require_in "$deploy_program" 'http://127.0.0.1:8083/internal/vmctl/deploy-refresh)'
require_in "$deploy_program" 'http://127.0.0.1:8083/internal/vmctl/deploy-refresh || printf'
require_in "$deploy_program" '{user_id:$user_id,desktop_id:$desktop_id,target:$target}'
require_in "$deploy_program" 'elif [ "$refresh_outcome" = "deferred" ] && { [ "${REFRESH_ACTIVE_COMPUTERS}" != "true" ] || [ "$refresh_rescue" = "true" ]; }; then'
require_in "$deploy_program" 'Deferred ${refresh_vm_id} (vmctl retries it every minute until it updates): ${refresh_reason}'
require_in "$deploy_program" 'record_receipt_artifact active_computers "$DEPLOY_COMMIT" pending'
require_in "$deploy_program" 'active_computers: {commit: $commit, status: $status, deferred: $deferred}'
require_in "$deploy_program" 'No active interactive computers need refresh'
# The operator refresh (crash boot) runs only for an explicit manual dispatch.
require_in "$workflow" "REFRESH_ACTIVE_COMPUTERS: \${{ github.event_name == 'workflow_dispatch' && inputs.refresh_active_computers && 'true' || 'false' }}"
require_in "$deploy_program" 'X-Choir-Lifecycle-Caller: ci.deploy-refresh-forced'
reject 'Preserving immutable constructed computer'
reject 'select((.snapshot_kind // "") != "constructed-computer-version")'
reject 'git reset --hard origin/main'
reject 'fast_build_host_service'
reject 'active computer refresh failed; continuing'
reject 'if [ "$commit" = "$DEPLOY_COMMIT" ]; then'
reject 'DEPLOY_PLAYWRIGHT_GUEST'
reject 'deploy_playwright_guest'
reject 'guest-image-playwright'
reject 'guest-playwright'
reject 'playwright_guest'
reject 'DEPLOY_ORDINARY_GUEST'
reject 'deploy_ordinary_guest'
reject 'install_guest_image'
reject 'ordinary_guest'
reject '/tmp/guest-image-result'

identity_line=$(grep -nF 'selected service build identity mismatch' "$deploy_program" | tail -n 1 | cut -d: -f1)
receipt_line=$(grep -nF 'Published activation receipt' "$deploy_program" | cut -d: -f1)
if [ -z "$identity_line" ] || [ -z "$receipt_line" ] || [ "$receipt_line" -le "$identity_line" ]; then
  echo "activation receipt must be published after selected-service identity verification" >&2
  exit 1
fi

# Keep the EXIT-trap artifact default valid JSON. A malformed parameter
# expansion here silently suppresses the very failure evidence it should write.
receipt_artifacts='{}'
artifacts_json="${receipt_artifacts:-"{}"}"
jq -n --argjson artifacts "$artifacts_json" '{observed_artifacts: $artifacts}' |
  jq -e '.observed_artifacts == {}' >/dev/null

# The deploy refresh selection (constructed computers included, held ones
# skipped) is vmctl's selectDeployRefresh, pinned by
# internal/vmctl/deploy_refresh_test.go; the workflow reads it from vmctl.
reject "select(.state == \"active\") | select((.kind == null)"

echo "deploy workflow contract tests passed"
