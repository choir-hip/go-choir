{
  "schema": "choir.app-package/v1",
  "name": "p2btest",
  "version": "0.1.0",
  "origin": "first_party",
  "display": { "title": "P2b test", "icon": "T", "description": "fixture" },
  "app": {
    "entry": "App.svelte",
    "abi": "choir.app-frontend/svelte-inline/v1",
    "aliases": ["p2b"],
    "launcher": { "menu": true, "desktopIcon": false, "order": 900 },
    "window": { "singleton": true, "heavy": false },
    "auth": { "preview": "private" },
    "theme": { "surface": "standard", "shellDataAttr": "p2btest", "contentClass": "p2btest-content" }
  },
  "opens": [{ "media_type": "application/x-p2btest", "extensions": ["p2b"] }],
  "kinds": [
    {
      "kind": "choir.app.p2btest.note",
      "identity": "external_key",
      "versioned": true,
      "owner_edits": true,
      "schema_version": 1,
      "reads_schema_versions": [1],
      "schema": {
        "type": "object",
        "required": ["title", "priority"],
        "properties": {
          "title": { "type": "string", "maxLength": 20 },
          "priority": { "type": "integer", "maximum": 5 },
          "state": { "type": "string", "enum": ["open", "done"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "meta": { "type": "object", "required": ["by"], "properties": { "by": { "type": "string" } } }
        }
      }
    },
    {
      "kind": "choir.app.p2btest.ledger",
      "identity": "external_key",
      "versioned": true,
      "owner_edits": false,
      "schema_version": 1,
      "reads_schema_versions": [1],
      "schema": { "type": "object", "required": ["entry"], "properties": { "entry": { "type": "string" } } }
    }
  ],
  "uses_kinds": ["choir.content_item"],
  "desk": null,
  "backend": null,
  "grants": []
}
