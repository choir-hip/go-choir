{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choir.news/schemas/supervision_transaction_v1.schema.json",
  "title": "Choir Supervision Transaction V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "reducer", "digest_recipe", "transaction_id", "transaction_class",
    "owner_id", "computer_id", "trajectory_id", "command_id", "command_digest",
    "actor", "expected", "observed_base", "mutations", "referenced_artifacts"
  ],
  "properties": {
    "schema": {"const": "choir.supervision_transaction.v1"},
    "reducer": {"const": "supervision/v1"},
    "digest_recipe": {"const": "sha256:choir.canonical-json/v1:logical-private-artifacts-without-command_digest-and-transaction_id"},
    "transaction_id": {"$ref": "#/$defs/id"},
    "transaction_class": {
      "enum": [
        "projection_import", "open_trajectory", "revise_intent", "revise_artifact",
        "record_message", "record_research", "open_assignment", "start_attempt",
        "return_result", "record_belief", "record_finding",
        "record_dissent", "record_reconciliation", "propose_decision",
        "record_owner_decision", "cancel_assignment", "record_disposition",
        "propose_settlement", "settle_trajectory", "archive_artifact"
      ]
    },
    "owner_id": {"$ref": "#/$defs/id"},
    "computer_id": {"$ref": "#/$defs/id"},
    "trajectory_id": {"$ref": "#/$defs/id"},
    "command_id": {"$ref": "#/$defs/id"},
    "command_digest": {"$ref": "#/$defs/digest"},
    "actor": {"$ref": "#/$defs/actor"},
    "expected": {"$ref": "#/$defs/expected"},
    "observed_base": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/observed_base"}]},
    "mutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/mutation"}
    }
    ,"referenced_artifacts": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "array",
          "maxItems": 256,
          "items": {"$ref": "#/$defs/referenced_artifact"}
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"transaction_class": {"const": "projection_import"}}},
      "then": {
        "properties": {
          "actor": {"properties": {"role": {"const": "runtime"}}},
          "mutations": {
            "minItems": 1, "maxItems": 1,
            "items": {"properties": {"kind": {"const": "projection_imported"}}}
          }
        }
      }
    },
    {
      "if": {"properties": {"transaction_class": {"const": "open_trajectory"}}},
      "then": {
        "properties": {
          "actor": {"properties": {"role": {"enum": ["texture", "owner"]}}},
          "mutations": {
            "items": {"properties": {"kind": {"enum": ["trajectory_started", "intent_revised", "texture_revision"]}}},
            "allOf": [
              {"contains": {"properties": {"kind": {"const": "trajectory_started"}}}, "minContains": 1, "maxContains": 1},
              {"contains": {"properties": {"kind": {"const": "intent_revised"}}}, "minContains": 1, "maxContains": 1},
              {"contains": {"properties": {"kind": {"const": "texture_revision"}}}, "minContains": 1, "maxContains": 1}
            ]
          }
        }
      }
    },
    {
      "if": {"properties": {"transaction_class": {"const": "revise_intent"}}},
      "then": {
        "properties": {
          "actor": {"properties": {"role": {"enum": ["texture", "owner"]}}},
          "mutations": {
            "items": {"properties": {"kind": {"enum": ["intent_revised", "disposition_recorded"]}}},
            "contains": {"properties": {"kind": {"const": "intent_revised"}}},
            "minContains": 1,
            "maxContains": 1
          }
        }
      }
    },
    {
      "if": {"properties": {"transaction_class": {"const": "revise_artifact"}}},
      "then": {"$ref": "#/$defs/texture_revision_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_message"}}},
      "then": {"$ref": "#/$defs/actor_message_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_research"}}},
      "then": {"$ref": "#/$defs/researcher_packet_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "open_assignment"}}},
      "then": {
        "properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "assignment_opened"}}}}
        }
      }
    },
    {
      "if": {"properties": {"transaction_class": {"const": "start_attempt"}}},
      "then": {"$ref": "#/$defs/attempt_started_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "return_result"}}},
      "then": {"$ref": "#/$defs/attempt_result_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_belief"}}},
      "then": {"$ref": "#/$defs/super_belief_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_finding"}}},
      "then": {"$ref": "#/$defs/super_finding_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_dissent"}}},
      "then": {"$ref": "#/$defs/dissent_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_reconciliation"}}},
      "then": {"$ref": "#/$defs/reconciliation_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "propose_decision"}}},
      "then": {"$ref": "#/$defs/super_decision_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_owner_decision"}}},
      "then": {"$ref": "#/$defs/owner_decision_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "cancel_assignment"}}},
      "then": {"$ref": "#/$defs/assignment_cancelled_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "record_disposition"}}},
      "then": {
        "properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "disposition_recorded"}}}}
        }
      }
    },
    {
      "if": {"properties": {"transaction_class": {"const": "propose_settlement"}}},
      "then": {"$ref": "#/$defs/settlement_proposed_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "settle_trajectory"}}},
      "then": {"$ref": "#/$defs/trajectory_settled_transaction"}
    },
    {
      "if": {"properties": {"transaction_class": {"const": "archive_artifact"}}},
      "then": {"$ref": "#/$defs/artifact_archived_transaction"}
    }
  ],
  "$defs": {
    "id": {"type": "string", "minLength": 1, "maxLength": 255},
    "nullable_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact_ref": {"type": "string", "pattern": "^artifact:sha256:[0-9a-f]{64}$"},
    "id_array": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "nonempty_id_array": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "artifact_ref_array": {
      "type": "array", "maxItems": 256, "uniqueItems": true,
      "items": {"$ref": "#/$defs/artifact_ref"}
    },
    "referenced_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "artifact_digest", "plaintext_digest", "media_type", "binding_id", "pin_receipt"],
      "properties": {
        "ref": {"$ref": "#/$defs/artifact_ref"},
        "artifact_digest": {"$ref": "#/$defs/digest"},
        "plaintext_digest": {"$ref": "#/$defs/digest"},
        "logical_plaintext_digest": {"$ref": "#/$defs/digest"},
        "media_type": {"type": "string", "minLength": 1, "maxLength": 255},
        "binding_id": {"$ref": "#/$defs/id"},
        "pin_receipt": {"$ref": "#/$defs/receipt"}
      }
    },
    "receipt": {
      "type": "object",
      "required": ["receipt_version", "receipt_kind", "receipt_id", "issuer", "issued_at", "required_signers", "canonical_payload_sha256", "signature_set"],
      "properties": {
        "receipt_version": {"type": "integer", "minimum": 1},
        "receipt_kind": {"$ref": "#/$defs/id"},
        "receipt_id": {"$ref": "#/$defs/id"},
        "issuer": {"$ref": "#/$defs/id"},
        "issued_at": {"type": "string", "format": "date-time"},
        "required_signers": {"type": "array"},
        "canonical_payload_sha256": {"$ref": "#/$defs/digest"},
        "signature_set": {"type": "array"}
      },
      "additionalProperties": true
    },
    "actor": {
      "type": "object", "additionalProperties": false,
      "required": ["actor_id", "role", "authority_ref"],
      "properties": {
        "actor_id": {"$ref": "#/$defs/id"},
        "role": {"enum": ["owner", "texture", "super", "researcher", "cosuper", "verifier", "runtime"]},
        "authority_ref": {"$ref": "#/$defs/id"}
      }
    },
    "expected": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_event_head", "lifecycle_version", "intent_revision_id", "artifact_head_revision_id", "settlement_proposal_id"],
      "properties": {
        "canonical_event_head": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/digest"}]},
        "lifecycle_version": {"oneOf": [{"type": "null"}, {"type": "integer", "minimum": 0}]},
        "intent_revision_id": {"$ref": "#/$defs/nullable_id"},
        "artifact_head_revision_id": {"$ref": "#/$defs/nullable_id"},
        "settlement_proposal_id": {"$ref": "#/$defs/nullable_id"}
      }
    },
    "observed_base": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_event_head", "intent_revision_id", "artifact_head_revision_id"],
      "properties": {
        "canonical_event_head": {"$ref": "#/$defs/digest"},
        "intent_revision_id": {"$ref": "#/$defs/id"},
        "artifact_head_revision_id": {"$ref": "#/$defs/id"}
      }
    },
    "affected_target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id", "prior_intent_revision_id", "state_digest", "rebase_obligation_id"],
      "properties": {
        "kind": {"enum": ["assignment", "attempt", "result", "update", "belief", "finding", "artifact_premise"]},
        "id": {"$ref": "#/$defs/id"},
        "prior_intent_revision_id": {"$ref": "#/$defs/id"},
        "state_digest": {"$ref": "#/$defs/digest"},
        "rebase_obligation_id": {"$ref": "#/$defs/id"}
      }
    },
    "subject_ref": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["trajectory", "artifact", "assignment", "attempt", "result", "update", "belief", "finding", "dissent", "decision", "premise", "rebase_obligation", "compensation_obligation", "owner_attention"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "disposition_target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["assignment", "attempt", "result", "update", "finding", "dissent", "rebase_obligation", "compensation_obligation"]},
        "id": {"$ref": "#/$defs/id"}
      }
    },
    "single_mutation": {
      "type": "object",
      "required": ["actor", "mutations"],
      "properties": {
        "mutations": {"minItems": 1, "maxItems": 1}
      }
    },
    "texture_revision_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"enum": ["texture", "owner"]}}},
          "mutations": {"items": {"properties": {"kind": {"const": "texture_revision"}}}}
        }}
      ]
    },
    "actor_message_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"enum": ["texture", "super"]}}},
          "mutations": {"items": {"properties": {"kind": {"const": "actor_message_recorded"}}}}
        }}
      ]
    },
    "researcher_packet_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "researcher"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "researcher_packet_recorded"}}}}
        }}
      ]
    },
    "attempt_started_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"enum": ["super", "runtime"]}}},
          "mutations": {"items": {"properties": {"kind": {"const": "attempt_started"}}}}
        }}
      ]
    },
    "attempt_result_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "cosuper"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "attempt_result"}}}}
        }}
      ]
    },
    "super_belief_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "super_belief_recorded"}}}}
        }}
      ]
    },
    "super_finding_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "super_finding_recorded"}}}}
        }}
      ]
    },
    "dissent_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"enum": ["super", "researcher", "cosuper", "verifier"]}}},
          "mutations": {"items": {"properties": {"kind": {"const": "dissent_recorded"}}}}
        }}
      ]
    },
    "reconciliation_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "super_reconciliation_recorded"}}}}
        }}
      ]
    },
    "super_decision_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "super_decision_proposed"}}}}
        }}
      ]
    },
    "owner_decision_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "owner"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "owner_decision_recorded"}}}}
        }}
      ]
    },
    "assignment_cancelled_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "assignment_cancelled"}}}}
        }}
      ]
    },
    "settlement_proposed_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"const": "super"}}},
          "mutations": {"items": {"properties": {"kind": {"const": "settlement_proposed"}}}}
        }}
      ]
    },
    "trajectory_settled_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"enum": ["texture", "owner"]}}},
          "mutations": {"items": {"properties": {"kind": {"const": "trajectory_settled"}}}}
        }}
      ]
    },
    "artifact_archived_transaction": {
      "allOf": [
        {"$ref": "#/$defs/single_mutation"},
        {"properties": {
          "actor": {"properties": {"role": {"enum": ["texture", "owner"]}}},
          "mutations": {"items": {"properties": {"kind": {"const": "artifact_archived"}}}}
        }}
      ]
    },
    "mutation": {
      "oneOf": [
        {"$ref": "#/$defs/projection_imported"},
        {"$ref": "#/$defs/trajectory_started"},
        {"$ref": "#/$defs/intent_revised"},
        {"$ref": "#/$defs/texture_revision"},
        {"$ref": "#/$defs/actor_message_recorded"},
        {"$ref": "#/$defs/researcher_packet_recorded"},
        {"$ref": "#/$defs/assignment_opened"},
        {"$ref": "#/$defs/attempt_started"},
        {"$ref": "#/$defs/attempt_result"},
        {"$ref": "#/$defs/super_belief_recorded"},
        {"$ref": "#/$defs/super_finding_recorded"},
        {"$ref": "#/$defs/dissent_recorded"},
        {"$ref": "#/$defs/super_reconciliation_recorded"},
        {"$ref": "#/$defs/super_decision_proposed"},
        {"$ref": "#/$defs/owner_decision_recorded"},
        {"$ref": "#/$defs/assignment_cancelled"},
        {"$ref": "#/$defs/disposition_recorded"},
        {"$ref": "#/$defs/settlement_proposed"},
        {"$ref": "#/$defs/trajectory_settled"},
        {"$ref": "#/$defs/artifact_archived"}
      ]
    },
    "projection_imported": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": {"const": "projection_imported"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["import_ref", "import_digest", "import_artifact_plaintext_digest", "source_dolt_commit", "source_projection_digest", "legacy_lifecycle_watermark", "object_count", "edge_count", "refusal_count", "quiescence_receipt_ref", "drain_receipt_refs", "manifest"],
          "properties": {
            "import_ref": {"$ref": "#/$defs/artifact_ref"},
            "import_digest": {"$ref": "#/$defs/digest"},
            "import_artifact_plaintext_digest": {"$ref": "#/$defs/digest"},
            "source_dolt_commit": {"$ref": "#/$defs/id"},
            "source_projection_digest": {"$ref": "#/$defs/digest"},
            "legacy_lifecycle_watermark": {"type": "integer", "minimum": 0},
            "object_count": {"type": "integer", "minimum": 1},
            "edge_count": {"type": "integer", "minimum": 0},
            "refusal_count": {"type": "integer", "minimum": 0},
            "quiescence_receipt_ref": {"$ref": "#/$defs/artifact_ref"},
            "drain_receipt_refs": {"$ref": "#/$defs/artifact_ref_array"},
            "manifest": {"$ref": "projection_import_v1.schema.json"}
          }
        }
      }
    },
    "trajectory_started": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": {"const": "trajectory_started"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["trajectory_kind", "subject_refs", "intent_revision_id", "artifact_id", "artifact_revision_id", "texture_actor_id", "initial_assignment_ids", "objective"],
          "properties": {
            "trajectory_kind": {"enum": ["document", "task", "publication"]},
            "subject_refs": {"type": "object", "additionalProperties": {"$ref": "#/$defs/id"}, "maxProperties": 256},
            "intent_revision_id": {"$ref": "#/$defs/id"},
            "artifact_id": {"$ref": "#/$defs/id"},
            "artifact_revision_id": {"$ref": "#/$defs/id"},
            "texture_actor_id": {"$ref": "#/$defs/id"},
            "initial_assignment_ids": {"$ref": "#/$defs/nonempty_id_array"},
            "objective": {"type": "string"}
          }
        }
      }
    },
    "intent_revised": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": {"const": "intent_revised"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["intent_revision_id", "parent_intent_revision_id", "intent", "material", "affected_targets"],
          "properties": {
            "intent_revision_id": {"$ref": "#/$defs/id"},
            "parent_intent_revision_id": {"$ref": "#/$defs/nullable_id"},
            "intent": {"type": "string"},
            "material": {"type": "boolean"},
            "affected_targets": {
              "type": "array", "maxItems": 512, "uniqueItems": true,
              "items": {"$ref": "#/$defs/affected_target"}
            }
          },
          "allOf": [
            {"if": {"properties": {"material": {"const": true}}}, "then": {"properties": {"affected_targets": {"minItems": 1}}}},
            {"if": {"properties": {"material": {"const": false}}}, "then": {"properties": {"affected_targets": {"maxItems": 0}}}}
          ]
        }
      }
    },
    "texture_revision": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": {"const": "texture_revision"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["artifact_id", "revision_id", "title", "parent_revision_id", "content", "source_graph", "metadata", "metadata_digest", "narrative_kind", "fulfills_intent_revision_id"],
          "properties": {
            "artifact_id": {"$ref": "#/$defs/id"},
            "revision_id": {"$ref": "#/$defs/id"},
            "title": {"type": "string", "maxLength": 8192},
            "parent_revision_id": {"$ref": "#/$defs/nullable_id"},
            "content": {"type": "string"},
            "source_graph": {"type": "object"},
            "metadata": {"type": "object"},
            "metadata_digest": {"$ref": "#/$defs/digest"},
            "narrative_kind": {"enum": ["owner_edit", "texture_synthesis", "semantic_rebase", "settlement"]},
            "fulfills_intent_revision_id": {"$ref": "#/$defs/id"}
          }
        }
      }
    },
    "actor_message_recorded": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": {"const": "actor_message_recorded"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["message_id", "from_actor_id", "to_role", "to_actor_id", "channel_id", "payload_artifact_ref", "material"],
          "properties": {
            "message_id": {"$ref": "#/$defs/id"},
            "from_actor_id": {"$ref": "#/$defs/id"},
            "to_role": {"enum": ["owner", "texture", "super", "researcher", "cosuper", "verifier"]},
            "to_actor_id": {"$ref": "#/$defs/nullable_id"},
            "channel_id": {"$ref": "#/$defs/id"},
            "payload_artifact_ref": {"$ref": "#/$defs/artifact_ref"},
            "material": {"type": "boolean"}
          }
        }
      }
    },
    "researcher_packet_recorded": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
        "kind": {"const": "researcher_packet_recorded"},
        "body": {
          "type": "object", "additionalProperties": false,
          "required": ["packet_id", "researcher_id", "obligation_id", "packet_artifact_ref", "source_artifact_refs", "uncertainty_artifact_ref", "conflict_refs"],
          "properties": {
            "packet_id": {"$ref": "#/$defs/id"},
            "researcher_id": {"$ref": "#/$defs/id"},
            "obligation_id": {"$ref": "#/$defs/id"},
            "packet_artifact_ref": {"$ref": "#/$defs/artifact_ref"},
            "source_artifact_refs": {"$ref": "#/$defs/artifact_ref_array"},
            "uncertainty_artifact_ref": {"$ref": "#/$defs/artifact_ref"},
            "conflict_refs": {"$ref": "#/$defs/id_array"}
          }
        }
      }
    },
    "assignment_opened": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "body"],
      "properties": {
