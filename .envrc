use flake
# Go build cache hygiene (docs/evidence/go-build-cache-growth-2026-11-09.md).
# -trimpath: without it the action ID of every package of this module includes
# its source directory, so every worktree (and every agent's worktree)
# recompiles and re-stores the whole module, ~200 MB per worktree for the
# agentcore tests alone. -gcflags=...=-dwarf=false: no compiler DWARF for this
# module's packages (the standard library and dependencies keep theirs); it
# cuts the 76 MB agentcore test archive that every edit rewrites to 47 MB.
# The cost: a debugger such as dlv sees no source info for module packages.
# Stack traces and pprof use the symbol table and are unaffected. To debug,
# run the one command with GOFLAGS= set to empty.
case " ${GOFLAGS:-} " in
  *" -trimpath "*) ;;
  *) export GOFLAGS="${GOFLAGS:+$GOFLAGS }-trimpath" ;;
esac
case " ${GOFLAGS:-} " in
  *" -gcflags=github.com/yusefmosiah/go-choir/...="*) ;;
  *) export GOFLAGS="${GOFLAGS:+$GOFLAGS }-gcflags=github.com/yusefmosiah/go-choir/...=-dwarf=false" ;;
esac
# Per-developer secrets (API keys, etc.) live in .envrc.local, which is
# gitignored. Create it with `dotenv .env` to auto-load your .env file.
source_env_if_exists .envrc.local
# Tracked git hooks: the pre-push hook runs the guest security epoch gate
# against the live staging commit before a push to main
# (docs/problems/gate-wedge-third-time-2026-11-02.md).
[ "$(git config --get core.hooksPath 2>/dev/null)" = .githooks ] || git config core.hooksPath .githooks
