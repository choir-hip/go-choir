use flake
# Per-developer secrets (API keys, etc.) live in .envrc.local, which is
# gitignored. Create it with `dotenv .env` to auto-load your .env file.
source_env_if_exists .envrc.local
# Tracked git hooks: the pre-push hook runs the guest security epoch gate
# against the live staging commit before a push to main
# (docs/problems/gate-wedge-third-time-2026-11-02.md).
[ "$(git config --get core.hooksPath 2>/dev/null)" = .githooks ] || git config core.hooksPath .githooks
