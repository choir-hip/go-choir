// The model files voice needs, offered with their sizes before anything is fetched (downloads.ts). One card per group: what it is for, the files with their sizes, the host, and the one press that is the agreement. On mobile data
// the card says so and the size before it starts, and the press is a different one. testIds: dl-<group>, dl-<group>-lines, dl-<group>-host, dl-<group>-mobile, dl-<group>-start, dl-<group>-mobile-start, dl-<group>-status.
use Theme from "@choir/autoradio"
use DownloadsView from "./downloads-types.contract"
use Btn from "./ui.contract"

component DownloadCard
  inject
    th: Theme
    dl: DownloadsView
    dlStart: action
    dlStartMobile: action
  props
    group: string
  view
    for g in dl.groups key=g.id
      if g.id == group
        column testId=`dl-${g.id}` width="100%" box-sizing="border-box" gap=8 padding="14px 0px"
          text g.title role="heading" aria-level=2 font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg
          text g.why font-family=th.fontLabel font-size="-exact-footnote" line-height=1.4 color=th.muted
          column testId=`dl-${g.id}-lines` gap=2
            for l, i in g.lines key=i
              text l font-family=th.fontLabel font-size="-exact-footnote" color=th.fg
          text g.hostLine testId=`dl-${g.id}-host` font-family=th.fontLabel font-size="-exact-footnote" line-height=1.4 color=th.muted
          if g.status != ""
            text g.status testId=`dl-${g.id}-status` font-family=th.fontLabel font-size="-exact-footnote" color=th.fg
          if g.ready == false and g.busy == false
            if g.onWiFi
              button press=dlStart(g.id) testId=`dl-${g.id}-start` appearance="none"
                Btn(label=g.startLabel, primary=false, wide=true)
            if g.onWiFi == false
              text g.mobileLine testId=`dl-${g.id}-mobile` font-family=th.fontLabel font-size="-exact-footnote" line-height=1.4 color=th.danger
              button press=dlStartMobile(g.id) testId=`dl-${g.id}-mobile-start` appearance="none"
                Btn(label=g.mobileLabel, primary=false, wide=true)

// The files of a group, listed with their sizes and the host, with no button: where another button (voice setup's) is the agreement. testIds: dl-<group>-lines, dl-<group>-host.
component DownloadLines
  inject
    th: Theme
    dl: DownloadsView
  props
    group: string
  view
    for g in dl.groups key=g.id
      if g.id == group and g.ready == false
        column testId=`dl-${g.id}` width="100%" gap=2
          for l, i in g.lines key=i
            text l font-family=th.fontLabel font-size="-exact-footnote" color=th.fg
          text g.hostLine testId=`dl-${g.id}-host` font-family=th.fontLabel font-size="-exact-footnote" line-height=1.4 color=th.muted
