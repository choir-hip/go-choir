// What the app says about the account (account-state.ts): state signedIn | signedOut | locked | rejected | ended | unknown | noSignIn, the sentence, and the action ("signIn" or "").
shape AccountView
  // signedIn | signedOut | locked | rejected | ended | unknown | noSignIn
  state: string
  message: string
  // The sentence the Autoradio page shows instead when the process is signed out (the public paper); "" otherwise.
  radioMessage: string
  // "signIn", "signOut" (a refused key) or "": the one button the state names.
  action: string
  // Also offer Sign out beside the action (a locked state that did not heal after five re-reads).
  alsoSignOut: bool
  // The account handle (account-state.ts): the first 16 hex of the key's digest, `anonymous`, or "". The identifying argument (acctHandle) of every gated resource.
  handle: string

// The page's own facts the host gives (exactPage): the app coming back to the front (visible) is when the card is asked again, so a phone whose key did not read yet (before the first unlock) and is unlocked now says so.
shape HostPage
  visibilityState: string
  hasFocus: bool
