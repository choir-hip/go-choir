// Lane members file (bar): the radio view, the focus of the bar's field, the player's pull-down and jumps.
// Owned by the bar lane. Source and send names live in exact-package/interface/bar.json.
use radioView, radioJump, radioSpeed from "@choir/autoradio"
use RadioInfo, SettingsAck from "@choir/autoradio"
use StackVp from "./ui.contract"

members Autoradio
  // The radio view: what plays, the block's sentences, the programme's items, the yield level, the talk mode.
  resource ri = radioView() as shape RadioInfo else empty() transient
  mutation rm as shape RadioInfo
  mutation rm2 as shape SettingsAck

  // The bar's field has the keyboard: the bar grows, the pages button gives way and Send replaces the voice button.
  state barFocused = false
  action barFocus
    barFocused = true
  action barBlur
    barFocused = false
  // Typing is the field focused with words in it (the aim line then shows above, because the placeholder is gone).
  derive typing = barFocused and ask != "" and bi.state == "idle"

  action jumpTo(index: number)
    send rm = radioJump(index=`${index}`)
  action setSpeed(speed: string)
    send rm = radioSpeed(speed=speed)

  // Next and previous STORY (the module answers with the new RadioInfo): the next in the list the story came from, the previous within its
  // first 3 seconds and otherwise the start of this one; in a programme the next and previous segment.
  action nextStory
    send rm2 = radioMove("next")
  action previousStory
    send rm2 = radioMove("previous")

  // The speed slider, 0.5 to 3. `speedLive` is what the finger (or a step) last chose, 0 until it is touched; until then the speed is the
  // radio's own (the saved one). The finger's move is relative: a drag across the track's width is the whole range. Sent when it lifts.
  resource spVp = exactViewport() as shape StackVp
  state speedLive = 0
  derive speedNow = speedLive > 0 ? speedLive : ri.speedValue
  derive speedShown = floor(speedNow * 20 + 0.5) / 20
  derive speedPct = floor((speedNow - 0.5) / 2.5 * 100)
  action speedMove(dx: number, dy: number)
    speedLive = min(max(speedNow + dx / max(spVp.width - 250, 1) * 2.5, 0.5), 3)
  action speedEnd(vx: number, vy: number)
    if speedLive > 0
      let v = floor(speedLive * 20 + 0.5) / 20
      speedLive = v
      send rm = radioSpeed(speed=`${v}`)
  action speedNudge(d: number)
    let v = min(max(floor((speedNow + d) * 20 + 0.5) / 20, 0.5), 3)
    speedLive = v
    send rm = radioSpeed(speed=`${v}`)
  action speedReset
    speedLive = 1
    send rm = radioSpeed(speed="1")
