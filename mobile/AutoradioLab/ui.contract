// Card and Layer: the depth primitives, driven by theme tokens (plan section 5, "Elevation"). Owned by the spine.
// A page is elevation 0, a Card is 1, the bar 2, a Layer 3. No component names a colour, a font or a radius.
// Elevation 2 and 3 use the theme's material ("glass" is UIGlassEffect on iOS 26, a blur before; "solid" is a fill).
use Theme from "@choir/autoradio"

// The surface behind a level: a box filling its parent with the theme's material and shadow for that elevation
// (1 card, 2 bar, 3 layer). Glass where the theme says glass, a solid fill where it says solid.
component Surface
  inject
    th: Theme
  props
    level: number
    radius: number
    bleed: number
  derive mat = level >= 3 ? th.material3 : level == 2 ? th.material2 : th.material1
  derive sh = level >= 3 ? th.shadow3 : level == 2 ? th.shadow2 : th.shadow1
  view
    box position="absolute" top=0 left=0 right=0 bottom=(0 - bleed) border-radius=radius box-shadow=sh
      backgroundMaterial=(mat == "glass" ? "glass" : "none")
      background-color=(mat == "glass" ? "transparent" : (level >= 2 ? th.paper : th.paper2))

component Card
  inject
    th: Theme
  props
    level: number
    testId: string
    minHeight: number
  slot
  view
    column testId=testId position="relative" min-height=minHeight
      Surface(level=level, radius=th.radiusCard, bleed=0)
      column overflow="hidden" border-radius=th.radiusCard flex=1
        children

component Layer
  inject
    th: Theme
  props
    testId: string
  slot
  view
    column testId=testId width="100%" height="100%" position="relative"
      Surface(level=3, radius=th.radiusCard, bleed=60)
      column flex=1 min-height=0
        children

// A full-bleed scrolling page body: starts under the status bar, ends clear of the bar
// (56 + 8 + the home indicator + 16, plan section 1, "Insets"), reads in the theme's body face.
component PageScroll
  inject
    th: Theme
  props
    id: string
  slot
  view
    scroll id=id flex=1 min-height=0 width="100%" scroll-padding-bottom="calc(56px + 8px + env(safe-area-inset-bottom) + 16px)"
      column padding-top="calc(env(safe-area-inset-top) + 12px)" padding-left=20 padding-right=20
        padding-bottom="calc(56px + 8px + env(safe-area-inset-bottom) + 16px)" gap=12
        font-family=th.fontRead color=th.fg
        children

// A page with a heading, the page's text, and nothing else. `lines` are paragraphs.
component PlainPage
  inject
    th: Theme
  props
    title: string
    lines: string[]
  view
    PageScroll(id="plain")
      text title role="heading" aria-level=1 font-size=28 font-weight=700 testId="page-title"
      for l, i in lines key=i
        text l font-size=17 line-height=1.5

// The page behind an address nothing has built yet, or that could not be opened: one plain sentence.
component NotYetPage
  inject
    th: Theme
  props
    address: string
    title: string
  view
    PageScroll(id="notyet")
      text title role="heading" aria-level=1 font-size=28 font-weight=700 testId="page-title"
      text `${title} is not built yet.` testId="notyet" font-family=th.fontUi color=th.muted
      text address font-family=th.fontMono font-size=13 color=th.muted
