// Mail: a mailbox (mailbox:<folder>) and a message (mail:<id>, mail:reply/<id>, mail:new, mail:draft/<id>).
// Mail is a place, not an app: a message is a page that opens as a card in the pile like any page. The phone never talks to a
// mail provider; the Mail agent on the listener's computer is the only custodian of email, and shared code asks it (mail.ts).
// A message reads in the theme's body face (th.fontText); the original HTML (cleaned by mail-sanitize.ts: the server sends it as it arrived) is a secondary view in a sandboxed frame with
// scripts, remote pictures and links off. Replies and new messages are drafts; sending is the listener's own act.
// testIds: mail-compose, mail-folder-<name>, mail-row-<id>, mail-skeleton, mail-empty, mail-offline, mail-error, mail-retry,
//   mail-from, mail-date, mail-to, mail-trust, mail-reply, mail-summarise, mail-read, mail-original-toggle,
//   mail-unread, mail-note, mail-body, mail-quoted-toggle, mail-original-frame, mail-saved-note, mail-attachment-<id>, mail-thread-<id>,
//   mail-field-to, mail-field-subject, mail-field-body, mail-save, mail-draft-status, mail-approval, mail-open-review.
use Theme from "@choir/autoradio"
use AccountView from "./account-state-types.contract"
use MailBoxView, MailMessageView, MailComposeView, MailSyncView from "./mail-types.contract"
use PageScroll, Card, Btn, ChoiceWord, RowRule, dyn from "./ui.contract"
use Swap, SkeletonRows, SkeletonBody, tLayout, tOut from "./transitions.contract"

// A message in a list: unread dot, sender, time, subject, a preview, a thread count.
component MailRowItem
  inject
    th: Theme
    openPage: action
  props
    id: string
    address: string
    sender: string
    subject: string
    snippet: string
    stamp: string
    unread: bool
    attachment: bool
    count: number
  view
    button press=openPage(address, subject) testId=`mail-row-${id}` appearance="none" width="100%"
      row gap=10 padding="12px 0" align-items="flex-start" width="100%" border-top-width=1 border-right-width=0 border-bottom-width=0 border-left-width=0 border-style="solid" border-color=th.rule
        box width=3 height=18 margin-top=3 background-color=(unread ? th.accent : "transparent")
        column flex=1 min-width=0 gap=2 align-items="flex-start"
          row width="100%" gap=8 align-items="baseline"
            text sender font-family=th.fontHead font-size="-exact-callout" font-weight=(unread ? 700 : 500) color=th.fg flex=1 min-width=0 line-clamp=1 text-align="left"
            text stamp font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          text subject font-family=th.fontHead font-size="-exact-callout" font-weight=(unread ? 600 : 400) color=th.fg line-clamp=1 text-align="left"
          text snippet font-family=th.fontLabel font-size="-exact-footnote" color=th.muted line-clamp=2 text-align="left"
          row gap=8
            if count > 1
              text `${count} in this thread` font-family=th.fontLabel font-size="-exact-caption1" color=th.muted
            if attachment
              text "With attachment" font-family=th.fontLabel font-size="-exact-caption1" color=th.muted
        image "symbol:forward-chevron" color=th.muted

// A state that is a whole screen: empty, offline, error. A sentence, and when it helps, one action.
component MailNotice
  inject
    th: Theme
    retryMail: action
  props
    testId: string
    title: string
    body: string
    retry: bool
  view
    column testId=testId gap=8 padding="24px 0" align-items="flex-start"
      text title font-family=th.fontHead font-size=dyn((body == "" ? 18 : 20)) font-weight=(body == "" ? 400 : 700) color=th.fg
      if body != ""
        text body font-family=th.fontLabel font-size="-exact-callout" color=th.muted line-height=1.4
      if retry
        button press=retryMail testId="mail-retry" appearance="none"
          Btn(label="Try again", primary=false, wide=false)

fn mailLabel(n: string): string = n == "inbox" ? "Inbox" : (n == "drafts" ? "Drafts" : (n == "sent" ? "Sent" : "Quarantine"))

// The mailbox: the frame (title, New message, the four tabs with their counts) is drawn from the address and the cache and never
// depends on the fetch, so it is on screen and tappable at every moment. Only the content under it is a Swap: it starts to leave at
// the tap, a skeleton (no words) holds the place when nothing is cached, and the list comes in when it is ready.
component MailboxPage
  inject
    th: Theme
    acs: AccountView
    mbx: MailBoxView
    mfr: MailBoxView
    msy: MailSyncView
    openPage: action
    mailTab: action
    mboxName: string
    mboxDir: number
  props
    address: string
    title: string
  derive liveHere = mbx.folder == mboxName and mbx.status != "" and mbx.status != "idle"
  derive cachedHere = mfr.folder == mboxName and mfr.status == "cached"
  derive rowsNow = liveHere ? mbx.rows : (cachedHere ? mfr.rows : [])
  derive waiting = liveHere == false and cachedHere == false
  derive tabs = ["inbox", "drafts", "sent", "quarantine"]
  view
    PageScroll(id="mailbox")
      row align-items="center" gap=12
        text "Mail" role="heading" aria-level=1 font-family=th.fontHead font-size="-exact-title1" font-weight=700 testId="page-title" flex=1
        if acs.state == "signedIn"
          button press=openPage("mail:new", "New message") testId="mail-compose" appearance="none"
            Btn(label="New message", primary=false, wide=false)
      row flex-wrap="wrap" gap=8 width="100%"
        for n in tabs key=n
          button press=mailTab(n) testId=`mail-folder-${n}` appearance="none" padding="0px 12px 0px 0px"
            ChoiceWord(label=mailLabel(n) + mfr.folders.filter(f => f.name == n).map(f => f.badge == "" ? "" : ` ${f.badge}`).join(""), selected=(n == mboxName))
      Swap(token=(waiting ? `${mboxName}-wait` : mboxName), dir=mboxDir)
        if waiting
          SkeletonRows(rows=6, testId="mail-skeleton")
        if liveHere and mbx.status == "empty"
          MailNotice(testId="mail-empty", title=(mbx.message != "" ? mbx.message : "Nothing here"), body="", retry=false)
        if liveHere and mbx.status == "error"
          MailNotice(testId="mail-error", title=(mbx.message != "" ? mbx.message : "Your mail could not be opened"), body="", retry=true)
        if liveHere and mbx.status == "offline"
          MailNotice(testId="mail-offline", title=(mbx.cached ? "Offline: showing what was last loaded" : "You are offline"), body=mbx.message, retry=true)
        if rowsNow.length > 0
          column width="100%"
            for r in rowsNow key=r.id
              column width="100%" -exact-layout-transition=tLayout(th.reducedMotion) -exact-exit-animation=tOut(th.reducedMotion, 0)
                MailRowItem(id=r.id, address=r.address, sender=r.sender, subject=r.subject, snippet=r.snippet, stamp=r.stamp, unread=r.unread, attachment=r.hasAttachments, count=r.count)
      if msy.note != ""
        text msy.note testId="mail-saved-note" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted margin-top=12
// One line in a message header: a small label and its value.
component MailHeaderLine
  inject
    th: Theme
  props
    testId: string
    label: string
    value: string
  view
    row gap=8 align-items="baseline"
      text label font-family=th.fontLabel font-size="-exact-footnote" color=th.muted width=52
      text value testId=testId font-family=th.fontLabel font-size="-exact-subheadline" color=th.fg flex=1 min-width=0

component MailMessage
  inject
    th: Theme
    mmsg: MailMessageView
    mailQuoted: bool
    mailOriginal: bool
    mailNote: string
    openPage: action
    toggleMailQuoted: action
    toggleMailOriginal: action
    readMail: action
    unreadMail: action
    askMail: action
    canAsk: bool
  props
    address: string
    title: string
  view
    PageScroll(id="mail")
      if mmsg.status == "error" or mmsg.status == "offline"
        text title role="heading" aria-level=1 font-family=th.fontHead font-size="-exact-title1" font-weight=700 testId="page-title"
        MailNotice(testId=(mmsg.status == "offline" ? "mail-offline" : "mail-error"), title=(mmsg.status == "offline" ? "You are offline" : "This message could not be opened"), body=mmsg.message, retry=true)
      if mmsg.status == "ready"
        text mmsg.subject role="heading" aria-level=1 font-family=th.fontHead font-size="-exact-title1" font-weight=700 line-height=1.2 testId="page-title"
        column gap=4
          MailHeaderLine(testId="mail-from", label="From", value=mmsg.sender)
          MailHeaderLine(testId="mail-to", label="To", value=mmsg.toLine)
          if mmsg.ccLine != ""
            MailHeaderLine(testId="mail-cc", label="Cc", value=mmsg.ccLine)
          MailHeaderLine(testId="mail-date", label="Date", value=mmsg.date)
        if mmsg.trustNote != ""
          Card(level=1, testId="mail-trust", minHeight=0)
            column padding=12
              text mmsg.trustNote font-family=th.fontLabel font-size="-exact-footnote" color=th.danger
        // What a person does with a message: reply, ask about it, hear it. The prompt in the bar is aimed at it too.
        row gap=8 flex-wrap="wrap"
          if mmsg.canReply
            button press=openPage(`mail:reply/${mmsg.id}`, `Reply: ${mmsg.subject}`) testId="mail-reply" appearance="none"
              Btn(label=mmsg.replyLabel, primary=false, wide=false)
          if canAsk
            button press=askMail("Summarise this thread") testId="mail-summarise" appearance="none"
              Btn(label="Summarise this thread", primary=false, wide=false)
          button press=readMail testId="mail-read" appearance="none"
            Btn(label="Read it to me", primary=false, wide=false)
        row gap=8 flex-wrap="wrap"
          if mmsg.hasOriginal
            button press=toggleMailOriginal testId="mail-original-toggle" appearance="none"
              Btn(label=(mailOriginal ? "Show text" : "Show original"), primary=false, wide=false)
          button press=unreadMail testId="mail-unread" appearance="none"
            Btn(label="Mark unread", primary=false, wide=false)
        if mailNote != ""
          text mailNote testId="mail-note" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        // The body, in the reader's type. Quoted earlier messages are folded away until asked for.
        if mailOriginal and mmsg.hasOriginal
          text "The sender's own layout. Scripts and pictures are turned off, and a link goes nowhere: its address is written after it." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          iframe src=mmsg.originalPath sandbox="" testId="mail-original-frame" width="100%" height=520 border-radius=th.radiusControl background-color=th.paper2
        if mailOriginal == false or mmsg.hasOriginal == false
          column testId="mail-body" gap=14 margin-top=6
            if mmsg.htmlOnly
              text "This message has only a formatted version; this is its text." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
            for b, i in mmsg.blocks key=i
              if b.kind == "p"
                text b.text font-family=th.fontText font-size="-exact-body" line-height=1.5 color=th.fg white-space="pre-wrap"
              if b.kind == "quote" and mailQuoted
                row gap=10
                  box width=3 background-color=th.rule
                  text b.text font-family=th.fontText font-size="-exact-callout" line-height=1.45 color=th.muted flex=1 min-width=0 white-space="pre-wrap"
              if b.kind == "sig"
                text b.text font-family=th.fontLabel font-size="-exact-footnote" line-height=1.4 color=th.muted white-space="pre-wrap"
            if mmsg.cut
              text "This message is very long; the rest is not shown." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
            if mmsg.hasQuoted
              button press=toggleMailQuoted testId="mail-quoted-toggle" appearance="none"
                text (mailQuoted ? "Hide quoted text" : "Show quoted text") font-family=th.fontLabel font-size="-exact-footnote" color=th.accent
        if mmsg.attachments.length > 0
          text "Attachments" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted margin-top=8
          for a in mmsg.attachments key=a.id
            if a.available
              button press=openPage(a.address, a.filename) testId=`mail-attachment-${a.id}` appearance="none" width="100%"
                Card(level=1, testId=`mail-attachment-card-${a.id}`, minHeight=0)
                  row gap=10 padding=12 align-items="center" width="100%"
                    column flex=1 min-width=0 gap=2 align-items="flex-start"
                      text a.filename font-family=th.fontHead font-size="-exact-callout" font-weight=600 color=th.fg line-clamp=1
                      text `${a.kind} · ${a.size}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
                    image "symbol:forward-chevron" color=th.muted
            if a.available == false
              Card(level=1, testId=`mail-attachment-${a.id}`, minHeight=0)
                column gap=2 padding=12 width="100%"
                  text a.filename font-family=th.fontHead font-size="-exact-callout" font-weight=600 color=th.fg line-clamp=1
                  text `${a.kind} · ${a.size}. ${a.note}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        if mmsg.thread.length > 1
          text "In this thread" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted margin-top=8
          for t in mmsg.thread key=t.id
            button press=openPage(t.address, mmsg.subject) testId=`mail-thread-${t.id}` appearance="none" width="100%"
              row gap=10 padding="8px 0" width="100%" align-items="baseline" border-top-width=1 border-right-width=0 border-bottom-width=0 border-left-width=0 border-style="solid" border-color=th.rule
                text t.sender font-family=th.fontHead font-size="-exact-subheadline" font-weight=(t.current ? 700 : 400) color=th.fg flex=1 min-width=0 line-clamp=1 text-align="left"
                text (t.current ? "this one" : t.stamp) font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
                image "symbol:forward-chevron" color=th.muted
        text mmsg.replyLabel font-family=th.fontLabel font-size="-exact-footnote" color=th.muted margin-top=8
        text "You can also say or type this in the bar below." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted

// A reply, a new message, or an existing draft. A draft is a document on the computer; sending it is the listener's own act.
component MailCompose
  inject
    acs: AccountView
    th: Theme
    mcmp: MailComposeView
    mailCurTo: string
    mailCurSubject: string
    mailCurBody: string
    mailDraftStatus: string
    mailDraftId: string
    mailDraftNote: string
    mailDraftUrl: string
    mailDraftFrom: string
    editMailTo: action
    editMailSubject: action
    editMailBody: action
    saveMailDraft: action
    approveMail: action
    openMailReview: action
  props
    address: string
    title: string
  view
    PageScroll(id="mail-compose-page")
      // Save sits beside the title, so it is never under the keyboard or the bar.
      row align-items="flex-start" gap=12
        text title role="heading" aria-level=1 font-family=th.fontHead font-size="-exact-title1" font-weight=700 line-height=1.2 testId="page-title" flex=1 min-width=0
        // saving and asking for an approval need the owner's computer: they close when the phone stops being signed in
        if mailDraftStatus != "approval" and acs.state == "signedIn"
          button press=saveMailDraft testId="mail-save" appearance="none"
            Btn(label=(mailDraftStatus == "saved" ? "Save again" : "Save draft"), primary=false, wide=false)
      if mcmp.status == "error" and mailDraftId == ""
        MailNotice(testId="mail-error", title="This draft could not be opened", body=mcmp.note, retry=false)
      if mcmp.status != "error" or mailDraftId != ""
        text (mailDraftFrom == "" ? "A draft on your computer. Nothing is sent from this screen." : `From ${mailDraftFrom}. Nothing is sent from this screen.`) testId="mail-draft-from" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        if mailDraftStatus == "error"
          text mailDraftNote testId="mail-draft-status" font-family=th.fontLabel font-size="-exact-footnote" color=th.danger
        if mailDraftStatus == "saved"
          Card(level=1, testId="mail-saved-card", minHeight=0)
            column gap=8 padding=12
              text mailDraftNote testId="mail-draft-status" font-family=th.fontLabel font-size="-exact-footnote" color=th.fg
              text "Sending is your decision. Ask for an approval link by email, read the draft in your browser and send it from there." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
              if acs.state == "signedIn"
                button press=approveMail testId="mail-approval" appearance="none"
                  Btn(label="Email me the approval link", primary=false, wide=false)
        if mailDraftStatus == "approval"
          Card(level=1, testId="mail-approval-card", minHeight=0)
            column gap=8 padding=12
              text mailDraftNote testId="mail-draft-status" font-family=th.fontLabel font-size="-exact-footnote" color=th.success
              if mailDraftUrl != ""
                button press=openMailReview(mailDraftUrl) testId="mail-open-review" appearance="none"
                  Btn(label="Open the approval page", primary=false, wide=false)
        column gap=4
          text "To" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          input value=mailCurTo input=editMailTo type="email" placeholder="name@example.com" aria-label="To" testId="mail-field-to"
            font-family=th.fontText font-size=16 color=th.fg padding="10px 0px" border-width=0 background-color="transparent"
          RowRule(indent=0)
        column gap=4
          text "Subject" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          input value=mailCurSubject input=editMailSubject placeholder="Subject" aria-label="Subject" testId="mail-field-subject"
            font-family=th.fontText font-size=16 color=th.fg padding="10px 0px" border-width=0 background-color="transparent"
          RowRule(indent=0)
        column gap=4
          text "Message" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          textarea value=mailCurBody input=editMailBody placeholder="Write here" aria-label="Message" testId="mail-field-body" appearance="none" width="100%" min-height=220 box-sizing="border-box"
            font-family=th.fontText font-size=17 line-height=1.5 color=th.fg padding="12px 0px" border-width=0 background-color="transparent"
          RowRule(indent=0)

component MailPage
  inject
    th: Theme
    mmsg: MailMessageView
    mcmp: MailComposeView
  props
    address: string
    title: string
  derive isCompose = mcmp.forAddress == address and mcmp.status != "idle" and mcmp.status != ""
  derive isMessage = mmsg.address == address and mmsg.status != "idle" and mmsg.status != ""
  view
    column position="absolute" inset=0
      if isCompose
        MailCompose(address=address, title=title)
      if isMessage
        MailMessage(address=address, title=title)
      if isCompose == false and isMessage == false
        PageScroll(id="mail-loading-page")
          text title role="heading" aria-level=1 font-family=th.fontHead font-size="-exact-title1" font-weight=700 testId="page-title"
          SkeletonBody(testId="mail-skeleton")
