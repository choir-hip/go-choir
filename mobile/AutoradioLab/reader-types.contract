// What the bar's prompt is aimed at. Declared here and answered by `app.ts` (reader-aim.ts: `aimView`, `setAim`); it was the Swift package's (interface/reader.json `ReaderAimInfo`, source `readerAim`)
// before the aim moved to shared code. `blockId` is empty for a whole document.

shape ReaderAimInfo
  address: string
  blockId: string
  label: string

// The block and sentence the radio is reading, for the reader to light (radio-follow.ts `followOf`, answered by app.ts as `readerFollowShared`); it was the Swift package's (interface/reader.json `ReaderFollowInfo`, source `readerFollow`)
// before the follow moved to shared code. Empty `address` and `blockId` and `sentence` -1 when nothing is lit.
shape ReaderFollowInfo
  address: string
  blockId: string
  sentence: number
