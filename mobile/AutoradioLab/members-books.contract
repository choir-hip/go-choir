// Lane members file (reader): the Reader place and a document's page, as if written in the root. Owned by the reader lane
// (autoradio-reader). Shapes and source names live in exact-package/interface/books.json; the module answering them is
// exact-package/apple/AutoradioModule+Books.swift (Kit/ReaderShelf.swift, Kit/Epub.swift). Every name a child component injects is in
// the reader-documents band of the `provide` list in app.contract. Prefixes: lb = the Reader place, ld = one document.
use shelfList, shelfDoc, shelfChapter, shelfFind, shelfFollow from "@choir/autoradio"
use shelfImport, shelfRemove, shelfPlace, shelfReadAloud, shelfEnqueue from "@choir/autoradio"
use ShelfListing, ShelfDocInfo, ShelfChapter, ShelfFind, ShelfFollowInfo, ShelfAck from "@choir/autoradio"

members Autoradio
  // ------------------------------------------------------------------ the Reader place (books:)
  resource lbList = shelfList(at=pg.top) as shape ShelfListing else empty()
  mutation lbM as shape ShelfListing
  derive lbNote = match lbM { case some(l) => l.message, case none => "" }
  // The system file picker opens this input; its copy lands under app:/tmp/picked (as for Files).
  action lbImport
    showPicker("lib-pick")
  action lbPicked(ps: Picked[])
    if ps.length > 0
      send lbM = shelfImport(from=(match ps.at(0) { case some(p) => p.path, case none => "" }), name=(match ps.at(0) { case some(p) => p.name, case none => "" }))
  action lbRemove(id: string)
    send lbM = shelfRemove(id=id)

  // ------------------------------------------------------------------ one document (doc:<id>)
  // Asked for every page; the module answers an empty "loading" record for any address that is not a document.
  resource ldInfo = shelfDoc(address=pg.top) as shape ShelfDocInfo else empty()
  // The chapter or page on screen as blocks, and what the find box found: asked only once the document is known.
  resource ldChap = shelfChapter(address=(ldInfo.id != "" ? pg.top : ""), index=ldSec) as shape ShelfChapter else empty()
  resource ldFound = shelfFind(address=(ldInfo.id != "" ? pg.top : ""), query=ldFind) as shape ShelfFind else empty()
  // The block the radio is reading now.
  resource ldFollow = shelfFollow() as shape ShelfFollowInfo else empty()
  mutation ldAck as shape ShelfAck

  state ldSec = 0
  // The block the listener chose (tap a paragraph); -1 for none. Reading aloud starts here.
  state ldBlock = -1
  // A PDF is shown as its pages by default; true shows its text as blocks instead (an e-book always shows text).
  state ldText = false
  state ldToc = false
  state ldFindDraft = ""
  state ldFind = ""
  state ldSeen = ""
  state ldFollowSeen = -1
  // A block to bring into view once its chapter is on screen (a found passage, the place left off, the block being read); -1 for none.
  state ldScrollTo = -1
  derive ldShowPages = ldInfo.kind == "pdf" and ldText == false

  // A different document starts where the listener left it.
  task ldSeenTask when ldInfo.address != ldSeen
    after(10, ldReset)
  action ldReset
    ldSeen = ldInfo.address
    ldSec = ldInfo.resumeSection
    ldBlock = ldInfo.position > 0 ? ldInfo.position : -1
    ldText = false
    ldToc = false
    ldFindDraft = ""
    ldFind = ""
    ldFollowSeen = -1
    ldScrollTo = ldInfo.position > 0 ? ldInfo.position : -1
  // The chapter or page follows the voice while the radio reads this document.
  task ldFollowTask when ldFollow.address == pg.top and ldFollow.block != ldFollowSeen
    after(10, ldFollowGo)
  action ldFollowGo
    ldFollowSeen = ldFollow.block
    ldSec = ldFollow.section
    ldScrollTo = ldFollow.block
  task ldScrollTask when ldScrollTo >= 0 and ldChap.status == "ready" and ldScrollTo >= ldChap.start and ldScrollTo < ldChap.start + ldChap.blocks.length
    after(60, ldScrollGo)
  action ldScrollGo
    scrollIntoView(`doc-block-${ldScrollTo.toFixed(0)}`)
    ldScrollTo = -1

  action ldGo(n: number)
    ldSec = max(0, min(n, max(0, ldInfo.sections.length - 1)))
    ldToc = false
    ldBlock = -1
    send ldAck = shelfPlace(address=pg.top, section=ldSec, block=-1)
  action ldJump(section: number, block: number)
    ldSec = section
    ldBlock = block
    ldScrollTo = block
    ldToc = false
    ldText = true
    send ldAck = shelfPlace(address=pg.top, section=section, block=block)
  action ldPlace(n: number)
    ldBlock = n
    send ldAck = shelfPlace(address=pg.top, section=ldSec, block=n)
  action ldTocToggle
    ldToc = not ldToc
  action ldSetText(on: bool)
    ldText = on
  action ldEditFind(v: string)
    ldFindDraft = v
  action ldDoFind
    ldFind = ldFindDraft.trim()
  action ldClearFind
    ldFindDraft = ""
    ldFind = ""
  action ldRead
    send ldAck = shelfReadAloud(address=pg.top, section=ldSec, block=ldBlock)
  action ldQueue
    send ldAck = shelfEnqueue(address=pg.top, section=ldSec, block=ldBlock)
  action ldRemove(id: string)
    send lbM = shelfRemove(id=id)
