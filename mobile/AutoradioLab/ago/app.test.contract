// agoText against the cases of the TypeScript `when()` it replaced (activity.ts on origin/main before 2026-11-28), same texts: see the change entry.
test "agoText: every edge of the old age rule"
  expect text "g-unknown" == ""
  expect text "g-at0" == ""
  expect text "g-atmax" == ""
  expect text "g-future" == "S"
  expect text "g-s0" == "a minute ago"
  expect text "g-s59" == "a minute ago"
  expect text "g-s119" == "a minute ago"
  expect text "g-s120" == "2 minutes ago"
  expect text "g-m59s59" == "59 minutes ago"
  expect text "g-h1" == "an hour ago"
  expect text "g-h1m59" == "an hour ago"
  expect text "g-h2" == "2 hours ago"
  expect text "g-h23m59" == "23 hours ago"
  expect text "g-d1" == "S"
  expect text "g-older" == "S"
