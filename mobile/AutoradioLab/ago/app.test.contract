// agoText on fixed inputs: the edges of the TypeScript `when()` it replaced (compared in ../ago.test.ts), except a row up to a minute ahead of the clock, which reads "a minute ago" on purpose.
test "agoText: every edge of the age rule"
  expect text "g-unknown" == ""
  expect text "g-at0" == ""
  expect text "g-atmax" == ""
  expect text "g-at86400001" == "S"
  expect text "g-future" == "S"
  expect text "g-neg1ms" == "a minute ago"
  expect text "g-neg59s" == "a minute ago"
  expect text "g-neg61s" == "S"
  expect text "g-s0" == "a minute ago"
  expect text "g-s59" == "a minute ago"
  expect text "g-a59999" == "a minute ago"
  expect text "g-a60000" == "a minute ago"
  expect text "g-s119" == "a minute ago"
  expect text "g-a119999" == "a minute ago"
  expect text "g-s120" == "2 minutes ago"
  expect text "g-m59s59" == "59 minutes ago"
  expect text "g-a3599999" == "59 minutes ago"
  expect text "g-h1" == "an hour ago"
  expect text "g-h1m59" == "an hour ago"
  expect text "g-a7199999" == "an hour ago"
  expect text "g-h2" == "2 hours ago"
  expect text "g-h23m59" == "23 hours ago"
  expect text "g-a86399999" == "23 hours ago"
  expect text "g-d1" == "S"
  expect text "g-older" == "S"
