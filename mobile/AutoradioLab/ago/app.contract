// A test fixture app around the production file ago.contract (agoText): nothing builds it into the Autoradio app. Run by `bun exact.mjs test web` in this folder, and by ../ago.test.ts.
use agoText from "./ago.contract"

// The stamp is "S", so a stamp is told from an age.
component App
  view
    column
      text agoText(1800000000000-300000, 1800000000000, false, "S") testId="g-unknown"
      text agoText(0, 1800000000000, true, "S") testId="g-at0"
