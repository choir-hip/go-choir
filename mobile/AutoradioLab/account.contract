// The integrator's members of the root: the Choir sign-in and the player (the voice lab page, its stages, parameters, trace and
// audio switch are gone: owner, 2026-11-19, "get rid of lab pages").
use choirAuth, choirPlayer from "@choir/autoradio"
use choirRefresh from "@choir/autoradio"
use ChoirAuth, ChoirPlayer from "@choir/autoradio"
use LabState, SettingsAck from "@choir/autoradio"
use SignOutResult, SignInView, SignInEnd from "./account-types.contract"
use AccountView, HostPage from "./account-state-types.contract"

members Autoradio
  resource au = choirAuth() as shape ChoirAuth else empty()
  resource pl = choirPlayer() as shape ChoirPlayer else empty()
  // What the app says about the account (account-state.ts): asked again when anything that can change it happened: a sign-in or a sign-out, a page change, the app coming back to the front (the phone
  // unlocked: a key that could not be read yet is read again). An unreadable key is "locked", never "signed out".
  resource hpg = exactPage() as shape HostPage else empty()
  // The tick: anything that can change the answer. The app coming back to the front (visibility, focus), a sign-in attempt's progress (siv.phase, siv.message), a sign-out (the epoch), a page change and the host fact (every input of the answer is in the tick). NOT the statuses of other pages' sources: a resource is asked only when something reads it, so waiting on them left the card unanswered at launch (found by the signed-out tour). A refusal (401) shows at the next page change or return to the front, and a counter that moves every 3 s while the key is locked, so "locked" cannot stick if no event arrives.
  state lockTick = 0
  action bumpLock
    lockTick = lockTick + 1
  // Also re-asked (with the host fact, spine.contract hc) while the answer is open: an unreadable key, a handle not bound yet, a host with no sign-in: a native module that arrives late corrects the state without a page change.
  task rereadLocked when acs.state == "locked" or acs.state == "unknown" key=lockTick
    after(3000, bumpLock)
  // A host with no native package: a module may still load late, so the re-probe runs a few times (15 s) and then stops; the decision is then final for this launch.
  state lateTicks = 0
  action bumpLate
    lateTicks = lateTicks + 1
    lockTick = lockTick + 1
  task rereadLate when acs.state == "noSignIn" and lateTicks < 5 key=lateTicks
    after(3000, bumpLate)
  // A refused key is re-read a few times too (15 s), then left to the events that recover it (a new key, a page's 200 above, the app coming to the front): two native calls and a hash every 3 s forever is too much.
  state rejTicks = 0
  action bumpRej
    rejTicks = rejTicks + 1
    lockTick = lockTick + 1
  task rereadRejected when acs.state == "rejected" and rejTicks < 5 key=rejTicks
    after(3000, bumpRej)
  // A page that hit a refusal (the server said 401 to this phone's key: api.ts records it) shows its error; the account sentence is asked again at that moment, not at the next tick, so the card
  // appears when it happens. Any error asks again (the answer is the same when the error was only the network): one keystate read.
  task noteRefusal when mbx.status == "error" or fsList.status == "error" or acctInfo.status == "failed" or (pg.top == "notebook:" and nb.docState == "offline") key=pg.top
    after(100, bumpLock)
  // And the other way: a page that works again clears a stale "rejected" at once (api.ts clears the digest on any 200), not at the next 3 s read.
  task noteRecovery when acs.state == "rejected" and (mbx.status == "ready" or fsList.status == "ready" or acctInfo.status == "ok") key=pg.top
    after(100, bumpLock)
  // The card is the first thing in the bar's own column (bar.contract), so it sits whole above the bar at every bar height (the "On:" line, the now-playing strip, the answer card). Not over the code screen, a
  // sheet, the launcher, the bar's field or any keyboard (exactViewport: the one general keyboard fact), the content controls, the reader's aim row or a web layer.
  derive bannerOn = acs.message != "" and not authOpen and not siv.pending and layer == "" and barFocused == false and ctlUp == false and spVp.keyboardHeight < 120 and (raim.address == "" or raim.address != pg.top) and webUrl == "" and (sheet == "" or sheetFor != pg.top)
  resource acs = accountState(`${au.signedIn}|${siv.phase}|${siv.message}|${signedOutTick}|${hpg.visibilityState}|${hpg.hasFocus}|${lockTick}|${hc.mode}|${hpg.platform}`, pg.top, hc.mode, hpg.platform) as shape AccountView else empty()
  mutation acct as shape LabState
  mutation racct as shape SettingsAck refreshes rpulse
  // Sign-out is led by shared code (account.ts): one native call signs out natively, then every shared store is wiped.
  mutation so as shape SignOutResult
  derive signOutNote = match so { case some(a) => a.message, case none => "" }
  // The wipe counter as the last sign-out answered it (account.ts wipeEpoch: bumped by every ATTEMPTED wipe, failed ones too, and by a late continuation's wipe); "" before any sign-out answered. It changes with
  // each sign-out result, so the shared sources that keep state in memory (the open pages, the notebook) are asked again. A late wipe bumps the counter but has no event that carries it here (a residual).
  derive signedOutTick = match so { case some(a) => `${a.epoch}`, case none => "" }
  mutation ctl as shape LabState
  mutation down as shape LabState
  mutation up as shape LabState

  // SIGN-IN and ACCOUNT CREATION are one attempt with an id, a state machine owned in one place (app-signin.ts): the platform's passkey screen (Exact's @exact/passkeys), no browser sheet; a new account's address is proved by a mailed code first; a user name with no "@" typed in the email field signs in the demo account instead (docs/ship/demo-account.md).
  // This file only renders the machine's view and sends the person's presses; it keeps no copy of its state. Each press answers with the machine's `rev` after its last change, and settling
  // bumps the tick (`then`): the view is always read once more after the attempt's LAST transition.
  mutation signedRun as shape SignInEnd then bumpSiv
  mutation signedCancel as shape SignInEnd then bumpSiv
  mutation signedOpen as shape SignInEnd then bumpSiv
  mutation signedCancelDeletion as shape SignInEnd then bumpSiv
  // The sign-in screen is up (the card, Settings and the first-run page open it through `signIn`) and the email typed for a new account.
  state authOpen = false
  state authEmail = ""
  // The 8-digit code from the email that proves the address of a new account (the server mails it before any account exists).
  state authCode = ""
  state sivTick = 0
  action bumpSiv
    sivTick = sivTick + 1
  derive sivKey = `${sivTick}|${match signedRun { case some(r) => r.rev, case none => 0 }}|${match signedCancel { case some(r) => r.rev, case none => 0 }}|${match signedOpen { case some(r) => r.rev, case none => 0 }}|${match signedCancelDeletion { case some(r) => r.rev, case none => 0 }}`
  resource siv = signInView(sivKey) as shape SignInView else empty()
  // A sign-in call is still answering (the screen is in its waiting state then, and shows no message from an earlier attempt).
  derive signRunning = pending(signedRun) or pending(revRun)
  // The view is asked again twice a second while an attempt runs (the machine changes under a running answer, with no event to carry it), and not at all otherwise.
  task sivWatch when pending(signedRun) or pending(revRun) key=sivTick
    after(500, bumpSiv)
  // Opening the screen starts clean: an old failure is not shown again (a running attempt is left alone).
  action signIn
    authOpen = true
    send signedOpen = signInOpen()
    sivTick = sivTick + 1
  action editAuthEmail(v: string)
    authEmail = v
    // The secret typed for a name is not kept across an edit of the field.
    namePass = ""
  action editAuthCode(v: string)
    authCode = v
  // "Create account": the email typed, the consent line above the button read, the passkey screen. Tapping it is the agreement (owner, 2026-11-23).
  // With no code typed it mails one (the screen then asks for it); with the code it makes the passkey.
  action createAccount
    if not nameLogin
      send signedRun = signInRun("create", authEmail, authCode)
      sivTick = sivTick + 1
  // A user name instead of an address (docs/ship/demo-account.md): a name with no "@" typed into the same field shows a second field and "Sign in" in place of "Create account"; the press
  // posts the name and that field (app-signin.ts `reviewerRun`). An address keeps the flow above exactly. The second field lives in this state only while it is typed and is cleared at the press.
  mutation revRun as shape SignInEnd then bumpSiv
  state namePass = ""
  derive nameLogin = authEmail != "" and not authEmail.includes("@")
  action editNamePass(v: string)
    namePass = v
  action nameSignIn
    if nameLogin
      send revRun = reviewerRun(authEmail, namePass)
      namePass = ""
      sivTick = sivTick + 1
  // The email field's Go key: the name's sign-in for a name, the account creation for an address (each action also guards itself).
  action emailSubmit
    if nameLogin
      send revRun = reviewerRun(authEmail, namePass)
      namePass = ""
      sivTick = sivTick + 1
    if not nameLogin
      send signedRun = signInRun("create", authEmail, authCode)
      sivTick = sivTick + 1
  // "Sign in": the passkey screen with no email typed (a discoverable credential).
  action signInPasskey
    send signedRun = signInRun("signin", "", "")
    sivTick = sivTick + 1
  // "Cancel deletion": a sign-in found the account pending deletion and offered this; the server's one-use token goes once and the answer is the app's key (app-signin.ts).
  action cancelDeletion
    send signedCancelDeletion = signInCancelDeletion()
    sivTick = sivTick + 1
  // The screen's Cancel while the passkey screen is up: the machine moves first (every later answer is ignored), so no key is kept after it.
  action cancelSignIn
    send signedCancel = signInCancel()
    sivTick = sivTick + 1
  // "Not now": the screen goes away and a running attempt ends.
  action closeAuth
    authOpen = false
    namePass = ""
    send signedCancel = signInCancel()
    // The attempt is put away with the screen: opening sign-in again starts from idle, never from the last attempt's failure or success.
    send signedOpen = signInOpen()
    sivTick = sivTick + 1
  // A finished sign-in puts the screen away by itself (the paper is then signed in).
  action finishAuth
    authOpen = false
    namePass = ""
    authEmail = ""
    authCode = ""
    send signedOpen = signInOpen()
    send acct = choirRefresh()
  // Only a finished attempt puts the screen away: not while any sign-in call is still answering (a stale "done" before a new attempt starts must not close the new screen).
  task authDone when siv.phase == "done" and authOpen and not pending(siv) and not pending(signedRun) and not pending(revRun) and not pending(signedOpen) key=sivTick
    after(400, finishAuth)
  action signOut
    namePass = ""
    // The unsent text of a message being written belongs to the account that is leaving (it may quote that account's mail).
    mailFor = ""
    mailTo = ""
    mailSubject = ""
    mailBody = ""
    send so = accountSignOut()
    // A signed-out phone starts the next sign-in from idle: the last attempt's done is not carried across.
    send signedOpen = signInOpen()
    sivTick = sivTick + 1
  action refreshRadio
    send acct = choirRefresh()
  action radioPlay
    send racct = radioPlayPause()
  // The page that names the story passes its title with the route: a story that is not in the radio's list still has a name on the lock screen.
  action playStory(route: string, title: string)
    send racct = radioPlayStory(route, title)
  // Listen: the radio reads this text now, headline first (the page's own text; the module cleans it).
  action listen(address: string, title: string, text: string)
    send racct = radioListen(address, title, text)
