// The integrator's members of the root: the Choir sign-in and the player (the voice lab page, its stages, parameters, trace and
// audio switch are gone: owner, 2026-11-19, "get rid of lab pages").
use choirAuth, choirPlayer, choirStories from "@choir/autoradio"
use choirSignIn, choirOpenApproval, choirCancelSignIn, choirRefresh, choirPlayPause, choirPlay, choirListen from "@choir/autoradio"
use ChoirAuth, ChoirPlayer, StoryList from "@choir/autoradio"
use LabState from "@choir/autoradio"
use SignOutResult from "./account-types.contract"

members Autoradio
  resource au = choirAuth() as shape ChoirAuth else empty()
  resource pl = choirPlayer() as shape ChoirPlayer else empty()
  resource sl = choirStories() as shape StoryList else empty()
  mutation acct as shape LabState
  // Sign-out is led by shared code (account.ts): one native call signs out natively, then every shared store is wiped.
  mutation so as shape SignOutResult
  derive signOutNote = match so { case some(a) => a.message, case none => "" }
  // Changes when a sign-out finished: the shared sources that keep state in memory (the open pages, the notebook) are asked again, so none of the old account's state is shown.
  derive signedOutTick = match so { case some(a) => a.done ? "out" : "", case none => "" }
  mutation ctl as shape LabState
  mutation down as shape LabState
  mutation up as shape LabState

  action signIn
    send acct = choirSignIn()
  action cancelSignIn
    send acct = choirCancelSignIn()
  action openApproval
    send acct = choirOpenApproval()
  action signOut
    // The unsent text of a message being written belongs to the account that is leaving (it may quote that account's mail).
    mailFor = ""
    mailTo = ""
    mailSubject = ""
    mailBody = ""
    send so = accountSignOut(dm.on)
  action refreshRadio
    send acct = choirRefresh()
  action radioPlay
    send acct = choirPlayPause()
  // The page that names the story passes its title with the route: a story that is not in the radio's list still has a name on the lock screen.
  action playStory(route: string, title: string)
    send acct = choirPlay(route=route, title=title)
  // Listen: the radio reads this text now, headline first (the page's own text; the module cleans it).
  action listen(address: string, title: string, text: string)
    send ctl = choirListen(address=address, title=title, text=text)
