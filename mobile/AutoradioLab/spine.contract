// The spine's members of the root: open pages, the layer in front, the theme, the bar's state. Owned by the spine;
// a lane does not edit this file (its own members go in members-<lane>.contract).
use openPages, pageModel, theme, themeList, barState, demoInfo from "@choir/autoradio"
use pageOpen, pageClose, pageFocus, pagePin, pageReopen, themeSet, schemeSet, signalRecord, demoSet from "@choir/autoradio"
use PageList, PageModel, Theme, ThemeList, BarInfo, DemoInfo from "@choir/autoradio"
use choirAsk from "@choir/autoradio"

members Autoradio
  resource pg = openPages() as shape PageList else empty()
  resource pmod = pageModel(address=pg.top) as shape PageModel else empty()
  resource th = theme() as shape Theme else empty()
  resource thl = themeList() as shape ThemeList else empty()
  resource bi = barState() as shape BarInfo else empty()
  resource dm = demoInfo() as shape DemoInfo else empty()
  mutation pm as shape PageList

  // The layer above the page: "" (none), "pile" (the open pages as cards), "launcher" (places and search).
  state layer = ""
  // The Ask field in the bar.
  state ask = ""
  // Voice button: a tap plays or pauses, a hold (350 ms) talks.
  state voiceArmed = false
  state voiceTalking = false

  action openPage(address: string, title: string)
    send pm = pageOpen(address=address, title=title)
    layer = ""
  action closePage(address: string)
    send pm = pageClose(address=address)
  action focusPage(address: string)
    send pm = pageFocus(address=address)
    layer = ""
  action pinPage(address: string)
    send pm = pagePin(address=address)
  action reopenPage
    send pm = pageReopen()
  action showLayer(name: string)
    layer = name
  action hideLayer
    layer = ""
  action togglePile
    layer = layer == "pile" ? "" : "pile"
  // `pan` reports the movement since its last event, so the pull accumulates and `panrelease` decides.
  state pull = 0
  action pullBar(dx: number, dy: number)
    pull = pull + dy
  action pullEnd(vx: number, vy: number)
    if pull < -60 and layer == ""
      layer = "launcher"
    pull = 0

  action setTheme(id: string)
    send pm = themeSet(id=id)
  action setMode(mode: string)
    send pm = schemeSet(mode=mode)
    setScheme(mode)
  action setDemo(on: string)
    send pm = demoSet(on=on)
  action record(kind: string, subject: string, detail: string)
    send pm = signalRecord(kind=kind, subject=subject, detail=detail)

  action editAsk(v: string)
    ask = v
  action sendAsk
    send pm = signalRecord(kind="ask", subject=pg.top, detail=ask)
    // The typed question is a turn like a spoken one (found with real data: it was only recorded as a signal).
    send acct = choirAsk(text=ask)
    ask = ""

  task voiceHold when voiceArmed
    after(350, voiceFire)
  action voiceDown
    voiceArmed = true
  action voiceFire
    if voiceArmed
      voiceArmed = false
      voiceTalking = true
      send down = choirTalkDown()
  action voiceUp
    if voiceTalking
      voiceTalking = false
      send up = choirTalkUp()
    else
      if voiceArmed
        voiceArmed = false
        send acct = choirPlayPause()
