// The spine's members of the root: the layer in front, the theme, the bar's state. Owned by the spine (round 3: SHELL);
// a lane does not edit this file (its own members go in members-<lane>.contract). The page stack (open, close, jump, the
// pager) is in members-stack.contract.
use openPages, pageModel, theme, themeList, barState, demoInfo from "@choir/autoradio"
use pageOpen, pageClose, pageFocus, pagePin, pageReopen, themeSet, schemeSet, signalRecord, demoSet from "@choir/autoradio"
use PageList, PageModel, Theme, ThemeList, BarInfo, DemoInfo from "@choir/autoradio"
use choirAsk, choirTalkCancel from "@choir/autoradio"

members Autoradio
  resource pg = openPages() as shape PageList else empty()
  resource pmod = pageModel(address=pg.top) as shape PageModel else empty()
  resource th = theme() as shape Theme else empty()
  resource thl = themeList() as shape ThemeList else empty()
  resource bi = barState() as shape BarInfo else empty()
  resource dm = demoInfo() as shape DemoInfo else empty()
  mutation pm as shape PageList

  // The layer above the page: "" (none), "launcher" (the stack's pages and the destinations), "player" (the expanded player, a
  // sheet over the page with the bar still under it).
  state layer = ""
  // The Ask field in the bar.
  state ask = ""
  // The microphone button: a tap starts talking, a tap again sends. (The hold-to-talk of the first build is gone, owner 2026-11-11.)
  state voiceTalking = false

  action showLayer(name: string)
    layer = name
  action hideLayer
    layer = ""
  action toggleLauncher
    layer = layer == "launcher" ? "" : "launcher"
  action pinPage(address: string)
    send pm = pagePin(address=address)
  action reopenPage
    send pm = pageReopen()

  action setTheme(id: string)
    send pm = themeSet(id=id)
  action setMode(mode: string)
    send pm = schemeSet(mode=mode)
    setScheme(mode)
  action setDemo(on: string)
    send pm = demoSet(on=on)
  action record(kind: string, subject: string, detail: string)
    send pm = signalRecord(kind=kind, subject=subject, detail=detail)

  action editAsk(v: string)
    ask = v
  // A typed ask is aimed at the page in front: its address goes with the turn (`aim`). The engine side reads `args["aim"]` of
  // choirAsk and choirTalkDown and puts the page's address, title and text in the Autoradio desk request.
  action sendAsk
    send pm = signalRecord(kind="ask", subject=pg.top, detail=ask)
    send acct = choirAsk(text=ask, aim=pg.top)
    ask = ""
  derive micOn = voiceTalking or bi.state == "listening" or bi.state == "talking"
  action micTap
    if micOn
      voiceTalking = false
      send up = choirTalkUp()
    else
      voiceTalking = true
      send down = choirTalkDown(aim=pg.top)
  // Cancel: the microphone closes and the turn is discarded, not sent: the engine drops the audio and the words and calls nothing
  // (choirTalkCancel; Send is micTap again).
  action micCancel
    voiceTalking = false
    send up = choirTalkCancel()
