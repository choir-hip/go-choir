// The spine's members of the root: the layer in front, the theme, the bar's state. Owned by the spine (round 3: SHELL);
// a lane does not edit this file (its own members go in members-<lane>.contract). The page stack (open, close, jump, the
// pager) is in members-stack.contract.
use pageModel, pageRequest, barFacts, deckState, radioNote from "@choir/autoradio"
use PageList, PageModel, PageRequest, Theme, ThemeList, SettingsAck, BarFacts, DeckState, RadioNote from "@choir/autoradio"
use RadioTick from "./radio-types.contract"
use BarInfo, BarRun from "./bar-types.contract"
use HostCaps from "./host-types.contract"
use ThemeRev from "./themes-types.contract"
use choirAsk, choirTalkCancel, choirHandsFreeToggle from "@choir/autoradio"

members Autoradio
  // Is there a native package? (host.ts: decided once from the native handle, never from what the native set holds). "none" is Android; "" (not decided) and "native" are iOS.
  resource hc = hostCaps(false, lockTick) as shape HostCaps else empty()
  derive noNative = hc.mode == "none"
  // The open pages are shared code's on every host (pages.ts, kept in storage.fs): the deck, the launcher and the voice's front page all read this one set. The voice is handed the pages as facts
  // (pages.ts `mirror`, the native op `pagesMirror`). A native request to open a page (an episode opened from the playing bar: `pageRequest`) is answered by `pageRequested`, which opens it here
  // once per request id and gives the new view; the set is read again after it.
  resource preq = pageRequest() as shape PageRequest else empty()
  resource preqd = pageRequested(preq.id, preq.address, preq.title) as shape PageList else empty()
  resource pgs = pagesView(signedOutTick, preqd.top) as shape PageList else empty()
  derive pg = pgs
  resource pmod = pageModel(address=pg.top) as shape PageModel else empty()
  // The themes are shared code (themes.ts, both platforms). The system's scheme and Reduce Motion are Exact's own facts (`vp`, members-stack.contract); the first frame shows the whole bundled light default (every field; themes.test.ts P1 keeps it in step) until the answer lands.
  // The one-time carry-over of the old choice and themes (themes.ts migrate) runs apart from the first paint: a task sends it at launch and again when the host fact is decided (the native handle may bind
  // late; at most three tries), and its reply REFRESHES the four theme resources (a revision passed as a resource's argument was not asked again: simulator drive, 2026-11-20).
  state migTries = 0
  mutation mig as shape ThemeRev refreshes th, thl, tc, tx
  action migGo
    migTries = migTries + 1
    send mig = themeMigrate(hc.mode)
  task themeMigrateTask when migTries < 3 key=hc.mode
    after(10, migGo)
  resource th = theme(vp.prefersColorScheme, vp.prefersReducedMotion) as shape Theme else empty(id="chrome-pastel", name="Chrome Pastel", scheme="light", schemes="light", paper="#F7FBFE", paper2="#EAF4FA", fg="#16232E", muted="#41596B", accent="#1F6E8C", accent2="#2F6F8F", success="#146B4A", danger="#9C2440", onAccent="#FFFFFF", rule="rgba(31,110,140,.18)", scrim="rgba(22,35,46,.84)", onScrim="#FFFFFF", fontRead="system-ui", fontUi="system-ui", fontMono="ui-monospace", fontHead="ui-serif", fontText="ui-serif", fontLabel="system-ui", fontAction="system-ui", scale="editorial", radiusCard=12, radiusControl=6, radiusPill=6, radiusRules=0, shadow1="0 8px 20px rgba(18,52,74,.14), inset 0 1px 0 rgba(255,255,255,.9)", shadow2="0 14px 34px rgba(18,52,74,.16)", shadow3="0 24px 64px rgba(18,52,74,.22), inset 0 0 0 1px rgba(255,255,255,.55)", edge1="inset 0 1px 0 rgba(255,255,255,.9)", edge2="inset 0 0 0 1px rgba(255,255,255,.55)", edge3="inset 0 0 0 1px rgba(255,255,255,.55)", material1="solid", material2="glass", material3="glass", press1=0.98, behindScale3=0.96, behindDim3=0.08, barBacking=0.94, layerBacking=0.86, lensStyle="A", lensWash=0, motionFastMs=120, motionEnterMs=340, motionSheetMs=260, staggerMs=40, springStiffness=240, springDamping=26, springMass=1, reducedMotion=false, markDriftS=60, markListenScale=1.15, markTumble="3.3s,5.9s")
  resource thl = themeList(vp.prefersColorScheme, vp.prefersReducedMotion) as shape ThemeList else empty(mode="system", themeID="chrome-pastel", scheme="light", locked="")
  // Every theme send (choose, mode, add from a Texture, remove) repaints the theme, the list, the cards and the scale.
  mutation thm as shape SettingsAck refreshes th, thl, tc, tx
  // The bar (bar.ts, shared code): what the native side reports as facts (the engine's phase and words, the player, the run sheet player; `barFacts`) and the conversation's entries, decided on the clock here.
  // While a timed state (an error, a revision) shows (`bi.until`), the facts are read again every quarter second (a data source may not read the clock, so the facts carry it), and the bar ends the state by itself.
  resource bf = barFacts(tick=barTick) as shape BarFacts else empty()
  state barTick = 0
  action barBump
    barTick = barTick + 1
  task barTimed when bi.until > 0 key=barTick
    after(250, barBump)
  // The radio (radio-bridge.ts): the pump reads the deck's journal and what native handed over, applies them, keeps the desk writing, and answers a number the screens ask again on. It runs when the deck changes
  // (`ds.seq`), when native says something did (`rnote`), and every second (the position labels, the writer's clock).
  state radioTick = 0
  action radioBump
    radioTick = radioTick + 1
  resource ds = deckState() as shape DeckState else empty()
  resource rnote = radioNote() as shape RadioNote else empty()
  resource rpulse = radioPulse(ds.seq, rnote.tick, radioTick) as shape RadioTick else empty()
  // One second while something sounds in front or something is due; five when nothing is (the pulse says `slow`): an idle, paused or locked phone is not asked about once a second. What native has to say moves `ds.seq`
  // or `rnote.tick`, which ask the pulse at once, whatever the clock.
  task radioClock when rpulse.tick >= 0 and not rpulse.slow key=radioTick
    after(1000, radioBump)
  task radioClockSlow when rpulse.tick >= 0 and rpulse.slow key=radioTick
    after(5000, radioBump)
  // The position is read again each second WHILE SOMETHING SOUNDS AND THE APP IS IN FRONT (the beat moves once per pulse then), and not otherwise: paused, in the background or the phone locked the key is a constant and nothing is asked.
  // "In front" is native's own `foreground` (radioFacts; UIApplication's notices, the signal the voice uses to give the microphone up), carried in `rpulse.live`, because Exact does not establish that an iPhone delivers `hidden` when it locks (docs/reference/exact/ui-model.md "Page facts"); the page's visibility is kept as a second gate (a web host, the simulator).
  // A seek, Next or a new entry moves `rpulse.tick` (the pump), which is the other half of every key. No second timer: this is the radioClock's pulse above.
  derive posKey = rpulse.live and hpg.visibilityState == "visible" ? rpulse.beat : 0
  resource brun = barRun(rpulse.tick, posKey) as shape BarRun else empty()
  resource bi = barInfo(bf, brun, cvraw, `${barTick}|${signedOutTick}`) as shape BarInfo else empty()
  // The shared set's handles (pages.ts); each refreshes the shared view.
  mutation pms as shape PageList refreshes pgs
  mutation pcs as shape PageList refreshes pgs

  // The layer above the page: "" (none), "launcher" (the stack's pages and the destinations). The expanded player is gone: the
  // Autoradio page (radio.contract, the deck's first card) is where the radio is read.
  state layer = ""
  // The Ask field in the bar.
  state ask = ""
  action showLayer(name: string)
    layer = name
  action hideLayer
    layer = ""
  action toggleLauncher
    mkPressAt = performanceNow()
    if layer == "launcher"
      mkCloseAt = performanceNow()
    layer = layer == "launcher" ? "" : "launcher"
  action pinPage(address: string)
    send pms = pagesPin(address)
  action reopenPage
    send pms = pagesReopen()

  action setTheme(id: string)
    send thm = themeSet(id)
  action setMode(mode: string)
    send thm = schemeSet(mode)
    // The system's scheme follows the mode the store ACCEPTED: a theme that has one scheme refuses the other (thl.locked), and then the system's scheme is left alone.
    if thl.locked == "" or thl.locked == mode
      setScheme(mode)
  action editAsk(v: string)
    ask = v
  // A typed ask is aimed at the page in front: its address goes with the turn (`aim`). The engine side reads `args["aim"]` of
  // choirAsk and puts the page's address, title and text in the Autoradio desk request.
  // An ask goes out only for a signed-in person (asking needs an account, and the account's creation carried the agreement to outside AI companies); otherwise the sign-in sheet opens and the text stays in the field.
  derive askGate = au.signedIn ? "" : "signin"
  action sendAsk
    if au.signedIn == false
      gate = "signin"
    if au.signedIn
      send acct = choirAsk(text=ask, aim=pg.top)
      ask = ""
  // The microphone button is the hands-free switch (owner, 2026-11-15): ON, the microphone is open and turns open and close by
  // themselves; OFF, nothing is heard. One state, OFF at every launch and on until the listener has been quiet for three minutes or taps it off (bi.handsFree, owner 2026-11-16); no tap to talk, no push to talk.
  derive micOn = bi.handsFree
  // The listening state shows only when the engine has good reason to think the reader began saying something meant for the radio
  // (sustained speech with words, ListeningVisibility). It is an addition to the bar, never a replacement.
  derive heardNow = bi.handsFree and bi.state == "talking"
  // Turning voice OFF is always allowed; turning it ON is an ask (the microphone, then requests): signed out it opens the sign-in sheet, and the microphone is never requested.
  // The microphone is asked where it is first needed, after one plain line with Not now (micask.ts): unasked shows it, refused shows the declined line; the system prompt follows Continue.
  action micTap
    if micOn or (askGate == "" and dl.hearingReady and micperm.gate == "")
      send up = choirHandsFreeToggle()
    if micOn == false and askGate != ""
      gate = askGate
    // Signed in but the hearing models are not on the phone: voice is offered as ready only once they are (owner, 2026-11-23), so Voice and models opens with every model, its size and its Download; the microphone is not asked.
    if micOn == false and askGate == "" and dl.hearingReady == false
      send pms = pagesOpen("settings:voice", "Voice and models")
      layer = ""
    if micOn == false and askGate == "" and dl.hearingReady and micperm.gate != ""
      micFor = "voice"
      gate = micperm.gate
  // Continue on the plain line: the system's prompt comes with the press it was held back from.
  action micContinue
    gate = ""
    if micFor == "take"
      send tpm = takesAct(micOp, micArg)
    if micFor == "talk"
      send obm = onboardingAct("talk", "", "", pg.top)
    if micFor == "voice"
      send up = choirHandsFreeToggle()
    micTick = micTick + 1
  // Cancel: drop this turn, nothing is sent, hands-free stays on (choirTalkCancel).
  action micCancel
    send up = choirTalkCancel()
