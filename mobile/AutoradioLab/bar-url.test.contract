// The bar's address rule (spine.contract `barUrlOf`, a pure fn of the field, derived as `askUrl`): this was Swift's `BarURL.detect`. `type` puts the text in the field and the derived value is read.
// What this cannot show: Send itself. Signed in cannot be made on the web host (it holds no key), and `answer source` is skipped on web, so the routing of Send is held by bar-url.test.ts (structure of `sendAsk`).


test "R1 an http or https address with a host is kept as typed"
  clock data
  type "bar-field" "https://choir.news/a?b=1"
  expect state askUrl == "https://choir.news/a?b=1"
  type "bar-field" "HTTP://Example.org"
  expect state askUrl == "HTTP://Example.org"
  type "bar-field" "http://localhost:8080"
  expect state askUrl == "http://localhost:8080"
  type "bar-field" "https://u@choir.news/x"
  expect state askUrl == "https://u@choir.news/x"

test "R2 http or https with no host is not an address"
  clock data
  type "bar-field" "https://"
  expect state askUrl == ""
  type "bar-field" "http:///x"
  expect state askUrl == ""
  type "bar-field" "https:///path"
  expect state askUrl == ""
  type "bar-field" "http://:80/x"
  expect state askUrl == ""

test "R3 one bare word with a dot and a lowercase top level gets https in front"
  clock data
  type "bar-field" "choir.news"
  expect state askUrl == "https://choir.news"
  type "bar-field" "example.com/path"
  expect state askUrl == "https://example.com/path"
  type "bar-field" "sub.example.co:8080/x"
  expect state askUrl == "https://sub.example.co:8080/x"
  type "bar-field" "my-site.org"
  expect state askUrl == "https://my-site.org"
  type "bar-field" "caf\u00e9.de"
  expect state askUrl == "https://caf\u00e9.de"

test "R4 a sentence or a plain word is not an address"
  clock data
  type "bar-field" "what is choir.news?"
  expect state askUrl == ""
  type "bar-field" "open choir.news"
  expect state askUrl == ""
  type "bar-field" "hello"
  expect state askUrl == ""
  type "bar-field" "play something"
  expect state askUrl == ""

test "R5 a word that is not a host is not an address"
  clock data
  type "bar-field" "a.b"
  expect state askUrl == ""
  type "bar-field" "Choir.News"
  expect state askUrl == ""
  type "bar-field" "1.2.3.4"
  expect state askUrl == ""
  type "bar-field" "a..com"
  expect state askUrl == ""
  type "bar-field" ".com"
  expect state askUrl == ""
  type "bar-field" "a.com."
  expect state askUrl == ""
  type "bar-field" "a_b.com"
  expect state askUrl == ""

test "R6 a question mark, another scheme or a mail address is not an address"
  clock data
  type "bar-field" "choir.news?"
  expect state askUrl == ""
  type "bar-field" "choir.news!"
  expect state askUrl == ""
  type "bar-field" "choir.news,"
  expect state askUrl == ""
  type "bar-field" "ftp://x.org"
  expect state askUrl == ""
  type "bar-field" "file:///x"
  expect state askUrl == ""
  type "bar-field" "javascript:alert(1)"
  expect state askUrl == ""
  type "bar-field" "a@example.com"
  expect state askUrl == ""
  type "bar-field" "x.org://y"
  expect state askUrl == ""

test "R7 empty and white space are not addresses, and white space around one is trimmed"
  clock data
  type "bar-field" ""
  expect state askUrl == ""
  type "bar-field" "   "
  expect state askUrl == ""
  type "bar-field" "  choir.news "
  expect state askUrl == "https://choir.news"
  type "bar-field" "\u0085choir.news\u0085"
  expect state askUrl == "https://choir.news"
  type "bar-field" "choir\u0085.news"
  expect state askUrl == ""

test "R8 a character a URL cannot hold refuses the text, as Foundation did"
  clock data
  type "bar-field" "example.com/a|b"
  expect state askUrl == ""
  type "bar-field" "https://example.com/a^b"
  expect state askUrl == ""
  type "bar-field" "https://example.com/{x}"
  expect state askUrl == ""
  type "bar-field" "https://example.com/a\\b"
  expect state askUrl == ""
  type "bar-field" "example.com/a{b"
  expect state askUrl == ""

test "R9 a top level is two or more ASCII lower-case letters, or punycode (xn--); anything else is a sentence"
  clock data
  type "bar-field" "why.now？"
  expect state askUrl == ""
  type "bar-field" "choir.news…"
  expect state askUrl == ""
  type "bar-field" "choir.news。"
  expect state askUrl == ""
  type "bar-field" "choir.news¿"
  expect state askUrl == ""
  type "bar-field" "choir.news！"
  expect state askUrl == ""
  type "bar-field" "choir.news”"
  expect state askUrl == ""
  type "bar-field" "choir.😀"
  expect state askUrl == ""
  type "bar-field" "choir.n٣"
  expect state askUrl == ""
  type "bar-field" "choir.中国"
  expect state askUrl == ""
  type "bar-field" "café.dé"
  expect state askUrl == ""
  type "bar-field" "choir.n3ws"
  expect state askUrl == ""
  type "bar-field" "choir.xn--p1ai"
  expect state askUrl == "https://choir.xn--p1ai"
  type "bar-field" "choir.xn--"
  expect state askUrl == ""
  type "bar-field" "choir.xn--中"
  expect state askUrl == ""
  type "bar-field" "choir.news"
  expect state askUrl == "https://choir.news"

test "R10 a port is one to five digits; an empty or other port is not an address"
  clock data
  type "bar-field" "choir.news:"
  expect state askUrl == ""
  type "bar-field" "choir.news:/x"
  expect state askUrl == ""
  type "bar-field" "choir.news:80a"
  expect state askUrl == ""
  type "bar-field" "choir.news:123456"
  expect state askUrl == ""
  type "bar-field" "choir.news:80:90"
  expect state askUrl == ""
  type "bar-field" "choir.news:8"
  expect state askUrl == "https://choir.news:8"
  type "bar-field" "choir.news:65535/x"
  expect state askUrl == "https://choir.news:65535/x"

test "R11 the rare Unicode spaces count as spaces"
  clock data
  type "bar-field" "choir .news"
  expect state askUrl == ""
  type "bar-field" "choir.news now"
  expect state askUrl == ""
  type "bar-field" "choir.news now"
  expect state askUrl == ""
  type "bar-field" "choir.news now"
  expect state askUrl == ""
  type "bar-field" "choir.news　now"
  expect state askUrl == ""
  type "bar-field" "choir.news now"
  expect state askUrl == ""
  type "bar-field" "choir.news now"
  expect state askUrl == ""
  type "bar-field" "choir.news now"
  expect state askUrl == ""
  type "bar-field" "https://choir.news/a b"
  expect state askUrl == ""
