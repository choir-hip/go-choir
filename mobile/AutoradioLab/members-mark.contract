// Lane members file (mark and motion): the mark's clock. Owned by lane 9. Tasks are root-owned in Contract, so the mark's
// one per-frame task lives here and writes `mkT`; MarkAt and the wait read it through `inject` (names in lane 9's band of
// `provide`). The task runs only while a mark is moving: per frame while the bar is not idle, a sign-in or onboarding
// screen is up or a motion page is open; five times a second for the idle drift; not at all under Reduce Motion.
use tRest, tCapture, tat from "./tetramark.contract"

members Autoradio
  state mkT = 0
  state mkFrames = 0
  state mkSince = 0
  // The mark's geometry (mark.contract's MarkAt reads it through `inject`): generated, then gathered per blade. A root derive is
  // evaluated once; a derive written in the component would be compiled again for each of its uses.
  // BEGIN tetramark-data (generated by mobile/scripts/gen-tetramark.py from frontend/src/lib/tetramark.ts; do not edit)
  derive ax0 = [0.0536, 0.01, -0.0223, -0.0168, 0.0257, 0.0759, 0.1284, 0.1374, 0.2032, 0.4724, 0.6578, 0.7572, 0.8588, 0.7091, 0.4076, 0.2837, 0.1374]
  derive ay0 = [-0.856, -0.7533, -0.4383, -0.1915, -0.0743, -0.0787, -0.2373, -0.5735, -0.588, -0.1156, 0.0932, 0.2675, 0.2775, -0.043, -0.4607, -0.6986, -0.8638]
  derive bx0 = [0.0985, 0.0732, 0.0014, -0.0546, -0.0829, -0.0908, 0.0495, 0.1199, 0.1612, 0.3863, 0.5758, 0.6715, 0.799, 0.6427, 0.3724, 0.2317, 0.1188]
  derive by0 = [-0.6899, -0.5987, -0.34, -0.1383, -0.0364, -0.0079, -0.09, -0.3436, -0.4925, -0.0265, 0.3658, 0.4856, 0.645, 0.3214, -0.2381, -0.5295, -0.7632]
  derive bz0 = [-0.3108, -0.201, 0.1105, 0.3534, 0.476, 0.5104, 0.2939, -0.0115, -0.1907, 0.0158, 0.1896, 0.2047, 0.2248, 0.0815, -0.1664, -0.2955, -0.3991]
  derive bn0 = [0.5917, -0.5478, 0.5914]
  derive ru0 = [0.6749, -0.7379]
  derive fx0 = [0.1188, 0.8502, -0.1066]
  derive fy0 = [-0.7632, 0.751, 0.049]
  derive fz0 = [-0.3991, 0.2718, 0.5788]
  derive ax1 = [-0.3194, -0.4724, -0.6891, -0.7862, -0.8621, -0.8543, -0.7896, -0.2915, -0.1463, -0.1485, -0.1943, -0.4277, -0.6377, -0.6969, -0.6902, -0.3138]
  derive ay1 = [-0.4182, -0.3144, 0.0977, 0.4104, 0.55, 0.6639, 0.7108, 0.5154, 0.3892, 0.3367, 0.3266, 0.4104, 0.5433, 0.5422, 0.4584, -0.3512]
  derive bx1 = [0.0593, -0.1249, -0.431, -0.6462, -0.732, -0.636, -0.5822, -0.2217, -0.1503, -0.214, -0.2404, -0.4002, -0.5648, -0.5232, -0.4679, -0.0693]
  derive by1 = [-0.6588, -0.3359, 0.2007, 0.5781, 0.7286, 0.6243, 0.5657, 0.1741, 0.0966, 0.1268, 0.1393, 0.313, 0.4918, 0.4188, 0.322, -0.377]
  derive bz1 = [-0.3882, -0.3546, -0.2988, -0.2596, -0.2439, -0.1176, -0.0468, 0.4273, 0.5212, 0.3501, 0.2791, 0.0688, -0.1477, -0.1553, -0.1653, -0.238]
  derive bn1 = [-0.8367, -0.5004, 0.2227]
  derive ru1 = [-0.863, 0.5053]
  derive fx1 = [-0.732, 0.1188, -0.1066]
  derive fy1 = [0.7286, -0.7632, 0.049]
  derive fz1 = [-0.2439, -0.3991, 0.5788]
  derive ax2 = [0.8611, 0.4344, 0.2691, 0.2747, 0.5204, 0.5182, -0.22, -0.3071, -0.3149, -0.277, 0.191, 0.7873, 0.8487]
  derive ay2 = [0.7789, 0.4048, 0.3255, 0.4071, 0.6438, 0.7019, 0.7298, 0.7812, 0.8225, 0.8638, 0.8482, 0.8638, 0.8337]
  derive bx2 = [0.8502, 0.18, -0.0396, 0.0665, 0.3296, 0.558, -0.2616, -0.3509, -0.4429, -0.6213, -0.1084, 0.7134, 0.8077]
  derive by2 = [0.751, 0.2592, 0.0981, 0.2914, 0.4845, 0.6521, 0.6404, 0.6392, 0.6701, 0.7302, 0.7374, 0.7491, 0.7504]
  derive bz2 = [0.2718, 0.4869, 0.5573, 0.4195, 0.335, 0.2618, -0.0054, -0.0345, -0.0935, -0.2078, -0.0407, 0.2272, 0.2579]
  derive bn2 = [-0.2442, 0.6483, 0.7212]
  derive ru2 = [0.37, 0.929]
  derive fx2 = [0.8502, -0.732, -0.1066]
  derive fy2 = [0.751, 0.7286, 0.049]
  derive fz2 = [0.2718, -0.2439, 0.5788]
  // END tetramark-data
  derive mdAX = [ax0, ax1, ax2]
  derive mdAY = [ay0, ay1, ay2]
  derive mdBX = [bx0, bx1, bx2]
  derive mdBY = [by0, by1, by2]
  derive mdBZ = [bz0, bz1, bz2]
  derive mdRU = [ru0, ru1, ru2]
  derive mdBN = [bn0, bn1, bn2]
  derive mdFX = [fx0, fx1, fx2]
  derive mdFY = [fy0, fy1, fy2]
  derive mdFZ = [fz0, fz1, fz2]

  // The bar's mark (tetramark.contract; the model is AutoradioKit/TetraMarkMotion.swift): the motion now (`mkCur`), the one before
  // it, when it began (ms on this clock) and the pose that was on screen then (`mkFrom`, 24 numbers), so a change never jumps.
  state mkCur = "idle"
  state mkPrev = "idle"
  state mkFrom = tRest()
  state mkPressAt = -100000
  state mkCloseAt = -100000
  // The motion the app's state asks for: a press first, then listening, the desk working (a turn in flight), the tray (open, or
  // turning back), the radio playing, else the slow breath.
  derive mkPressed = mkT - mkPressAt < 420
  derive mkBase = bi.state == "listening" or bi.state == "talking" ? "listening" : (bi.state == "holding" or bi.state == "heard" ? "working" : (layer == "launcher" ? "trayOpen" : (mkT - mkCloseAt < 700 ? "trayClose" : (bi.state == "playing" ? "playing" : "idle"))))
  derive mkMotion = mkPressed ? "pressed" : mkBase
  // Frames: per frame while the mark moves (any state but idle, a one-shot in its first second, a sign-in or onboarding screen, the
  // galleries), five a second for the idle breath, none under Reduce Motion once the 300 ms cross-fade is over. The mark is not
  // drawn off screen (the page deck) and a backgrounded app has no display link, so neither costs a frame.
  derive mkHot = (th.reducedMotion == false and (bi.state != "idle" or isSignedIn == false or mkT - mkSince < 1000 or pg.top.startsWith("onboarding"))) or (th.reducedMotion and mkT - mkSince < 400)
  derive mkIdle = th.reducedMotion == false and mkHot == false
  action mkStep
    mkT = performanceNow()
    mkFrames = mkFrames + 1
  action mkEntered
    let now = performanceNow()
    mkFrom = tCapture(mkCur, now - mkSince, mkFrom, ri.micLevel)
    mkPrev = mkCur
    mkCur = mkMotion
    mkSince = now
  task markFrame when mkHot
    every(frame, mkStep)
  task markIdle when mkIdle
    every(200, mkStep)
  task markEnter when true key=mkMotion
    after(1, mkEntered)

