// The voice cards: tap a voice and it says one short line at once; the voice you tapped is the one the radio speaks with. Used by
// first-run (a step of its own, between the hearing check and the interview) and by Settings, voice and models.
// The state is the voice controller's in the module (AutoradioModule+Voice.swift); the cards are the kit's VoiceSampler.
//
// testIds: ob-voice, voice-cards, voice-card-<id>, ob-voice-continue.
use Theme, VoiceCards from "@choir/autoradio"
use Card, Btn from "./ui.contract"

// One card per voice: its name, how it sounds, its size, a progress bar while its model downloads, and "Playing" while it speaks.
component VoiceCardsList
  inject
    th: Theme
    vc: VoiceCards
    vcPick: action
  view
    column testId="voice-cards" gap=10 width="100%"
      for c, i in vc.cards key=c.id
        // A model's name and its credit are shown once, above its first voice (the cards of one model are together).
        if c.group != "" and (i == 0 or match vc.cards.at(i - 1) { case some(p) => p.model != c.model, case none => true })
          column gap=2 padding="8px 2px 0px" testId=`voice-group-${c.model}`
            text c.group testId=`voice-group-name-${c.model}` role="heading" aria-level=3 font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg
            if c.credit != ""
              text c.credit testId=`voice-credit-${c.model}` font-family=th.fontLabel font-size="-exact-caption2" line-height=1.35 color=th.muted
        button press=vcPick(c.id) testId=`voice-card-${c.id}` appearance="none" width="100%" role="radio" aria-checked=c.selected
          Card(level=(c.selected ? 2 : 1), testId=`voice-card-box-${c.id}`, minHeight=0)
            column padding=14 gap=8
              row gap=10 align-items="center"
                column flex=1 min-width=0 gap=2
                  text c.name font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg
                  text `${c.blurb} · ${c.sizeLabel}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
                if c.playing
                  text "Playing" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
                if c.playing == false and c.selected
                  image "symbol:checkmark" color=th.success
              if c.state == "downloading"
                column height=4 background-color=th.rule width="100%"
                  box height=4 background-color=th.accent width=`${floor(c.progress * 100)}%`
              if c.note != ""
                text c.note font-family=th.fontLabel font-size="-exact-footnote" color=(c.state == "failed" ? th.danger : th.muted) line-height=1.35

// The first-run step.
component VoiceStep
  inject
    th: Theme
    vcContinue: action
  view
    column gap=12 width="100%"
      Card(level=1, testId="ob-voice", minHeight=0)
        column padding=18 gap=8
          text "Pick the voice you like." font-size="-exact-title3" font-weight=600 font-family=th.fontHead
          text "Tap a voice to hear it. The one you tap is the one that reads the paper and talks with you. You can change it later in Settings." font-family=th.fontLabel font-size="-exact-subheadline" line-height=1.4 color=th.muted
      VoiceCardsList()
      button press=vcContinue testId="ob-voice-continue" appearance="none"
        Btn(label="Use this voice", primary=true, wide=true)
