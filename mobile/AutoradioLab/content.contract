// The content row (owner, 2026-11-16: "for reader and for the embedded web view, the content should get the full screen except for the
// prompt bar area at the bottom. The screen real estate at the top should not be used that way. We could have some controls just above
// the prompt bar, which can expand."). A document in the Reader and an embedded web page carry no title, tabs, action row, find field,
// stepper or header above them: the content starts under the status bar and ends at the top of the bar's lens.
//
// This row is the first line inside the lens, above the "On: ..." line. State and actions: members-content.contract.
//   collapsed  one line: the document's title or the site's host, where you are ("2 of 5" in a paged document, "Loading" for a web
//              page), the word More, and a Close icon. Tapping the line expands it; the content is not covered beyond this line.
//   expanded   the actions as words, opening upward over the content (the lens grows up):
//              a document      Read aloud, Add to queue, Contents, Find, Pages and Text (a PDF), and the page (or chapter) stepper;
//                              Contents and Find open their list under the words (Find has its field and its hits)
//              a web page      Read aloud, Add to queue, Open in Safari (the X on the line closes it)
//              It collapses after an action (not after a page step, so a page can be turned again) and on a tap outside (the scrim in app.contract).
// testIds: content-row, content-line, content-toggle, content-title, content-position, content-more, content-open,
//   doc-close, doc-read, doc-queue, doc-toc, doc-find-open, doc-find, doc-find-clear, doc-find-none, doc-hits, doc-hit-<n>, doc-mode-pages,
//   doc-mode-text, doc-prev, doc-position, doc-next, doc-contents, doc-chapter-<n>; for a web page reader-web-host, reader-web-close,
//   reader-web-read, reader-web-add, reader-web-safari (the page typed into the bar: bar-web-host, bar-web-close, bar-web-read, bar-web-add, bar-web-safari).
use Theme from "@choir/autoradio"
use ImportedDocInfo, ImportedSection, ImportedFind from "./imported-types.contract"
use StackVp, Btn, ChipFace, ChoiceWord, PlainList, LineRow, RowRule from "./ui.contract"

// A list under the actions: it scrolls inside the panel only when it is long (the page behind it never moves).
component Capped
  inject
    vp: StackVp
  props
    tall: bool
  slot
  view
    if tall
      scroll overflow-x="hidden" width="100%" height=(vp.height * 0.3)
        column width="100%" box-sizing="border-box"
          children
    else
      column width="100%" box-sizing="border-box"
        children

component DocExpanded
  inject
    th: Theme
    ldInfo: ImportedDocInfo
    ldChap: ImportedSection
    ldSec: number
    ldShowPages: bool
    ldFind: string
    ldFound: ImportedFind
    ldFindDraft: string
    ctlPanel: string
    ctlRead: action
    ctlQueueDoc: action
    ctlShare: action
    ctlPanelOf: action
    ctlSetText: action
    ctlGo: action
    ctlStep: action
    ctlJump: action
    ldEditFind: action
    ldDoFind: action
    ldClearFind: action
  derive pdf = ldInfo.kind == "pdf"
  derive unitWord = pdf ? "page" : "chapter"
  view
    column width="100%" gap=0 testId="content-open"
      row flex-wrap="wrap" gap=8 width="100%" align-items="center"
        button press=ctlRead testId="doc-read" appearance="none" aria-label="Read aloud from here"
          ChipFace(label="Read aloud", selected=false)
        button press=ctlQueueDoc testId="doc-queue" appearance="none" aria-label="Add to queue"
          ChipFace(label="Add to queue", selected=false)
        button press=ctlShare testId="doc-share" appearance="none" aria-label="Share this document"
          ChipFace(label="Share", selected=false)
        button press=ctlPanelOf("contents") testId="doc-toc" appearance="none" aria-label="Contents"
          ChipFace(label="Contents", selected=(ctlPanel == "contents"))
        button press=ctlPanelOf("find") testId="doc-find-open" appearance="none" aria-label="Find in this document"
          ChipFace(label="Find", selected=(ctlPanel == "find"))
        if pdf
          button press=ctlSetText(false) testId="doc-mode-pages" appearance="none" aria-label="Show the pages"
            ChoiceWord(label="Pages", selected=ldShowPages)
          button press=ctlSetText(true) testId="doc-mode-text" appearance="none" aria-label="Show the text"
            ChoiceWord(label="Text", selected=(ldShowPages == false))
      row gap=8 align-items="center" width="100%"
        button press=ctlStep(ldSec - 1) testId="doc-prev" appearance="none" aria-label=`Previous ${unitWord}`
          ChipFace(label="‹ Previous", selected=false)
        text ldChap.title testId="doc-position" font-family=th.fontLabel font-size="-exact-footnote" color=th.fg flex=1 min-width=0 line-clamp=1 text-align="center" font-variant-numeric="tabular-nums"
        button press=ctlStep(ldSec + 1) testId="doc-next" appearance="none" aria-label=`Next ${unitWord}`
          ChipFace(label="Next ›", selected=false)
      if ctlPanel == "contents"
        RowRule(indent=0)
        Capped(tall=(ldInfo.sections.length > 5))
          PlainList(testId="doc-contents")
            for s, i in ldInfo.sections key=s.index
              if i > 0
                RowRule(indent=0)
              button press=ctlGo(s.index) testId=`doc-chapter-${s.index}` appearance="none" width="100%"
                LineRow(label=s.title, detail="", trailing=(s.index == ldSec ? "Here" : ""), chevron=false)
      if ctlPanel == "find"
        RowRule(indent=0)
        row gap=8 align-items="center" width="100%"
          column flex=1 min-width=0
            input type="search" value=ldFindDraft input=ldEditFind submit=ldDoFind placeholder="Find in this document" aria-label="Find in this document" testId="doc-find"
              enterkeyhint="search" min-width=0 font-family=th.fontText font-size=16 color=th.fg min-height=44 padding="8px 0px" border-width=0 background-color="transparent"
            RowRule(indent=0)
          if ldFind != ""
            button press=ldClearFind testId="doc-find-clear" appearance="none" aria-label="Clear the search"
              ChipFace(label="Clear", selected=false)
        if ldFind != ""
          if ldFound.hits.length == 0
            text ldFound.message testId="doc-find-none" font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted
          else
            Capped(tall=(ldFound.hits.length > 3))
              PlainList(testId="doc-hits")
                for h, i in ldFound.hits key=h.block
                  if i > 0
                    RowRule(indent=0)
                  button press=ctlJump(h.section, h.block) testId=`doc-hit-${h.block}` appearance="none" width="100%" aria-label=`Go to ${h.label}`
                    LineRow(label=h.label, detail=h.snippet, trailing="", chevron=false)

// A Texture document of your own: Edit, then the formatting row (Done, Bold, Italic, Heading, List, Quote, Code, Link). Nothing here is Markdown
// syntax: each button is Exact's `format` on the editor, lit from the selection's `formats`.
component TextureExpanded
  inject
    th: Theme
    ctlPanel: string
    edOn: bool
    edStatus: string
    edKeepMine: action
    edUseTheirs: action
    edFormats: string
    edUnavail: string
    edUrl: string
    edCurLink: string
    edOpenCurLink: action
    edBegin: action
    edDone: action
    edFormat: action
    edHeading: action
    edOpenLink: action
    edUrlChanged: action
    edApplyLink: action
  view
    column gap=8 width="100%" testId="content-open"
      row flex-wrap="wrap" gap=8 width="100%" align-items="center"
        if edOn == false
          button press=edBegin testId="texture-edit" appearance="none" aria-label="Edit this document"
            ChipFace(label="Edit", selected=false)
        else
          button press=edDone retainFocus=true testId="texture-done" appearance="none" aria-label="Done editing"
            ChipFace(label="Done", selected=false)
          button press=edFormat("bold") retainFocus=true testId="format-bold" appearance="none" aria-label="Bold"
            ChipFace(label="Bold", selected=(` ${edFormats} `.includes(" bold ")))
          button press=edFormat("italic") retainFocus=true testId="format-italic" appearance="none" aria-label="Italic"
            ChipFace(label="Italic", selected=(` ${edFormats} `.includes(" italic ")))
          button press=edHeading retainFocus=true testId="format-heading" appearance="none" aria-label="Heading"
            ChipFace(label="Heading", selected=(` ${edFormats} `.includes(" heading2 ")))
          button press=edFormat("bullet") retainFocus=true testId="format-list" appearance="none" aria-label="List"
            ChipFace(label="List", selected=(` ${edFormats} `.includes(" bullet ")))
          button press=edFormat("quote") retainFocus=true testId="format-quote" appearance="none" aria-label="Quote"
            ChipFace(label="Quote", selected=(` ${edFormats} `.includes(" quote ")))
          button press=edFormat("code") retainFocus=true testId="format-code" appearance="none" aria-label="Code"
            ChipFace(label="Code", selected=(` ${edFormats} `.includes(" code ")))
          button press=edOpenLink retainFocus=true testId="format-link" appearance="none" aria-label="Link"
            ChipFace(label="Link", selected=(ctlPanel == "link"))
      // The document changed somewhere else while this text was unsent: it is kept, nothing was posted over the new version.
      if edOn and edStatus == "conflict"
        row gap=8 align-items="center" width="100%" testId="texture-conflict"
          text "Changed somewhere else. Your text is kept." testId="texture-conflict-words" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted flex=1 min-width=0
          button press=edKeepMine retainFocus=true testId="texture-keep-mine" appearance="none" aria-label="Save my text over the new version"
            ChipFace(label="Keep mine", selected=false)
          button press=edUseTheirs retainFocus=true testId="texture-use-theirs" appearance="none" aria-label="Drop my text and use the new version"
            ChipFace(label="Use theirs", selected=false)
      // The caret is in a link (the editor shows its text only): its address, with Edit and Open.
      if edOn and edCurLink != ""
        row gap=8 align-items="center" width="100%" testId="texture-link-row"
          text edCurLink testId="texture-link-url-now" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted flex=1 min-width=0 line-clamp=1
          button press=edOpenLink retainFocus=true testId="texture-link-edit" appearance="none" aria-label="Edit this link"
            ChipFace(label="Edit link", selected=false)
          button press=edOpenCurLink testId="texture-link-open" appearance="none" aria-label="Open this link"
            ChipFace(label="Open link", selected=false)
      if ctlPanel == "link"
        row gap=8 align-items="center" width="100%"
          input id="texture-link-url" value=edUrl input=edUrlChanged submit=edApplyLink aria-label="Link address" placeholder="https://" testId="texture-link-url"
            min-width=0 flex=1 font-family=th.fontLabel font-size=16 color=th.fg min-height=44 padding="8px 0px" border-width=0 background-color="transparent"
          button press=edApplyLink retainFocus=true testId="texture-link-apply" appearance="none" aria-label="Apply the link"
            ChipFace(label="Apply", selected=false)

component WebExpanded
  inject
    th: Theme
    ctlMode: string
    ctlKey: string
    ctlTitle: string
    ctlWebRead: action
    ctlWebLater: action
    ctlSafari: action
  derive pre = ctlMode == "barweb" ? "bar-web" : "reader-web"
  view
    row flex-wrap="wrap" gap=8 width="100%" align-items="center" testId="content-open"
      button press=ctlWebRead(ctlKey, ctlTitle) testId=`${pre}-read` appearance="none" aria-label="Read this page aloud"
        ChipFace(label="Read aloud", selected=false)
      button press=ctlWebLater(ctlKey, ctlTitle) testId=`${pre}-add` appearance="none" aria-label="Add this page to the queue"
        ChipFace(label="Add to queue", selected=false)
      button press=ctlSafari(ctlKey) testId=`${pre}-safari` appearance="none" aria-label="Open this page in Safari"
        ChipFace(label="Open in Safari", selected=false)

component ContentRow
  inject
    th: Theme
    ctlMode: string
    ctlUp: bool
    ctlTitle: string
    ctlPos: string
    ctlBusy: bool
    ctlToggle: action
    ctlCloseDoc: action
    ctlCloseWeb: action
    ctlCloseBarWeb: action
  derive pre = ctlMode == "barweb" ? "bar-web" : "reader-web"
  view
    column testId="content-row" width="100%" gap=0
      if ctlUp
        if ctlMode == "doc"
          DocExpanded()
        else if ctlMode == "texture"
          TextureExpanded()
        else
          WebExpanded()
      row testId="content-line" width="100%" align-items="center" gap=4 min-height=36
        button press=ctlToggle testId="content-toggle" appearance="none" flex=1 min-width=0 aria-label=(ctlUp ? "Fewer controls" : "More controls for this page")
          row width="100%" align-items="center" gap=8 min-height=36 padding-left=4
            text ctlTitle testId=((ctlMode == "doc" or ctlMode == "texture") ? "content-title" : `${pre}-host`) font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg flex=1 min-width=0 line-clamp=1 text-align="left"
            if ctlBusy
              progress aria-label="Busy" width=16 height=16 color=th.accent
            if ctlPos != ""
              text ctlPos testId=(ctlMode == "texture" ? "texture-saved" : "content-position") font-family=th.fontLabel font-size="-exact-footnote" color=th.muted font-variant-numeric="tabular-nums"
            text (ctlUp ? "Less" : "More") testId="content-more" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
        if ctlMode == "doc" or ctlMode == "texture"
          button press=ctlCloseDoc testId="doc-close" appearance="none" aria-label="Close this document" width=36 height=36
            image "symbol:close" color=th.fg
        else if ctlMode == "barweb"
          button press=ctlCloseBarWeb testId="bar-web-close" appearance="none" aria-label="Close page" width=36 height=36
            image "symbol:close" color=th.fg
        else
          button press=ctlCloseWeb testId="reader-web-close" appearance="none" aria-label="Close source" width=36 height=36
            image "symbol:close" color=th.fg
