    showLayer
    hideLayer
    toggleLauncher
    micTap
    micCancel
    micOn
    heardNow
    setTheme
    setMode
    editAsk
    sendAsk
    // ---- integrator (Choir sign-in, player) ----
    au
    pl
    signIn
    cancelSignIn
    openApproval
    sheetNote
    signOut
    signOutNote
    acs
    hpg
    signedOutTick
    hc
    noNative
    refreshRadio
    radioPlay
    playStory
    listen
    // ---- lane 1: bar, radio, talk ----
    ri
    typing
    barFocus
    barBlur
    jumpTo
    setSpeed
    nextStory
