// Lane members file (reader): the reader's and the Textures place's resources, states and actions, as if written in the root.
// Owned by the reader lane. The child components (reader.contract, textures.contract) `inject` these by name; each name is
// in lane 3's band of the `provide` list in app.contract.
use readerFollow, readerAim from "@choir/autoradio"
use readerAimSet, readerOpenExternal from "@choir/autoradio"
use ReaderDoc, ReaderFollowInfo, ReaderAimInfo, ReaderAck from "@choir/autoradio"
use TextureList, TextureMade from "./textures-types.contract"

members Autoradio
  // The story or document in front, read by shared code on both platforms (reader.ts, reader-parse.ts; any other address answers "loading"). It is asked again when the account state changes (a sign-in from
  // the banner), when the editor saves (the Texture editor says "saved"), after a stop, a restore or a reload (`rack` refreshes it) and every few seconds while the desk is revising it (`rtick`).
  resource rdoc = readerDocShared(pg.top, acs.state, edInfo.status == "saved", rtick) as shape ReaderDoc else empty()
  state rtick = 0
  action rbump
    rtick = rtick + 1
  task rrevising when rdoc.revising key=rtick
    after(5, rbump)
  // The Textures place reloads each time it is the page in front (textures.ts, shared code: both platforms), and again when a document was stopped, restored or reloaded (`rack` refreshes it) and when the account state changes (sign-in from the banner).
  resource tlist = texturesList(pg.top, acs.state) as shape TextureList else empty()
  // "New document" on the Textures page (textures.ts createTexture): the computer makes the document, then the deck opens it (the reader, and its editor for your own document); the list is asked again.
  // A failure opens nothing and the page says why (tnewMessage). Defined here, in the root, so the page reads it as `tnewMessage` and presses `newDocument`.
  mutation tnew as shape TextureMade refreshes tlist then textureMade
  derive tnewTarget = match tnew { case some(r) => r.address, case none => "" }
  derive tnewTitle = match tnew { case some(r) => r.title, case none => "" }
  derive tnewMessage = match tnew { case some(r) => r.message, case none => "" }
  action newDocument
    send tnew = textureCreate()
  action textureMade
    if tnewTarget != ""
      order = [tnewTarget].concat(order.filter(a => a != tnewTarget))
      px = 0
      pdrag = false
      flying = false
      send pms = pagesOpen(tnewTarget, tnewTitle)
      layer = ""
  // The block and sentence the radio is reading (set by the radio); what the bar's prompt is aimed at.
  resource rfollow = readerFollow() as shape ReaderFollowInfo else empty()
  resource raim = readerAim() as shape ReaderAimInfo else empty()
  mutation rack as shape ReaderAck refreshes tlist, rdoc
  // Opening a link outside the app changes no document: it does not refresh the Textures list.
  mutation rext as shape ReaderAck
  mutation raimm as shape ReaderAimInfo

  // Open citation cards, keyed "<address>|<anchor>": several can be open, and a card is open for one page only.
  state openCites: string[] = []
  // The sheet over the reader: "" | "menu" | "versions", for the page `sheetFor`.
  state sheet = ""
  state sheetFor = ""
  // The source page shown in place over the story (WebLayer): its address, host, the page it was opened from, and whether it is loading.
  state webUrl = ""
  state webHost = ""
  state webFor = ""
  state webBusy = false
  // Experiments (no control in the page menu reaches them now): the side note that text flows around (textflow), and the document
  // drawn as one Markdown text with citations as atom pills.
  state sideNotes = false
  state mdMode = false

  action toggleCite(key: string)
    openCites = openCites.includes(key) ? openCites.filter(k => k != key) : openCites.concat([key])
  action showSheet(name: string)
    sheet = name
    sheetFor = pg.top
  action hideSheet
    sheet = ""
  action jumpSources
    sheet = ""
    scrollIntoView("reader-sources")
  action toggleSideNotes
    sideNotes = sideNotes == false
    sheet = ""
  action toggleMdMode
    mdMode = mdMode == false
    sheet = ""
  action mdPress(e: AtomEvent)
    let k = `${pg.top}|${e.href.replaceAll("cite:", "")}`
    openCites = openCites.includes(k) ? openCites.filter(x => x != k) : openCites.concat([k])
  action aimAt(address: string, blockId: string, label: string)
    send raimm = readerAimSet(address=address, blockId=blockId, label=label)
    sheet = ""
  action clearAim
    send raimm = readerAimSet(address="", blockId="", label="")
  action stopRevision(address: string)
    send rack = readerStopShared(address)
  action restoreVersion(address: string, version: string)
    send rack = readerRestoreShared(address, version)
    sheet = ""
  action reloadDoc(address: string)
    send rack = readerReloadShared(address)
    sheet = ""
  // A web page opens in place, over the story and above the bar; anything else (mailto, tel, sms) goes to the system, and
  // the native side refuses what is neither (readerOpenExternal decides with SourceLink.route).
  action openLink(u: string, host: string)
    if u.startsWith("https://") or u.startsWith("http://")
      webUrl = u
      webHost = host
      webFor = pg.top
      webBusy = true
      sheet = ""
    else
      send rext = readerOpenExternal(url=u)
  action closeWeb
    webUrl = ""
    webBusy = false
  action webMsg(m: string)
    webBusy = m == "loading"
  action openExternal(u: string)
    send rext = readerOpenExternal(url=u)
  action shareDoc
    share(title=rdoc.title, text=rdoc.plain, url=(rdoc.permalink == "" ? "" : `https://choir.news/${rdoc.permalink}`))
    sheet = ""
