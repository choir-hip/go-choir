// The shape of the Texture editor's answer (texture-edit.ts `Info`): what the editor says about the document in front.
// status: idle | dirty | saving | saved | offline | failed | conflict. `kept` is the listener's newest unsent text ("" when none): the field is seeded from it on reopening.
// `head` is the document's text as the server holds it (read by `textureEditOpen`; `opened` says it was read): the field is seeded from it when nothing is kept.
// `waiting` counts the documents with unsent text that a retry can send (not one in conflict: it waits for the listener); a refused or moved head is `conflict` (the text is kept and the listener chooses).

shape TextureEditInfo
  status: string
  label: string
  address: string
  editable: bool
  kept: string
  waiting: number
  stamp: number
  head: string
  opened: bool
