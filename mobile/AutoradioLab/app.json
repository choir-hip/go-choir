{
  "$schema": "../.exact-src/scripts/app.schema.json",
  "name": "Autoradio 1",
  "short_name": "Autoradio 1",
  "version": "1.0",
  "id": "news.choir.autoradio",
  "start_url": "/",
  "display": "standalone",
  "app": {
    "id": "news.choir.autoradio",
    "name": "Autoradio 1"
  },
  "icons": [
    { "src": "assets/appicon/default.png", "sizes": "1024x1024", "type": "image/png", "purpose": "any" }
  ],
  "host": {
    "ios": {
      "launchImage": { "src": "launch-mark.png", "width": 96 },
      "minimumOS": "18.0",
      "deviceFamily": ["iphone"],
      "backgroundModes": ["audio"],
      "link": ["-lc++"],
      "resources": [{ "from": "tiny-voca-resources/TinyVoca", "to": "Resources/TinyVoca" }]
    },
    "macos": {
      "minimumOS": "15.0",
      "window": { "width": 430, "height": 900, "minWidth": 360, "minHeight": 560 },
      "link": ["-lc++"],
      "resources": [{ "from": "tiny-voca-resources/TinyVoca", "to": "Resources/TinyVoca" }]
    },
    "web": {},
    "android": {}
  },
  "deploy": {
    "store": {
      "ios": "0",
      "macos": "0",
      "web": "0"
    }
  },
  "env": ["APP_ID"],
  "variants": {
    "lab": { "idSuffix": ".lab", "name": "Autoradio", "env": { "APP_ID": "news.choir.autoradio.lab" } },
    "lab-one": { "idSuffix": ".lab.one", "name": "Autoradio 1 Dev", "env": { "APP_ID": "news.choir.autoradio.lab.one" } }
  },
  "audio_session": "playback",
  "typescript": { "sources": { "fixtures": "../fixtures", "layouts": "../layouts", "themes": "../themes" } }
}
