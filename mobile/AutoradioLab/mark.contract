// The mark: the brand TetraMark (frontend/src/lib/tetramark.ts), animated. Lane MARK owns this file. PURE CONTRACT (owner,
// 2026-11-11: "ideally we can do pure contract so we can easily run on other platforms"): no Swift view, no TypeScript.
//
// What it is: three independent pieces, the brand's three blades, each a closed polygon drawn as `svg polygon` in the
// brand's own 512 box. The mark breathes between two poles (owner: "the perspective is a little off, and that's kind of
// intentional ... the three pieces should be able to move independently, so they come into more of a correct perspective,
// or grow apart ... between something closer to a sharp tetrahedron and that flat symbol"):
//   pole A: the flat hand-drawn symbol, exactly as drawn (a triskelion: three chevrons chasing round a centre);
//   pole B: the same points moved onto a real tetrahedron in perspective, each chevron straightened into the angle at one
//           base corner of one face (generated; see mobile/scripts/gen-tetramark.py, which also fails `--check` when the
//           web drawing drifts from the data below). The faces are drawn behind as a translucent solid.
// Each blade has its own parameters: beta (0 = pole A, 1 = pole B, a point-wise blend), rho (it moves outward from the
// centre and back), theta (it rolls about the centre: the chase) and s (scale). States are choreography over those, with a
// phase offset per blade so they are never in step. Only when all three sit at pole B is the whole turned (yaw, pitch) and
// perspective-projected, so the turn is a real solid with filled faces and has no edge-on sliver. Every parameter is 0
// at rest, and then the projection is the exact flat brand drawing.
//
// The clock: tasks are root-owned in Contract, so the one per-frame task lives in members-mark.contract; it writes the
// root state `mkT` (ms) and a component reads it through `inject`. Time-in-state (`since`, ms) is the root's `mkSince`
// for the bar, or the caller's own for another mark. Every pose is a closed form of tt (seconds) and ee (seconds since the
// state began), starting from the rest pose at ee = 0 so a state change never jumps; the new state also remounts the
// glyph (`for k in [state]`), which plays the `markpop` keyframes, so the change reads as a beat.
//
// States (the bar's names or the plain ones): idle (the flat symbol; with the theme's drift a very slow breath toward
// pole B), listening (the blades spread and pulse outward with the mic level), thinking / holding / heard (the chase: the
// blades roll round the centre while spreading, snap together into the tetrahedron, the solid turns once with a hop, then
// they relax out to the flat symbol and rest), speaking / playing (a gentle breath between A and a little of B in time
// with speech), success / revised (snap to the tetrahedron, turn, settle to the symbol), error / failed (the blades jolt
// apart and return, a shake, danger tint). Reduced motion (the theme's flag, or `still`): the flat brand drawing, a gentle
// opacity change, state shown by tint. The state "pose:0" to "pose:1" draws a still blend of the poles (the lab).
//
// Every duration is a theme token: th.motionEnterMs (ramps, pop, reduced fade), th.markDriftS, th.markTumble ("3.3s,5.9s":
// the first sets the thinking cycle), th.markListenScale, th.reducedMotion. The projection's bound (every point within 1.15
// x the brand box over every state's cycle) is asserted by mobile/scripts/check-tetramark-projection.py.
use Theme, RadioInfo from "@choir/autoradio"

keyframes markpop
  from opacity=0.35 scale=0.85
keyframes markfade
  50% opacity=0.65

shape MarkPoly
  id: number
  pts: string
  fill: string
  op: number

fn at0(xs: number[], i: number): number = match xs.at(i) { case some(v) => v, case none => 0 }
fn at0s(xs: number[][], i: number): number[] = match xs.at(i) { case some(v) => v, case none => [0, 0, 0] }
fn smooth(u: number): number = u * u * (3 - 2 * u)
fn rise(a: number, b: number, u: number): number = smooth(min(1, max(0, (u - a) / (b - a))))
fn pulsei(tt: number, i: number): number = 0.5 + 0.5 * sin(6.2832 * 3.1 * tt + 2.1 * i)
fn canon(s: string): string = s.startsWith("pose:") ? "pose" : s == "playing" or s == "speaking" ? "speaking" : s == "listening" ? "listening" : s == "holding" or s == "thinking" or s == "heard" or s == "working" or s == "waiting" ? "thinking" : s == "revised" or s == "success" ? "success" : s == "error" or s == "failed" ? "error" : "idle"

// The drawing is staged through lists, never through nested calls: a call's arguments are written out again wherever the
// function uses them, and a derive that holds a single number is written out at every read, so nesting them costs a copy
// per level and per read (this file's first form was 165 KB of plan per use, mark-cost 2026-11-18). A list a derive holds
// is built once and read by index.
// A turned list of points: about y (yaw), tipped about x (pitch). cam = [sin yaw, cos yaw, sin pitch, cos pitch, scale, dx, dy, fb].
fn turn(ps: number[][], cam: number[]): number[][] = ps.map(p => [at0(p, 0) * at0(cam, 1) + at0(p, 2) * at0(cam, 0), at0(p, 1), at0(p, 2) * at0(cam, 1) - at0(p, 0) * at0(cam, 0)]).map(p => [at0(p, 0), at0(p, 1) * at0(cam, 3) - at0(p, 2) * at0(cam, 2), at0(p, 1) * at0(cam, 2) + at0(p, 2) * at0(cam, 3)])
// The perspective (eye at 8 radii; the divisor is clamped so no point can blow up), then the brand box (256 is its centre).
fn project(ps: number[][], cam: number[]): string = turn(ps, cam).map(p => `${256 + 256 * at0(p, 0) * 8 / max(8 - at0(p, 2), 4) * at0(cam, 4) + at0(cam, 5)},${256 + 256 * at0(p, 1) * 8 / max(8 - at0(p, 2), 4) * at0(cam, 4) + at0(cam, 6)}`).join(" ")
// A blade's points blended between the poles (b), rolled about the centre (ct, st), scaled (s) and moved outward (rho along u).
// bp = [b, cos th, sin th, rho, ux, uy, s].
fn bladePts(axs: number[], ays: number[], bxs: number[], bys: number[], bzs: number[], bp: number[]): number[][] = axs.map((ax, i) => [ax + (at0(bxs, i) - ax) * at0(bp, 0), at0(ays, i) + (at0(bys, i) - at0(ays, i)) * at0(bp, 0), at0(bp, 6) * at0(bzs, i) * at0(bp, 0)]).map(q => [at0(bp, 6) * (at0(q, 0) * at0(bp, 1) - at0(q, 1) * at0(bp, 2)) + at0(bp, 3) * at0(bp, 4), at0(bp, 6) * (at0(q, 0) * at0(bp, 2) + at0(q, 1) * at0(bp, 1)) + at0(bp, 3) * at0(bp, 5), at0(q, 2)])
fn facePts(fx: number[], fy: number[], fz: number[]): number[][] = fx.map((x, i) => [x, at0(fy, i), at0(fz, i)])
// Facing: a normal turned by the whole's yaw and pitch, seen against a light at the upper left; 1 is bright, 0 is dark.
// [x, y, z, lit].
fn facing(ns: number[][], cam: number[]): number[][] = turn(ns, cam).map(v => [at0(v, 0), at0(v, 1), at0(v, 2), 0.5 + 0.5 * (at0(v, 2) >= 0 ? 1 : -1) * (at0(v, 0) * -0.42 + at0(v, 1) * -0.52 + at0(v, 2) * 0.74)])

// The choreography, per blade i (0, 1, 2). tv = [tt, r, amp, u, ue, dd, dr]: tt the clock (s), r the ramp into the state, amp
// the listening level, u the thinking cycle's phase (0 to 1), ue the one-shot phase of success and error, dd 1 when the theme
// drifts, dr the drift period.
fn qBeta(st: string, i: number, tv: number[]): number = st == "thinking" ? rise(0.3 + 0.04 * i, 0.46 + 0.04 * i, at0(tv, 3)) - rise(0.8 + 0.03 * i, 0.92 + 0.03 * i, at0(tv, 3)) : st == "listening" ? at0(tv, 1) * 0.2 * at0(tv, 2) * (0.5 + 0.5 * sin(6.2832 * at0(tv, 0) / 1.6 + 2.1 * i + 1)) : st == "speaking" ? at0(tv, 1) * (0.1 + 0.12 * pulsei(at0(tv, 0), i)) : st == "success" ? rise(0.05 * i, 0.25 + 0.05 * i, at0(tv, 4)) - rise(0.6 + 0.05 * i, 0.9 + 0.05 * i, at0(tv, 4)) : st == "idle" ? at0(tv, 5) * 0.14 * (0.5 + 0.5 * sin(6.2832 * at0(tv, 0) / at0(tv, 6) + 2.1 * i)) : 0
fn qRho(st: string, i: number, tv: number[]): number = st == "thinking" ? 0.2 * sin(3.1416 * rise(0.02 * i, 0.34 + 0.02 * i, at0(tv, 3))) : st == "listening" ? at0(tv, 1) * (0.04 + 0.14 * at0(tv, 2)) * (0.6 + 0.4 * sin(6.2832 * at0(tv, 0) / 1.6 + 2.1 * i)) : st == "speaking" ? at0(tv, 1) * 0.03 * pulsei(at0(tv, 0), i) : st == "error" ? 0.17 * (1 - at0(tv, 4)) * sin(6.2832 * (3 * at0(tv, 4) + i / 3)) : 0
fn qTheta(st: string, i: number, tv: number[]): number = st == "thinking" ? 6.2832 * rise(0.02 * i, 0.28 + 0.02 * i, at0(tv, 3)) : st == "listening" ? at0(tv, 1) * 0.1 * at0(tv, 2) * sin(6.2832 * at0(tv, 0) / 1.6 + 2.1 * i) : st == "speaking" ? at0(tv, 1) * 0.08 * sin(6.2832 * at0(tv, 0) / 2.4 + 2.1 * i) : st == "error" ? 0.25 * (1 - at0(tv, 4)) * sin(6.2832 * (4 * at0(tv, 4) + i / 3)) : 0
fn qScale(st: string, i: number, tv: number[]): number = st == "thinking" ? 1 - 0.3 * sin(3.1416 * rise(0.02 * i, 0.34 + 0.02 * i, at0(tv, 3))) : st == "listening" ? 1 + (0.05) * at0(tv, 2) * at0(tv, 1) : 1

// The whole's yaw, pitch, move, scale and togetherness (fb: how far all three blades are at pole B and together). tv as in the
// choreography below (and ee at 7), bm = [the least beta, the greatest outward move], tw = [the turn's phase].
fn whole(st: string, calm: bool, tv: number[], bm: number[], tw: number[]): number[] = [calm ? 0 : st == "thinking" ? 6.2832 * at0(tw, 0) : st == "success" ? 6.2832 * at0(tw, 0) : st == "listening" ? at0(tv, 1) * 0.3 * at0(tv, 2) * sin(6.2832 * at0(tv, 0) / 2.2) * at0(bm, 0) : st == "speaking" ? at0(tv, 1) * 0.3 * sin(6.2832 * at0(tv, 0) / 3.2) * at0(bm, 0) : 0, calm ? 0 : st == "thinking" ? 0.25 * sin(3.1416 * rise(0.52, 0.8, at0(tv, 3))) : st == "success" ? 0.2 * sin(3.1416 * rise(0.25, 0.65, at0(tv, 4))) : 0, calm ? 0 : st == "thinking" ? 10 * sin(6.2832 * rise(0.3, 0.8, at0(tv, 3))) : st == "error" ? 20 * (1 - at0(tv, 4)) * (1 - at0(tv, 4)) * sin(6.2832 * 8 * at0(tv, 7)) : 0, calm ? 0 : st == "thinking" ? -26 * sin(3.1416 * rise(0.3, 0.8, at0(tv, 3))) : st == "success" ? -22 * sin(3.1416 * rise(0, 0.6, at0(tv, 4))) : 0, calm ? 1 : st == "success" ? 1 + 0.04 * sin(3.1416 * at0(tv, 4)) : 1, at0(bm, 0) * at0(bm, 0) * at0(bm, 0) * max(0, 1 - 5 * at0(bm, 1))]
// All the drawing's polygons, faces first (when the blades are together) then the three blades: nT the turned normals (see
// `facing`), bs / ts / rs / ss each blade's beta, roll, outward move and scale, step the blades lit by desk steps (-1: shaded).
fn scene(nT: number[][], cam: number[], bs: number[], ts: number[], rs: number[], ss: number[], step: number, tint: string, tint2: string, AX: number[][], AY: number[][], BX: number[][], BY: number[][], BZ: number[][], RU: number[][], FX: number[][], FY: number[][], FZ: number[][]): MarkPoly[] = (at0(cam, 7) > 0.01 ? [0, 1, 2].map(f => MarkPoly(id=f, pts=project(facePts(at0s(FX, f), at0s(FY, f), at0s(FZ, f)), cam), fill=tint2, op=at0(cam, 7) * (at0(at0s(nT, f), 2) >= 0 ? 0.2 + 0.3 * at0(at0s(nT, f), 3) : 0.1))) : []).concat([0, 1, 2].map(i => MarkPoly(id=3 + i, pts=project(bladePts(at0s(AX, i), at0s(AY, i), at0s(BX, i), at0s(BY, i), at0s(BZ, i), [at0(bs, i), cos(at0(ts, i)), sin(at0(ts, i)), at0(rs, i), at0(at0s(RU, i), 0), at0(at0s(RU, i), 1), at0(ss, i)]), cam), fill=tint, op=step >= 0 ? (i < step ? 1 : 0.3) : 1 - at0(bs, i) * 0.45 * (1 - at0(at0s(nT, i), 3)))))

// The glyph at any size (points). `since`: ms on the root clock when the state began. `level`: 0 to 1 input level for
// listening (0 = a synthesized breath). `step`: blades lit by real desk steps (0 to 3; 4 steps light all), or -1 for facing shades.
// `still`: draw the reduced-motion form whatever the system says (the gallery's reduced row).
component MarkAt
  inject
    th: Theme
    mkT: number
    mdAX: number[][]
    mdAY: number[][]
    mdBX: number[][]
    mdBY: number[][]
    mdBZ: number[][]
    mdRU: number[][]
    mdBN: number[][]
    mdFX: number[][]
    mdFY: number[][]
    mdFZ: number[][]
  props
    state: string
    size: number
    since: number
    level: number
    step: number
    still: bool
    testId: string
  derive st = canon(state)
  derive calm = still or th.reducedMotion
  derive tt = mkT / 1000
  derive ee = max(0, (mkT - since) / 1000)
  derive eu = min(1, ee * 1000 / (th.motionEnterMs * 2))
  derive r = calm ? 0 : smooth(eu)
  derive tparts = th.markTumble.split(",")
  derive taText = match tparts.at(0) { case some(v) => v.replaceAll("s", "").trim(), case none => "3.3" }
  derive ta = match parseNumber(taText) { case some(n) => max(n, 0.5), case none => 3.3 }
  derive dr = max(th.markDriftS, 8)
  derive dd = th.markDriftS > 0 ? 1 : 0
  derive breath = 0.5 + 0.5 * sin(6.2832 * tt / 2.6)
  derive amp = max(level, 0.5 * breath)
  derive cyc = max(2.4, min(4.5, ta * 0.9))
  derive u = (ee % cyc) / cyc
  derive ue = min(1, ee / (st == "success" ? 1.3 : 0.9))
  derive pb = match parseNumber(state.startsWith("pose:") ? state.slice(5) : "0") { case some(n) => min(1, max(0, n)), case none => 0 }
  derive tv = [tt, r, amp, u, ue, dd, dr, ee]
  derive bs = calm ? [0, 0, 0] : st == "pose" ? [pb, pb, pb] : [0, 1, 2].map(i => qBeta(st, i, tv))
  derive rs = calm ? [0, 0, 0] : [0, 1, 2].map(i => qRho(st, i, tv))
  derive ts = calm ? [0, 0, 0] : [0, 1, 2].map(i => qTheta(st, i, tv))
  derive ss = calm ? [1, 1, 1] : [0, 1, 2].map(i => qScale(st, i, tv))
  derive bm = [min(at0(bs, 0), min(at0(bs, 1), at0(bs, 2))), max(at0(rs, 0), max(at0(rs, 1), at0(rs, 2)))]
  derive wh = whole(st, calm, tv, bm, [st == "thinking" ? rise(0.55, 0.77, at0(tv, 3)) : st == "success" ? rise(0.3, 0.6, at0(tv, 4)) : 0])
  derive tint2 = th.accent2
  derive tint = st == "success" ? th.success : st == "error" ? th.danger : th.accent
  // The whole's turn and everything the drawing reads, as lists (see the note above `turn`).
  derive cam = [sin(at0(wh, 0)), cos(at0(wh, 0)), sin(at0(wh, 1)), cos(at0(wh, 1)), at0(wh, 4), at0(wh, 2), at0(wh, 3), at0(wh, 5)]
  derive polys = scene(facing(mdBN, cam), cam, bs, ts, rs, ss, step, tint, tint2, mdAX, mdAY, mdBX, mdBY, mdBZ, mdRU, mdFX, mdFY, mdFZ)

  view
    box testId=testId width=size height=size position="relative" role="img" aria-label=`TetraMark, ${st}`
      for k in [state] key=k
        box position="absolute" inset=0 animation=(calm ? `markfade ${th.motionEnterMs * 10}ms ease-in-out infinite` : `markpop ${th.motionEnterMs}ms ease-out both`)
          svg viewBox="0 0 512 512" width=size height=size overflow="visible"
            for p in polys key=p.id
              polygon points=p.pts fill=p.fill fill-opacity=p.op

// The bar's voice button face: the 44 pt target with the mark at 36 pt. Keeps the spine's name, props and test id
// (`mark`). It handles no gesture: the bar's tap button owns the press.
component Mark
  inject
    mkSince: number
    ri: RadioInfo
  props
    state: string
  view
    row width=44 height=44 align-items="center" justify-content="center" testId="mark"
      MarkAt(state=state, size=36, since=mkSince, level=(state == "listening" ? ri.micLevel : 0), step=-1, still=false, testId="mark-glyph")

// The large mark for onboarding and the wait (the caller owns `since` and `step`).
component MarkHero
  props
    state: string
    since: number
    step: number
  view
    MarkAt(state=state, size=144, since=since, level=0, step=step, still=false, testId="mark-hero")
