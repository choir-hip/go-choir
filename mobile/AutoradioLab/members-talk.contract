// Lane members file (talk): the conversation page's resource and the answer card's actions. Owned by the talk lane
// (autoradio-talk). Shapes and source names: exact-package/interface/talk.json; module: exact-package/apple/AutoradioModule+Talk.swift.
// Every name a child component injects is in the talk band of `provide` in app.contract.
use conversationEntries, answerAction, voiceProfile, voiceLearn, voiceForget from "@choir/autoradio"
use ConversationEntries, VoiceProfile, SettingsAck from "@choir/autoradio"
use ConversationInfo from "./conversation-types.contract"

members Autoradio
  // The entries are the voice turn engine's (native, read whole); the page's rows are shared code (conversation.ts), asked again whenever the entries change.
  resource cvraw = conversationEntries() as shape ConversationEntries else empty()
  resource cv = conversationInfo(cvraw) as shape ConversationInfo else empty()
  resource voicep = voiceProfile() as shape VoiceProfile else empty()
  mutation tk as shape SettingsAck
  // The answer card's buttons (bar.contract): ask the same words again, hide the card (shared code), stop the turn.
  action answerRetry(id: string)
    send tk = answerAction(action="retry", id=id)
  // Close is shared code's (bar.ts `dismissAnswer`): the id of the entry the card shows is remembered there, so no later turn can bring that card back. Native keeps no dismissal.
  mutation dm as shape SettingsAck refreshes bi
  action answerDismiss(id: string)
    send dm = answerDismissShared(id)
  action answerCancel
    send tk = answerAction(action="cancel", id="")
  // Settings, Listening: the learned voice (kept on this phone only).
  // "Learn again" opens the learn-your-voice page; native rewinds it (the old profile is deleted when the person starts).
  action learnVoice
    send tk = voiceLearn()
    send pms = pagesOpen("settings:voiceprint", "Your voice")
  action forgetVoice
    send tk = voiceForget()
