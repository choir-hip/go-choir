// The conversation (conversation:). Lane autoradio-talk. Every question the reader asked, typed or spoken, newest first, with what came
// back: the answer the phone gave first from the reader's saved stories (marked as such), the full answer from the computer, or a plain
// failure with a way to ask again. One entry per question; the bar's answer card opens this page. testIds: conversation-row-<id>,
// conversation-retry-<id>, conversation-empty.
use Theme, ThemeExtras from "@choir/autoradio"
use ConversationInfo, ConversationRow from "./conversation-types.contract"
use ToolScroll, Card, Btn, dyn from "./ui.contract"
use ScreenTitle, SectionLabel, Hairline from "./settings.contract"

component ConversationPage
  inject
    th: Theme
    tx: ThemeExtras
    cv: ConversationInfo
  props
    address: string
    title: string
  view
    ToolScroll(id="conversation")
      ScreenTitle(label="Conversation", back=false)
      if cv.empty
        text "Nothing asked yet. Type in the bar, or turn the voice on and ask." testId="conversation-empty" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted
      for r, i in cv.rows key=r.id
        column width="100%"
          if i > 0
            Hairline()
          ConversationEntryCard(r=r)

component ConversationEntryCard
  inject
    th: Theme
    tx: ThemeExtras
    answerRetry: action
  props
    r: ConversationRow
  view
    column testId=`conversation-row-${r.id}` width="100%"
      column width="100%" gap=8 box-sizing="border-box" padding="12px 0px"
        text r.question font-family=th.fontHead font-size=dyn(tx.sizeLabel) font-weight=600 color=th.fg
        if r.answer != ""
          text r.answer font-family=th.fontText font-size=dyn(tx.sizeLabel) line-height=1.4 color=th.fg
        if r.first != "" and r.answer == ""
          text "FROM YOUR SAVED STORIES" font-family=th.fontLabel font-size="-exact-caption2" font-weight=600 letter-spacing=0.8 color=th.muted
          if r.firstSource != ""
            text r.firstSource font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.fg
          text r.first font-family=th.fontText font-size=dyn(tx.sizeLabel) line-height=1.4 color=th.fg
        if r.first != "" and r.answer != ""
          text "FIRST HEARD, FROM YOUR SAVED STORIES" font-family=th.fontLabel font-size="-exact-caption2" color=th.muted
          text r.first font-family=th.fontText font-size=dyn(tx.sizeMeta) line-height=1.4 color=th.muted
        if r.status == "asking"
          text "Looking…" font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
        if r.note != ""
          text r.note font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.danger
        if r.canRetry
          button press=answerRetry(r.id) testId=`conversation-retry-${r.id}` appearance="none"
            Btn(label="Try again", primary=false, wide=false)
