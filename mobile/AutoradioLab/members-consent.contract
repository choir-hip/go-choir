// Lane members file (consent, lane onboard-consent): the model-download agreement (consent.ts) and the sheet in front of an ask. Signed out, an ask opens "Sign in to ask the radio"; signed in, it is sent.
// Turning the voice ON is an ask (the microphone is requested only then, and only signed in); turning it off, and every transport word, never are. There is no consent screen before the radio answers (owner, 2026-11-23).
use ConsentView from "./consent-types.contract"
use ModelsView from "./models-types.contract"
use MicPerm from "./consent-types.contract"

members Autoradio
  // Asked again when the account changes (sign-in, sign-out) and after each press (the mutation's answer is the new view).
  resource cons = consentView(`${isSignedIn}|${signedOutTick}`) as shape ConsentView else empty(rev=0, signTitle="", signWhy="", signIn="", make="", later="", micPre="", micOff="", micContinue="", micNotNow="", micOk="")
  // "" (none), "signin", "micpre" (the plain line before the microphone is asked) or "micoff" (the declined line): which sheet is up.
  state gate = ""
  // What the microphone was wanted for when the plain line went up: "voice" (the bar's button) or "take"; and a count that asks the system again after a press went on to its prompt.
  state micFor = ""
  state micTick = 0
  // The take press that was held back for the plain line (record, or record again of this take): Continue goes on with exactly it.
  state micOp = "record"
  state micArg = ""
  resource micperm = micPermission(`${isSignedIn}|${bi.handsFree}|${micTick}|${hpg.visibilityState}|${hpg.hasFocus}`) as shape MicPerm else empty(state="granted", gate="")
  action hideGate
    gate = ""
  action gateSignIn
    gate = ""
    // The sign-in screen goes up first (it shows the passkey screen's waiting, Cancel and failure, and `authDone` puts it away on success), after the machine is reset so an older done or failed state cannot show or end it.
    authOpen = true
    send signedOpen = signInOpen()
    send signedRun = signInRun("signin", "", "")
    sivTick = sivTick + 1
  // Make an account: the create-account screen (account.contract: the email, the consent line, the mailed code, then the passkey screen) opens, as it does from the card and Settings.
  action gateMakeAccount
    gate = ""
    authOpen = true
    send signedOpen = signInOpen()
    sivTick = sivTick + 1

  // Settings > Voice and models (models.ts): asked again when the voice side's facts change (ovoice) or an agreement is recorded. Each press is one row's: Download is the agreement to that model's files and starts it.
  resource dl = modelsPage(ovoice, cons.rev) as shape ModelsView else empty(tabs=[], jobs=[], rev=0, voiceReady=false, hearingReady=false, setupTotal="", voiceNote="", lines=[], voiceOffer=[])
  mutation dlm as shape ModelsView refreshes dl
  // The tab of Settings > Voice and models: one tab per kind of model (hearing, voice, answering, deciding, search, your voice).
  state mdTab = "hearing"
  action mdTabTo(tab: string)
    mdTab = tab
  action mdDownload(section: string, id: string)
    send dlm = modelsAct("download", section, id, ovoice)
  action mdDownloadMobile(section: string, id: string)
    send dlm = modelsAct("downloadMobile", section, id, ovoice)
  action mdUse(section: string, id: string)
    send dlm = modelsAct("use", section, id, ovoice)
  action mdRemove(section: string, id: string)
    send dlm = modelsAct("remove", section, id, ovoice)
  action mdTest(section: string, id: string)
    send dlm = modelsAct("test", section, id, ovoice)
