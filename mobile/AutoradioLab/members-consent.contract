// Lane members file (consent, lane onboard-consent): the model-download agreement (consent.ts) and the sheet in front of an ask. Signed out, an ask opens "Sign in to ask the radio"; signed in, it is sent.
// Turning the voice ON is an ask (the microphone is requested only then, and only signed in); turning it off, and every transport word, never are. There is no consent screen before the radio answers (owner, 2026-11-23).
use ConsentView from "./consent-types.contract"
use DownloadsView from "./downloads-types.contract"
use MicPerm from "./consent-types.contract"

members Autoradio
  // Asked again when the account changes (sign-in, sign-out) and after each press (the mutation's answer is the new view).
  resource cons = consentView(`${au.signedIn}|${signedOutTick}`) as shape ConsentView else empty(rev=0, signTitle="", signWhy="", signIn="", make="", later="", micPre="", micOff="", micContinue="", micNotNow="", micOk="")
  // "" (none), "signin", "micpre" (the plain line before the microphone is asked) or "micoff" (the declined line): which sheet is up.
  state gate = ""
  // What the microphone was wanted for when the plain line went up: "voice" (the bar's button) or "take"; and a count that asks the system again after a press went on to its prompt.
  state micFor = ""
  state micTick = 0
  // The take press that was held back for the plain line (record, or record again of this take): Continue goes on with exactly it.
  state micOp = "record"
  state micArg = ""
  resource micperm = micPermission(`${au.signedIn}|${bi.handsFree}|${micTick}|${hpg.visibilityState}|${hpg.hasFocus}`) as shape MicPerm else empty(state="granted", gate="")
  action hideGate
    gate = ""
  action gateSignIn
    gate = ""
    send signedRun = signInRun()
    sivTick = sivTick + 1
  // Until the native passkey lane's create-account screen exists this is the same press as Sign in; that lane replaces this action's body.
  action gateMakeAccount
    gate = ""
    send signedRun = signInRun()
    sivTick = sivTick + 1

  // The model downloads (downloads.ts): asked again when the voice side's facts change (ovoice) or an agreement is recorded; each press is one group's agreement and start.
  resource dl = downloadsPage(ovoice, cons.rev) as shape DownloadsView else empty(groups=[], rev=0, voiceReady=false, hearingReady=false, setupTotal="", voiceNote="")
  mutation dlm as shape DownloadsView refreshes dl
  action dlStart(group: string)
    send dlm = downloadsAct("start", group, ovoice, "")
  action dlStartMobile(group: string)
    send dlm = downloadsAct("startMobile", group, ovoice, "")
  // The person chooses one option for one job (kept); nothing is fetched by it.
  // Remove a downloaded model that is not in use (downloads.ts D19).
  action dlRemove(job: string, id: string)
    send dlm = downloadsAct("remove", job, ovoice, id)
  action dlPick(job: string, id: string)
    send dlm = downloadsAct("pick", job, ovoice, id)
