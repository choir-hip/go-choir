// Lane members file (onboarding): first run. Owned by the onboarding lane. The state is the controller's in the module
// (AutoradioModule+Onboarding.swift): setup rows, microphone and hearing checks, the edition topics, the edition. The page reads
// it as one resource, `ob`; every button is a send that answers the same shape.
use onboardingState, onboardingBegin, onboardingRetry, onboardingFallback, onboardingMic, onboardingMicNext, onboardingHearing from "@choir/autoradio"
use onboardingTopics, onboardingTalk, onboardingTopicsDone from "@choir/autoradio"
use onboardingEditionRetry, onboardingEditDone, onboardingEditLeave, onboardingContinueAnyway, onboardingSkip from "@choir/autoradio"
use pageOpen, pageClose from "@choir/autoradio"
use Onboarding from "@choir/autoradio"
use EditionPage from "./edition-types.contract"

members Autoradio
  resource ob = onboardingState() as shape Onboarding else empty()
  mutation obm as shape Onboarding
  // The edition picks and the topic tree are shared code (edition-picks.ts), the one reader and writer of the saved topics. Every pick send repaints the tree and the paper's picks.
  // While the voice listens at this screen (and the page is on top) the page asks again twice a second: that ask takes the words the voice heard, applies them and answers the voice (edition-picks.ts drainHeard).
  state epTick = 0
  resource ep = editionTopics(epTick, ob.talking, signedOutTick) as shape EditionPage else empty()
  mutation epm as shape EditionPage refreshes ep, epicks
  action epBump
    epTick = epTick + 1
  task epPoll when ob.talking and pg.top.startsWith("onboarding:") key=epTick
    after(500, epBump)
  // What the reader has typed in the "Add your own topic" field.
  state obTopicText = ""

  action obBegin
    send obm = onboardingBegin(mobile="false")
  action obBeginMobile
    send obm = onboardingBegin(mobile="true")
  action obRetry(stage: string)
    send obm = onboardingRetry(stage=stage)
  action obFallback(stage: string)
    send obm = onboardingFallback(stage=stage)
  action obMic
    send obm = onboardingMic()
  action obMicNext
    send obm = onboardingMicNext()
  action obHearingYes
    send obm = onboardingHearing(ok="true")
  action obHearingNo
    send obm = onboardingHearing(ok="false")
  action obTopics
    send obm = onboardingTopics()
  action obToggleTopic(label: string)
    send epm = editionToggle(label)
  action obExpandTopic(label: string)
    send epm = editionExpand(label)
  action editObTopic(v: string)
    obTopicText = v
  action obAddTopic
    send epm = editionAdd(obTopicText)
    obTopicText = ""
  action obTalk
    send obm = onboardingTalk()
  action obTopicsDone
    if ep.loaded
      send obm = onboardingTopicsDone(topics=ep.picks)
  action obEditionRetry
    if ep.loaded
      send obm = onboardingEditionRetry(topics=ep.picks)
  action obEditDone
    if ep.loaded
      send obm = onboardingEditDone(topics=ep.picks)
  action obEditLeave
    send obm = onboardingEditLeave()
  action obContinueAnyway
    send obm = onboardingContinueAnyway()
  action obSkip
    send obm = onboardingSkip()
    send pm = pageClose(address="onboarding:setup")
    send pms = pagesClose("onboarding:setup")
  // The edition is a Texture page: open it (the reader draws it).
  action obOpenEdition
    send pm = pageOpen(address="onboarding:edit", title="My edition")
    send pms = pagesOpen("onboarding:edit", "My edition")
    layer = ""
  // Then the front page, and the first story playing.
  action obFinish
    send pm = pageOpen(address="paper:front", title="Paper")
    send pms = pagesOpen("paper:front", "Paper")
    send racct = radioStart()
    layer = ""
