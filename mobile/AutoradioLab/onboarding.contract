// First run: sign in, voice setup, the edition's topics, the edition (plan section 2). Lane 8 owns this file.
//
// Sign-in is the screen the listener-first app already had (SignInScreen), restyled. After it, `OnboardingPage` is ONE page
// (address onboarding:setup) that shows the step the controller is on: voice setup (configuring the voice and audio models:
// download with honest progress, check each model on this phone, fall back), the microphone asked in context with one live
// check, a hearing check, then the edition's topics (chips to tap, a field to type your own, "Talk to it") and the edition. It is a page, so
// it can be left and returned to; the paper stays usable meanwhile. `FirstRunCard` is the card other places show.
//
// The mark: the TetraMark and the alive wait are lane 9's. `ob-mark-slot` and `ob-wait-slot` hold the spine's Mark glyph.
//
// testIds: signin, signin-intro, signin-code, signin-open, signin-cancel, signin-message (unchanged);
//   ob-steps, ob-mark-slot, ob-begin, ob-begin-mobile, ob-skip, ob-row-<stage>, ob-retry-<stage>, ob-fallback-<stage>,
//   ob-summary, ob-mic-ask, ob-mic-level, ob-heard, ob-mic-next, ob-route, ob-hearing-yes, ob-hearing-no, ob-topics-start,
//   ob-topics, ob-explainer, edit-edition, edit-edition-done, edit-edition-link, edit-edition-retry, edit-edition-leave, ob-topic-<label>, ob-topic-open-<label>, ob-trow-<row key>, ob-topic-input, ob-topic-add, ob-selection, ob-talk, ob-topics-done, ob-wait-slot, ob-writing-line,
//   ob-edition-retry, ob-continue-anyway, ob-edition, ob-edition-open, ob-start-radio, firstrun-card, firstrun-open.
use Theme, ChoirAuth, Onboarding from "@choir/autoradio"
use Card, PaperCard, PageScroll, Btn, ListGroup, RowRule, SelectMark, PageHeader, dyn from "./ui.contract"
use Mark from "./mark.contract"
use VoiceStep from "./voice.contract"
use AccountView from "./account-state-types.contract"
use SignInView from "./account-types.contract"
use EditionPage from "./edition-types.contract"
use DownloadCard, DownloadLines from "./downloads.contract"
use LearnCard from "./learn.contract"
use DownloadsView from "./downloads-types.contract"

keyframes obBreathe
  from opacity=1 scale=1
  to opacity=0.35 scale=0.7

keyframes obReveal
  from opacity=0
  to opacity=1

// ---------------------------------------------------------------- sign-in

component SignInScreen
  inject
    th: Theme
    siv: SignInView
    acs: AccountView
    signIn: action
    cancelSignIn: action
    openApproval: action
  view
    column position="absolute" inset=0 padding=24 gap=20 align-items="center" justify-content="center"
      box testId="ob-mark-slot" width=72 height=72 align-items="center" justify-content="center"
        Mark(state="idle")
      column gap=8 align-items="center"
        text "Autoradio" font-size="-exact-large-title" font-weight=700 role="heading" aria-level=2 font-family=th.fontHead color=th.fg
        text "Sign in to hear the paper and talk to your computer." testId="signin-intro" text-align="center" font-size="-exact-body" line-height=1.45 font-family=th.fontText color=th.muted
      if siv.pending
        Card(level=2, testId="signin-card", minHeight=0)
          column padding=20 gap=12 align-items="center"
            text "Your code" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
            text siv.userCode testId="signin-code" font-size="-exact-large-title" font-weight=600 font-family=th.fontMono color=th.fg
            text "Approve this sign-in in the window that opened." font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted text-align="center"
            if siv.note != ""
              text siv.note testId="signin-sheet-note" font-family=th.fontLabel font-size="-exact-footnote" color=th.danger text-align="center"
            // No path is only the sheet: the same link, in the system browser (Exact: an absolute https href leaves the app and opens there), only when the view validated it. The attempt's poll goes on as before.
            if siv.browserLink != ""
              text "Open it in your browser" href=siv.browserLink testId="signin-browser" font-family=th.fontLabel font-size="-exact-subheadline" color=th.fg text-align="center"
            button press=openApproval testId="signin-open" appearance="none"
              Btn(label="Open the approval page", primary=true, wide=false)
            button press=cancelSignIn testId="signin-cancel" appearance="none"
              Btn(label="Cancel", primary=false, wide=false)
      if not siv.pending and acs.action == "signIn"
        button press=signIn testId="signin" appearance="none"
          Btn(label="Sign in", primary=true, wide=true)
      text siv.message testId="signin-message" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="center"

// ---------------------------------------------------------------- the page

component StepDots
  inject
    th: Theme
  props
    n: number
  view
    row testId="ob-steps" gap=6 width="100%" aria-label=`Step ${n} of 4`
      box flex=1 height=3 background-color=(n >= 1 ? th.accent : th.rule)
      box flex=1 height=3 background-color=(n >= 2 ? th.accent : th.rule)
      box flex=1 height=3 background-color=(n >= 3 ? th.accent : th.rule)
      box flex=1 height=3 background-color=(n >= 4 ? th.accent : th.rule)

// One model's row: name in plain words, the model and its size, a real progress bar, the state in words, the numbers measured
// on this phone, and "Try again" / "Use the fallback" where the row stalled or failed.
component SetupRowItem
  inject
    th: Theme
    obRetry: action
    obFallback: action
  props
    stage: string
    name: string
    model: string
    sizeLabel: string
    state: string
    progress: number
    statusLine: string
    numbers: string
    isFallback: bool
    canRetry: bool
    canFallback: bool
    compact: bool
  derive bad = state == "stalled" or state == "failed"
  view
    Card(level=1, testId=`ob-row-${stage}`, minHeight=0)
      column padding=14 gap=8
        row gap=10 align-items="center"
          column flex=1 min-width=0 gap=2
            text name font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg
            text `${model} · ${sizeLabel}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          if state == "ready"
            image "symbol:checkmark" color=(isFallback ? th.muted : th.success)
          if bad
            image "symbol:alert" color=th.danger
          if state == "preparing" and th.reducedMotion == false
            box width=3 height=12 background-color=th.accent animation="obBreathe 900ms ease-in-out infinite alternate"
        if compact == false and state != "ready" and state != "waiting"
          column height=4 background-color=th.rule width="100%"
            box height=4 background-color=(bad ? th.danger : th.accent) width=`${floor(progress * 100)}%`
        text statusLine font-family=th.fontLabel font-size="-exact-footnote" color=(bad ? th.danger : th.fg) line-height=1.35
        if numbers != ""
          text numbers font-family=th.fontLabel font-size="-exact-caption1" color=th.muted font-variant-numeric="tabular-nums"
        if canRetry or canFallback
          row gap=8
            if canRetry
              button press=obRetry(stage) testId=`ob-retry-${stage}` appearance="none"
                Btn(label="Try again", primary=false, wide=false)
            if canFallback
              button press=obFallback(stage) testId=`ob-fallback-${stage}` appearance="none"
                Btn(label="Use the fallback", primary=false, wide=false)

// One line of the topic tree, drawn as a grouped list (design system: ui.contract). A category is a row 52 tall with ONE left edge: the
// disclosure chevron at the leading edge (a 48 by 52 tap target; it opens and closes, it does not select), the name as text, a quiet
// count of what inside is picked, and the selection mark at the trailing edge (the row is the tap target that selects). A subtopic sits
// under its category (48 tall) beside a hairline guide; one that sits under several categories says "also in <the others>" under its name
// and lights up under all of them, because it is one topic. Unpicked rows have muted text and a quiet plus; picked rows have full-strength text,
// an accent check and a faint wash; "partial" (some inside picked) has full-strength text and an accent dash. Only colour and the glyph change on
// a pick: the mark, the row and the text keep their size, so selecting never moves anything. Opening and closing moves what is below, gently (not with Reduce Motion).
component TopicRowItem
  inject
    th: Theme
    obExpandTopic: action
    obToggleTopic: action
  props
    rowId: string
    label: string
    kind: string
    selected: bool
    partial: bool
    expandable: bool
    expanded: bool
    note: string
    first: bool
  derive discLabel = expanded ? `Close ${label}` : `Open ${label}`
  derive pickLabel = partial ? `${label}, some inside picked` : label
  derive markState = selected ? "on" : (partial ? "partial" : "off")
  derive wash = selected ? 0.08 : 0
  derive sub = kind == "sub"
  derive rowH = sub ? 48 : 52
  view
    column width="100%"
      if kind == "yoursHead"
        text "Yours" testId="ob-topics-yours" font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted padding="16px 16px 6px 16px"
      if kind != "yoursHead"
        if first == false
          RowRule(indent=48)
        row align-items="center" width="100%" min-height=rowH position="relative" testId=`ob-trow-${rowId}`
          animation=((sub and th.reducedMotion == false) ? "obReveal 220ms ease-out" : "none")
          box position="absolute" inset=0 pointer-events="none" background-color=th.accent opacity=wash transition=`opacity ${th.motionFastMs}ms ease`
          // the leading column: the chevron of a category that opens, the guide of a subtopic, or nothing
          if kind == "category" and expandable
            button press=obExpandTopic(label) testId=`ob-topic-open-${label}` appearance="none" aria-label=discLabel width=48 height=52
              row width=48 height=52 align-items="center" justify-content="center"
                row width=14 height=14 align-items="center" justify-content="center" rotate=(expanded ? 90 : 0) transition=(th.reducedMotion ? "none" : `rotate ${th.motionFastMs}ms ease`)
                  image "symbol:forward-chevron" color=th.muted
          if kind == "category" and expandable == false
            box width=48 height=rowH
          if kind == "yours"
            box width=16 height=rowH
          if sub
            row width=48 align-self="stretch" justify-content="center"
              box width=1 align-self="stretch" background-color=th.rule
          button press=obToggleTopic(label) testId=`ob-topic-${label}` role="radio" aria-checked=selected aria-label=pickLabel appearance="none" flex=1 min-width=0
            row align-items="center" gap=12 width="100%" box-sizing="border-box" min-height=rowH padding="0px 16px 0px 0px"
              column flex=1 min-width=0 gap=1 align-items="flex-start"
                text label font-family=th.fontHead font-size=dyn((sub ? 16 : 17)) font-weight=(sub ? 400 : 600) color=((selected or partial) ? th.fg : th.muted) text-align="left"
                if sub and note != ""
                  text note font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="left"
              if sub == false and note != ""
                text note font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
              SelectMark(state=markState)

// The topic tree with everything that goes with it: the one line of explanation, the tree, a field to type your own, the selection, "Talk to it".
// The ONE implementation: the first-run topics step and the edit page (Settings, the paper, the launcher) both render this. The picks
// save as they are made; what Continue or Done does is the caller's.
component TopicPicker
  inject
    th: Theme
    ob: Onboarding
    ep: EditionPage
    obTopicText: string
    editObTopic: action
    obAddTopic: action
    obTalk: action
  derive talkLabel = ob.talking ? "Stop talking" : "Talk to it"
  derive addLabel = ob.talking ? `Listening. ${ep.voiceHint}` : ep.voiceHint
  view
    column width="100%" gap=16
      text "Tap a topic to pick it. Open one to see what is inside; a topic that fits under several says “also in”." testId="ob-explainer" font-family=th.fontLabel font-size="-exact-subheadline" line-height=1.4 color=th.muted
      ListGroup(testId="ob-topics")
        for r, i in ep.tree key=r.key
          TopicRowItem(rowId=r.key, label=r.label, kind=r.kind, selected=r.selected, partial=r.partial, expandable=r.expandable, expanded=r.expanded, note=r.note, first=(i == 0))
      row gap=8 align-items="center" width="100%"
        column flex=1 min-width=0
          input value=obTopicText input=editObTopic submit=obAddTopic placeholder="Add your own topic" aria-label="Add your own topic" testId="ob-topic-input" enterkeyhint="done" min-height=44
            font-family=th.fontText font-size=17 color=th.fg padding="8px 0px" border-width=0 background-color="transparent"
            ::placeholder
              color=th.muted
          RowRule(indent=0)
        button press=obAddTopic testId="ob-topic-add" appearance="none" aria-label="Add this topic"
          Btn(label="Add", primary=false, wide=false)
      text ep.selectionLine testId="ob-selection" font-family=th.fontLabel font-size="-exact-subheadline" line-height=1.4 color=th.muted
      button press=obTalk testId="ob-talk" appearance="none" aria-label=talkLabel
        Btn(label=talkLabel, primary=false, wide=true)
      text addLabel font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
      text ep.message font-family=th.fontLabel font-size="-exact-footnote" color=th.danger
      text ob.message font-family=th.fontLabel font-size="-exact-footnote" color=th.danger

// The edit page: the same topic tree, preselected with the saved picks, without the first-run steps. Changes save as they are made;
// Done rewrites the edition through the same completion path as onboarding (deadline, progress, Retry) and returns to where the reader was.
component EditEditionPage
  inject
    th: Theme
    ob: Onboarding
    obEditDone: action
    obEditLeave: action
    obEditionRetry: action
  props
    address: string
    title: string
  derive busy = ob.editing and ob.editionStatus == "writing"
  derive failed = ob.editing and ob.editionStatus == "failed"
  view
    PageScroll(id="edit-edition")
      PageHeader(title="My edition", subtitle="These topics shape the paper. Change them any time.", subId="edit-edition-line")
      if busy
        Card(level=2, testId="edit-edition-writing", minHeight=0)
          column padding=18 gap=8 align-items="center"
            text ob.writingLine testId="edit-edition-progress" font-family=th.fontText font-size="-exact-title3" text-align="center"
            text "This takes a few seconds." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
      if failed
        Card(level=2, testId="edit-edition-failed", minHeight=0)
          column padding=18 gap=10 align-items="center"
            text ob.editionError testId="edit-edition-error" font-family=th.fontText font-size="-exact-body" text-align="center" line-height=1.35
            text "Your topics are saved. The edition stays as it was until this works." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="center"
            button press=obEditionRetry testId="edit-edition-retry" appearance="none"
              Btn(label="Retry", primary=true, wide=true)
            button press=obEditLeave testId="edit-edition-leave" appearance="none"
              Btn(label="Leave it as it was", primary=false, wide=true)
      if busy == false and failed == false
        TopicPicker()
        button press=obEditDone testId="edit-edition-done" appearance="none"
          Btn(label="Done", primary=true, wide=true)

// A small "Edit my edition" control for the places the edition is seen (the front page, Textures). Shown once there is an edition.
component EditEditionLink
  inject
    th: Theme
    ob: Onboarding
    openPage: action
  view
    if ob.editionDone
      button press=openPage("onboarding:edit", "My edition") testId="edit-edition-link" appearance="none" aria-label="Edit my edition" align-self="flex-start"
        row align-items="center" gap=4 min-height=44
          text "Edit my edition" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
          image "symbol:forward-chevron" color=th.accent

component OnboardingPage
  inject
    th: Theme
    au: ChoirAuth
    dl: DownloadsView
    ob: Onboarding
    obBegin: action
    obBeginMobile: action
    obMic: action
    obMicNext: action
    obMicSkip: action
    obHearingYes: action
    obHearingNo: action
    obTopics: action
    obTopicsDone: action
    obEditionRetry: action
    obContinueAnyway: action
    obSkip: action
    obOpenEdition: action
    obFinish: action
  props
    address: string
    title: string
  derive n = ob.step == "mic" ? 2 : (ob.step == "hearing" or ob.step == "learn" or ob.step == "voice") ? 3 : (ob.step == "ready" or ob.step == "topics" or ob.step == "writing" or ob.step == "done") ? 4 : 1
  derive markState = ob.step == "writing" ? "holding" : (ob.step == "topics" and ob.talking) ? "listening" : "idle"
  derive beginLabel = ob.setupStarted ? "Continue voice setup" : "Set up the voice"
  derive deviceLine = ob.device == "" ? "Choosing the models that fit this phone." : `Chosen for this phone: ${ob.device}.`
  derive micLabel = ob.mic == "unasked" ? "Continue" : "Try again"
  derive eyebrow = ob.step == "done" ? "ALL SET" : ob.step == "skipped" ? "WHEN YOU ARE READY" : `STEP ${n} OF 4`
  view
    PageScroll(id="onboarding")
      row gap=14 align-items="center"
        box testId="ob-mark-slot" width=56 height=56 align-items="center" justify-content="center"
          Mark(state=markState)
        column flex=1 min-width=0 gap=2
          text eyebrow font-family=th.fontLabel font-size="-exact-caption1" color=th.accent
          text ob.title role="heading" aria-level=1 font-size="-exact-title1" font-weight=700 line-height=1.1 testId="page-title" font-family=th.fontHead
      StepDots(n=n)

      // ---- welcome (and skipped): what is about to happen, plainly
      // Signed out the first run is only the radio's voice: the one download a listener needs, with its size, its host and one press (downloads.ts); the radio plays the paper meanwhile, in the iPhone's voice.
      if (ob.step == "welcome" or ob.step == "skipped") and au.signedIn == false
        Card(level=1, testId="ob-welcome-voice", minHeight=0)
          column padding=18 gap=12
            text "The radio reads the paper to you. Until its own voice is on this phone it uses the iPhone's built-in voice." font-size="-exact-body" line-height=1.45 font-family=th.fontText
            DownloadCard(group="voice")
            if dl.voiceReady
              text "The radio's voice is on this phone." testId="ob-voice-ready" font-family=th.fontLabel font-size="-exact-footnote" color=th.success
            text "To ask the radio, or to make your edition, sign in or make an account." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        button press=obSkip testId="ob-skip" appearance="none" padding=10
          text "Not now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600
      if (ob.step == "welcome" or ob.step == "skipped") and au.signedIn
        Card(level=1, testId="ob-welcome", minHeight=0)
          column padding=18 gap=12
            text "Autoradio can arrange your paper around what you care about: you pick topics, or just tell it." font-size="-exact-body" line-height=1.45 font-family=th.fontText
            text "First it sets up the voice on this phone: these files, and a check that each one works here." font-size="-exact-callout" line-height=1.45 color=th.muted font-family=th.fontText
            DownloadLines(group="voice")
            DownloadLines(group="voice-rest")
            text `Everything above: ${dl.setupTotal}` testId="ob-welcome-total" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
            button press=obBegin testId="ob-begin" appearance="none"
              Btn(label=beginLabel, primary=true, wide=true)
            if ob.step == "skipped"
              text "You skipped this once. The paper stays as it is until you do it." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        button press=obSkip testId="ob-skip" appearance="none" padding=10
          text "Skip for now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600

      // ---- voice setup: configure the voice and audio models
      if ob.step == "setup"
        if ob.askMobile
          Card(level=2, testId="ob-mobile", minHeight=0)
            column padding=18 gap=10
              text "You are on mobile data." font-weight=600 font-size="-exact-body" font-family=th.fontHead
              text ob.totalLabel font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted
              button press=obBeginMobile testId="ob-begin-mobile" appearance="none"
                Btn(label="Download anyway", primary=true, wide=true)
        if ob.askMobile == false
          text ob.totalLabel font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted testId="ob-total"
          text deviceLine font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          for r in ob.rows key=r.stage
            SetupRowItem(stage=r.stage, name=r.name, model=r.model, sizeLabel=r.sizeLabel, state=r.state, progress=r.progress, statusLine=r.statusLine, numbers=r.numbers, isFallback=r.isFallback, canRetry=r.canRetry, canFallback=r.canFallback, compact=false)
          text "You can leave this page. The paper keeps playing, and setup carries on." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          button press=obSkip testId="ob-skip" appearance="none" padding=10
            text "Skip for now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600

      // ---- the microphone, asked in context, with one live check
      if ob.step == "mic"
        Card(level=1, testId="ob-mic", minHeight=0)
          column padding=18 gap=12
            if ob.mic == "unasked" or ob.mic == "refused" or ob.mic == "silent"
              text "To talk to the radio or record a take, Autoradio 1 needs your microphone and speech recognition." testId="ob-mic-why" font-size="-exact-title3" font-weight=600 line-height=1.35 font-family=th.fontHead
              text "What you say stays on this phone as sound; only the words go to your computer." font-size="-exact-callout" line-height=1.45 color=th.muted font-family=th.fontText
              if ob.mic != "refused"
                button press=obMic testId="ob-mic-ask" appearance="none"
                  Btn(label=micLabel, primary=true, wide=true)
                button press=obMicSkip testId="ob-mic-skip" appearance="none" padding=10
                  text "Not now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600
              if ob.mic == "refused"
                button press=obMicSkip testId="ob-mic-skip" appearance="none" padding=10
                  text "Go on without it" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600
            if ob.mic == "checking"
              text "Say anything." font-size="-exact-title1" font-weight=700 font-family=th.fontHead
              column testId="ob-mic-level" height=6 background-color=th.rule width="100%"
                box height=6 background-color=th.success width=`${floor(ob.level * 100)}%`
              text "Listening…" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
            if ob.mic == "heard"
              row gap=8 align-items="center"
                image "symbol:checkmark" color=th.success
                text "I heard you:" font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted
              text ob.heard testId="ob-heard" font-size="-exact-title2" font-family=th.fontHead line-height=1.3 font-weight=700
              button press=obMicNext testId="ob-mic-next" appearance="none"
                Btn(label="Continue", primary=true, wide=true)
            text ob.message font-family=th.fontLabel font-size="-exact-footnote" color=th.danger
        if ob.setupStarted
          text "The models" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        for r in ob.rows key=r.stage
          SetupRowItem(stage=r.stage, name=r.name, model=r.model, sizeLabel=r.sizeLabel, state=r.state, progress=r.progress, statusLine=r.statusLine, numbers=r.numbers, isFallback=r.isFallback, canRetry=r.canRetry, canFallback=r.canFallback, compact=true)
        button press=obSkip testId="ob-skip" appearance="none" padding=10
          text "Skip for now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600

      // ---- a hearing check on the current output route
      if ob.step == "hearing"
        Card(level=1, testId="ob-hearing", minHeight=0)
          column padding=18 gap=12
            text ob.route testId="ob-route" font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted
            text "Can you hear this?" font-size="-exact-title1" font-weight=700 font-family=th.fontHead
            row gap=10
              button press=obHearingYes testId="ob-hearing-yes" appearance="none"
                Btn(label="Yes, I hear it", primary=true, wide=false)
              button press=obHearingNo testId="ob-hearing-no" appearance="none"
                Btn(label="No", primary=false, wide=false)
            text ob.message font-family=th.fontLabel font-size="-exact-footnote" color=th.danger

      // ---- the person's voice: three sentences read aloud, one more to check (learn.contract, voicelearn.ts)
      if ob.step == "learn"
        LearnCard(flow=true)

      // ---- the voice: tap a voice to hear it, then go on (voice.contract)
      if ob.step == "voice"
        VoiceStep()

      // ---- ready: voice setup is done
      if ob.step == "ready"
        Card(level=1, testId="ob-ready", minHeight=0)
          column padding=18 gap=12
            text "The voice is set up." font-size="-exact-title3" font-weight=600 font-family=th.fontHead
            text "Next, choose what your edition covers. Tap the topics you like, or tell me." font-size="-exact-body" line-height=1.45 font-family=th.fontText
            text "You can change it later, any time." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
            button press=obTopics testId="ob-topics-start" appearance="none"
              Btn(label="Choose your topics", primary=true, wide=true)
            text ob.message font-family=th.fontLabel font-size="-exact-footnote" color=th.danger
        if ob.setupStarted
          text "The models" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="ob-summary"
        for r in ob.rows key=r.stage
          SetupRowItem(stage=r.stage, name=r.name, model=r.model, sizeLabel=r.sizeLabel, state=r.state, progress=r.progress, statusLine=r.statusLine, numbers=r.numbers, isFallback=r.isFallback, canRetry=r.canRetry, canFallback=r.canFallback, compact=true)
        button press=obSkip testId="ob-skip" appearance="none" padding=10
          text "Skip for now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600

      // ---- the edition's topics: tap to select and deselect, type your own, or say it. Any number; none is the general edition.
      if ob.step == "topics"
        TopicPicker()
        button press=obTopicsDone testId="ob-topics-done" appearance="none"
          Btn(label="Continue", primary=true, wide=true)
        button press=obSkip testId="ob-skip" appearance="none" padding=10
          text "Skip for now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600

      // ---- the desk writes the edition: the alive wait (lane 9 owns the mark and the motion)
      if ob.step == "writing"
        Card(level=2, testId="ob-writing", minHeight=0)
          column padding=22 gap=14 align-items="center"
            box testId="ob-wait-slot" width=96 height=96 align-items="center" justify-content="center"
              Mark(state="holding")
            if ob.editionStatus == "writing"
              text ob.writingLine testId="ob-writing-line" font-family=th.fontText font-size="-exact-title3" text-align="center"
              text "This takes a few seconds." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
            if ob.editionStatus == "failed"
              text ob.editionError testId="ob-edition-error" font-family=th.fontText font-size="-exact-title3" text-align="center" line-height=1.35
              text "Your topics are saved. The paper carries on with the general edition meanwhile." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="center"
              button press=obEditionRetry testId="ob-edition-retry" appearance="none"
                Btn(label="Retry", primary=true, wide=true)
              button press=obContinueAnyway testId="ob-continue-anyway" appearance="none"
                Btn(label="Continue anyway", primary=false, wide=true)
        button press=obSkip testId="ob-skip" appearance="none" padding=10
          text "Skip for now" font-family=th.fontAction font-size="-exact-subheadline" color=th.muted font-weight=600

      // ---- the edition, shown; then the front page and a story
      if ob.step == "done"
        button press=obOpenEdition testId="ob-edition-open" appearance="none"
          Btn(label="Open your edition", primary=false, wide=true)
        button press=obFinish testId="ob-start-radio" appearance="none"
          Btn(label="Start the radio", primary=true, wide=true)
        Card(level=2, testId="ob-edition", minHeight=0)
          column padding=20 gap=10
            text ob.editionIntro font-size="-exact-title3" font-weight=600 line-height=1.3 font-family=th.fontHead
            for l, i in ob.editionLines key=i
              text l font-family=th.fontText font-size="-exact-callout" line-height=1.45 color=th.fg

// The card other places show while the edition does not exist: "Make your edition" (Textures place), "Choose your topics",
// "Finish voice setup", or the microphone note. Opens the same page; nothing resumes by itself.
component FirstRunCard
  inject
    th: Theme
    ob: Onboarding
    openPage: action
    obSkip: action
  view
    if ob.card != ""
      // one quiet line, not a card: the action in the accent ("Make your edition", "Choose your topics", "Finish voice setup") and "Not now" beside it. Not now
      // is the saved skip: the line does not come back (the module hides it once the reader has skipped or has an edition).
      row testId="firstrun-card" align-items="center" gap=12 width="100%" box-sizing="border-box" min-height=44
        button press=openPage("onboarding:setup", "Make it yours") testId="firstrun-open" appearance="none" flex=1 min-width=0 aria-label=ob.cardBody
          row align-items="center" gap=4 min-height=44
            text ob.card font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.accent line-clamp=1 text-align="left"
            image "symbol:forward-chevron" color=th.accent
        button press=obSkip testId="firstrun-dismiss" appearance="none" aria-label="Not now"
          row min-height=44 padding="0px 4px" align-items="center"
            text "Not now" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.muted
