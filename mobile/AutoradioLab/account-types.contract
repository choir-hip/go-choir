// The answer of sign-out, which shared code leads (account.ts, `accountSignOut`; app.ts answers it).
shape SignOutResult
  done: bool
  failed: string
  message: string
  // Counts every completed wipe (monotonic): the sources that keep state in memory are asked again when it changes.
  epoch: number

// What the sign-in screen shows of the one attempt (app-signin.ts `view`): the phase (idle, working, done, failed, cancelled), whether the passkey screen is up, what the person was doing (create or signin) and the
// plain words of a failure. Never a key.
shape SignInView
  phase: string
  pending: bool
  mode: string
  message: string
  // The account was found pending deletion by a sign-in: "Cancel deletion" is on offer (never the token).
  offer: bool
  // The machine's count of published changes: the resource is keyed on it so the last change is read.
  rev: number

// The answer of a press (run, cancel, open): the phase the attempt is in.
shape SignInEnd
  phase: string
  rev: number

// What the Delete account screen shows of the one deletion run (account-delete.ts `deleteView`): the phase (idle, working, done, failed, cancelled), whether the passkey screen or the server is being waited on, the plain words of how it
// ended, the date the purge happens once the server accepted, and whether this phone has been signed out. Never a key or an assertion.
shape DeleteView
  phase: string
  pending: bool
  message: string
  purgeOn: string
  signedOut: bool
  rev: number

// The answer of a press (run, open): the phase the run is in.
shape DeleteEnd
  phase: string
  rev: number
