// The answer of sign-out, which shared code leads (account.ts, `accountSignOut`; app.ts answers it).
shape SignOutResult
  done: bool
  failed: string
  message: string
  // Counts every completed wipe (monotonic): the sources that keep state in memory are asked again when it changes.
  epoch: number

// How the system sign-in sheet ended (signin-sheet.ts, `signInSheet`): returned (the page closed it: a hint to wait for the poll, not proof), cancelled (the
// owner closed it: the pending code is abandoned) or failed (it could not open: `message` says so in plain words). Never a key, a code or a URL.
shape SignInSheet
  outcome: string
  message: string
