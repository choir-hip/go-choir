// Files: a feature of the phone, not an app (owner, 2026-11-10). Addresses: `file:/` is the place (your computer's files: folders,
// breadcrumbs, list and grid, sort, search, recent); `file:/path/name.ext` is one file, opened as a page so it sits in the pile
// with everything else. Lane 5 owns this file and viewers.contract; members-files.contract holds the states and actions.
// testIds: files-search, files-mode-browse, files-mode-recent, files-sort-<key>, files-sort-dir, files-view-list, files-view-grid,
// files-crumb-<path>, files-row-<path>, files-more-<path>, files-rename-input, files-rename-go, files-delete-<path>,
// files-new-toggle, files-new-input, files-new-go, files-upload, files-banner, files-list, files-empty; page-title on every page.
use Theme from "@choir/autoradio"
use AccountView from "./account-state-types.contract"
use FileListing, FileInfo, FileRow from "./files-types.contract"
use PageScroll, Card, RowRule, PlainList from "./ui.contract"
use Swap, SkeletonRows, SkeletonBody from "./transitions.contract"
use Chip, ChoiceChip, NoPreview, FileWaiting, ImageViewer, VideoViewer, AudioViewer, CsvViewer from "./viewers.contract"

component FilePage
  inject
    fvInfo: FileInfo
  props
    address: string
    title: string
  derive isFolder = address == "file:" or address.endsWith("/")
  view
    if isFolder
      FilesPlace()
    else if fvInfo.address != address or fvInfo.status == ""
      FileWaiting(address=address, title=title)
    else if fvInfo.status == "notfound" or fvInfo.status == "error" or fvInfo.status == "toolarge"
      NoPreview(address=address, title=title, message=fvInfo.message)
    else if fvInfo.kind == "image"
      ImageViewer()
    else if fvInfo.kind == "video"
      VideoViewer()
    else if fvInfo.kind == "audio"
      AudioViewer()
    else if fvInfo.kind == "pdf" or fvInfo.kind == "epub"
      FileWaiting(address=address, title=title)
    else if fvInfo.kind == "csv"
      CsvViewer()
    else if fvInfo.kind == "markdown" or fvInfo.kind == "text" or fvInfo.kind == "code"
      FileWaiting(address=address, title=title)
    else
      NoPreview(address=address, title=title, message="There is no viewer for this kind of file yet, so it cannot be previewed here.")

// One line of a folder: icon, name and what it is, a button for its actions; the actions open under it.
component RowBody
  inject
    th: Theme
  props
    item: FileRow
  view
    row width="100%" align-items="center" gap=14 padding="10px 0 10px 0" min-height=56
      image item.symbol width=26 height=26 color=(item.isDir ? th.accent : th.muted) flex-shrink=0
      column flex=1 min-width=0 gap=2 align-items="flex-start"
        text item.name font-family=th.fontHead font-size="-exact-body" color=th.fg text-align="left" line-clamp=1 font-weight=600
        text (item.place.length > 0 ? `${item.place} · ${item.detail}` : item.detail) font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="left" line-clamp=1

component FileRowItem
  inject
    th: Theme
    fsSel: string
    fsRenameText: string
    openPage: action
    fsBrowse: action
    fsSelect: action
    fsEditName: action
    fsRename: action
    fsDelete: action
  props
    item: FileRow
    last: bool
  view
    column width="100%"
      row width="100%" align-items="center"
        if item.isDir
          button press=fsBrowse(item.path) testId=`files-row-${item.path}` appearance="none" flex=1 min-width=0
            RowBody(item=item)
        else
          button press=openPage(item.address, item.name) testId=`files-row-${item.path}` appearance="none" flex=1 min-width=0
            RowBody(item=item)
        button press=fsSelect(item.path, item.name) testId=`files-more-${item.path}` aria-label=`Actions for ${item.name}` appearance="none" width=44 height=44 flex-shrink=0
          image "symbol:sf/ellipsis" color=th.muted
      if fsSel == item.path
        column padding="0 0 14px 0" gap=10
          input value=fsRenameText input=fsEditName submit=fsRename placeholder="New name" aria-label="New name" testId="files-rename-input"
            font-family=th.fontText font-size=16 color=th.fg min-height=44 padding="8px 0px" border-width=0 background-color="transparent"
          RowRule(indent=0)
          row gap=8 align-items="center"
            Chip(label="Rename", active=false, testId="files-rename-go", press=fsRename)
            button press=fsDelete(item.path) testId=`files-delete-${item.path}` appearance="none" padding="0px 12px 0px 0px"
              row min-height=44 align-items="center"
                text "Delete" font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.danger
      if not last
        box height=1 margin-left=40 background-color=th.rule opacity=0.35

component FileTile
  inject
    th: Theme
    openPage: action
    fsBrowse: action
  props
    item: FileRow
  view
    if item.isDir
      button press=fsBrowse(item.path) testId=`files-row-${item.path}` appearance="none"
        column padding=14 gap=10 align-items="flex-start" min-height=112 border-radius=th.radiusCard background-color=th.paper2 box-shadow=th.shadow1
          image item.symbol width=34 height=34 color=th.accent
          text item.name font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg text-align="left" line-clamp=2
          text item.detail font-family=th.fontLabel font-size="-exact-caption1" color=th.muted text-align="left" line-clamp=1
    else
      button press=openPage(item.address, item.name) testId=`files-row-${item.path}` appearance="none"
        column padding=14 gap=10 align-items="flex-start" min-height=112 border-radius=th.radiusCard background-color=th.paper2 box-shadow=th.shadow1
          image item.symbol width=34 height=34 color=th.muted
          text item.name font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg text-align="left" line-clamp=2
          text item.detail font-family=th.fontLabel font-size="-exact-caption1" color=th.muted text-align="left" line-clamp=1

// The place itself.
component FilesPlace
  inject
    th: Theme
    acs: AccountView
    fsList: FileListing
    fsMode: string
    fsSort: string
    fsDesc: bool
    fsGrid: bool
    fsDraft: string
    fsNewing: bool
    fsNewName: string
    fsNoteOn: bool
    fsNote: string
    fsBrowse: action
    fsSetMode: action
    fsSortBy: action
    fsFlip: action
    fsSetGrid: action
    fsEditQuery: action
    fsSearch: action
    fsClear: action
    fsNewToggle: action
    fsEditNew: action
    fsMakeFolder: action
    fsUpload: action
    fsPicked: action
  view
    PageScroll(id="files")
      // the title with the two things you can add at its trailing edge, as Mail's New message is
      row align-items="center" gap=4 width="100%"
        text "Files" role="heading" aria-level=1 testId="page-title" font-size="-exact-large-title" font-weight=700 flex=1 min-width=0 font-family=th.fontHead
        // writing needs the owner's computer: no New folder, Add a file or search signed out (the card above the bar is the way in)
        if fsMode == "browse" and acs.state == "signedIn"
          Chip(label="New folder", active=fsNewing, testId="files-new-toggle", press=fsNewToggle)
        if acs.state == "signedIn"
          Chip(label="Add a file", active=false, testId="files-upload", press=fsUpload)
      // Search the names under this folder (a bounded walk); Enter sends it. The field is the system's search field.
      if acs.state == "signedIn"
        input type="search" value=fsDraft input=fsEditQuery submit=fsSearch placeholder="Search files" aria-label="Search files" testId="files-search"
          enterkeyhint="search" font-family=th.fontLabel font-size=17 color=th.fg min-height=48 padding="8px 0px" border-width=0 background-color="transparent"
          ::placeholder
            color=th.muted
      RowRule(indent=0)
      // one row: the two modes (a set) at the left; at the right the sort (tap to change what it sorts by; the arrow turns it round) and the view
      row gap=4 align-items="center" width="100%" testId="files-sorts"
        ChoiceChip(label="Browse", active=(fsMode == "browse"), testId="files-mode-browse", press=fsSetMode("browse"))
        ChoiceChip(label="Recent", active=(fsMode == "recent"), testId="files-mode-recent", press=fsSetMode("recent"))
        box flex=1
        if fsMode == "browse"
          Chip(label=`Sort: ${fsSort == "name" ? "Name" : (fsSort == "modified" ? "Modified" : (fsSort == "size" ? "Size" : "Kind"))}`, active=false, testId="files-sort-cycle", press=fsSortBy(fsSort == "name" ? "modified" : (fsSort == "modified" ? "size" : (fsSort == "size" ? "kind" : "name"))))
          Chip(label=(fsDesc ? "↓" : "↑"), active=false, testId="files-sort-dir", press=fsFlip)
        Chip(label=(fsGrid ? "List" : "Grid"), active=false, testId="files-view-toggle", press=fsSetGrid(fsGrid == false))
      if fsMode == "browse"
        // Breadcrumbs: Files / Documents / ...
        row flex-wrap="wrap" gap=4 align-items="center" width="100%" testId="files-crumbs"
          for c, i in fsList.crumbs key=c.path
            if i > 0
              image "symbol:forward-chevron" width=10 height=10 color=th.muted flex-shrink=0
            button press=fsBrowse(c.path) testId=`files-crumb-${c.path}` appearance="none" padding="6px 6px" flex-shrink=0
              text c.name font-family=(i == fsList.crumbs.length - 1 ? th.fontLabel : th.fontAction) font-size="-exact-subheadline" font-weight=(i == fsList.crumbs.length - 1 ? 400 : 600) color=(i == fsList.crumbs.length - 1 ? th.fg : th.accent)
        if fsNewing
          row gap=8 align-items="center"
            column flex=1 min-width=0
              input value=fsNewName input=fsEditNew submit=fsMakeFolder placeholder="Folder name" aria-label="Folder name" testId="files-new-input"
                min-width=0 font-family=th.fontText font-size=16 color=th.fg min-height=44 padding="8px 0px" border-width=0 background-color="transparent"
              RowRule(indent=0)
            Chip(label="Create", active=true, testId="files-new-go", press=fsMakeFolder)
      if fsList.mode == "search"
        row gap=8 align-items="center"
          text `Results for “${fsList.query}” in ${fsList.title}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="files-search-title" flex=1 min-width=0
          Chip(label="Clear", active=false, testId="files-search-clear", press=fsClear)
      if fsNoteOn and fsNote.length > 0
        Card(level=2, testId="files-banner", minHeight=0)
          text fsNote font-family=th.fontLabel font-size="-exact-footnote" color=th.fg padding="10px 14px" testId="files-banner-text"
      if fsList.status == ""
        SkeletonRows(rows=6, testId="files-skeleton")
      if fsList.status == "error"
        Card(level=1, testId="files-error", minHeight=0)
          text fsList.message font-family=th.fontLabel font-size="-exact-subheadline" color=(acs.state == "signedIn" ? th.danger : th.fg) padding=16
      if fsList.status == "empty"
        text fsList.message font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted testId="files-empty"
      if fsList.status == "ready" and fsGrid == false
        PlainList(testId="files-list")
          column width="100%" padding="4px 0"
            for r, i in fsList.rows key=r.path
              FileRowItem(item=r, last=(i == fsList.rows.length - 1))
      if fsList.status == "ready" and fsGrid
        // Two columns of tiles, even rows left and odd rows right (percent widths in a padded page resolve against the
        // full frame, so the columns share the row by flex instead).
        row gap=12 align-items="flex-start" testId="files-grid"
          column flex=1 min-width=0 gap=12
            for r, i in fsList.rows key=r.path
              if i % 2 == 0
                FileTile(item=r)
          column flex=1 min-width=0 gap=12
            for r, i in fsList.rows key=r.path
              if i % 2 == 1
                FileTile(item=r)
      if fsList.status == "ready"
        text (fsList.count == 1 ? "1 item" : `${fsList.count.toFixed(0)} items`) font-family=th.fontLabel font-size="-exact-caption1" color=th.muted testId="files-count"
      // The system file picker (Add a file) opens this input; its copy lands under app:/tmp/picked.
      input type="file" id="files-pick" change=fsPicked aria-label="Choose a file to add" width=1 height=1 opacity=0
