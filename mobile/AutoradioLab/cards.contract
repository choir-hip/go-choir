// Open pages as cards: the pile (plan section 1, "Open pages are cards"), and today's stories as a stack of cards (section 3).
// Lane 4 owns this file. The pile is a deck with depth: the page in front, older pages offset upward, smaller and dimmer.
//   - Drag the front card (or any card you can reach): it follows the finger, leaning as it goes (rotate = dx * 0.05), springs home
//     if let go early, and a growing mark shows what the drag will do: "Close" to the left, "More of this" to the right (on a story).
//   - Left past 110 pt or 800 pt/s: the card leaves and the page closes (neutral: no ranking effect, unless the gesture meanings
//     in Preferences say otherwise); the Undo pill shows for 5 s. Right on a story: "More on <entity>", the card springs back.
//     Right on any other page: it leans and springs back, nothing else.
//   - Tap: go to that page. Long press (or the "..." button): Pin, More / Less of this, Close.
//   - The stack mode: a story per card in the shaded order; left sets aside, right is more of this, tap opens the story as a page.
// The meanings of the gestures are data (the `Told` shape: left, right); the stack and the pile read them in the module.
// testIds: pile, pile-scrim, pile-places, pile-reopen, pile-mode-pages, pile-mode-stack, card-<address>, card-wrap-<address>,
// card-swipe-<address> (the touch surface: pan, tap, long press), card-close-<address>, card-menu-<address>, card-menu (the sheet),
// menu-pin, menu-more, menu-less, menu-close, stack, stack-swipe-<route>, stack-card-<route>, stack-aside, stack-more, stack-undo,
// stack-restart, stack-all, undo-pill, undo-close, note-toast, stamp-more-<id>, stamp-close-<id>.
use Theme, PageList, CardStoryList, Told, UndoInfo from "@choir/autoradio"
use Card, PaperCard, Btn from "./ui.contract"

fn unit(v: number): number = v > 0 ? min(v, 1) : 0

// A card arriving: it rises into place (and the deck is dealt with a stagger when the pile opens).
keyframes cardIn
  from opacity=0 translate="0px 28px" scale=0.94

keyframes pillIn
  from opacity=0 translate="0px 14px"

// The marks a drag grows: "More of this" appears on the right-hand drag, "Close" on the left-hand drag. They scale and fade with the distance.
component Stamps
  inject
    th: Theme
  props
    tag: string
    moreLabel: string
    closeLabel: string
    moreShow: number
    closeShow: number
  view
    row position="absolute" left=0 right=0 top=(0 - 12) padding-left=16 padding-right=16 justify-content="space-between" pointer-events="none"
      text moreLabel testId=`stamp-more-${tag}` font-family=th.fontUi font-size=14 font-weight=800 letter-spacing=1.5 color=th.accent
        border-width=3 border-style="solid" border-color=th.accent border-radius=8 padding="4px 10px" rotate=-8
        opacity=moreShow scale=(0.8 + 0.25 * moreShow)
      text closeLabel testId=`stamp-close-${tag}` font-family=th.fontUi font-size=14 font-weight=800 letter-spacing=1.5 color=th.muted
        border-width=3 border-style="solid" border-color=th.muted border-radius=8 padding="4px 10px" rotate=8
        opacity=closeShow scale=(0.8 + 0.25 * closeShow)

// An inverse pill (the foreground colour as its ground): the acknowledgement and the Undo.
component NoteToast
  inject
    th: Theme
    told: Told
  view
    if told.note != ""
      column position="absolute" left=0 right=0 top="calc(env(safe-area-inset-top) + 64px)" align-items="center" pointer-events="none" z-index=60
        row testId="note-toast" align-items="center" gap=8 padding="10px 16px" border-radius=th.radiusPill background-color=th.fg box-shadow=th.shadow2
          animation=(th.reducedMotion ? "none" : `pillIn ${th.motionEnterMs}ms ease both`)
          text told.note font-family=th.fontUi font-size=15 font-weight=600 color=th.paper

component UndoPill
  inject
    th: Theme
    und: UndoInfo
    undoClose: action
  view
    if und.open
      column position="absolute" left=0 right=0 bottom="calc(env(safe-area-inset-bottom) + 76px)" align-items="center" pointer-events="none" z-index=60
        row testId="undo-pill" align-items="center" gap=12 padding="6px 6px 6px 16px" border-radius=th.radiusPill background-color=th.fg box-shadow=th.shadow2 pointer-events="auto"
          animation=(th.reducedMotion ? "none" : `pillIn ${th.motionEnterMs}ms ease both`)
          text `Closed ${und.title}` font-family=th.fontUi font-size=15 color=th.paper line-clamp=1 max-width=220
          button press=undoClose testId="undo-close" appearance="none" aria-label="Undo the close"
            text "Undo" font-family=th.fontUi font-size=15 font-weight=700 color=th.onAccent padding="8px 14px" border-radius=th.radiusPill background-color=th.accent

// One page as a card in the deck.
component PileCard
  inject
    th: Theme
    cst: CardStoryList
    dragAddr: string
    dragX: number
    dragY: number
    dragging: bool
    leaving: string
    cardDrag: action
    cardRelease: action
    closeCard: action
    focusPage: action
    openMenu: action
  props
    address: string
    kind: string
    title: string
    pinned: bool
    i: number
  derive mine = dragAddr == address
  derive tx = mine ? dragX : 0
  derive ty = mine ? dragY * 0.2 : 0
  derive rows = cst.rows.filter((s) => s.address == address)
  derive isStory = rows.length > 0
  derive dek = match first(rows) { case some(s) => s.dek, case none => "" }
  derive entityLine = match first(rows) { case some(s) => s.entityLine, case none => "" }
  derive moreShow = (mine and isStory) ? unit(tx / 80) : 0
  derive closeShow = mine ? unit((0 - tx) / 80) : 0
  derive depth = min(i, 5)
  derive held = dragging and mine
  view
    column position="absolute" left="9%" right="9%" height=300 testId=`card-wrap-${address}`
      bottom=`calc(env(safe-area-inset-bottom) + ${96 + depth * 34}px)`
      z-index=(50 - i)
      translate=`${tx}px ${ty}px` rotate=(tx * 0.05)
      scale=((1 - depth * 0.04) * (1 + 0.02 * (moreShow + closeShow)))
      opacity=(leaving == address ? 0 : 1)
      transition=(held ? "none" : `translate -exact-spring(${th.springStiffness}, ${th.springDamping}, ${th.springMass}), rotate -exact-spring(${th.springStiffness}, ${th.springDamping}, ${th.springMass}), scale -exact-spring(${th.springStiffness}, ${th.springDamping}, ${th.springMass}), opacity ${th.motionFastMs}ms ease`)
      animation=(th.reducedMotion ? "none" : `cardIn ${th.motionEnterMs}ms cubic-bezier(.2, .9, .3, 1) ${depth * th.staggerMs}ms both`)
      -exact-layout-transition=`${th.motionEnterMs}ms ease`
      PaperCard(testId=`card-${address}`, minHeight=300)
        column padding=16 gap=6 align-items="flex-start" width="100%" box-sizing="border-box"
          row gap=8 align-items="center"
            text kind font-family=th.fontUi font-size=12 color=th.muted
            if pinned
              text "Pinned" font-family=th.fontUi font-size=12 font-weight=700 color=th.accent
          text title font-family=th.fontRead font-size=22 font-weight=700 color=th.fg text-align="left" line-clamp=3 width="100%" padding-right=8
          if isStory
            text dek font-family=th.fontRead font-size=16 color=th.muted text-align="left" line-clamp=3 width="100%"
            text entityLine font-family=th.fontUi font-size=12 color=th.accent
          text address font-family=th.fontMono font-size=12 color=th.muted
        box position="absolute" top=0 left=0 right=0 bottom=0 border-radius=th.radiusCard background-color=th.scrim opacity=(depth * 0.12) pointer-events="none"
        Stamps(tag=address, moreLabel="MORE OF THIS", closeLabel="CLOSE", moreShow=moreShow, closeShow=closeShow)
        column testId=`card-swipe-${address}` position="absolute" top=0 left=0 right=0 bottom=0 touch-action="none"
          pan=cardDrag(address) panrelease=cardRelease(address, kind) press=focusPage(address) contextmenu=openMenu(address)
          aria-label=`Go to ${title}`
        button press=openMenu(address) testId=`card-menu-${address}` aria-label=`Options for ${title}` appearance="none"
          position="absolute" top=8 right=52 width=44 height=44
          text "…" font-family=th.fontUi font-size=22 color=th.muted
        button press=closeCard(address) testId=`card-close-${address}` aria-label=`Close ${title}` appearance="none"
          position="absolute" top=8 right=8 width=44 height=44
          image "symbol:close" color=th.muted

// A card's long-press menu: pin, more or less of this (a story), close.
component PileMenu
  inject
    th: Theme
    pg: PageList
    cst: CardStoryList
    menuFor: string
    closeMenu: action
    menuPin: action
    menuMore: action
    menuLess: action
    menuClose: action
  derive rows = cst.rows.filter((s) => s.address == menuFor)
  derive isStory = rows.length > 0
  derive why = match first(rows) { case some(s) => s.why, case none => "" }
  derive pinned = pg.rows.filter((p) => p.address == menuFor and p.pinned).length > 0
  view
    column position="absolute" top=0 left=0 right=0 bottom=0 z-index=70
      box testId="menu-scrim" position="absolute" top=0 left=0 right=0 bottom=0 background-color=th.fg opacity=th.behindDim3 press=closeMenu
      column position="absolute" left=16 right=16 bottom="calc(env(safe-area-inset-bottom) + 76px)"
        animation=(th.reducedMotion ? "none" : `pillIn ${th.motionEnterMs}ms ease both`)
        Card(level=3, testId="card-menu", minHeight=0)
          column padding=8 width="100%"
            if isStory
              text why font-family=th.fontUi font-size=13 color=th.muted padding="8px 8px 4px 8px" text-align="left"
            button press=menuPin(menuFor) appearance="none" testId="menu-pin" width="100%"
              row padding="12px 8px" align-items="center" width="100%"
                text (pinned ? "Unpin" : "Pin") font-family=th.fontUi font-size=17 color=th.fg flex=1 text-align="left"
            if isStory
              button press=menuMore(menuFor) appearance="none" testId="menu-more" width="100%"
                row padding="12px 8px" align-items="center" width="100%"
                  text "More of this" font-family=th.fontUi font-size=17 color=th.fg flex=1 text-align="left"
              button press=menuLess(menuFor) appearance="none" testId="menu-less" width="100%"
                row padding="12px 8px" align-items="center" width="100%"
                  text "Less of this" font-family=th.fontUi font-size=17 color=th.fg flex=1 text-align="left"
            button press=menuClose(menuFor) appearance="none" testId="menu-close" width="100%"
              row padding="12px 8px" align-items="center" width="100%"
                text "Close" font-family=th.fontUi font-size=17 color=th.danger flex=1 text-align="left"

// One story as a card in the stack. pos is its place relative to the top: -1 parked off screen where it was thrown, 0 the top,
// 1 the next (peeking under it), 2 hidden behind that. Keyed by route, so a card keeps its node as it rises.
component StackCard
  inject
    th: Theme
    stk: CardStoryList
    sx: number
    sy: number
    sdragging: bool
    sFly: number
    stackDrag: action
    stackRelease: action
    openPage: action
  props
    route: string
    address: string
    title: string
    dek: string
    section: string
    entityLine: string
    lift: number
    n: number
    dir: string
  derive pos = n - stk.index
  derive moving = sdragging or sFly == n
  derive tx = pos == 0 ? (moving ? sx : 0) : (pos == 0 - 1 ? (dir == "left" ? 0 - 560 : (dir == "right" ? 560 : 0)) : 0)
  derive progress = pos == 0 ? unit(max(sx, 0 - sx) / 110) : 0
  derive ty = pos == 0 ? (sdragging ? sy * 0.3 : 0) : (pos == 1 ? 14 * (1 - progress) : (pos == 0 - 1 ? 0 : 14))
  derive tilt = pos == 0 - 1 ? (dir == "left" ? 0 - 14 : (dir == "right" ? 14 : 0)) : tx * 0.05
  derive moreShow = (pos == 0 and sx > 0) ? unit(sx / 80) : 0
  derive asideShow = (pos == 0 and sx < 0) ? unit((0 - sx) / 80) : 0
  derive spring = `-exact-spring(${th.springStiffness}, ${th.springDamping}, ${th.springMass})`
  derive held = pos == 0 and sdragging
  derive shadeNote = lift > 0.01 ? "Lifted for you" : (lift < 0 - 0.01 ? "Dipped for you" : "")
  view
    column position="absolute" left="5%" right="5%" height=430 top="calc(env(safe-area-inset-top) + 72px)" testId=`stack-card-${route}`
      translate=`${tx}px ${ty}px` rotate=tilt scale=(pos <= 0 ? 1 : (pos == 1 ? 0.94 + 0.06 * progress : 0.9)) opacity=(pos == 2 ? 0 : 1)
      z-index=(40 - pos)
      transition=(held ? "none" : (pos == 0 ? `translate ${spring}, rotate ${spring}, scale ${th.motionEnterMs}ms ease-out, opacity ${th.motionFastMs}ms ease-out` : `translate ${th.motionEnterMs}ms cubic-bezier(.2, .8, .2, 1), rotate ${th.motionEnterMs}ms cubic-bezier(.2, .8, .2, 1), scale ${th.motionEnterMs}ms ease-out, opacity ${th.motionFastMs}ms ease-out`))
      PaperCard(testId=`stack-face-${route}`, minHeight=430)
        column padding=22 gap=10 align-items="flex-start" width="100%" box-sizing="border-box"
          text section font-family=th.fontUi font-size=12 font-weight=700 letter-spacing=1.5 color=th.muted
          text title font-family=th.fontRead font-size=30 font-weight=700 color=th.fg text-align="left" line-clamp=5 width="100%"
          text dek font-family=th.fontRead font-size=18 color=th.muted text-align="left" line-clamp=6 width="100%"
          text entityLine font-family=th.fontUi font-size=13 color=th.accent
          text shadeNote font-family=th.fontUi font-size=12 font-weight=700 color=th.accent
        Stamps(tag=route, moreLabel="MORE OF THIS", closeLabel="SET ASIDE", moreShow=moreShow, closeShow=asideShow)
        column testId=`stack-swipe-${route}` position="absolute" top=0 left=0 right=0 bottom=0 touch-action="none"
          pan=stackDrag panrelease=stackRelease(address, n) press=openPage(address, title)
          aria-label=`Open ${title}`

// The stack mode of the pile layer: today's stories as cards in the shaded order.
component StoryStack
  inject
    th: Theme
    stk: CardStoryList
    stackAside: action
    stackMore: action
    stackUndoAct: action
    stackRestart: action
    hideLayer: action
    openPage: action
  derive deck = stk.rows.filter((r) => r.n >= stk.index - 1 and r.n <= stk.index + 2)
  derive done = stk.total > 0 and stk.index >= stk.total
  derive topAddr = match first(stk.rows.filter((r) => r.n == stk.index)) { case some(r) => r.address, case none => "" }
  view
    column testId="stack" position="absolute" top=0 left=0 right=0 bottom=0
      if stk.total == 0
        column position="absolute" top=0 left=0 right=0 bottom=0 align-items="center" justify-content="center" padding=32
          text "No stories yet." font-family=th.fontRead font-size=20 color=th.onScrim
      if done
        column testId="stack-end" position="absolute" top=0 left=0 right=0 bottom=0 align-items="center" justify-content="center" gap=14 padding=32
          text "That is all for now." font-family=th.fontRead font-size=24 font-weight=700 color=th.onScrim
          text `Set aside ${stk.setAside}. They stay on the front page.` font-family=th.fontUi font-size=15 color=th.onScrim
          row gap=10
            button press=stackRestart testId="stack-restart" appearance="none"
              Btn(label="Start over", primary=false, wide=false)
            button press=hideLayer testId="stack-all" appearance="none"
              Btn(label="All stories", primary=false, wide=false)
      for r in deck key=r.route
        StackCard(route=r.route, address=r.address, title=r.title, dek=r.dek, section=r.section, entityLine=r.entityLine, lift=r.lift, n=r.n, dir=r.dir)
      if done == false
        column position="absolute" left=0 right=0 bottom="calc(env(safe-area-inset-bottom) + 132px)" align-items="center" gap=8 z-index=55
          text `${min(stk.index + 1, stk.total)} of ${stk.total}  ·  set aside ${stk.setAside}` font-family=th.fontUi font-size=13 color=th.onScrim testId="stack-count"
          row gap=8
            button press=stackAside(topAddr, stk.index) testId="stack-aside" appearance="none"
              Btn(label="Set aside", primary=false, wide=false)
            button press=stackUndoAct testId="stack-undo" appearance="none"
              Btn(label="Undo", primary=false, wide=false)
            button press=stackMore(topAddr, stk.index) testId="stack-more" appearance="none"
              Btn(label="More of this", primary=false, wide=false)

component Pile
  inject
    th: Theme
    pg: PageList
    pileMode: string
    menuFor: string
    hideLayer: action
    showLayer: action
    undoClose: action
    setPileMode: action
  view
    column testId="pile" position="absolute" top=0 left=0 right=0 bottom=0
      box testId="pile-scrim" position="absolute" top=0 left=0 right=0 bottom=0 background-color=th.scrim press=hideLayer
      row position="absolute" left=20 right=20 top="calc(env(safe-area-inset-top) + 12px)" gap=6 align-items="center" z-index=60
        button press=setPileMode("pages") testId="pile-mode-pages" appearance="none" opacity=(pileMode == "pages" ? 1 : 0.55)
          Btn(label="Pages", primary=false, wide=false)
        button press=setPileMode("stack") testId="pile-mode-stack" appearance="none" opacity=(pileMode == "stack" ? 1 : 0.55)
          Btn(label="Stories", primary=false, wide=false)
        box flex=1
        button press=undoClose testId="pile-reopen" appearance="none"
          Btn(label="Reopen", primary=false, wide=false)
        button press=showLayer("launcher") testId="pile-places" appearance="none"
          Btn(label="Places", primary=false, wide=false)
      if pileMode == "pages"
        for p, i in pg.rows key=p.address
          PileCard(address=p.address, kind=p.kind, title=p.title, pinned=p.pinned, i=i)
      if pileMode == "stack"
        StoryStack()
      NoteToast()
      UndoPill()
      if menuFor != ""
        PileMenu()
