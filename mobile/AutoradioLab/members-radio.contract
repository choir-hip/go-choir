// Lane members file (the Autoradio page): the run sheet made readable, and the gestures on it. Owned by lane autoradio-page.
// Source and send are declared in exact-package/interface/radio.json. The page (radio.contract) only reads `rp` and sends these.
use SettingsAck from "@choir/autoradio"
use RadioPageInfo, RadioPageFacts, RadioTick from "./radio-types.contract"

members Autoradio
  // The page is shared code (radio-page.ts): the native facts (the run sheet as the store holds it, the player, the desk's flags), the bar's facts (a turn open is the bar's state) and the
  // conversation's entries. The facts carry the clock; while the radio plays they are read again (the native side touches them).
  // The on-air entry as shared code holds it (its id, its page's address, and the id and text last handed to the deck) and the deck's place in that text (`ds.place`) make the page's sentence and progress (radio-follow.ts `nowOf`). `rair` is asked again when the deck's item changes as well as on the pulse and the beat, and a page gesture refreshes it with the facts that read it; whatever disagrees (a skip that has reached the sheet and not the deck state, or the other way) lights nothing, because every id is checked on every ask.
  // `rair` is declared in spine.contract (the bar reads it too).
  resource rpfacts = radioPageFacts(rpulse.tick, posKey, ds, rair) as shape RadioPageFacts else empty()
  resource rp = radioPage(rpfacts, bf, cvraw) as shape RadioPageInfo else empty()
  // The gestures stay native until the queue and its posted ops move: the native side carries them out and the page is read again.
  mutation rpm as shape SettingsAck refreshes rpfacts, rair, brun, rp, rpulse
  // The desk's ask and the sheet's post (radio-bridge.ts radioWrite): long fetches, so a mutation that stays until they are done (a resource answer is let go when the next pulse is asked).
  mutation rwm as shape RadioTick
  action writeNow
    send rwm = radioWrite(rpulse.tick)
  task writeKick when rpulse.write key=rpulse.tick
    after(1, writeNow)
  mutation rhm as shape RadioTick
  action holdNow
    send rhm = radioHold(rpulse.tick)
  // The key moves with the clock tick as well: the start waits for the front page or for 2 s, and nothing else may move `rpulse.tick` meanwhile (a plain launch), so a hold still due is sent again each second.
  derive holdKey = `${rpulse.tick}|${radioTick}`
  task holdKick when rpulse.hold key=holdKey
    after(1, holdNow)

  // "All of it" opens Up next to the whole run sheet ahead, in place.
  state radioAll = false
  action radioToggleAll
    radioAll = radioAll == false
  // "Why this" is open for the entry whose title it was opened on; another entry on air closes it by itself.
  state whyFor = ""
  action radioToggleWhy
    whyFor = whyFor == rp.title ? "" : rp.title

  // A Heard row's "Built on" list is open for the entry whose id it was opened on.
  state heardOpen = ""
  action toggleHeardBuilt(id: string)
    heardOpen = heardOpen == id ? "" : id

  // remove | play | replay, arg the entry's id
  action radioDo(op: string, id: string)
    send rpm = radioPageAct(op, id, "")
  // A row dragged to a new place: the entry, and the entry it now sits above (none: the end). One `move` op.
  action radioDrop(item: string, before: option<string>)
    match before
      case some(b)
        send rpm = radioPageAct("reorder", item, b)
      case none
        send rpm = radioPageAct("reorder", item, "")
