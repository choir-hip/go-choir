// Lane members file (the Autoradio page): the run sheet made readable, and the gestures on it. Owned by lane autoradio-page.
// Source and send are declared in exact-package/interface/radio.json. The page (radio.contract) only reads `rp` and sends these.
use radioPageFacts, radioPageAct from "@choir/autoradio"
use RadioPageFacts, SettingsAck from "@choir/autoradio"
use RadioPageInfo from "./radio-types.contract"

members Autoradio
  // The page is shared code (radio-page.ts): the native facts (the run sheet as the store holds it, the player, the desk's flags), the bar's facts (a turn open is the bar's state) and the
  // conversation's entries. The facts carry the clock; while the radio plays they are read again (the native side touches them).
  resource rpfacts = radioPageFacts() as shape RadioPageFacts else empty()
  resource rp = radioPage(rpfacts, bf, cvraw, acctTick) as shape RadioPageInfo else empty()
  // The gestures stay native until the queue and its posted ops move: the native side carries them out and the page is read again.
  mutation rpm as shape SettingsAck refreshes rpfacts, rp

  // "All of it" opens Up next to the whole run sheet ahead, in place.
  state radioAll = false
  action radioToggleAll
    radioAll = radioAll == false
  // "Why this" is open for the entry whose title it was opened on; another entry on air closes it by itself.
  state whyFor = ""
  action radioToggleWhy
    whyFor = whyFor == rp.title ? "" : rp.title

  // A Heard row's "Built on" list is open for the entry whose id it was opened on.
  state heardOpen = ""
  action toggleHeardBuilt(id: string)
    heardOpen = heardOpen == id ? "" : id

  // remove | play | replay, arg the entry's id
  action radioDo(op: string, id: string)
    send rpm = radioPageAct(op=op, arg=id, to="")
  // A row dragged to a new place: the entry, and the entry it now sits above (none: the end). One `move` op.
  action radioDrop(item: string, before: option<string>)
    match before
      case some(b)
        send rpm = radioPageAct(op="reorder", arg=item, to=b)
      case none
        send rpm = radioPageAct(op="reorder", arg=item, to="")
