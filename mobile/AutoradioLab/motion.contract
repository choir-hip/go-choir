// Motion (lane 9): the alive wait. Lane 9 owns this file. Pure Contract; every duration is a
// theme token.
use Theme from "@choir/autoradio"
use MarkAt from "./mark.contract"
use PageScroll, Btn, dyn from "./ui.contract"

keyframes waitrise
  from opacity=0 translate="0px 8px"

// The wait for the desk (about 15 s): the hero mark tumbling, real lifecycle lines beneath it, never a spinner and never
// a percentage. `lines` are the document lifecycle's own sentences so far (the last three show),
// `step` is how many of the four faces the desk's steps have filled (started, reading, writing, checking), `since` is
// when the wait began.
component AliveWait
  inject
    th: Theme
  props
    since: number
    lines: string[]
    step: number
    testId: string
  derive shown = lines.slice(-3)
  derive stp = step
  view
    column testId=testId align-items="center" gap=16 width="100%" padding-top=8 padding-bottom=8
      MarkAt(state="thinking", size=132, since=since, level=0, step=stp, still=false, testId=`${testId}-mark`)
      column align-items="center" gap=6 min-height=84 width="100%"
        for l, i in shown key=l
          row gap=6 align-items="center" justify-content="center"
            animation=`waitrise ${th.motionEnterMs}ms ${th.staggerMs}ms ease-out both`
            if i < shown.length - 1
              image "symbol:checkmark" color=th.muted
            text l testId=(i == shown.length - 1 ? `${testId}-line` : `${testId}-prev-${i}`) font-family=th.fontLabel text-align="center"
              font-size=dyn((i == shown.length - 1 ? 17 : 14)) color=(i == shown.length - 1 ? th.fg : th.muted)
        text `${floor(el)} s` testId=`${testId}-elapsed` font-family=th.fontMono font-size="-exact-caption1" color=th.muted
