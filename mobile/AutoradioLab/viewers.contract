// Viewers (image, video, audio, PDF, e-book, text, table, and an honest "cannot preview") that FilePage in files.contract picks
// between. Lane 5 owns this file. Every viewer is a component that injects what it needs from the root (members-files.contract:
// fvInfo and the fv* states and actions). Themes are data: every colour, face, radius and shadow is a `th` token.
//
// What Exact gives at our pin, measured by building it (see mobile/README.md, "Files and viewers"):
//   image  `image` + `transformDragFor`: pinch and drag, zoom 1x to 4x, clamped to the frame (Exact's own photo viewer pattern)
//   video  `video` with native controls (AVPlayer): scrub, full screen, picture in picture
//   audio  `audio` with native controls and `metadata=` for Now Playing and the lock screen
//   PDF    `iframe` on a local .pdf shows PDFKit's PDFView: its own scrolling and pinch, page set by `#page=N` in src
//   e-book chapters become Markdown for `text markup="markdown"` (no EPUB element in Exact; Kit/Epub.swift parses the book)
use Theme from "@choir/autoradio"
use FileInfo from "./files-types.contract"
use PageScroll, Card, RowRule, PlainList from "./ui.contract"
use SkeletonBody from "./transitions.contract"

// The one control of the Files place and the viewers, drawn as a word (no pill: owner, 2026-11-15): a text action in the accent; when `active` (a
// chosen mode, sort or zoom) it is full strength with a short accent rule under it. `press` is an action call from the caller.
component Chip
  inject
    th: Theme
  props
    label: string
    active: bool
    testId: string
    press: action
  view
    button press=press testId=testId appearance="none" flex-shrink=0 padding="0px 12px 0px 0px"
      column align-items="flex-start" justify-content="center" min-height=44 gap=3
        text label font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=(active ? th.fg : th.accent)
        box width=20 height=2 background-color=(active ? th.accent : "transparent")

// One choice of a set (a zoom, a mode, a page of results): the chosen one full strength with the short accent rule, the others MUTED (the accent is
// for actions, never for a choice not taken). `press` is an action call from the caller.
component ChoiceChip
  inject
    th: Theme
  props
    label: string
    active: bool
    testId: string
    press: action
  view
    button press=press testId=testId appearance="none" flex-shrink=0 padding="0px 12px 0px 0px"
      column align-items="flex-start" justify-content="center" min-height=44 gap=3
        text label font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=(active ? th.fg : th.muted)
        box width=20 height=2 background-color=(active ? th.accent : "transparent")

// The page's heading, scrolling away with nothing: the viewers that fill the screen keep it above their frame.
component ViewerHeader
  inject
    th: Theme
  props
    title: string
    sub: string
  view
    column padding-left=20 padding-right=20 padding-top="calc(env(safe-area-inset-top) + 12px)" padding-bottom=10 gap=2 flex-shrink=0
      text title role="heading" aria-level=1 testId="page-title" font-family=th.fontHead font-size="-exact-title2" font-weight=700 color=th.fg line-clamp=2
      text sub font-family=th.fontLabel font-size="-exact-footnote" color=th.muted line-clamp=1

component FactRow
  inject
    th: Theme
  props
    label: string
    value: string
  view
    row gap=12 align-items="flex-start"
      text label font-family=th.fontLabel font-size="-exact-footnote" color=th.muted width=92 flex-shrink=0
      text value font-family=th.fontLabel font-size="-exact-footnote" color=th.fg flex=1 min-width=0

// ---------------------------------------------------------------- image
component ImageViewer
  inject
    th: Theme
    fvInfo: FileInfo
    fvZoom: number
    fvPanX: number
    fvPanY: number
    fvZoomTo: action
    fvCenter: action
    fvGeometry: action
    fvRelease: action
    fvShare: action
  view
    column flex=1 min-height=0 width="100%" testId="viewer-image"
      ViewerHeader(title=fvInfo.name, sub=`${fvInfo.kindLabel} · ${fvInfo.width.toFixed(0)} × ${fvInfo.height.toFixed(0)} · ${fvInfo.sizeLabel}`)
      row gap=8 padding-left=20 padding-right=20 padding-bottom=10 align-items="center" flex-shrink=0
        ChoiceChip(label="Fit", active=(fvZoom == 1), testId="image-fit", press=fvZoomTo(1))
        ChoiceChip(label="2×", active=(fvZoom == 2), testId="image-2x", press=fvZoomTo(2))
        ChoiceChip(label="4×", active=(fvZoom == 4), testId="image-4x", press=fvZoomTo(4))
        Chip(label="Center", active=false, testId="image-center", press=fvCenter)
        Chip(label="Share", active=false, testId="image-share", press=fvShare(fvInfo.name, fvInfo.src))
      // The frame: it clips the picture (a rounded wrapper), and ends above the bar.
      column flex=1 min-height=0 margin-left=12 margin-right=12 margin-bottom="calc(56px + 8px + env(safe-area-inset-bottom) + 16px)"
        overflow="hidden" border-radius=th.radiusCard background-color=th.paper2 box-shadow=th.shadow1
        // Exact's transform handle needs: the target box 100% x 100%, border-box, no padding, border or margin; its parent
        // overflow hidden with no padding or border (docs/agent-pitfalls.md, "A transformDragFor handle does nothing").
        box testId="image-clip" width="100%" height="100%" position="relative" overflow="hidden" padding=0 border-width=0 box-sizing="border-box"
          box id="viewer-transform" testId="image-transform" width="100%" height="100%" position="relative" padding=0 border-width=0 margin=0 box-sizing="border-box"
            translate=`${fvPanX}px ${fvPanY}px` scale=fvZoom transition=`translate -exact-spring(${th.springStiffness}, ${th.springDamping}, ${th.springMass}), scale -exact-spring(${th.springStiffness}, ${th.springDamping}, ${th.springMass})`
            image fvInfo.src aria-label=fvInfo.name position="absolute" left=0 top=0 width="100%" height="100%" object-fit="contain" testId="image-view"
            box transformDragFor="viewer-transform" transformgeometry=fvGeometry transformrelease=fvRelease touch-action="none" position="absolute" left=0 top=0 width="100%" height="100%" testId="image-handle" aria-label=`Pan and zoom ${fvInfo.name}`

// ---------------------------------------------------------------- video
component VideoViewer
  inject
    th: Theme
    fvInfo: FileInfo
    fvHold: bool
    fvPlayed: action
    fvPausedEv: action
    fvEnded: action
    fvTick: action
    fvMeasured: action
    fvShare: action
  view
    column flex=1 min-height=0 width="100%" testId="viewer-video"
      ViewerHeader(title=fvInfo.name, sub=`${fvInfo.kindLabel} · ${fvInfo.sizeLabel} · ${fvInfo.modifiedLabel}`)
      row gap=8 padding-left=20 padding-right=20 padding-bottom=10 align-items="center" flex-shrink=0
        Chip(label="Share", active=false, testId="video-share", press=fvShare(fvInfo.name, fvInfo.src))
      column flex=1 min-height=0 margin-left=12 margin-right=12 margin-bottom="calc(56px + 8px + env(safe-area-inset-bottom) + 16px)"
        video fvInfo.src id="viewer-video" testId="video-view" aria-label=fvInfo.name controls=true playsinline=true preload="metadata" paused=fvHold
          play=fvPlayed pause=fvPausedEv ended=fvEnded timeupdate=fvTick durationchange=fvMeasured
          width="100%" flex=1 min-height=0 object-fit="contain" overflow="hidden" background-color=th.paper2 border-radius=th.radiusCard box-shadow=th.shadow1

// ---------------------------------------------------------------- audio
// An audio file in Files is played the way everything is played: it is an entry on the run sheet (Play is `place now`, Add to queue is
// `place queued`), heard through the radio's own player with its Now Playing, its scrubber, Keep listening and the lock screen. This page has
// no player of its own.
component AudioViewer
  inject
    th: Theme
    fvInfo: FileInfo
    fvShare: action
    queueFilePlay: action
  view
    column flex=1 min-height=0 width="100%" testId="viewer-audio"
      ViewerHeader(title=fvInfo.name, sub=`${fvInfo.kindLabel} · ${fvInfo.sizeLabel} · ${fvInfo.modifiedLabel}`)
      column padding-left=20 padding-right=20 padding-top=8
        Card(level=2, testId="audio-card", minHeight=0)
          column padding=20 gap=16 align-items="center"
            image "symbol:sf/waveform" width=64 height=64 color=th.accent
            row gap=8 align-items="center" flex-wrap="wrap"
              Chip(label="Play", active=false, testId="audio-play", press=queueFilePlay("now", fvInfo.address, fvInfo.local, fvInfo.name))
              Chip(label="Add to queue", active=false, testId="audio-queue", press=queueFilePlay("add", fvInfo.address, fvInfo.local, fvInfo.name))
              Chip(label="Share", active=false, testId="audio-share", press=fvShare(fvInfo.name, fvInfo.src))

// ---------------------------------------------------------------- table (CSV, TSV)
component CsvViewer
  inject
    th: Theme
    fvInfo: FileInfo
  view
    PageScroll(id="csv")
      text fvInfo.name role="heading" aria-level=1 testId="page-title" font-size="-exact-title1" font-weight=700 font-family=th.fontHead
      text `Table · ${fvInfo.rows.length.toFixed(0)} rows · ${fvInfo.sizeLabel}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
      Card(level=1, testId="csv-card", minHeight=0)
        column width="100%" box-sizing="border-box" testId="csv-scroll"
          column width="100%" padding="4px 0"
            for r, i in fvInfo.rows key=i
              row width="100%" background-color=(i == 0 ? th.paper : "transparent") border-top-left-radius=(i == 0 ? th.radiusCard : 0) border-top-right-radius=(i == 0 ? th.radiusCard : 0)
                for c, j in r.cells key=j
                  text c font-family=th.fontLabel font-size="-exact-footnote" color=th.fg flex=1 min-width=0 padding="8px 10px" line-clamp=2 font-variant-numeric="tabular-nums"

// ---------------------------------------------------------------- nothing to open with, or a problem
// A file that is opening: its real title in the frame, the shape of a page under it, no words.
component FileWaiting
  inject
    th: Theme
  props
    address: string
    title: string
  view
    PageScroll(id="file-waiting")
      text title role="heading" aria-level=1 testId="page-title" font-size="-exact-title1" font-weight=700 font-family=th.fontHead
      SkeletonBody(testId="file-skeleton")

// The honest page: what the file is, and why it is not shown. `message` is the reason ("too large", "not there any more", ...).
component NoPreview
  inject
    th: Theme
    fvInfo: FileInfo
  props
    address: string
    title: string
    message: string
  view
    PageScroll(id="nopreview")
      text (fvInfo.address == address and fvInfo.name.length > 0 ? fvInfo.name : title) role="heading" aria-level=1 testId="page-title" font-size="-exact-title1" font-weight=700 font-family=th.fontHead
      Card(level=1, testId="nopreview-card", minHeight=0)
        column padding=18 gap=14
          row gap=14 align-items="center"
            image (fvInfo.address == address ? "symbol:document" : "symbol:sf/hourglass") width=40 height=40 color=th.muted
            text message testId="nopreview-message" font-family=th.fontLabel font-size="-exact-callout" color=th.fg flex=1 min-width=0
          if fvInfo.address == address and fvInfo.name.length > 0
            FactRow(label="Type", value=fvInfo.kindLabel)
            FactRow(label="Size", value=fvInfo.sizeLabel)
            FactRow(label="Modified", value=fvInfo.modifiedLabel)
            FactRow(label="Location", value=fvInfo.folder)
            FactRow(label="Format", value=fvInfo.mime)
