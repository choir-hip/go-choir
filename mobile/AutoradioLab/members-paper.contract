// Lane members file (paper): the composed front page. The page reads `pfront`; the data and the layout run in app.ts (paper.ts, paper-layout.ts).
// A resource may only live in the root, so it is here, keyed by the VIEW (`paperView`: "front", "mine" or a category id; state, so it outlives the page
// on top and an open article keeps the list of the view it came from), the width the
// page reports, `paperTick` (a pull to refresh: asks the server again) and `paperFocus` (paper, article or away: coming back to the paper from another
// page, the topic screen above all, asks again so My edition is built from the picks as they are now; paper.ts answers from its kept lists).
use EditionPicks from "./edition-types.contract"
use PaperFront from "./paper-types.contract"

members Autoradio
  state paperWidth = 0
  state paperView = "front"
  state paperTick = 0
  derive paperFocus = pg.top.startsWith("paper:") ? "paper" : (pg.top.startsWith("pub:") ? "article" : "away")
  // The reader's saved picks (a topic per line), shared code (edition-picks.ts); asked again when the reader comes back to the paper and when the account changes.
  resource epicks = editionPicks(paperFocus, signedOutTick) as shape EditionPicks else empty()
  // Arguments are positional (named ones belong to a package's sources): view, width, tick, focus, picks.
  // `paperFront` is not a package name: it is answered by app.ts (paper.ts). The page reads the list from the server, keeps the last good one for an offline start,
  // and composes the bands for the width the page reports. It is asked once its arguments have settled (first-open lane): the focus and the picks are arguments only
  // for My edition, which is built from them (every other view passes them empty, so the deck catching up with the page or the picks arriving a moment later asks nothing),
  // and the width is the viewport's until the page has reported its own (so the first composition is at the width the page will have, and the page's report changes nothing when they agree).
  resource pfront = paperFront(paperView, paperWidth > 0 ? paperWidth : vp.width, paperTick, paperView == "mine" ? paperFocus : "", paperView == "mine" ? epicks.picks : "") as shape PaperFront else empty()
  derive paperLoading = pending(pfront)
  action paperReload
    paperTick = paperTick + 1
  // Switch the paper's view. The list the article stack and the player read is the new view's (pfront.routes, PaperCurrentList).
  action pickView(v: string)
    paperView = v
  action paperFit(w: number, h: number)
    paperWidth = w
