// Textures: the listener's documents (a place in the launcher). Lane 3 owns this file.
// The edition is pinned first; "Make your edition" is a card when there is none; the rest are recent, newest first, and a
// search field filters them. A document opens in the reader (`texture:<doc>`). "New document" (top right, beside the title) makes an empty document on the listener's computer and opens it
// (members-reader.contract newDocument); when that fails the words are on the page (textures-new-message), never nothing.
// testIds: page-title, textures-search, textures-edition, textures-make-edition, textures-new, textures-new-message, textures-doc-<address>.
use Theme, Onboarding from "@choir/autoradio"
use TextureList, TextureRow from "./textures-types.contract"
use PageScroll, Card, Btn, RowRule from "./ui.contract"
use SkeletonRows from "./transitions.contract"
use FirstRunCard, EditEditionLink from "./onboarding.contract"

component TextureRowView
  inject
    th: Theme
    openPage: action
  props
    r: TextureRow
    pinned: bool
  view
    button press=openPage(r.address, r.title) testId=`textures-doc-${r.address}` appearance="none" width="100%" margin-bottom=10
      Card(level=(pinned ? 2 : 1), testId=`textures-card-${r.address}`, minHeight=0)
        column padding=16 gap=6 align-items="flex-start" width="100%"
          if pinned
            text "YOUR EDITION" font-family=th.fontLabel font-size="-exact-caption2" font-weight=600 letter-spacing="0.08em" color=th.muted
          text r.title font-family=th.fontHead font-size="-exact-title3" font-weight=600 line-height=1.2 color=th.fg text-align="left"
          text r.meta font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="left"

component TexturesPage
  inject
    th: Theme
    tlist: TextureList
    ob: Onboarding
    openPage: action
    editAsk: action
    newDocument: action
    tnewMessage: string
  props
    address: string
    title: string
  state q = ""
  derive shown = tlist.rows.filter(r => q == "" or r.title.toLowerCase().includes(q.toLowerCase()))
  derive edition = shown.filter(r => r.edition)
  derive others = shown.filter(r => r.edition == false)
  action editQ(v: string)
    q = v
  view
    PageScroll(id="textures")
      row align-items="baseline" justify-content="space-between" width="100%" gap=12
        text "Textures" role="heading" aria-level=1 font-family=th.fontHead font-size="-exact-title1" font-weight=700 testId="page-title" color=th.fg
        button press=newDocument testId="textures-new" appearance="none"
          Btn(label="New document", primary=false, wide=false)
      if tnewMessage != ""
        text tnewMessage testId="textures-new-message" role="alert" font-family=th.fontLabel font-size="-exact-footnote" color=th.danger
      input type="search" value=q input=editQ placeholder="Search your documents" aria-label="Search your documents" testId="textures-search"
        font-family=th.fontText font-size=17 color=th.fg min-height=48 padding="8px 0px" border-width=0 background-color="transparent"
        ::placeholder
          color=th.muted
      RowRule(indent=0)
      // The generic "Make your edition" card is this page's own card below (found with real data: both showed, one under the other).
      if ob.card != "Make your edition"
        FirstRunCard()
      if tlist.status == "loading"
        SkeletonRows(rows=5, testId="textures-skeleton")
      if tlist.status == "error"
        text tlist.message testId="textures-message" font-family=th.fontLabel color=th.muted
      if tlist.status == "ready" and tlist.hasEdition == false and q == ""
        Card(level=2, testId="textures-make-edition-card", minHeight=0)
          column padding=18 gap=8 align-items="flex-start" width="100%" box-sizing="border-box"
            text "YOUR EDITION" font-family=th.fontLabel font-size="-exact-caption2" font-weight=600 letter-spacing="0.08em" color=th.muted
            text "Make your edition" font-family=th.fontHead font-size="-exact-title2" font-weight=700 color=th.fg
            text "A front page written for you each morning from the sources you follow. Say what you want in it." font-family=th.fontText font-size="-exact-callout" line-height=1.45 color=th.muted width="100%"
            button press=editAsk("Make my edition: ") testId="textures-make-edition" appearance="none"
              Btn(label="Make your edition", primary=false, wide=false)
      EditEditionLink()
      for r in edition key=r.address
        TextureRowView(r=r, pinned=true)
      if others.length > 0
        text "Recent" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted margin-top=6
      for r in others key=r.address
        TextureRowView(r=r, pinned=false)
      if tlist.status == "ready" and shown.length == 0 and q != ""
        text "No documents match." font-family=th.fontLabel color=th.muted testId="textures-none"
