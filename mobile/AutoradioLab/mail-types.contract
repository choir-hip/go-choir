// The shapes of the mail pages' data. They are declared here, in Contract, and `app.ts` answers them (mail.ts); the generated app.contract.d.ts gives
// mail.ts its types from these lines, so a field is added in this file and nowhere else. Before mail moved to shared logic these came from the Swift
// package's interface (interface/mail.json). `MailAck` stays with the package: two native sends (ask, open the approval page) answer it.

// The note under a message, chosen in shared code by the LAST action (mail.ts `noteOf`).
shape MailNote
  text: string

shape MailRow
  id: string
  address: string
  sender: string
  subject: string
  snippet: string
  stamp: string
  trust: string
  direction: string
  unread: bool
  hasAttachments: bool
  count: number

shape MailFolderRow
  name: string
  label: string
  address: string
  badge: string
  current: bool

shape MailBoxView
  status: string
  message: string
  folder: string
  title: string
  unread: number
  total: number
  cached: bool
  rows: MailRow[]
  folders: MailFolderRow[]

shape MailBlock
  kind: string
  text: string

shape MailAttachmentRow
  id: string
  filename: string
  size: string
  kind: string
  address: string
  note: string
  available: bool

shape MailThreadRow
  id: string
  address: string
  sender: string
  stamp: string
  snippet: string
  current: bool

shape MailMessageView
  status: string
  message: string
  id: string
  address: string
  subject: string
  sender: string
  fromAddress: string
  toLine: string
  ccLine: string
  date: string
  trust: string
  trustNote: string
  unread: bool
  htmlOnly: bool
  hasOriginal: bool
  hasQuoted: bool
  canReply: bool
  cut: bool
  originalPath: string
  blocks: MailBlock[]
  attachments: MailAttachmentRow[]
  thread: MailThreadRow[]
  replyLabel: string
  spoken: string

shape MailComposeView
  status: string
  forAddress: string
  sendAs: string
  toLine: string
  subject: string
  body: string
  draftId: string
  note: string
  reviewURL: string
  replyTo: string

// What the catch-up answers: counts only (how many messages the phone holds and how many this answer fetched).
shape MailSyncView
  status: string
  held: number
  fetched: number
  note: string
