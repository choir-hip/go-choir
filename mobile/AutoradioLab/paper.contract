// Paper: the front page, composed from data (plan section 3). Lane 2 owns this file.
// The Kit's layout engine (Kit/Layout/*.swift, layout document mobile/layouts/default.json) takes the edition's stories and returns
// placed bands: lead, colead, pair (side by side when it fits, stacked when it does not), cluster ("Developing"), briefs,
// river (by section) and opinion. This file only draws a band by its module; sizes and weights of headlines come with the
// items, faces, colours and depth come from the theme. The page has views (owner QA round 1, 2026-11-15): Front page, My edition, then one per category; `paperView` (state, kept for the session) says which, and
// the article stack reads the answer's routes, so a story swipes through the list of the view it was opened from.
// testIds: page-title, paper-section-front, paper-section-mine, paper-section-<id>, paper-mine-from, paper-edit-edition, paper-choose-topics, paper-mine-note, paper-band-<id>, paper-story-<route>, paper-play-<route>, paper-composition,
// paper-edition-<big|even|thin|default>, paper-status.
use Theme, ChoirAuth, DemoInfo from "@choir/autoradio"
use PaperFront, PaperBand, PaperItem from "./paper-types.contract"
use Card, CardFill, Btn, BarClear, sectionName, SegmentedTrack, SegmentFace, ChoiceWord, Emerge, dyn from "./ui.contract"
use FirstRunCard from "./onboarding.contract"

// The two actions of a story, one form everywhere (a card, a brief, a follow-up): an icon and one short word each on one line, Play in the accent and
// Queue muted (one accent use per row). The full words are the aria labels.
component StoryActions
  inject
    th: Theme
    playStory: action
    queueLater: action
  props
    s: PaperItem
    tall: number
  view
    row gap=12 align-items="center"
      button press=playStory(s.route, s.title) appearance="none" testId=`paper-play-${s.route}` aria-label=`Play from ${s.title}` flex-shrink=0
        row gap=4 align-items="center" min-height=tall
          image "symbol:play-fill" width=14 height=14 color=th.accent
          text "Play" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent line-clamp=1
      button press=queueLater("story", s.route, s.title) appearance="none" testId=`paper-queue-${s.route}` aria-label=`Add ${s.title} to the queue` flex-shrink=0
        row gap=4 align-items="center" min-height=tall
          image "symbol:sf/text.badge.plus" width=16 height=16 color=th.accent
          text "Queue" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent line-clamp=1

// A headline with its dek and meta, as one story. `kicker` shows the section above, `listen` the play-from-here button.
component Story
  inject
    th: Theme
    openPage: action
    playStory: action
    queueLater: action
  props
    s: PaperItem
    kicker: bool
    listen: bool
  view
    column gap=6 align-items="flex-start" width="100%" flex=1
      if kicker
        text sectionName(s.section) font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted
      button press=openPage(`pub:${s.route}`, s.title) appearance="none" testId=`paper-story-${s.route}` width="100%"
        column gap=6 align-items="flex-start" width="100%"
          text s.title font-family=th.fontHead font-size=dyn(s.size) font-weight=s.weight line-height=s.lineHeight color=th.fg text-align="left" text-wrap="balance"
          if s.showDek
            text s.dek font-family=th.fontText font-size=dyn(s.dekSize) line-height=1.4 color=th.muted text-align="left"
      if s.meta != ""
        text s.meta font-family=th.fontLabel font-size="-exact-footnote" font-variant-numeric="tabular-nums" color=th.muted
      if s.entityLabels != ""
        text s.entityLabels font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
      if listen
        box flex=1
        StoryActions(s=s, tall=44)

// A compact row: a small headline, a byline and the story actions under it. Used for briefs, river and opinion.
component BriefRow
  inject
    th: Theme
    openPage: action
    playStory: action
    queueLater: action
  props
    s: PaperItem
    kicker: bool
    first: bool
  view
    column width="100%"
      if first == false
        box height=1 background-color=th.rule width="100%"
      row align-items="center" gap=4 width="100%" padding="10px 0" box-sizing="border-box"
        column flex=1 min-width=0 gap=3 align-items="flex-start"
          if kicker
            text sectionName(s.section) font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted
          button press=openPage(`pub:${s.route}`, s.title) appearance="none" testId=`paper-story-${s.route}` width="100%"
            text s.title font-family=th.fontHead font-size=dyn(s.size) font-weight=s.weight line-height=s.lineHeight color=th.fg text-align="left"
          if s.byline != ""
            text s.byline font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
          StoryActions(s=s, tall=40)

// A cluster follow-up: indented under the lead behind an accent rule.
component FollowRow
  inject
    th: Theme
    openPage: action
    playStory: action
    queueLater: action
  props
    s: PaperItem
  view
    row align-items="center" gap=4 width="100%"
      box width=2 align-self="stretch" background-color=th.accent
      column flex=1 min-width=0 gap=2 align-items="flex-start" padding="8px 0 8px 10px"
        button press=openPage(`pub:${s.route}`, s.title) appearance="none" testId=`paper-story-${s.route}` width="100%"
          text s.title font-family=th.fontHead font-size=dyn(s.size) font-weight=s.weight line-height=s.lineHeight color=th.fg text-align="left"
        if s.entityLabels != ""
          text s.entityLabels font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        StoryActions(s=s, tall=40)

component Band
  inject
    th: Theme
    openPage: action
    pickView: action
  props
    b: PaperBand
  view
    column width="100%" gap=12
      if b.module == "lead"
        Card(level=1, testId=`paper-band-${b.id}`, minHeight=0)
          column padding=16 gap=10 width="100%" box-sizing="border-box"
            for s in b.items key=s.route
              Story(s=s, kicker=true, listen=true)
      if b.module == "colead"
        for s, i in b.items key=s.route
          Card(level=1, testId=`paper-band-${b.id}-${i}`, minHeight=0)
            column padding=16 gap=10 width="100%" box-sizing="border-box"
              Story(s=s, kicker=true, listen=true)
      if b.module == "pair" and b.side
        row gap=12 width="100%" align-items="stretch" testId=`paper-band-${b.id}`
          for s in b.items key=s.route
            column flex=1 min-width=0
              // cards in a row are as tall as the tallest, and each card's actions sit at its bottom, so they are in the same place
              CardFill(level=1, testId=`paper-pair-${s.route}`, minHeight=0)
                column padding=14 gap=8 width="100%" box-sizing="border-box" flex=1
                  Story(s=s, kicker=true, listen=true)
      if b.module == "pair" and b.side == false
        column gap=12 width="100%" testId=`paper-band-${b.id}`
          for s in b.items key=s.route
            Card(level=1, testId=`paper-pair-${s.route}`, minHeight=0)
              column padding=16 gap=8 width="100%" box-sizing="border-box"
                Story(s=s, kicker=true, listen=true)
      if b.module == "cluster"
        Card(level=1, testId=`paper-band-${b.id}`, minHeight=0)
          column padding=16 gap=2 width="100%" box-sizing="border-box"
            text sectionName(b.label) font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted
            for s in b.items key=s.route
              FollowRow(s=s)
      if b.module == "briefs" or b.module == "opinion"
        Card(level=1, testId=`paper-band-${b.id}`, minHeight=0)
          column padding="14px 16px 4px 16px" width="100%" box-sizing="border-box"
            text sectionName(b.label) font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted
            for s, i in b.items key=s.route
              BriefRow(s=s, kicker=(b.module == "briefs"), first=(i == 0))
      if b.module == "river"
        Card(level=1, testId=`paper-band-${b.id}`, minHeight=0)
          column padding="6px 16px 4px 16px" width="100%" box-sizing="border-box"
            button press=pickView(b.id.slice(6)) appearance="none" testId=`paper-more-${b.id.slice(6)}` width="100%"
              row align-items="center" justify-content="space-between" padding="10px 0 2px 0" width="100%" box-sizing="border-box"
                text sectionName(b.label) font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted
                image "symbol:forward-chevron" color=th.muted
            for s, i in b.items key=s.route
              BriefRow(s=s, kicker=false, first=(i == 0))

// One choice of the view switcher. The two main views (Front page, My edition: `segment`) are a pair of words, the chosen one full strength with a
// short accent rule under it; the categories are a plain wrapping line of words, the chosen one ruled the same way (never a sideways scroller: the
// deck takes sideways drags; no capsule, no outline: owner, 2026-11-15). The set does not change when one is picked, only which word is
// full strength, and the rule's space is always there, so a pick never moves or resizes anything.
component ViewChip
  inject
    th: Theme
    paperView: string
    pickView: action
  props
    vid: string
    label: string
    segment: bool
  derive sel = paperView == vid
  view
    if segment
      button press=pickView(vid) appearance="none" testId=`paper-section-${vid}` role="radio" aria-checked=sel flex=1 min-width=0
        SegmentFace(label=label, selected=sel)
    if segment == false
      button press=pickView(vid) appearance="none" testId=`paper-section-${vid}` role="radio" aria-checked=sel flex-shrink=0 align-self="flex-start" padding="0px 12px 0px 0px"
        ChoiceWord(label=label, selected=sel)

component PaperPage
  inject
    th: Theme
    au: ChoirAuth
    dm: DemoInfo
    devDetails: bool
    openPage: action
    pfront: PaperFront
    paperView: string
    paperLoading: bool
    paperReload: action
    paperFit: action
    pickEdition: action
  props
    address: string
    title: string
  // The sections are one line (the current one, and a "Sections" word that opens the rest): ten words wrapped to three rows, and a sideways scroller would
  // fight the deck's swipe (owner ruling), so the rest open and close in place. The one way in is the card above the bar (signedout.contract), not a line here.
  state secOpen = false
  action toggleSections
    secOpen = secOpen == false
  view
    column flex=1 min-height=0 width="100%" resize=paperFit
      scroll id="paper" testId="paper-scroll" overflow-x="hidden" flex=1 min-height=0 width="100%" refresh=paperReload refreshing=paperLoading
        column width="100%" box-sizing="border-box" min-width=0 padding-top="calc(env(safe-area-inset-top) + 12px)" padding-left=20 padding-right=20 gap=14
          font-family=th.fontText color=th.fg
          // the masthead: nameplate, a double rule, the date and when it was last updated
          column gap=6 width="100%"
            row align-items="baseline" justify-content="space-between" width="100%"
              text "AUTOPAPER" font-family=th.fontHead font-size="-exact-large-title" font-weight=700 letter-spacing=-0.3 color=th.fg testId="page-title" role="heading" aria-level=1
              text pfront.dateLine font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="paper-date"
            box height=1 background-color=th.fg width="100%"
            box height=1 background-color=th.fg width="100%" margin-top=2
            row justify-content="space-between" width="100%"
              text ((pfront.viewId == "front" or pfront.viewId == "mine" or pfront.viewLabel == "") ? "" : pfront.viewLabel) font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted testId="paper-section-title"
              text pfront.updated font-family=th.fontLabel font-size="-exact-caption1" color=th.muted testId="paper-updated"
          // the views: Front page and My edition as a segmented pair, then the categories the paper has (its live section list, in house order) as quiet chips
          column gap=10 width="100%"
            SegmentedTrack(testId="paper-views")
              ViewChip(vid="front", label="Front page", segment=true)
              ViewChip(vid="mine", label="My edition", segment=true)
            button press=toggleSections testId="paper-sections-toggle" appearance="none" align-self="flex-start" aria-label=(secOpen ? "Close the sections" : "Open the sections")
              row align-items="center" gap=6 min-height=44
                text ((secOpen or pfront.viewLabel == "" or pfront.viewId == "front" or pfront.viewId == "mine") ? "Sections" : `Sections · ${pfront.viewLabel}`) font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.accent
                row width=12 height=12 align-items="center" justify-content="center" rotate=(secOpen ? 90 : 0) transition=(th.reducedMotion ? "none" : `rotate ${th.motionFastMs}ms ease`)
                  image "symbol:forward-chevron" color=th.accent
            if secOpen
              row flex-wrap="wrap" gap=8 width="100%" testId="paper-sections"
                for sec in pfront.sections key=sec.id
                  ViewChip(vid=sec.id, label=sec.label, segment=false)
          // My edition: what it is built from, and the way to change it (the edit page is `onboarding:edit`, the topic tree with the saved picks preselected; the paper has no other edit link: the owner asked for it in My edition)
          if pfront.viewId == "mine"
            column gap=10 width="100%" align-items="flex-start"
              if pfront.mineFrom != ""
                row align-items="center" gap=10 width="100%" testId="paper-mine-from"
                  column flex=1 min-width=0
                    text `From: ${pfront.mineFrom}` font-family=th.fontLabel font-size="-exact-footnote" line-height=1.35 color=th.muted line-clamp=2 text-align="left"
                  button press=openPage("onboarding:edit", "My edition") appearance="none" testId="paper-edit-edition" aria-label="Edit my edition"
                    flex-shrink=0 padding="10px 4px"
                    text "Edit my edition" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
              if pfront.note != ""
                text pfront.note font-family=th.fontText font-size="-exact-callout" line-height=1.4 color=th.fg text-align="left" testId="paper-mine-note"
              if pfront.mineState == "nopicks"
                button press=openPage("onboarding:edit", "My edition") appearance="none" testId="paper-choose-topics"
                  Btn(label="Choose topics", primary=false, wide=false)
          // Not set up yet: "Make it yours" (voice setup and the edition topics) until the listener has done it or skipped it. Not on My edition: that
          // view already says it in its own paragraph with its own action (two prompts for one thing was one too many).
          // one prompt line at most: the sign-in line first; the edition line once the reader is signed in or has put the sign-in line away
          if pfront.viewId == "front" and au.signedIn
            FirstRunCard()
          // demo mode, Settings, Developer, "Demo controls": three editions to show how the page changes with the day
          if dm.on and devDetails
            column gap=8 width="100%" padding-top=8 box-sizing="border-box"
              text `Composition: ${pfront.composition}` font-family=th.fontMono font-size="-exact-caption2" color=th.muted testId="paper-composition"
              row gap=8 width="100%"
                button press=pickEdition("big") testId="paper-edition-big" appearance="none"
                  Btn(label="Big news", primary=false, wide=false)
                button press=pickEdition("even") testId="paper-edition-even" appearance="none"
                  Btn(label="Even", primary=false, wide=false)
                button press=pickEdition("thin") testId="paper-edition-thin" appearance="none"
                  Btn(label="Thin", primary=false, wide=false)
                button press=pickEdition("") testId="paper-edition-default" appearance="none"
                  Btn(label="Default", primary=false, wide=false)
          // nothing to read, or it failed: a line of plain words and one action
          if pfront.status == "offline" or pfront.status == "error" or pfront.status == "empty"
            column align-items="center" gap=12 width="100%" box-sizing="border-box" padding="24px 16px"
              text pfront.message font-family=th.fontText font-size="-exact-body" line-height=1.4 color=(pfront.status == "error" ? th.danger : th.fg) text-align="center" testId="paper-status"
              if pfront.status != "empty"
                button press=paperReload testId="paper-retry" appearance="none"
                  Btn(label="Try again", primary=false, wide=false)
          for b, bi in pfront.bands key=b.id
            Emerge(delay=((bi > 5 ? 5 : bi) * th.staggerMs))
              Band(b=b)
          if pfront.count > 0
            text `${pfront.count} ${pfront.count == 1 ? "story" : "stories"} · pull down to refresh` font-family=th.fontLabel font-size="-exact-caption1" color=th.muted text-align="center" width="100%"
          BarClear()
