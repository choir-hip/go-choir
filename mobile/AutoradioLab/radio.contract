// The Autoradio page (docs/design/autoradio-page-2026-11-17.md): the app opens here. It is the run sheet made readable: what is on air, what comes
// next, how to talk to it, where to go, what was heard. It replaces the sheet that rose from the bar (that view is deleted); the bar's now-playing
// line comes here. The model is the Kit's (RadioPage.swift); this file only draws it and sends the gestures.
// Type is the Autopaper's: the masthead and its double rule (paper.contract), the headline face for titles, the label face for what describes,
// the action face for what is pressed (mobile/docs/typography.md). No second scale.
// takes testIds: radio-takes, takes-record, takes-stop, takes-elapsed, takes-review, takes-transcript, takes-preview, takes-rerecord, takes-discard, takes-publish, takes-notice, takes-mine-<n>, takes-delete-<n>, takes-muted-<n>, takes-unmute-<n>, radio-take, radio-take-mute, radio-heard-mute-<n>.
// notebook link: radio-notebook. radio-take-start (the Take control beside Next), radio-take-flow (the flow's panel under the on-air section).
// testIds: radio-page, radio-scroll, radio-title, radio-date, radio-status, radio-onair, radio-onair-kind, radio-onair-title, radio-onair-open,
// radio-onair-byline, radio-onair-sentence, radio-onair-sentence-number, radio-greeting, radio-heard-words, radio-cannot, radio-retry, radio-then-back,
// radio-progress, radio-elapsed, radio-remaining, radio-play, radio-next, radio-why, radio-why-text, radio-forecast, radio-back15, radio-fwd15,
// radio-speed, radio-speed-slider, radio-speed-down, radio-speed-up, radio-speed-reset, radio-next-list, radio-next-<n>, radio-next-play-<n>,
// radio-next-grip-<n>, radio-next-all, radio-next-writing, radio-next-empty, radio-notice, radio-builton-<n>, radio-heard-<n>, radio-heard-built-<n>, radio-heard-builton-<n>-<m>.
use Theme, RadioPageInfo, QueueInfo, TakesPageInfo from "@choir/autoradio"
use Btn, SectionHeader, RowRule, BarClear from "./ui.contract"
use AccountView from "./account-state-types.contract"
use PaperFront from "./paper-types.contract"
use QueueAudio, QueueScrub from "./queue.contract"
use tIn, tOut, tLayout, tRiseInOf, tRiseOutOf from "./transitions.contract"

// The take flow, once: recording, the wait, the review (transcript, Re-record, Discard, Publish), the notice and the line after a publish.
// The page draws it directly under the on-air section whenever it has something to show (a take is under way, a notice, a take just published);
// the Takes section at the foot keeps the Record line, the listener's takes, the muted voices and the record.
component TakeFlow
  inject
    th: Theme
    tp: TakesPageInfo
    takesDo: action
  view
    if tp.state == "recording"
      column gap=6 width="100%" testId="takes-recording"
        row justify-content="space-between" width="100%" align-items="baseline"
          text `Recording ${tp.elapsed} of ${tp.limit}` font-family=th.fontLabel font-size="-exact-subheadline" color=th.fg font-variant-numeric="tabular-nums" testId="takes-elapsed"
        box height=2 background-color=th.rule width="100%"
          box height=2 width=`${floor(tp.fraction * 100)}%` background-color=th.accent
        if tp.respondsTo != ""
          text tp.respondsTo font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="takes-responds"
        text "The radio is paused while you record." font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
        button press=takesDo("stop", "") testId="takes-stop" appearance="none" align-self="flex-start" aria-label="Stop recording"
          Btn(label="Stop", primary=false, wide=false)
    if tp.state == "transcribing"
      text "Reading what you said…" font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted testId="takes-wait"
    if tp.state == "review" or tp.state == "publishing"
      column gap=8 width="100%" testId="takes-review"
        if tp.respondsTo != ""
          text tp.respondsTo font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="takes-responds"
        text (tp.transcript != "" ? tp.transcript : "Nothing was recognised.") font-family=th.fontText font-size="-exact-body" line-height=1.4 color=th.fg testId="takes-transcript"
        text `${tp.elapsed} · ${tp.publishLine}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="takes-publish-line"
        text tp.rightsLine font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="takes-rights"
        if tp.state == "review"
          row gap=16 align-items="center" width="100%"
            button press=takesDo("preview", "") testId="takes-preview" appearance="none" aria-label=(tp.previewing ? "Stop playing back" : "Play back")
              Btn(label=(tp.previewing ? "Stop" : "Play back"), primary=false, wide=false)
            button press=takesDo("rerecord", "") testId="takes-rerecord" appearance="none" aria-label="Record it again"
              Btn(label="Re-record", primary=false, wide=false)
            button press=takesDo("discard", "") testId="takes-discard" appearance="none" aria-label="Discard this take"
              Btn(label="Discard", primary=false, wide=false)
          if tp.canPublish
            button press=takesDo("publish", "") testId="takes-publish" appearance="none" align-self="flex-start" aria-label="Publish this take"
              Btn(label="Publish", primary=false, wide=false)
        else
          text "Publishing…" font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted testId="takes-publishing"
    if tp.notice != ""
      text tp.notice font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="takes-notice"
    if tp.justPublished != ""
      text tp.justPublished font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="takes-published"

component RadioPage
  inject
    th: Theme
    rp: RadioPageInfo
    tp: TakesPageInfo
    takesDo: action
    qv: QueueInfo
    radioAll: bool
    whyFor: string
    heardOpen: string
    toggleHeardBuilt: action
    radioPlay: action
    acs: AccountView
    pfront: PaperFront
    noNative: bool
    playPublic: action
    playStory: action
    queueLater: action
    nextStory: action
    queueDo: action
    openPage: action
    radioToggleAll: action
    radioToggleWhy: action
    radioDrop: action
    radioDo: action
    speedShown: number
    speedPct: number
    speedMove: action
    speedEnd: action
    speedNudge: action
    speedReset: action
  props
    address: string
    title: string
  derive shownRows = radioAll ? rp.ahead : rp.ahead.slice(0, 5)
  derive byline = [rp.source, rp.published].filter(s => s != "").join(" · ")
  derive showWhy = rp.canWhy and whyFor == rp.title
  derive isError = rp.state == "error"
  derive playLabel = rp.playing ? "Pause the radio" : "Play the radio"
  view
    column flex=1 min-height=0 width="100%" position="relative" testId="radio-page"
      // an opaque band under the status bar: the page scrolls beneath it, never under the clock
      box position="absolute" top=0 left=0 right=0 height="env(safe-area-inset-top)" background-color=th.paper z-index=5 pointer-events="none" testId="radio-statusbar-band"
      scroll id="radio" testId="radio-scroll" overflow-x="hidden" flex=1 min-height=0 width="100%"
        column width="100%" box-sizing="border-box" min-width=0 padding-top="calc(env(safe-area-inset-top) + 12px)" padding-left=20 padding-right=20 gap=20
          font-family=th.fontText color=th.fg
          // the masthead: the nameplate in the paper's type, a double rule, the date, and one line in plain words
          column gap=6 width="100%"
            row align-items="baseline" justify-content="space-between" width="100%"
              text "AUTORADIO" font-family=th.fontHead font-size="-exact-large-title" font-weight=700 letter-spacing=-0.3 color=th.fg testId="radio-title" role="heading" aria-level=1
              text rp.dateLine font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="radio-date"
            box height=1 background-color=th.fg width="100%"
            box height=1 background-color=th.fg width="100%" margin-top=2
            row align-items="center" gap=8 width="100%"
              text rp.statusLine font-family=th.fontLabel font-size="-exact-subheadline" color=(isError ? th.danger : th.muted) testId="radio-status" line-clamp=3 flex=1 min-width=0
              if rp.action != ""
                button press=radioPlay testId="radio-retry" appearance="none" flex-shrink=0 aria-label=rp.action
                  Btn(label=rp.action, primary=false, wide=false)
          // Signed out the radio still has something to read aloud: the PUBLIC paper's front page (the same list the paper shows: shared code, paper.ts). Play reads the first story and queues the
          // second; each row plays or queues its own. The programme and the voice need the owner's computer (the card above the bar says so, with the one way in). Locked, refused and no-sign-in states offer the public paper too: it is public either way..
          if (acs.state == "signedOut" or acs.state == "locked" or acs.state == "rejected" or acs.state == "noSignIn") and pfront.routes.length > 0
            column gap=10 width="100%" testId="radio-public"
              text "The public paper" font-family=th.fontLabel font-size="-exact-footnote" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted
              // play and the queue are the native player's: a host with no native package lists the stories and opens them (the reader), it has nothing to play them with
              if noNative == false
                button press=playPublic(pfront.routes.slice(0, 1).join(""), pfront.titles.slice(0, 1).join(""), pfront.routes.slice(1, 2).join(""), pfront.titles.slice(1, 2).join("")) testId="radio-play-public" appearance="none" align-self="flex-start" aria-label="Play the public paper"
                  Btn(label="Play the public paper", primary=false, wide=false)
              for t, i in pfront.titles.slice(0, 6) key=i
                row gap=10 width="100%" align-items="center" testId=`radio-public-row-${i}`
                  if noNative
                    button press=openPage(`pub:${pfront.routes.slice(i, i + 1).join("")}`, t) testId=`radio-public-open-${i}` appearance="none" flex=1 min-width=0 aria-label=`Open ${t}`
                      row gap=8 width="100%" align-items="center"
                        text t font-family=th.fontHead font-size="-exact-body" color=th.fg line-clamp=2 text-align="left" flex=1 min-width=0
                        image "symbol:forward-chevron" color=th.muted flex-shrink=0
                  else
                    button press=playStory(pfront.routes.slice(i, i + 1).join(""), t) testId=`radio-public-play-${i}` appearance="none" flex=1 min-width=0 aria-label=`Play ${t}`
                      row gap=8 width="100%" align-items="center"
                        text t font-family=th.fontHead font-size="-exact-body" color=th.fg line-clamp=2 text-align="left" flex=1 min-width=0
                        text "Play" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent flex-shrink=0
                    button press=queueLater("story", pfront.routes.slice(i, i + 1).join(""), t) testId=`radio-public-queue-${i}` appearance="none" flex-shrink=0 aria-label=`Add ${t} to the queue`
                      text "Add" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.muted
          // on air: the largest thing on the page; it dims while the listener speaks
          column gap=14 width="100%" testId="radio-onair" opacity=(rp.dim ? 0.4 : 1) transition=(th.reducedMotion ? "none" : `opacity ${th.motionFastMs}ms ease`)
            if rp.onAir
              for entryKey in [rp.title] key=entryKey
                column gap=8 width="100%" align-items="flex-start" animation=tIn(th.reducedMotion, 0) -exact-exit-animation=tOut(th.reducedMotion, 0)
                  text rp.kindLabel font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 text-transform="uppercase" color=th.muted testId="radio-onair-kind"
                  if rp.openAddress != ""
                    button press=openPage(rp.openAddress, rp.title) testId="radio-onair-open" appearance="none" width="100%" aria-label=`Open ${rp.title}`
                      row gap=8 align-items="center" width="100%"
                        text rp.title font-family=th.fontHead font-size="-exact-title1" font-weight=700 line-height=1.15 color=th.fg text-align="left" text-wrap="balance" flex=1 min-width=0 testId="radio-onair-title" role="heading" aria-level=2
                        image "symbol:forward-chevron" color=th.muted pointer-events="none"
                  else
                    text rp.title font-family=th.fontHead font-size="-exact-title1" font-weight=700 line-height=1.15 color=th.fg text-align="left" text-wrap="balance" testId="radio-onair-title" role="heading" aria-level=2
                  if byline != ""
                    text byline font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="radio-onair-byline"
              // the sentence being spoken, moving as the voice moves
              if rp.sentence != ""
                column gap=6 width="100%"
                  text rp.sentence font-family=th.fontText font-size="-exact-title3" line-height=1.5 color=th.fg line-clamp=4 testId="radio-onair-sentence"
                  text `${rp.sentenceNumber} of ${rp.sentenceCount}` font-family=th.fontLabel font-size="-exact-footnote" font-variant-numeric="tabular-nums" color=th.muted testId="radio-onair-sentence-number"
              if rp.thenBack != ""
                text rp.thenBack font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="radio-then-back"
              // the thin progress line, with time heard and time left (remote audio has its scrubber)
              if qv.audio
                QueueScrub()
              else
                column gap=4 width="100%" testId="radio-progress"
                  box height=2 background-color=th.rule width="100%"
                    box height=2 width=`${floor(rp.fraction * 100)}%` background-color=th.accent
                  if rp.elapsed != ""
                    row justify-content="space-between" width="100%"
                      text rp.elapsed font-family=th.fontLabel font-size="-exact-footnote" font-variant-numeric="tabular-nums" color=th.muted testId="radio-elapsed"
                      text rp.remaining font-family=th.fontLabel font-size="-exact-footnote" font-variant-numeric="tabular-nums" color=th.muted testId="radio-remaining"
            else
              // nothing on air: the greeting with what is lined up, or one plain line
              if rp.greeting != ""
                text rp.greeting font-family=th.fontText font-size="-exact-title3" line-height=1.5 color=th.fg testId="radio-greeting"
              else if rp.state != "error" and rp.state != "writing"
                text "Nothing is on air." font-family=th.fontText font-size="-exact-title3" line-height=1.5 color=th.fg testId="radio-greeting"
            // what the listener said, as it was recognised
            if rp.heardWords != ""
              text rp.heardWords font-family=th.fontText font-size="-exact-body" font-style="italic" color=th.fg line-clamp=3 testId="radio-heard-words"
            // the controls: a large Play or Pause, Next and Take (the Why this button was removed by the owner, 2026-11-18; voice can still ask why)
            row align-items="center" gap=12 width="100%" flex-wrap="wrap"
              if qv.audio
                button press=queueDo("back15", "") testId="radio-back15" appearance="none" aria-label="Back 15 seconds" width=44 height=44
                  row width=44 height=44 align-items="center" justify-content="center" pointer-events="none"
                    image "symbol:skip-back-15" color=th.fg pointer-events="none"
              if rp.canPlay
                button press=radioPlay testId="radio-play" appearance="none" width=64 height=64 aria-label=playLabel
                  row width=64 height=64 align-items="center" justify-content="center" pointer-events="none"
                    if rp.playing
                      image "symbol:pause-fill" width=40 height=40 color=th.accent pointer-events="none"
                    else
                      image "symbol:play-fill" width=40 height=40 color=th.accent pointer-events="none"
              if qv.audio
                button press=queueDo("fwd15", "") testId="radio-fwd15" appearance="none" aria-label="Forward 15 seconds" width=44 height=44
                  row width=44 height=44 align-items="center" justify-content="center" pointer-events="none"
                    image "symbol:skip-forward-15" color=th.fg pointer-events="none"
              if rp.onAir
                button press=nextStory testId="radio-next" appearance="none" aria-label="Next" height=44
                  row min-height=44 padding="0px 4px" align-items="center" gap=6
                    image "symbol:sf/forward.end.fill" color=th.fg pointer-events="none"
                    text "Next" font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.fg
              if tp.state == "idle"
                button press=takesDo("record", "") testId="radio-take-start" appearance="none" aria-label="Record a take"
                  row min-height=44 padding="0px 4px" align-items="center" gap=6
                    image "symbol:sf/mic.fill" color=th.accent pointer-events="none"
                    text "Take" font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.accent
            if showWhy
              column gap=4 width="100%" testId="radio-why-panel"
                if rp.why != ""
                  text rp.why font-family=th.fontText font-size="-exact-callout" line-height=1.4 color=th.fg testId="radio-why-text"
                if rp.forecast != ""
                  text rp.forecast font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="radio-forecast"
            // a take under way (or just done) shows here, under the on-air section, so the listener sees the timer, Stop and the review without scrolling
            if tp.state != "idle" or tp.notice != "" or tp.justPublished != ""
              column gap=8 width="100%" testId="radio-take-flow"
                TakeFlow()
            // a take on air: who made it, what they said (the text the phone read from the recording), and a way to stop hearing them
            if rp.takePublisher != ""
              column gap=6 width="100%" align-items="flex-start" testId="radio-take"
                if rp.takeTranscript != ""
                  text rp.takeTranscript font-family=th.fontText font-size="-exact-callout" line-height=1.4 color=th.fg line-clamp=6 testId="radio-take-transcript"
                if rp.takeRecord != ""
                  text `${rp.takePublisher} · ${rp.takeRecord}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="radio-take-record"
                button press=takesDo("mute", rp.takePublisher) testId="radio-take-mute" appearance="none" aria-label=`Never play takes by ${rp.takePublisher}`
                  Btn(label=`Mute ${rp.takePublisher}`, primary=false, wide=false)
            // the stories this entry was built on: tap one to open its Texture (which shows its own sources). Nothing is drawn for an entry with none.
            if rp.builtOn.length > 0
              column gap=0 width="100%" testId="radio-builton"
                SectionHeader(label="Built on")
                for b in rp.builtOn key=b.address
                  button press=openPage(b.address, b.title) testId=`radio-builton-${b.n}` appearance="none" width="100%" aria-label=`Open ${b.title}`
                    row align-items="center" gap=8 width="100%" min-height=44
                      column flex=1 min-width=0 gap=2 align-items="flex-start"
                        text b.title font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg text-align="left" line-clamp=2
                        if b.role != "" or b.note != ""
                          text (b.role != "" and b.note != "" ? `${b.role} · ${b.note}` : `${b.role}${b.note}`) font-family=th.fontLabel font-size="-exact-caption2" color=th.muted line-clamp=1
                      image "symbol:forward-chevron" color=th.muted pointer-events="none"
            // a clip: keep listening to the episode it is cut from, or open the episode
            QueueAudio()
            // the reading speed, one line: the value, minus, the slider from 0.5x to 3x, plus, and 1x to reset when it is not 1x
            if rp.onAir
              row gap=4 width="100%" align-items="center"
                text "Speed" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted width=44
                text `${speedShown}×` testId="radio-speed" font-family=th.fontLabel font-size="-exact-footnote" color=th.fg width=44 font-variant-numeric="tabular-nums"
                button press=speedNudge(0 - 0.05) testId="radio-speed-down" appearance="none" aria-label="Slower" width=36 height=44
                  row width=36 height=44 align-items="center" justify-content="center" pointer-events="none"
                    text "−" font-family=th.fontAction font-size="-exact-title2" font-weight=600 color=th.fg
                column flex=1 min-width=0 height=44 justify-content="center" pan=speedMove panrelease=speedEnd testId="radio-speed-slider" aria-label="Speed"
                  row width="100%" height=22 align-items="center" padding-left=11 box-sizing="border-box"
                    box width=`${speedPct}%` height=4 background-color=th.accent
                    row width=22 height=22 margin-left=-11 justify-content="center"
                      box width=3 height=22 background-color=th.accent
                    box flex=1 height=4 background-color=th.rule
                button press=speedNudge(0.05) testId="radio-speed-up" appearance="none" aria-label="Faster" width=36 height=44
                  row width=36 height=44 align-items="center" justify-content="center" pointer-events="none"
                    text "+" font-family=th.fontAction font-size="-exact-title2" font-weight=600 color=th.fg
                if speedShown != 1
                  button press=speedReset testId="radio-speed-reset" appearance="none" aria-label="Reset the speed to 1 times" width=32 height=44
                    row width=32 height=44 align-items="center" justify-content="center" pointer-events="none"
                      text "1×" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
                else
                  box width=32 height=44
          // up next: the first five (all of it on request): kind, title, length, and who placed each. Drag the grip to reorder (the list's native reorderdrop, which needs a virtualized list), swipe left to remove (swipeleft: the platform's own delete swipe belongs to a grouped list, which cannot be virtualized), tap to play now.
          column gap=8 width="100%" testId="radio-up-next"
            SectionHeader(label=(rp.ahead.length > 0 ? `Up next · ${rp.ahead.length}` : "Up next"))
            if rp.notice != ""
              text rp.notice font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="radio-notice"
            if rp.ahead.length == 0
              text rp.emptyNote font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted testId="radio-next-empty"
            else
              list id="radio-next" testId="radio-next-list" appearance="none" virtualized=true reorderdrop=radioDrop width="100%" height=(shownRows.length * 64) overflow-x="hidden"
                for r in shownRows key=r.id
                  row testId=`radio-next-${r.n}` -exact-layout-transition=tLayout(th.reducedMotion) -exact-exit-animation=tOut(th.reducedMotion, 0) swipeleft=radioDo("remove", r.id) touch-action="pan-y" height=64 align-items="center" gap=8 width="100%"
                    button press=radioDo("play", r.id) testId=`radio-next-play-${r.n}` appearance="none" flex=1 min-width=0 aria-label=`Play ${r.title} now`
                      column gap=2 align-items="flex-start" width="100%"
                        row gap=6 align-items="baseline"
                          text r.kind font-family=th.fontLabel font-size="-exact-caption2" font-weight=600 letter-spacing=0.8 text-transform="uppercase" color=th.muted
                          text (r.note != "" ? `${r.byWord} · ${r.note}` : r.byWord) font-family=th.fontLabel font-size="-exact-caption2" color=th.muted line-clamp=1
                        row align-items="center" gap=6 width="100%"
                          text r.title font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg text-align="left" line-clamp=1 flex=1 min-width=0
                          image "symbol:forward-chevron" color=th.muted pointer-events="none"
                    text r.length font-family=th.fontLabel font-size="-exact-footnote" font-variant-numeric="tabular-nums" color=th.muted
                    box reorderFor="radio-next" touch-action="none" testId=`radio-next-grip-${r.n}` aria-label=`Drag ${r.title} to reorder` width=44 height=44
                      row width=44 height=44 align-items="center" justify-content="center"
                        image "symbol:sf/line.3.horizontal" color=th.muted
              if rp.aheadMore > 0
                button press=radioToggleAll testId="radio-next-all" appearance="none" align-self="flex-start" aria-label=(radioAll ? "Show fewer" : "Show all of it")
                  row min-height=44 align-items="center"
                    text (radioAll ? "Fewer" : `All of it · ${rp.aheadMore} more`) font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.accent
              if rp.writing
                text "The desk is writing ahead…" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="radio-next-writing"
          // heard: what ended, newest first, with how it ended; tap to hear it again
          if rp.heard.length > 0
            column gap=0 width="100%" testId="radio-heard"
              SectionHeader(label="Heard")
              for h, k in rp.heard key=h.id
                if k > 0
                  RowRule(indent=0)
                button press=radioDo("replay", h.id) testId=`radio-heard-${h.n}` appearance="none" width="100%" animation=tIn(th.reducedMotion, 0) -exact-layout-transition=tLayout(th.reducedMotion) -exact-exit-animation=tOut(th.reducedMotion, 0) aria-label=`Play ${h.title} again`
                  row align-items="center" gap=8 width="100%" min-height=52
                    column flex=1 min-width=0 gap=2 align-items="flex-start"
                      text h.kind font-family=th.fontLabel font-size="-exact-caption2" font-weight=600 letter-spacing=0.8 text-transform="uppercase" color=th.muted
                      text h.title font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg text-align="left" line-clamp=1
                    text h.outcome font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
                    image "symbol:forward-chevron" color=th.muted pointer-events="none"
                if h.publisher != ""
                  button press=takesDo("mute", h.publisher) testId=`radio-heard-mute-${h.n}` appearance="none" align-self="flex-start" aria-label=`Never play takes by ${h.publisher}`
                    Btn(label=`Mute ${h.publisher}`, primary=false, wide=false)
                if h.builtOn.length > 0
                  button press=toggleHeardBuilt(h.id) testId=`radio-heard-built-${h.n}` appearance="none" -exact-layout-transition=tLayout(th.reducedMotion) align-self="flex-start" aria-label=(heardOpen == h.id ? "Hide the stories it was built on" : "Show the stories it was built on")
                    row min-height=44 align-items="center"
                      text (heardOpen == h.id ? "Hide built on" : "Built on") font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
                  if heardOpen == h.id
                    for b in h.builtOn key=b.address
                      button press=openPage(b.address, b.title) testId=`radio-heard-builton-${h.n}-${b.n}` appearance="none" width="100%" animation=tRiseInOf(th.reducedMotion) -exact-exit-animation=tRiseOutOf(th.reducedMotion) -exact-layout-transition=tLayout(th.reducedMotion) aria-label=`Open ${b.title}`
                        row align-items="center" gap=8 width="100%" min-height=44
                          text b.title font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg text-align="left" line-clamp=2 flex=1 min-width=0
                          image "symbol:forward-chevron" color=th.muted pointer-events="none"
          // my notebook: what Autoradio has been told and has learned about you (station L6)
          button press=openPage("notebook:", "My notebook") testId="radio-notebook" appearance="none" width="100%" aria-label="Open my notebook"
            row align-items="center" gap=8 width="100%" min-height=48
              column flex=1 min-width=0 gap=2 align-items="flex-start"
                Btn(label="My notebook", primary=false, wide=false)
                text "What Autoradio has learned about you, and the scorecard" font-family=th.fontLabel font-size="-exact-caption2" color=th.muted text-align="left"
              image "symbol:forward-chevron" color=th.muted pointer-events="none"
          // takes: your own voice, offered to other listeners (design 11). Record, review, publish; your takes; the voices you muted; your record.
          column gap=8 width="100%" testId="radio-takes"
            SectionHeader(label="Takes")
            if tp.state == "idle"
              button press=takesDo("record", "") testId="takes-record" appearance="none" align-self="flex-start" aria-label="Record a take"
                Btn(label="Record a take", primary=false, wide=false)
            if tp.record != ""
              text `Your record: ${tp.record}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted testId="takes-record-line"
            if tp.mine.length > 0
              column gap=0 width="100%" testId="takes-mine"
                for t, k in tp.mine key=t.id
                  if k > 0
                    RowRule(indent=0)
                  row align-items="center" gap=8 width="100%" min-height=52 testId=`takes-mine-${k}`
                    column flex=1 min-width=0 gap=2 align-items="flex-start"
                      text t.title font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg text-align="left" line-clamp=1
                      text `${t.state} · ${t.length}` font-family=th.fontLabel font-size="-exact-caption2" color=th.muted
                    button press=takesDo("delete", t.id) testId=`takes-delete-${k}` appearance="none" aria-label=`Delete ${t.title}`
                      Btn(label="Delete", primary=false, wide=false)
            if tp.muted.length > 0
              column gap=0 width="100%" testId="takes-muted"
                SectionHeader(label="Muted voices")
                for m, k in tp.muted key=m.handle
                  row align-items="center" gap=8 width="100%" min-height=44 testId=`takes-muted-${k}`
                    text m.line font-family=th.fontLabel font-size="-exact-footnote" color=th.muted flex=1 min-width=0
                    button press=takesDo("unmute", m.handle) testId=`takes-unmute-${k}` appearance="none" aria-label=`Hear ${m.handle} again`
                      Btn(label="Undo", primary=false, wide=false)
          BarClear()
