// The bar (round 3, owner rulings 21 and 22): a glass lens at the bottom of the screen, always visible and usable on every page, in
// onboarding and with the launcher or the player open. It is not a floating capsule: it spans the full width, overlaps the page
// (which scrolls full bleed underneath and shows through the glass), covers the bottom safe area and runs off the bottom edge;
// only its top corners are rounded. With the keyboard up it rides on top of the keyboard (`interactive-widget` on the root).
//
// Explicit controls, no hidden gestures (no hold, no drag):
//   the mark       tap opens and closes the launcher (the web's button). One job.
//   the field      "Ask about this page...", aimed at the page in front (its address goes with the turn).
//   the microphone tap to start talking, tap again to send (the lens says "Listening" plainly while it is open).
//   play / pause   the radio; when nothing is loaded it starts the edition.
// A line above the controls says what is going on: what is loaded when something plays or is paused (tap: the player), the
// words as heard, the holding line, a revision, an error, the setup state, or the aim while typing. A quiet count
// ("Story · 7 in the deck") sits just above the lens. The launcher and the player rise from the lens, as sheets
// above it, so the bar stays visible and usable under them.
// testIds: bar-stack, bar, bar-mark, bar-field, bar-mic, bar-send, bar-play, bar-text, bar-aim, bar-setup, bar-yield, bar-progress,
// page-indicator.
use Theme, PageList, BarInfo, RadioInfo, ReaderAimInfo, Onboarding, MailMessageView from "@choir/autoradio"
use Mark from "./mark.contract"
use Launcher from "./launcher.contract"
use PlayerLayer from "./player.contract"
use StackVp from "./ui.contract"

keyframes barRise
  from opacity=0 translate="0px 6px"
keyframes barPulse
  50% scale=1.16 opacity=0.5
keyframes barSpin
  from rotate="0deg"
  to rotate="360deg"
keyframes barBlink
  50% opacity=0.25
keyframes sheetUp
  from opacity=0 translate="0px 40px"

// A control of the row: a glyph above a one-word caption, so each says what it will do.
component BarGlyph
  inject
    th: Theme
  props
    glyph: string
    caption: string
    on: bool
  view
    column align-items="center" justify-content="center" gap=1 width=52 height=48
      row width=34 height=28 border-radius=14 align-items="center" justify-content="center"
        background-color=(on ? th.accent : "transparent")
        if glyph == "mic"
          image "symbol:microphone" color=(on ? th.onAccent : th.fg)
        if glyph == "stop"
          image "symbol:stop-fill" color=(on ? th.onAccent : th.fg)
        if glyph == "play"
          image "symbol:play-fill" color=(on ? th.onAccent : th.fg)
        if glyph == "pause"
          image "symbol:pause-fill" color=(on ? th.onAccent : th.fg)
        if glyph == "send"
          image "symbol:send" color=(on ? th.onAccent : th.fg)
      text caption font-family=th.fontUi font-size=10 font-weight=600 color=(on ? th.accent : th.muted)

component BarShell
  inject
    th: Theme
    pg: PageList
    bi: BarInfo
    ri: RadioInfo
    raim: ReaderAimInfo
    ob: Onboarding
    mmsg: MailMessageView
    vp: StackVp
    layer: string
    typing: bool
    ask: string
    micOn: bool
    onbd: bool
    topAddr: string
    moreFor: string
    moreOfThis: action
    stackCount: number
    frontName: string
    frontKind: string
    editAsk: action
    sendAsk: action
    micTap: action
    micCancel: action
    radioPlay: action
    toggleLauncher: action
    showLayer: action
    hideLayer: action
    barFocus: action
    barBlur: action
  derive st = bi.state
  // What the field says it is aimed at: the page in front (owner, 2026-11-11). Before setup the invitation is the first-run card on
  // Paper's; the bar still asks.
  derive aimMail = (topAddr.startsWith("mail:") and mmsg.replyLabel != "") ? `${mmsg.replyLabel}…` : "Reply to this message…"
  derive aimPage = topAddr.startsWith("paper:") ? "Ask about today's paper…" : (topAddr.startsWith("pub:") ? "Ask about this story…" : (topAddr.startsWith("texture:") ? "Ask about this Texture…" : (topAddr.startsWith("mail:") ? aimMail : ((topAddr.startsWith("file:") and topAddr != "file:/") ? "Ask about this file…" : "Ask or tell Choir…"))))
  derive aim = (raim.address == pg.top and raim.blockId != "") ? `Ask about “${raim.label}”…` : aimPage
  derive onSetup = pg.top == "onboarding:setup"
  derive setupLine = ob.step == "interview" ? (ob.paused ? "Interview paused" : ((st == "listening" or st == "talking" or st == "heard") ? "Interview: listening…" : "Interview: speaking…")) : (ob.step == "setup" ? "Setting up the voice…" : (ob.step == "mic" ? "Check the microphone" : (ob.step == "hearing" ? "Check that you can hear me" : (ob.step == "ready" ? "Voice is set up" : (ob.step == "writing" ? "Writing your edition…" : (ob.step == "done" ? "Your edition is ready" : "Voice setup"))))))
  // What the line above the controls shows.
  derive lineMode = micOn ? "listen" : (st == "heard" ? "heard" : (st == "holding" ? "holding" : (st == "revised" ? "revised" : (st == "error" ? "error" : (st == "playing" ? "playing" : (st == "paused" ? "paused" : (onSetup ? "setup" : (typing ? "aim" : "none"))))))))
  derive loaded = ri.title != "" ? ri.title : bi.text
  derive yielded = ri.level != "play" and micOn
  derive tint = st == "error" ? th.danger : (st == "revised" ? th.success : (st == "playing" ? th.accent2 : th.accent))
  derive tintOn = (lineMode == "none" or lineMode == "aim" or lineMode == "paused" or lineMode == "listen") ? 0 : (st == "playing" ? 0.08 : 0.12)
  derive markState = micOn ? "listening" : (st == "paused" ? "idle" : st)
  derive isPlaying = ri.playing or st == "playing"
  derive playWord = isPlaying ? "Pause" : "Play"
  derive playLabel = isPlaying ? "Pause the radio" : (st == "paused" ? "Resume the radio" : "Play the edition")
  derive still = th.reducedMotion
  derive calm = still ? 0 : 1
  derive enter = still ? "none" : "barRise 220ms ease-out both"
  derive panelH = vp.height * 0.62
  view
    column testId="bar-stack" position="absolute" left=0 right=0 bottom=0 z-index=20
      // the launcher and the player rise from the lens; the lens stays under them, visible and usable
      if layer == "launcher"
        column testId="launcher" width="100%" height=panelH animation=(still ? "none" : "sheetUp 260ms ease-out both")
          Launcher()
      if layer == "player"
        column testId="player" width="100%" height=panelH animation=(still ? "none" : "sheetUp 260ms ease-out both")
          PlayerLayer()
      // the lens: glass over the page, full width, top corners rounded, running off the bottom edge
      column testId="bar" position="relative" width="100%" box-sizing="border-box" gap=4
        padding-top=8 padding-left=12 padding-right=12 padding-bottom="calc(env(safe-area-inset-bottom) + 6px)"
        border-top-left-radius=th.radiusCard border-top-right-radius=th.radiusCard
        backgroundMaterial=(th.material2 == "glass" ? "glass" : "none")
        background-color=(th.material2 == "glass" ? "transparent" : th.paper)
        box-shadow=th.shadow3
        // a light wash of the page colour inside the glass, so the controls stay legible over busy content in light and dark (the lens itself
        // is Exact's glass material: a blurred, translucent view of the page passing under it)
        box position="absolute" inset=0 pointer-events="none" z-index=-1 border-top-left-radius=th.radiusCard border-top-right-radius=th.radiusCard
          background-color=th.paper opacity=(th.barBacking * 0.3)
        // the state's tint
        box position="absolute" inset=0 pointer-events="none" border-top-left-radius=th.radiusCard border-top-right-radius=th.radiusCard
          background-color=tint opacity=tintOn
          transition=`opacity ${th.motionFastMs * calm}ms ease, background-color ${th.motionFastMs * calm}ms ease`
        // the top edge: a hairline and a soft highlight, the lip of the glass
        box position="absolute" left=0 right=0 top=0 height=1 pointer-events="none" background-color=th.rule opacity=0.22
          border-top-left-radius=th.radiusCard border-top-right-radius=th.radiusCard
        box position="absolute" left=0 right=0 top=1 height=14 pointer-events="none" border-top-left-radius=th.radiusCard border-top-right-radius=th.radiusCard
          background-image="linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0))"
        // the deck's quiet count: where you are, in a hairline of text at the top of the lens (not over the page)
        if onbd == false and layer == ""
          row width="100%" align-items="center" justify-content="space-between" gap=8
            text `${frontKind} · ${stackCount} in the deck` testId="page-indicator" aria-label=`${frontKind}, ${stackCount} pages in the deck` font-family=th.fontUi font-size=10 font-weight=600 letter-spacing=0.4 color=th.muted
            if topAddr.startsWith("pub:")
              button press=moreOfThis(topAddr) testId="story-more" appearance="none" aria-label="More stories like this one"
                row padding="3px 10px" border-radius=th.radiusPill border-width=1 border-style="solid" border-color=th.rule align-items="center"
                  text (moreFor == topAddr ? "Noted" : "More of this") font-family=th.fontUi font-size=12 font-weight=600 color=th.fg
        // ---- the line above the controls
        if lineMode == "aim"
          text aim testId="bar-aim" font-family=th.fontUi font-size=11 color=th.muted line-clamp=1 padding-left=4 animation=enter
        if lineMode == "setup"
          text setupLine testId="bar-setup" font-family=th.fontUi font-size=14 font-weight=600 color=th.fg line-clamp=1 padding-left=4 animation=enter
        if lineMode == "playing" or lineMode == "paused"
          column gap=4 animation=enter
            button press=showLayer("player") testId="bar-text" appearance="none" width="100%" aria-label=`${lineMode == "playing" ? "Now playing" : "Paused"}, ${loaded}. Open the player`
              row gap=8 align-items="center" width="100%" padding-left=4 min-height=30
                if lineMode == "playing"
                  image "symbol:waveform" color=th.accent
                if lineMode == "paused"
                  image "symbol:pause" color=th.accent
                column flex=1 min-width=0 gap=1 align-items="flex-start"
                  text (lineMode == "playing" ? "NOW PLAYING" : "PAUSED") font-family=th.fontUi font-size=9 font-weight=700 letter-spacing=0.8 color=th.muted
                  text loaded font-family=th.fontUi font-size=14 font-weight=600 color=th.fg line-clamp=1 text-align="left"
                image "symbol:forward-chevron" color=th.muted
            box testId="bar-progress" height=2 border-radius=1 background-color=th.rule opacity=(ri.level == "play" ? 1 : 0.4) transition=`opacity ${th.motionFastMs}ms ease`
              box height=2 border-radius=1 width=`${floor(bi.progress * 100)}%` background-color=th.accent
        if lineMode == "listen"
          column gap=3 animation=enter padding-left=4
            if yielded
              row gap=5 align-items="center" testId="bar-yield" height=16
                box width=6 height=6 border-radius=3 background-color=th.accent animation=(still ? "none" : "barBlink 1.1s ease-in-out infinite")
                text (ri.level == "pause" ? "Radio paused while you speak" : "Radio lowered while you speak") font-family=th.fontUi font-size=11 color=th.muted
            row gap=6 align-items="center" width="100%"
              box width=8 height=8 border-radius=4 background-color=th.danger animation=(still ? "none" : "barBlink 1s ease-in-out infinite")
              text "Listening" font-family=th.fontUi font-size=11 font-weight=700 letter-spacing=0.6 color=th.danger flex=1
              button press=micCancel testId="bar-cancel" appearance="none" aria-label="Cancel listening"
                row padding="4px 10px" border-radius=th.radiusPill border-width=1 border-style="solid" border-color=th.rule align-items="center"
                  text "Cancel" font-family=th.fontUi font-size=12 font-weight=600 color=th.fg
            text ((bi.text == "" or bi.text.startsWith("Listening")) ? "Tap the microphone again to send." : bi.text) testId="bar-text" font-family=th.fontRead font-size=15 font-style="italic" color=th.fg line-clamp=3
        if lineMode == "heard"
          text bi.text testId="bar-text" font-family=th.fontRead font-size=15 color=th.fg line-clamp=3 padding-left=4 animation=enter
        if lineMode == "holding"
          text bi.text testId="bar-text" font-family=th.fontUi font-size=14 color=th.fg line-clamp=2 padding-left=4 animation=enter
        if lineMode == "revised"
          button press=showLayer("player") testId="bar-text" appearance="none" aria-label="Revised. Show" animation=enter
            row gap=6 align-items="center" padding-left=4 min-height=30
              image "symbol:sparkles" color=th.success
              text bi.text font-family=th.fontUi font-size=14 font-weight=600 color=th.fg
        if lineMode == "error"
          row gap=6 align-items="center" animation=enter padding-left=4
            image "symbol:alert" color=th.danger
            text bi.text testId="bar-text" font-family=th.fontUi font-size=14 color=th.fg line-clamp=3 flex=1
        // ---- the controls
        row align-items="center" gap=6
          button testId="bar-mark" press=toggleLauncher appearance="none" width=48 height=48 aria-label=(layer == "launcher" ? "Close the launcher" : "Open the launcher")
            column width=48 height=48 align-items="center" justify-content="center"
              Mark(state=markState)
          input value=ask input=editAsk submit=sendAsk focus=barFocus blur=barBlur placeholder=aim aria-label=aim testId="bar-field" enterkeyhint="send" flex=1 min-width=0 min-height=44
            font-family=th.fontRead font-size=17 color=th.fg padding="8px 6px"
            ::placeholder
              color=th.muted
          if typing
            button testId="bar-send" press=sendAsk appearance="none" width=52 height=48 aria-label="Send"
              BarGlyph(glyph="send", caption="Send", on=true)
          else
            button testId="bar-mic" press=micTap appearance="none" width=52 height=48 aria-label=(micOn ? "Stop listening and send" : "Talk")
              box position="relative" width=52 height=48
                if micOn
                  box position="absolute" left=9 top=3 width=34 height=28 border-radius=14 border-width=2 border-style="solid" border-color=th.danger pointer-events="none"
                    animation=(still ? "none" : "barPulse 1.1s ease-in-out infinite")
                BarGlyph(glyph=(micOn ? "stop" : "mic"), caption=(micOn ? "Send" : "Talk"), on=micOn)
          button testId="bar-play" press=radioPlay appearance="none" width=52 height=48 aria-label=playLabel
            BarGlyph(glyph=(isPlaying ? "pause" : "play"), caption=playWord, on=false)
