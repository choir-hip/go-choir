// The bar: one glass capsule floating over the bottom of every page (plan section 1). Lane 1 owns this file.
// Three zones: pages button (leading), the centre that changes with the bar's state (BarInfo.state), the voice button
// (trailing: tap plays or pauses, hold 350 ms talks). It floats: bottom 8 pt above the home indicator, 12 pt in from
// the sides, no border, no strip beneath it; the page runs full-bleed under it and shows through the glass.
//
// States (BarInfo.state, from BarState.swift) and what the centre shows:
//   idle       the aim ("Ask about this page…", "Reply to <title>…", "Edit <title>…") as the Ask field
//   playing    NOW PLAYING and the title; hairline progress rule; swipe left/right: next/previous; tap: the player
//   paused     PAUSED and the title; tap: the player
//   listening  the mic is open (open mode heard something): "Listening…", a pulsing ring on the voice button
//   talking    the listener's words as heard (italic, up to three lines, the bar grows upward); and, when the
//              programme yields, "Radio lowered/paused while you speak"
//   heard      the words set in roman
//   holding    the holding line, a dashed ring turning on the voice button
//   revised    "Revised · Show" for 6 s, tap: the player
//   error      one plain sentence for 4 s, danger ring
//   typing     (the field has the keyboard) the aim line above the field, Send in place of the voice button
// Motion is declarative: height, tint and content enter with transitions and keyframes, all off under Reduce Motion.
// testIds: bar, bar-pages, bar-pages-count, bar-field, bar-aim, bar-text, bar-yield, bar-voice, bar-send, bar-progress.
use Theme, PageList, BarInfo, RadioInfo, ReaderAimInfo, Onboarding from "@choir/autoradio"
use Mark from "./mark.contract"

keyframes barRise
  from opacity=0 translate="0px 6px"
keyframes barPulse
  50% scale=1.16 opacity=0.5
keyframes barSpin
  from rotate="0deg"
  to rotate="360deg"
keyframes barBlink
  50% opacity=0.25

component BarShell
  inject
    th: Theme
    pg: PageList
    bi: BarInfo
    ri: RadioInfo
    raim: ReaderAimInfo
    ob: Onboarding
    typing: bool
    ask: string
    editAsk: action
    sendAsk: action
    togglePile: action
    pullBar: action
    pullEnd: action
    voiceDown: action
    voiceUp: action
    showLayer: action
    barFocus: action
    barBlur: action
    next: action
    previous: action
  derive st = bi.state
  derive aimOwn = `Edit ${pg.topTitle}…`
  derive aimReply = `Reply to ${pg.topTitle}…`
  // The prompt's aim: one block of the open document when the reader has aimed it there; before voice setup is done (and off the
  // reader) the invitation to set up; otherwise the page.
  derive aimPage = pg.topKind == "reader" ? (pg.top.startsWith("texture:") ? aimOwn : aimReply) : (ob.aim != "" ? ob.aim : "Ask about this page…")
  derive aim = (raim.address == pg.top and raim.blockId != "") ? `Ask about “${raim.label}”…` : aimPage
  derive lines = min(3, max(1, ceil(bi.text.length / 30)))
  derive yielded = ri.level != "play" and (st == "listening" or st == "talking")
  derive wordy = st == "listening" or st == "talking" or st == "heard" or st == "error"
  derive barH = typing ? 88 : (wordy ? 56 + (lines - 1) * 20 + (yielded ? 16 : 0) : 56)
  derive tint = st == "error" ? th.danger : (st == "revised" ? th.success : (st == "playing" ? th.accent2 : th.accent))
  derive tintOn = (st == "idle" or st == "paused") ? 0 : (st == "playing" ? 0.1 : 0.16)
  derive markState = st == "talking" ? "listening" : (st == "paused" ? "idle" : st)
  derive still = th.reducedMotion
  derive calm = still ? 0 : 1
  derive enter = still ? "none" : "barRise 220ms ease-out both"
  view
    row testId="bar" position="absolute" left=12 right=12 bottom="calc(env(safe-area-inset-bottom) + 8px)" z-index=20
      height=barH align-items="center" gap=4 padding=6 box-sizing="border-box"
      pan=pullBar panrelease=pullEnd border-radius=th.radiusPill
      backgroundMaterial=(th.material2 == "glass" ? "glass" : "none")
      background-color=(th.material2 == "glass" ? "transparent" : th.paper)
      box-shadow=th.shadow2
      transition=`height ${th.motionEnterMs * calm}ms ease`
      // the backing: the page colour under the glass, so text and the field stay legible over busy content in light and dark
      box position="absolute" inset=0 border-radius=th.radiusPill pointer-events="none" z-index=-1
        background-color=th.paper opacity=0.94 border-width=1 border-style="solid" border-color=th.rule
      // the state's tint: warms while playing, brighter while the listener is heard, danger on a failure
      box position="absolute" inset=0 border-radius=th.radiusPill pointer-events="none"
        background-color=tint opacity=tintOn
        transition=`opacity ${th.motionFastMs * calm}ms ease, background-color ${th.motionFastMs * calm}ms ease`
      if typing == false
        button testId="bar-pages" press=togglePile aria-label=`Open pages, ${pg.count} open` appearance="none" width=44 height=44
          column align-items="center" justify-content="center"
            image "symbol:layers" color=th.fg
            text `${pg.count}` testId="bar-pages-count" font-family=th.fontUi font-size=11 color=th.muted
      column flex=1 min-width=0 justify-content="center" gap=2
        if typing
          text aim testId="bar-aim" font-family=th.fontUi font-size=11 color=th.muted line-clamp=1 animation=enter
        if st == "idle"
          input value=ask input=editAsk submit=sendAsk focus=barFocus blur=barBlur placeholder=aim aria-label=aim testId="bar-field" enterkeyhint="send"
            font-family=th.fontRead font-size=16 color=th.fg padding="8px 6px"
            ::placeholder
              color=th.muted
        if st == "playing"
          column swipeleft=next swiperight=previous animation=enter
            button press=showLayer("player") testId="bar-text" appearance="none" aria-label=`Now playing, ${bi.text}. Open the player`
              column align-items="flex-start" gap=1 width="100%"
                text "NOW PLAYING" font-family=th.fontUi font-size=10 font-weight=600 color=th.muted
                text bi.text font-family=th.fontUi font-size=15 color=th.fg line-clamp=1 text-align="left"
        if st == "paused"
          button press=showLayer("player") testId="bar-text" appearance="none" aria-label=`Paused, ${bi.text}. Open the player` animation=enter
            column align-items="flex-start" gap=1 width="100%"
              text "PAUSED" font-family=th.fontUi font-size=10 font-weight=600 color=th.muted
              text bi.text font-family=th.fontUi font-size=15 color=th.fg line-clamp=1 text-align="left"
        if st == "listening" or st == "talking"
          column animation=enter
            if yielded
              row gap=5 align-items="center" testId="bar-yield" height=16
                box width=6 height=6 border-radius=3 background-color=th.accent animation=(still ? "none" : "barBlink 1.1s ease-in-out infinite")
                text (ri.level == "pause" ? "Radio paused while you speak" : "Radio lowered while you speak") font-family=th.fontUi font-size=11 color=th.muted
            text bi.text testId="bar-text" font-family=th.fontRead font-size=15 font-style="italic" color=th.fg line-clamp=3 padding="2px 6px"
        if st == "heard"
          text bi.text testId="bar-text" font-family=th.fontRead font-size=15 color=th.fg line-clamp=3 padding="2px 6px" animation=enter
        if st == "holding"
          text bi.text testId="bar-text" font-family=th.fontUi font-size=15 color=th.fg line-clamp=2 padding="2px 6px" animation=enter
        if st == "revised"
          button press=showLayer("player") testId="bar-text" appearance="none" aria-label="Revised. Show" animation=enter
            row gap=6 align-items="center"
              image "symbol:sparkles" color=th.success
              text bi.text font-family=th.fontUi font-size=15 font-weight=600 color=th.fg
        if st == "error"
          row gap=6 align-items="center" animation=enter
            image "symbol:alert" color=th.danger
            text bi.text testId="bar-text" font-family=th.fontUi font-size=14 color=th.fg line-clamp=3 flex=1
      if typing
        button testId="bar-send" press=sendAsk appearance="none" width=44 height=44 aria-label="Send"
          row width=36 height=36 border-radius=18 align-items="center" justify-content="center" background-color=th.accent
            image "symbol:send" color=th.onAccent
      else
        button testId="bar-voice" pointerdown=voiceDown pointerup=voiceUp appearance="none" width=44 height=44
          aria-label=(st == "playing" ? "Pause. Hold to talk" : "Play. Hold to talk")
          box position="relative" width=44 height=44
            if st == "listening" or st == "talking"
              box position="absolute" inset=2 border-radius=20 border-width=2 border-style="solid" border-color=th.accent pointer-events="none"
                animation=(still ? "none" : "barPulse 1.2s ease-in-out infinite")
            if st == "holding"
              box position="absolute" inset=2 border-radius=20 border-width=2 border-style="dashed" border-color=th.accent pointer-events="none"
                animation=(still ? "none" : "barSpin 2.4s linear infinite")
            if st == "error"
              box position="absolute" inset=2 border-radius=20 border-width=2 border-style="solid" border-color=th.danger pointer-events="none"
            Mark(state=markState)
      if st == "playing" or st == "paused"
        box testId="bar-progress" position="absolute" left=22 right=22 bottom=3 height=2 border-radius=1 background-color=th.rule
          opacity=(ri.level == "play" ? 1 : 0.4) transition=`opacity ${th.motionFastMs}ms ease`
          box height=2 border-radius=1 width=`${floor(bi.progress * 100)}%` background-color=th.accent
