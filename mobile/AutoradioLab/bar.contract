// The bar (round 3, owner rulings 21 and 22): a glass lens at the bottom of the screen, always visible and usable on every page, in
// onboarding and with the launcher open. It is not a floating capsule: it spans the full width, overlaps the page
// (which scrolls full bleed underneath and shows through the glass), covers the bottom safe area and runs off the bottom edge;
// only its top corners are rounded. With the keyboard up it rides on top of the keyboard (`interactive-widget` on the root).
//
// Explicit controls, no hidden gestures (no hold, no drag):
//   the mark       tap opens and closes the launcher (the web's button). One job.
//   the field      "Ask about this page...", aimed at the page in front (its address goes with the turn).
//   the microphone tap to start talking, tap again to send (the lens says "Listening" plainly while it is open).
//   play / pause   the radio; when nothing is loaded it starts the edition.
// For a document in the Reader or an embedded web page the lens carries one more line at its top, the content row (content.contract),
// and the page above it takes the whole screen (owner, 2026-11-16).
// A line above the controls says what is going on: what is loaded when something plays or is paused (tap: the Autoradio page), the
// words as heard, the holding line, a revision, an error, the setup state, or the aim while typing. A quiet count
// ("Story · 7 in the deck") sits just above the lens. The launcher rises from the lens, as a sheet
// above it, so the bar stays visible and usable under them.
// testIds: bar-stack, bar, bar-mark, bar-field, bar-mic, bar-send, bar-play, bar-text, bar-aim, bar-setup, bar-yield, bar-progress,
// page-indicator, content-row (content.contract), bar-answer, bar-asked, bar-answer-text, bar-answer-working, bar-answer-note, bar-answer-retry, bar-answer-cancel, bar-answer-close.
use Theme, PageList, RadioInfo, Onboarding from "@choir/autoradio"
use ReaderAimInfo from "./reader-types.contract"
use BarInfo from "./bar-types.contract"
use MailMessageView from "./mail-types.contract"
use BarMark from "./tetramark.contract"
use Launcher from "./launcher.contract"
use StackVp from "./ui.contract"
use ContentRow from "./content.contract"
use SignedOutBanner from "./signedout.contract"
use tRiseInOf, tRiseOutOf, tOut from "./transitions.contract"

keyframes barPulse
  50% scale=1.16 opacity=0.5
keyframes barSpin
  from rotate="0deg"
  to rotate="360deg"
keyframes barBlink
  50% opacity=0.25

// A control of the row: the icon alone with its caption under it. On is the accent (icon and caption), off is muted: no ring, no circle, no fill
// (owner, 2026-11-15: no pills). The icon and the caption are the same size in both states, so a state moves nothing.
component BarGlyph
  inject
    th: Theme
  props
    glyph: string
    caption: string
    on: bool
  derive tone = on ? th.accent : th.muted
  view
    column align-items="center" justify-content="center" gap=2 width=52 height=48
      // the state is in the shape as well as the colour: the microphone is solid when on and crossed out when off
      if glyph == "mic"
        if on
          image "symbol:microphone" color=tone
        else
          image "symbol:sf/mic.slash" color=tone
      if glyph == "stop"
        image "symbol:stop-fill" color=tone
      if glyph == "play"
        image "symbol:play-fill" color=tone
      if glyph == "pause"
        image "symbol:pause-fill" color=tone
      if glyph == "send"
        image "symbol:send" color=tone
      text caption font-family=th.fontAction font-size="-exact-caption2" font-weight=600 color=tone

component BarShell
  inject
    th: Theme
    pg: PageList
    bi: BarInfo
    ri: RadioInfo
    raim: ReaderAimInfo
    bannerOn: bool
    ob: Onboarding
    mmsg: MailMessageView
    vp: StackVp
    layer: string
    typing: bool
    ask: string
    micOn: bool
    heardNow: bool
    onbd: bool
    topAddr: string
    ctlMode: string
    moreFor: string
    moreOfThis: action
    stackCount: number
    frontName: string
    frontKind: string
    editAsk: action
    sendAsk: action
    micTap: action
    micCancel: action
    openPage: action
    answerRetry: action
    answerDismiss: action
    answerCancel: action
    radioPlay: action
    toggleLauncher: action
    showLayer: action
    hideLayer: action
    barFocus: action
    barBlur: action
  derive st = bi.state
  // One neutral placeholder on every page. What the field does: the words go to the Autoradio desk with the page in front (its title,
  // text and what was just heard), and the radio answers aloud in a few sentences. Today's route (docs/reference/AUTORADIO-TURNS.md) answers
  // and has no tools, so the wording says "ask" and promises no action.
  // The aim is shown apart, as a short label on the glass: "On: <the page's title>" (never an address). The address itself goes with
  // the turn (`aim=`), unchanged.
  derive aim = "Ask about this page…"
  derive aimTitle = topAddr == "paper:front" ? "Front page" : ((raim.address == pg.top and raim.blockId != "") ? raim.label : frontName)
  derive onSetup = pg.top == "onboarding:setup"
  derive setupLine = ob.step == "topics" ? "Choose your topics" : (ob.step == "setup" ? "Setting up the voice…" : (ob.step == "mic" ? "Check the microphone" : (ob.step == "hearing" ? "Check that you can hear me" : (ob.step == "ready" ? "Voice is set up" : (ob.step == "writing" ? "Writing your edition…" : (ob.step == "done" ? "Your edition is ready" : "Voice setup"))))))
  // What the line above the controls shows. On the Autoradio page the now-playing line is redundant (the page is what it opens), so it is not drawn there.
  derive lineMode = heardNow ? "listen" : (st == "heard" ? "heard" : (st == "holding" ? "holding" : (st == "revised" ? "revised" : (st == "error" ? "error" : (typing ? "aim" : (st == "playing" ? (topAddr == "radio:" ? "none" : "playing") : (st == "paused" ? (topAddr == "radio:" ? "none" : "paused") : (onSetup ? "setup" : "none"))))))))
  derive loaded = ri.title != "" ? ri.title : bi.text
  derive yielded = ri.level != "play" and heardNow
  derive tint = st == "error" ? th.danger : (st == "revised" ? th.success : (st == "playing" ? th.accent2 : th.accent))
  derive tintOn = (lineMode == "none" or lineMode == "aim" or lineMode == "paused" or lineMode == "listen") ? 0 : (st == "playing" ? 0.08 : 0.12)
  derive markState = heardNow ? "listening" : (st == "paused" ? "idle" : st)
  // One truth for the button and the strip: the bar state decides; the radio view (which can lag a pause) only counts while the bar has no verdict.
  derive isPlaying = st == "playing" or (st != "paused" and ri.playing)
  derive playWord = isPlaying ? "Pause" : "Play"
  derive playLabel = isPlaying ? "Pause the radio" : (st == "paused" ? "Resume the radio" : "Play the edition")
  derive still = th.reducedMotion
  derive calm = still ? 0 : 1
  derive enter = tRiseInOf(still)
  derive leave = tRiseOutOf(still)
  derive panelH = vp.height * 0.62
  view
    column testId="bar-stack" position="absolute" left=0 right=0 bottom=0 z-index=20
      if bannerOn
        SignedOutBanner()
      // the launcher rises from the lens; the lens stays under it, visible and usable
      if layer == "launcher"
        column testId="launcher" width="100%" height=panelH animation=enter -exact-exit-animation=leave
          Launcher()
      // the lens: glass over the page, full width, top corners rounded, running off the bottom edge
      column testId="bar" position="relative" width="100%" box-sizing="border-box" gap=4
        padding-top=8 padding-left=12 padding-right=12 padding-bottom="calc(env(safe-area-inset-bottom) + 6px)"
        border-top-left-radius=(th.radiusCard * 1.7) border-top-right-radius=(th.radiusCard * 1.7)
        backgroundMaterial=(th.lensStyle == "B" ? "none" : (th.lensStyle == "C" ? "ultra-thin" : "glass"))
        background-color="transparent"
        box-shadow=th.shadow3
        // a wash of the page colour inside the glass (theme data: th.lensWash, 0 for the native glass), so the controls stay legible over busy
        // content in light and dark (the lens itself is Exact's glass material, th.lensStyle: A native glass, B none, C ultra-thin)
        box position="absolute" inset=0 pointer-events="none" z-index=-1 border-top-left-radius=(th.radiusCard * 1.7) border-top-right-radius=(th.radiusCard * 1.7)
          background-color=th.paper opacity=max(th.lensWash, 0.55)
        // the state's tint
        box position="absolute" inset=0 pointer-events="none" border-top-left-radius=(th.radiusCard * 1.7) border-top-right-radius=(th.radiusCard * 1.7)
          background-color=tint opacity=tintOn
          transition=`opacity ${th.motionFastMs * calm}ms ease, background-color ${th.motionFastMs * calm}ms ease`
        // the top edge: a hairline and a soft highlight, the lip of the glass
        box position="absolute" left=0 right=0 top=0 height=1 pointer-events="none" background-color=th.rule opacity=0.22
          border-top-left-radius=(th.radiusCard * 1.7) border-top-right-radius=(th.radiusCard * 1.7)
        box position="absolute" left=0 right=0 top=1 height=14 pointer-events="none" border-top-left-radius=(th.radiusCard * 1.7) border-top-right-radius=(th.radiusCard * 1.7)
          background-image="linear-gradient(180deg, rgba(255,255,255,0.35), rgba(255,255,255,0))"
        // the content row (content.contract): for a document in the Reader or an embedded web page, one line above the "On:" line that
        // expands upward to the page's actions. The page itself carries no header; it runs down to the top of this lens.
        if onbd == false and layer == "" and ctlMode != ""
          ContentRow()
        // the deck's quiet count: where you are, in a hairline of text at the top of the lens (not over the page)
        if onbd == false and layer == ""
          row width="100%" align-items="center" justify-content="space-between" gap=8
            text `On: ${aimTitle} · ${stackCount} in the deck` testId="page-indicator" aria-label=`On ${aimTitle}. ${stackCount} pages in the deck` line-clamp=1 flex=1 min-width=0 font-family=th.fontLabel font-size="-exact-caption2" color=th.muted
            if topAddr.startsWith("pub:")
              button press=moreOfThis(topAddr) testId="story-more" appearance="none" aria-label="More stories like this one"
                row padding="6px 4px" align-items="center"
                  text (moreFor == topAddr ? "Noted" : "More of this") font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=(moreFor == topAddr ? th.muted : th.accent)
        // ---- the conversation card (lane autoradio-talk): what the reader asked and what came back, above the line, never replacing it.
        // working: heard, nothing yet; first: the phone's answer from the saved stories (the full one is on its way); full: the computer's
        // answer; failed: plain words and a retry. Tapping the answer opens the conversation page, where every answer is kept.
        if bi.answerState != "" and layer == "" and onbd == false
          column gap=4 animation=enter -exact-exit-animation=leave padding-left=4 padding-right=4 testId="bar-answer"
            row gap=8 align-items="center" width="100%"
              text `You asked: ${bi.question}` testId="bar-asked" font-family=th.fontLabel font-size="-exact-caption2" color=th.muted line-clamp=1 flex=1 min-width=0
              if bi.answerState == "working" or bi.answerState == "first" or bi.answering
                button press=answerCancel testId="bar-answer-cancel" appearance="none" aria-label="Cancel this question"
                  row padding="6px 4px" align-items="center"
                    text "Cancel" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
              else
                button press=answerDismiss(bi.answerId) testId="bar-answer-close" appearance="none" aria-label="Close the answer"
                  row padding="6px 4px" align-items="center"
                    text "Close" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
            if bi.answerState == "working"
              text "Looking it up…" testId="bar-answer-working" font-family=th.fontLabel font-size="-exact-footnote" color=th.fg
            if bi.answerState == "first" or bi.answerState == "full"
              button press=openPage("conversation:", "Conversation") testId="bar-answer-text" appearance="none" width="100%" aria-label="Open the conversation"
                column gap=2 align-items="flex-start" width="100%"
                  if bi.answerLabel != ""
                    text bi.answerLabel font-family=th.fontLabel font-size="-exact-caption2" color=th.muted
                  text bi.answerText font-family=th.fontText font-size="-exact-subheadline" color=th.fg line-clamp=4 text-align="left"
            if bi.answerNote != ""
              text bi.answerNote testId="bar-answer-note" font-family=th.fontLabel font-size="-exact-footnote" color=(bi.answerState == "failed" ? th.danger : th.muted) line-clamp=3
            if bi.canRetry
              button press=answerRetry(bi.answerId) testId="bar-answer-retry" appearance="none" aria-label="Ask again"
                row padding="6px 4px" align-items="center"
                  text "Try again" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
        // ---- the line above the controls
        if lineMode == "aim"
          text `The radio answers aloud, from ${aimTitle}. Try “Summarize this” or “Who is involved?”` testId="bar-aim" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted line-clamp=2 padding-left=4 animation=enter -exact-exit-animation=leave
        if lineMode == "setup"
          text setupLine testId="bar-setup" font-family=th.fontLabel font-size="-exact-footnote" color=th.fg line-clamp=1 padding-left=4 animation=enter -exact-exit-animation=leave
        if lineMode == "playing" or lineMode == "paused"
          column gap=4 animation=enter -exact-exit-animation=leave
            button press=openPage("radio:", "Autoradio") testId="bar-now" appearance="none" width="100%" aria-label=`${lineMode == "playing" ? "Now playing" : "Paused"}, ${loaded}. Open the Autoradio page`
              row gap=8 align-items="center" width="100%" padding-left=4 min-height=30 testId="bar-text"
                if lineMode == "playing"
                  image "symbol:waveform" color=th.accent
                if lineMode == "paused"
                  image "symbol:pause" color=th.accent
                column flex=1 min-width=0 gap=1 align-items="flex-start"
                  text (lineMode == "playing" ? "NOW PLAYING" : "PAUSED") font-family=th.fontLabel font-size="-exact-caption2" font-weight=600 letter-spacing=0.8 color=th.muted
                  text loaded font-family=th.fontHead font-size="-exact-subheadline" font-weight=600 color=th.fg line-clamp=1 text-align="left"
                image "symbol:forward-chevron" color=th.muted
            box testId="bar-progress" height=2 background-color="transparent" opacity=(ri.level == "play" ? 1 : 0.4) transition=`opacity ${th.motionFastMs}ms ease`
              box height=2 width=`${floor(bi.progress * 100)}%` background-color=th.accent
        if lineMode == "listen"
          column gap=3 animation=enter -exact-exit-animation=leave padding-left=4
            if yielded
              row gap=5 align-items="center" testId="bar-yield" height=16
                box width=3 height=12 background-color=th.accent animation=(still ? "none" : "barBlink 1.1s ease-in-out infinite")
                text (ri.level == "pause" ? "Radio paused while you speak" : "Radio lowered while you speak") font-family=th.fontLabel font-size="-exact-caption2" color=th.muted
            row gap=6 align-items="center" width="100%"
              box width=3 height=12 background-color=th.danger animation=(still ? "none" : "barBlink 1s ease-in-out infinite")
              text "Listening" font-family=th.fontLabel font-size="-exact-caption2" color=th.danger flex=1
              button press=micCancel testId="bar-cancel" appearance="none" aria-label="Cancel listening"
                row padding="8px 4px" align-items="center"
                  text "Cancel" font-family=th.fontAction font-size="-exact-footnote" font-weight=600 color=th.accent
            text bi.text testId="bar-text" font-family=th.fontText font-size="-exact-subheadline" font-style="italic" color=th.fg line-clamp=3
        if lineMode == "heard"
          text bi.text testId="bar-text" font-family=th.fontText font-size="-exact-subheadline" color=th.fg line-clamp=3 padding-left=4 animation=enter -exact-exit-animation=leave font-style="italic"
        if lineMode == "holding"
          text bi.text testId="bar-text" font-family=th.fontText font-size="-exact-subheadline" color=th.fg line-clamp=2 padding-left=4 animation=enter -exact-exit-animation=leave font-style="italic"
        if lineMode == "revised"
          button press=openPage("radio:", "Autoradio") testId="bar-text" appearance="none" aria-label="Revised. Show" animation=enter -exact-exit-animation=leave
            row gap=6 align-items="center" padding-left=4 min-height=30
              image "symbol:sparkles" color=th.success
              text bi.text font-family=th.fontLabel font-size="-exact-footnote" color=th.fg
        if lineMode == "error"
          row gap=6 align-items="center" animation=enter -exact-exit-animation=leave padding-left=4
            image "symbol:alert" color=th.danger
            text bi.text testId="bar-text" font-family=th.fontLabel font-size="-exact-footnote" color=th.fg line-clamp=3 flex=1
        // ---- the controls
        row align-items="center" gap=6
          button testId="bar-mark" press=toggleLauncher appearance="none" width=48 height=48 aria-label=(layer == "launcher" ? "Close the launcher" : "Open the launcher")
            column width=48 height=48 align-items="center" justify-content="center"
              BarMark()
          input appearance="none" value=ask input=editAsk submit=sendAsk focus=barFocus blur=barBlur placeholder=(vp.width < 360 ? "Ask…" : aim) aria-label=aim testId="bar-field" enterkeyhint="send" flex=1 min-width=0 min-height=44
            font-family=(ask == "" ? th.fontLabel : th.fontText) font-size=(vp.width < 360 ? 16 : 17) color=th.fg padding="8px 6px" border-width=0 background-color="transparent"
            ::placeholder
              color=th.muted
          if typing
            button testId="bar-send" press=sendAsk retainFocus=true appearance="none" width=52 height=48 aria-label="Send"
              BarGlyph(glyph="send", caption="Send", on=true)
          else
            button testId="bar-mic" press=micTap appearance="none" width=52 height=48 aria-label=(micOn ? "Hands-free on. Turn it off" : "Hands-free off. Turn it on")
              box position="relative" width=52 height=48
                BarGlyph(glyph="mic", caption=(micOn ? "Voice on" : "Voice off"), on=micOn)
          button testId="bar-play" press=radioPlay appearance="none" width=52 height=48 aria-label=playLabel
            BarGlyph(glyph=(isPlaying ? "pause" : "play"), caption=playWord, on=isPlaying)
