// Lane members file (content row, owner 2026-11-16: "for reader and for the embedded web view, the content should get the full screen
// except for the prompt bar area at the bottom"): the one compact control row above the bar's "On:" line, for a document in the
// imported document and for an embedded web page. Collapsed it is one line; expanded it lists the actions as words. The row itself is
// `ContentRow` in content.contract (drawn inside the bar's lens, bar.contract); the content above it never carries a header.
//
// What the row is shown for (`ctlMode`): a page typed into the bar (barweb), a source page opened over a story (web), or the
// document in front when it is open and ready (doc). Everything else has no row and no clearance.
// `ctlClear` is how far the content's frame stops above the bottom edge (the bar's lens plus this row): 124 with the bar idle
// (8 + the "On:" line + the controls + the row), 168 while a line shows above the controls (now playing, heard, holding, error).
use readerOpenExternal from "@choir/autoradio"
use TextureEditInfo from "./textedit-types.contract"
use TextureMade from "./textures-types.contract"

members Autoradio
  state ctlOpen = false
  // The page the row was expanded for (a document's address, a web page's URL): another page in front finds it collapsed.
  state ctlFor = ""
  // What the expanded row shows under its actions: "" | "contents" | "find".
  state ctlPanel = ""

  // ---- your own Texture document: edited in rich text with Exact's Markdown editor (texture-edit.ts, shared code; its state model is at the head of that file)
  // The second argument is only the key that asks again: the editor is writable once the computer is known, and a sign-in (acs.state, signedOutTick) or a discovery (edAsk, below) changes that without pg.top moving.
  // It cannot name rdoc: rdoc reads edInfo.status.
  state edAskTick = 0
  resource edInfo = textureEditInfo(pg.top, `${acs.state}|${signedOutTick}|${edAskTick}`) as shape TextureEditInfo else empty()
  // Three mutations so one never lets another go (answers-let-go.md): the typed text, the saves (Done, the idle pause, leaving the page, the listener's choice after a conflict) and the retry.
  mutation edm as shape TextureEditInfo refreshes edInfo
  mutation edf as shape TextureEditInfo refreshes edInfo
  mutation edr as shape TextureEditInfo refreshes edInfo
  // The editor opens on the head the server holds NOW: the field first shows the reader's copy (or the kept text), and the answer of `textureEditOpen` replaces it while the listener has typed nothing.
  mutation edo as shape TextureEditInfo then edOpened
  // The field is replaced by what the open found only while the listener has typed nothing (`edUntouched`). The answer names its document: another page's answer is not used.
  state edUntouched = true
  derive edHasKeptHere = edInfo.address == topAddr and edInfo.hasKept
  derive edOpenGot = match edo { case some(a) => (a.address == edFor and (a.opened or a.hasKept)), case none => false }
  derive edOpenText = match edo { case some(a) => (a.address == edFor ? (a.hasKept ? a.kept : a.head) : ""), case none => "" }
  derive edStatus = edInfo.status
  state edOn = false
  state edFor = ""
  state edDraft = ""
  state edFormats = ""
  state edUnavail = ""
  state edCurLink = ""
  state edUrl = ""
  // Signed in and the editor still answers "not writable" (the account's computer is not known yet: a discovery by any request, on any page, changes that without this page moving; the answer is local, no
  // network): ask again, every 2 s five times, then every 30 s. api.ts's discovery cannot re-key a resource, so this is how the editor learns it.
  action edAsk
    edAskTick = edAskTick + 1
  task edKnow when acs.state == "signedIn" and not edInfo.writable and edAskTick < 5 key=edAskTick
    after(2000, edAsk)
  task edKnowSlow when acs.state == "signedIn" and not edInfo.writable and edAskTick >= 5 key=edAskTick
    after(30000, edAsk)
  derive edReady = topAddr.startsWith("texture:") and rdoc.address == topAddr and rdoc.status == "ready" and rdoc.editable and edInfo.writable

  derive ctlMode = qv.webUrl != "" ? "barweb" : ((webUrl != "" and webFor == topAddr) ? "web" : ((topAddr.startsWith("doc:") and ldInfo.address == topAddr and ldInfo.status == "ready") ? "doc" : (edReady ? "texture" : "")))
  derive ctlKey = ctlMode == "barweb" ? qv.webUrl : (ctlMode == "web" ? webUrl : topAddr)
  derive ctlUp = ctlMode != "" and ctlOpen and ctlFor == ctlKey
  derive ctlClear = ctlMode == "" ? 0 : (bi.state == "idle" ? 124 : 168)
  derive ctlTitle = ctlMode == "barweb" ? qv.webHost : (ctlMode == "web" ? webHost : (ctlMode == "texture" ? rdoc.title : ldInfo.title))
  derive ctlBusy = (ctlMode == "barweb" or ctlMode == "web") and webBusy
  derive ctlPos = (ctlMode == "doc" and ldInfo.sections.length > 0) ? `${(ldSec + 1).toFixed(0)} of ${ldInfo.sections.length.toFixed(0)}` : (ctlMode == "texture" ? (edInfo.notice != "" ? edInfo.notice : edInfo.label) : "")

  action ctlToggle
    ctlOpen = ctlUp == false
    ctlFor = ctlKey
    ctlPanel = ""
  action ctlHide
    ctlOpen = false
    ctlPanel = ""
  action ctlPanelOf(name: string)
    ctlPanel = ctlPanel == name ? "" : name

  // ---- a document: each one puts the row away, except stepping (a page turn is repeated) and typing in Find
  action ctlRead
    ctlOpen = false
    ctlPanel = ""
    send ldAck = importedReadAloud(pg.top, ldSec, ldBlock)
  action ctlQueueDoc
    ctlOpen = false
    ctlPanel = ""
    send ldAck = importedQueue(pg.top, ldSec, ldBlock)
  // Share is the document's own file (a Files document keeps the file it came from): the system share sheet.
  action ctlShare
    ctlOpen = false
    ctlPanel = ""
    share(title=ldInfo.title, files=[ldInfo.shareSrc])
  action ctlGo(n: number)
    ldSec = max(0, min(n, max(0, ldInfo.sections.length - 1)))
    ldToc = false
    ldBlock = -1
    ctlOpen = false
    ctlPanel = ""
    send ldAck = importedPlace(pg.top, ldSec, -1)
  action ctlStep(n: number)
    ldSec = max(0, min(n, max(0, ldInfo.sections.length - 1)))
    ldToc = false
    ldBlock = -1
    send ldAck = importedPlace(pg.top, ldSec, -1)
  action ctlJump(section: number, block: number)
    ldSec = section
    ldBlock = block
    ldScrollTo = block
    ldToc = false
    ldText = true
    ctlOpen = false
    ctlPanel = ""
    send ldAck = importedPlace(pg.top, section, block)
  action ctlSetText(on: bool)
    ldText = on
    ctlOpen = false
    ctlPanel = ""
  action ctlCloseDoc
    let gone = topAddr
    let nxt = order.slice(1, 2).join("")
    ctlOpen = false
    ctlPanel = ""
    order = order.filter(a => a != gone)
    px = 0
    send pms = pagesOpen(nxt, "")
    send pcs = pagesClose(gone)

  // ---- a Texture document: Edit turns the reader into the editor; every keystroke is told to the Kit, which posts a revision after a pause in
  // typing, at once on Done, and when the page is left (textureFlush). The formatting row never shows Markdown syntax; it drives `format`.
  action edBegin
    edOn = true
    edFor = topAddr
    edDraft = edHasKeptHere ? edInfo.kept : rdoc.source
    edUntouched = true
    send edo = textureEditOpen(topAddr)
    edFormats = ""
    ctlOpen = true
    ctlFor = topAddr
    ctlPanel = ""
  // ---- "New document" (the Textures page's top-right button): the server makes an empty document (textures.ts createTexture), it is opened as a page, and when that page has loaded and the editor is writable
  // it is put in the editor with the cursor in the body. Nothing is typed or posted until the listener types: the first revision is the editor's first save.
  mutation ndm as shape TextureMade then ndMade
  state ndPending = ""
  state ndFocus = false
  derive ndBusy = pending(ndm)
  derive ndOk = match ndm { case some(a) => (a.status == "ok" ? a.address : ""), case none => "" }
  derive ndMsg = match ndm { case some(a) => (a.status == "failed" ? a.message : ""), case none => "" }
  action ndNew
    send ndm = textureCreate()
  action ndMade
    if ndOk != ""
      ndPending = ndOk
      send pms = pagesOpen(ndOk, "Untitled Texture")
  task ndStart when ndPending != "" and topAddr == ndPending and edReady key=ndPending
    after(1, ndGo)
  action ndGo
    ndPending = ""
    edOn = true
    edFor = topAddr
    edDraft = ""
    edUntouched = true
    send edo = textureEditOpen(topAddr)
    edFormats = ""
    ctlOpen = true
    ctlFor = topAddr
    ctlPanel = ""
    ndFocus = true
  task ndFocusTask when ndFocus and edOn key=ndFocus
    after(150, ndFocusGo)
  action ndFocusGo
    ndFocus = false
    focus("texture-editor")
  action edDone
    edOn = false
    ctlOpen = false
    ctlPanel = ""
    send edf = textureFlush(edFor)
  action edOpened
    if edOn and edUntouched and edOpenGot
      edDraft = edOpenText
  // Every keystroke names what the field showed BEFORE it (an action reads the state as it was at its start): the editor posts over the head only when that was the head's text.
  action edInput(value: string)
    edUntouched = false
    edDraft = value
    send edm = textureEdit(edFor, value, edDraft)
  // The pause in typing: 2 s after the last keystroke (the key is the draft, so each keystroke restarts the wait) the text is posted. A source cannot sleep between answers, so the wait is here.
  action edSave
    send edf = textureFlush(edFor)
  task edIdle when edOn and edFor != "" and edInfo.status == "dirty" key=edDraft
    after(2000, edSave)
  // Leaving the page with the editor open posts what was typed.
  action edLeft
    edOn = false
    ctlOpen = false
    ctlPanel = ""
    send edf = textureFlush(edFor)
  task edLeave when edOn and edFor != "" and topAddr != edFor key=edFor
    after(1, edLeft)
  // What an offline or refused save kept: tried again 2 s after launch, then every 30 s while anything is waiting and the key is good, on any page.
  state edRetryTick = 0
  action edRetryGo
    edRetryTick = edRetryTick + 1
    send edr = textureFlush("")
  task edRetryFirst when edInfo.waiting > 0 and edRetryTick == 0 and acs.state == "signedIn" key=edRetryTick
    after(2000, edRetryGo)
  task edRetry when edInfo.waiting > 0 and edRetryTick > 0 and acs.state == "signedIn" key=edRetryTick
    after(30000, edRetryGo)
  // The head moved under an unsent text: nothing was posted or merged. The listener chooses: their text over the new version, or the new version.
  action edKeepMine
    send edf = textureOverwrite(edFor)
  action edUseTheirs
    edOn = false
    ctlOpen = false
    ctlPanel = ""
    rtick = rtick + 1
    send edf = textureDiscard(edFor)
  action edSelected(s)
    edFormats = s.formats
    edUnavail = s.unavailable
    edCurLink = s.link
  action edFormat(name: string)
    format("texture-editor", name)
  action edHeading
    format("texture-editor", "heading", "2")
  action edOpenLink
    ctlPanel = ctlPanel == "link" ? "" : "link"
    edUrl = edCurLink
    focus("texture-link-url")
  action edOpenCurLink
    send qm = queueAct("openWeb", edCurLink)
  action edUrlChanged(value: string)
    edUrl = value
  action edApplyLink
    format("texture-editor", "link", edUrl)
    ctlPanel = ""
    focus("texture-editor")

  // ---- a web page
  action ctlWebRead(u: string, h: string)
    ctlOpen = false
    send qm = queueAdd("now", "page", u, h, "")
  action ctlWebLater(u: string, h: string)
    ctlOpen = false
    send qm = queueAdd("add", "page", u, h, "")
  action ctlSafari(u: string)
    ctlOpen = false
    send rext = readerOpenExternal(url=u)
  action ctlCloseWeb
    ctlOpen = false
    webUrl = ""
    webBusy = false
  action ctlCloseBarWeb
    ctlOpen = false
    send qm = queueAct("closeWeb", "")
