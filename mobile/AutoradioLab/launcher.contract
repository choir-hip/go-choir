// The launcher (round 3): opened by the mark, as on choir.news; it rises above the bar, which stays visible and usable under it.
// It opens the key pages (each comes to the top of the deck) and lists the pages now in the deck (tap to bring one to the top, a
// remove button on opened ones; the key pages stay), and the app's other destinations,
// plus search over pages, files and stories. Titles are human: a page's title, else one made from its slug; never an address.
// The panel is placed by the bar (bar.contract); the scrim behind the page is the root's.
// testIds: launcher-layer, launcher-search, launcher-open-<address>, launcher-close-<address>, search-hit-<address>,
// place-<slug> (radio, notebook, paper, textures, files, mail, books, podcasts, settings as glyphs; activity, told, components in More), launcher-nohits.
use Theme, PageList, LauncherData, LauncherHit from "@choir/autoradio"
use Layer, stackName, kindOf, kindWord, isFixed, pageName, SectionHeader, RowRule from "./ui.contract"

component PlaceRow
  inject
    th: Theme
    openPage: action
  props
    slug: string
    name: string
    address: string
    line: string
  view
    button press=openPage(address, name) testId=`place-${slug}` appearance="none" width="100%" aria-label=`Open ${name}`
      row padding="10px 0" align-items="center" width="100%" gap=8 min-height=44
        column flex=1 gap=2 align-items="flex-start"
          text name font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg text-align="left"
          if line != ""
            text line font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="left" line-clamp=1
        image "symbol:forward-chevron" color=th.muted

// A key page as a glyph (owner, 2026-11-17: "make them glyphs, and then we can remove the key pages label"): a line drawing in the accent colour,
// drawn here as `svg` paths in the app's own line style (round caps, one stroke weight), the same mechanism as the tetramark. Owner, 2026-11-18:
// "glyphs and text labels for the buttons, not just the glyphs": the page's name sits under the glyph. The button's aria-label is the name and the
// visible caption is aria-hidden, so VoiceOver says it once. A touch target of 44 by 44 or more; the row width comes from `cols` (nine glyphs make three rows of three).
component KeyGlyph
  inject
    th: Theme
    openPage: action
  props
    slug: string
    name: string
    address: string
    cols: number
  view
    button press=openPage(address, name) testId=`place-${slug}` appearance="none" width=`${floor(10000 / cols) / 100}%` aria-label=`Open ${name}`
      column min-height=64 padding="6px 2px" gap=4 align-items="center" justify-content="center" pointer-events="none"
        svg viewBox="0 0 24 24" width=28 height=28 fill="none" stroke=th.accent stroke-width=1.7 stroke-linecap="round" stroke-linejoin="round" pointer-events="none"
          if slug == "radio"
            circle cx=12 cy=12 r=1.8
            path d="M8.6 8.6a4.8 4.8 0 0 0 0 6.8"
            path d="M15.4 8.6a4.8 4.8 0 0 1 0 6.8"
            path d="M5.6 5.6a9 9 0 0 0 0 12.8"
            path d="M18.4 5.6a9 9 0 0 1 0 12.8"
          if slug == "notebook"
            rect x=6 y=3 width=13 height=18 rx=1.5
            path d="M3.5 7.5h5M3.5 12h5M3.5 16.5h5M12.5 8h4M12.5 12h4"
          if slug == "paper"
            rect x=4 y=4 width=16 height=16 rx=1.5
            path d="M7.5 8h9M7.5 12h4M7.5 15.5h4M14 12h2.5M14 15.5h2.5"
          if slug == "textures"
            path d="M4 6h16M4 11h16M4 16h9"
            circle cx=18 cy=16.5 r=2
          if slug == "files"
            path d="M3 7.5a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8.5a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"
          if slug == "mail"
            rect x=3 y=6 width=18 height=12 rx=2
            path d="M3.5 8l8.5 6 8.5-6"
          if slug == "imported"
            path d="M12 6.5v13M12 6.5c-2-1.6-5-2.2-8-2.2v13c3 0 6 .6 8 2.2 2-1.6 5-2.2 8-2.2v-13c-3 0-6 .6-8 2.2z"
          if slug == "podcasts"
            rect x=9 y=3 width=6 height=11 rx=3
            path d="M6 11a6 6 0 0 0 12 0M12 17.5v3.5M9 21h6"
          if slug == "settings"
            path d="M4 8h16M4 16h16"
            circle cx=9 cy=8 r=2.2
            circle cx=15 cy=16 r=2.2
        text name testId=`place-label-${slug}` aria-hidden=true font-family=th.fontLabel font-size="-exact-footnote" color=th.fg text-align="center" pointer-events="none"

// One page of the stack: tap to jump to it; a close button when it can be closed.
component StackRow
  inject
    th: Theme
    pg: PageList
    topAddr: string
    focusPage: action
    closePage: action
  props
    address: string
    index: number
  derive name = stackName(pg.rows, address)
  derive word = kindWord(kindOf(address), address)
  derive here = address == topAddr
  view
    row width="100%" align-items="center" gap=4 min-height=48
      button press=focusPage(address) testId=`launcher-open-${address}` appearance="none" flex=1 min-width=0 aria-label=`${here ? "Current page, " : "Go to "}${name}, ${word}`
        row align-items="center" gap=10 width="100%" padding="6px 0"
          text `${index + 1}` font-family=th.fontLabel font-size="-exact-caption1" color=th.muted width=18 font-variant-numeric="tabular-nums"
          column flex=1 min-width=0 gap=1 align-items="flex-start"
            text name font-family=th.fontHead font-size="-exact-callout" font-weight=600 color=th.fg line-clamp=1 text-align="left"
            if name.startsWith(word) == false
              text word font-family=th.fontLabel font-size="-exact-caption2" font-weight=600 letter-spacing=0.6 text-transform="uppercase" color=th.muted
          if here
            box width=3 height=18 background-color=th.accent
          image "symbol:forward-chevron" color=th.muted
      if isFixed(address) == false and here == false
        button press=closePage(address) testId=`launcher-close-${address}` appearance="none" width=44 height=44 aria-label=`Remove ${name} from the deck`
          row width=44 height=44 align-items="center" justify-content="center"
            image "symbol:close" color=th.muted

component Launcher
  inject
    th: Theme
    pg: PageList
    lnc: LauncherData
    shownHits: LauncherHit[]
    shownNote: string
    lq: string
    stackAddrs: string[]
    editLq: action
    openPage: action
  view
    Layer(testId="launcher-layer")
      scroll testId="launcher-scroll" overflow-x="hidden" flex=1 min-height=0 width="100%"
        column padding=20 gap=6 padding-bottom=24 box-sizing="border-box" width="100%" min-width=0
          input type="search" value=lq input=editLq placeholder="Search the paper and your pages" aria-label="Search" testId="launcher-search"
            font-family=th.fontText font-size=17 color=th.fg min-height=48 padding="8px 0px" border-width=0 background-color="transparent"
            ::placeholder
              color=th.muted
          RowRule(indent=0)
          if lnc.hasQuery
            for h in shownHits key=h.address
              button press=openPage(h.address, pageName(h.title, h.address)) testId=`search-hit-${h.address}` appearance="none" width="100%"
                row padding="8px 0" gap=8 align-items="center" width="100%"
                  column gap=2 align-items="flex-start" flex=1 min-width=0
                    text pageName(h.title, h.address) font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg text-align="left" line-clamp=2
                    row gap=6
                      text kindWord(kindOf(h.address), h.address) font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
                      text h.detail font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="left" line-clamp=2
                  image "symbol:forward-chevron" color=th.muted
            if shownNote != ""
              text shownNote testId="launcher-search-note" font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted
            if shownHits.length == 0 and shownNote == ""
              text "Nothing found." testId="launcher-nohits" font-family=th.fontLabel font-size="-exact-subheadline" color=th.muted
          if lnc.hasQuery == false
            row flex-wrap="wrap" gap=0 width="100%" testId="launcher-key-pages"
              // nine glyphs: a row holds `cols` of them (3), so three even rows
              KeyGlyph(slug="radio", name="Autoradio", address="radio:", cols=3)
              KeyGlyph(slug="notebook", name="My notebook", address="notebook:", cols=3)
              KeyGlyph(slug="paper", name="Paper", address="paper:front", cols=3)
              KeyGlyph(slug="textures", name="Textures", address="textures:", cols=3)
              KeyGlyph(slug="files", name="Files", address="file:/", cols=3)
              KeyGlyph(slug="mail", name="Mail", address="mailbox:inbox", cols=3)
              KeyGlyph(slug="imported", name="Imported documents", address="imported:", cols=3)
              KeyGlyph(slug="podcasts", name="Podcasts", address="podcasts:", cols=3)
              KeyGlyph(slug="settings", name="Settings", address="settings:root", cols=3)
            SectionHeader(label="In the deck, top first")
            for a, i in stackAddrs key=a
              StackRow(address=a, index=i)
            SectionHeader(label="More")
            PlaceRow(slug="activity", name="Activity", address="activity:", line="What your computer has been doing")
            PlaceRow(slug="edit-edition", name="Edit my edition", address="onboarding:edit", line="Topics you follow")
            PlaceRow(slug="told", name="What I've told the paper", address="settings:learned", line="")
