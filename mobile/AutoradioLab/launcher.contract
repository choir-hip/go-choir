// The launcher (round 3): opened by the mark, as on choir.news; it rises above the bar, which stays visible and usable under it.
// It opens the key pages (each comes to the top of the deck) and lists the pages now in the deck (tap to bring one to the top, a
// remove button on opened ones; the key pages stay), and the app's other destinations,
// plus search over pages, files and stories. Titles are human: a page's title, else one made from its slug; never an address.
// The panel is placed by the bar (bar.contract); the scrim behind the page is the root's.
// testIds: launcher-layer, launcher-search, launcher-open-<address>, launcher-close-<address>, search-hit-<address>,
// place-<slug> (paper, textures, files, mail, settings, activity, told, components), launcher-nohits.
use Theme, PageList, LauncherData from "@choir/autoradio"
use Layer, stackName, kindOf, kindWord, isFixed, pageName from "./ui.contract"

component PlaceRow
  inject
    th: Theme
    openPage: action
  props
    slug: string
    name: string
    address: string
    line: string
  view
    button press=openPage(address, name) testId=`place-${slug}` appearance="none" width="100%" aria-label=`Open ${name}`
      row padding="10px 0" align-items="center" width="100%" gap=8 min-height=44
        column flex=1 gap=2 align-items="flex-start"
          text name font-family=th.fontUi font-size=17 font-weight=600 color=th.fg text-align="left"
          if line != ""
            text line font-family=th.fontUi font-size=13 color=th.muted text-align="left" line-clamp=1
        image "symbol:forward-chevron" color=th.muted

// A key page as a chip: tap to bring it to the top of the deck.
component ChipPlace
  inject
    th: Theme
    openPage: action
  props
    slug: string
    name: string
    address: string
  view
    button press=openPage(address, name) testId=`place-${slug}` appearance="none" flex-shrink=0 aria-label=`Open ${name}`
      row padding="10px 12px" border-radius=th.radiusPill align-items="center" justify-content="center" min-height=44 background-color=th.paper2 border-width=1 border-style="solid" border-color=th.rule
        text name font-family=th.fontUi font-size=15 font-weight=600 color=th.fg

// One page of the stack: tap to jump to it; a close button when it can be closed.
component StackRow
  inject
    th: Theme
    pg: PageList
    topAddr: string
    focusPage: action
    closePage: action
  props
    address: string
    index: number
  derive name = stackName(pg.rows, address)
  derive word = kindWord(kindOf(address), address)
  derive here = address == topAddr
  view
    row width="100%" align-items="center" gap=4 min-height=48
      button press=focusPage(address) testId=`launcher-open-${address}` appearance="none" flex=1 min-width=0 aria-label=`${here ? "Current page, " : "Go to "}${name}, ${word}`
        row align-items="center" gap=10 width="100%" padding="6px 0"
          text `${index + 1}` font-family=th.fontMono font-size=12 color=th.muted width=18
          column flex=1 min-width=0 gap=1 align-items="flex-start"
            text name font-family=th.fontUi font-size=16 font-weight=(here ? 700 : 500) color=th.fg line-clamp=1 text-align="left"
            text word font-family=th.fontUi font-size=11 font-weight=600 letter-spacing=0.6 text-transform="uppercase" color=(here ? th.accent : th.muted)
          if here
            box width=8 height=8 border-radius=4 background-color=th.accent
      if isFixed(address) == false and here == false
        button press=closePage(address) testId=`launcher-close-${address}` appearance="none" width=44 height=44 aria-label=`Remove ${name} from the deck`
          row width=44 height=44 align-items="center" justify-content="center"
            image "symbol:close" color=th.muted

component Launcher
  inject
    th: Theme
    pg: PageList
    lnc: LauncherData
    lq: string
    stackAddrs: string[]
    editLq: action
    openPage: action
  view
    Layer(testId="launcher-layer")
      scroll testId="launcher-scroll" flex=1 min-height=0 width="100%"
        column padding=20 gap=6 padding-bottom=24 box-sizing="border-box" width="100%"
          input type="search" value=lq input=editLq placeholder="Search pages, files, mail" aria-label="Search" testId="launcher-search"
            font-family=th.fontUi padding="10px 4px"
          if lnc.hasQuery
            for h in lnc.hits key=h.address
              button press=openPage(h.address, pageName(h.title, h.address)) testId=`search-hit-${h.address}` appearance="none" width="100%"
                column padding="8px 0" gap=2 align-items="flex-start" width="100%"
                  text pageName(h.title, h.address) font-family=th.fontUi font-size=17 font-weight=600 color=th.fg text-align="left" line-clamp=2
                  row gap=6
                    text kindWord(kindOf(h.address), h.address) font-family=th.fontUi font-size=12 font-weight=700 color=th.accent
                    text h.detail font-family=th.fontUi font-size=13 color=th.muted text-align="left" line-clamp=1
            if lnc.hits.length == 0
              text "Nothing found." testId="launcher-nohits" font-family=th.fontUi font-size=15 color=th.muted
          if lnc.hasQuery == false
            text "Key pages" font-family=th.fontUi font-size=13 color=th.muted margin-top=4
            scroll overflow-x="scroll" overflow-y="hidden" display="flex" flex-direction="row" gap=8 width="100%" testId="launcher-key-pages"
              ChipPlace(slug="paper", name="Paper", address="paper:front")
              ChipPlace(slug="textures", name="Textures", address="textures:")
              ChipPlace(slug="files", name="Files", address="file:/")
              ChipPlace(slug="mail", name="Mail", address="mailbox:inbox")
              ChipPlace(slug="settings", name="Settings", address="settings:root")
            text "In the deck, top first" font-family=th.fontUi font-size=13 color=th.muted margin-top=8
            for a, i in stackAddrs key=a
              StackRow(address=a, index=i)
            text "More" font-family=th.fontUi font-size=13 color=th.muted margin-top=12
            PlaceRow(slug="activity", name="Activity", address="activity:", line="What your computer has been doing")
            PlaceRow(slug="told", name="What I've told the paper", address="texture:what-i-told-the-paper", line="")
            PlaceRow(slug="components", name="Components", address="lab:components", line="Voice models and tools")
