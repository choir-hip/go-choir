// Lane members file (mail): this lane's states, derives, resources, mutations and actions, as if written in the root.
// The sources are answered by app.ts (mail.ts), with positional arguments (named ones belong to a package's sources): the shapes are in mail-types.contract.
// The approval page opens in the radio's shared web layer (mailReviewOpen, mail.ts). "Read this to me" is shared code's radio (radioListen, radio-bridge.ts).
//
// One resource per page family, each asked for the top page's address and answering "idle" at once for any other
// address, so only the page in front does any work: mbx (a mailbox), mmsg (a message), mcmp (a compose page: a reply,
// a new message, or an existing draft). The compose fields are local state that takes the resource's seed (the
// reply's recipient, subject and quoted text) the first time the person edits; after that the person's words win.
use choirAsk, SettingsAck from "@choir/autoradio"
use MailAck, MailNote, MailBoxView, MailMessageView, MailComposeView, MailSyncView from "./mail-types.contract"

members Autoradio
  // The mailbox's tab is page state, not a page: tapping a tab changes `mboxSel` in the same action, so the frame (title, tabs, counts)
  // never leaves and the content under it starts its transition at the tap (transitions.contract). `mfr` answers at once from the
  // cache (the tabs, their counts, the last list seen); `mbx` is the fetch, newest request wins.
  state mboxFor = ""
  state mboxSel = ""
  state mboxDir = 0
  derive mboxAddr = (mboxFor == pg.top and mboxSel != "") ? mboxSel : pg.top
  derive mboxName = mboxAddr.startsWith("mailbox:") ? mboxAddr.slice(8) : "inbox"
  // Arguments: the address; (message only) whether "Show original" is open on this page, which is when its document is written.
  resource mbx = mailBox(mboxAddr, acs.state) as shape MailBoxView else empty()
  resource mfr = mailFrame(mboxAddr) as shape MailBoxView else empty()
  // The catch-up that keeps the phone's copy: asked again when the list arrives, answers counts only.
  resource msy = mailSync(mboxAddr, mbx.rows.length) as shape MailSyncView else empty()
  resource mmsg = mailMessage(pg.top, mailOriginal, acs.state) as shape MailMessageView else empty()
  resource mcmp = mailCompose(pg.top) as shape MailComposeView else empty()
  mutation mdr as shape MailComposeView refreshes mbx
  mutation mak as shape MailAck
  mutation mro as shape MailAck refreshes qv, rpulse
  mutation mrd as shape SettingsAck refreshes rpulse
  // Marking unread asks the computer, then the mailbox and the message are read again (the message is not marked read a second time: mail.ts).
  mutation mun as shape MailAck refreshes mbx, mfr, mmsg

  // The compose fields, and the page they belong to.
  state mailFor = ""
  state mailTo = ""
  state mailSubject = ""
  state mailBody = ""
  // Per-page view toggles: the address they are on for ("" none).
  state mailQuotedFor = ""
  state mailOriginalFor = ""
  state mailNoteFor = ""

  derive mailSeeded = mailFor == pg.top
  derive mailCurTo = mailSeeded ? mailTo : mcmp.toLine
  derive mailCurSubject = mailSeeded ? mailSubject : mcmp.subject
  derive mailCurBody = mailSeeded ? mailBody : mcmp.body

  derive mdrFor = match mdr { case some(d) => d.forAddress, case none => "" }
  derive mdrStatus = match mdr { case some(d) => d.status, case none => "" }
  derive mdrDraft = match mdr { case some(d) => d.draftId, case none => "" }
  derive mdrNote = match mdr { case some(d) => d.note, case none => "" }
  derive mdrUrl = match mdr { case some(d) => d.reviewURL, case none => "" }
  derive mdrSendAs = match mdr { case some(d) => d.sendAs, case none => "" }
  derive mdrMine = mdrFor == pg.top
  // What the compose page shows about the draft: the last save or approval for this page, else what the server said.
  derive mailDraftStatus = mdrMine ? mdrStatus : mcmp.status
  derive mailDraftId = mdrMine and mdrDraft != "" ? mdrDraft : mcmp.draftId
  derive mailDraftNote = mdrMine ? mdrNote : mcmp.note
  derive mailDraftUrl = mdrMine ? mdrUrl : ""
  derive mailDraftFrom = mdrMine and mdrSendAs != "" ? mdrSendAs : mcmp.sendAs

  derive mailQuoted = mailQuotedFor == pg.top
  derive mailOriginal = mailOriginalFor == pg.top
  // ONE notice state: the last action sets `mailNoteSrc`, and the words are chosen from it in shared code (mail.ts `noteOf`), so an earlier answer (Mark unread, Ask) never hides the note of Read it to me.
  state mailNoteSrc = ""
  derive mailUnreadMsg = match mun { case some(a) => a.message, case none => "" }
  derive mailAskMsg = match mak { case some(a) => a.message, case none => "" }
  derive mailReviewMsg = match mro { case some(a) => a.message, case none => "" }
  resource mnote = mailNoteSelect(mailNoteSrc, mailUnreadMsg, mailAskMsg, mmsg.spoken, mailReviewMsg) as shape MailNote else empty()
  derive mailNoteRaw = mnote.text
  derive mailNote = mailNoteFor == pg.top ? mailNoteRaw : ""

  action editMailTo(v: string)
    if mailFor != pg.top
      mailSubject = mcmp.subject
      mailBody = mcmp.body
      mailFor = pg.top
    mailTo = v
  action editMailSubject(v: string)
    if mailFor != pg.top
      mailTo = mcmp.toLine
      mailBody = mcmp.body
      mailFor = pg.top
    mailSubject = v
  action editMailBody(v: string)
    if mailFor != pg.top
      mailTo = mcmp.toLine
      mailSubject = mcmp.subject
      mailFor = pg.top
    mailBody = v

  action saveMailDraft
    send mdr = mailSaveDraft(pg.top, mailCurTo, mailCurSubject, mailCurBody)
  action approveMail
    send mdr = mailApprovalEmail(pg.top, mailDraftId)
  action openMailReview(url: string)
    mailNoteFor = pg.top
    mailNoteSrc = "review"
    send mro = mailReviewOpen(url)

  action toggleMailQuoted
    mailQuotedFor = mailQuotedFor == pg.top ? "" : pg.top
  action toggleMailOriginal
    mailOriginalFor = mailOriginalFor == pg.top ? "" : pg.top
  action readMail
    mailNoteFor = pg.top
    mailNoteSrc = "read"
    send mrd = radioListen(pg.top, mmsg.subject, mmsg.spoken)
  action unreadMail
    mailNoteFor = pg.top
    mailNoteSrc = "unread"
    send mun = mailMarkUnread(pg.top)
  action askMail(q: string)
    mailNoteFor = pg.top
    mailNoteSrc = "ask"
    send mak = mailAsk(pg.top, q)
    if offerSignIn
      gate = "signin"
    if au.signedIn
      send acct = choirAsk(text=q, aim=pg.top)
  // Tap a tab: synchronous. The direction is the new tab's side of the old one; the outgoing content leaves at once.
  action mailTab(name: string)
    mboxDir = (["inbox", "drafts", "sent", "quarantine"].indexOf(name) > ["inbox", "drafts", "sent", "quarantine"].indexOf(mboxName)) ? 1 : -1
    mboxFor = pg.top
    mboxSel = `mailbox:${name}`
  action retryMail
    refresh mbx
    refresh mmsg
    refresh mcmp
