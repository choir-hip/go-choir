// The shapes of the model downloads page (downloads.ts `downloadsPage`).
shape DownloadOption
  id: string
  text: string
  tag: string
  note: string
  credit: string
  withheld: bool
  selected: bool
  ready: bool

shape DownloadJob
  job: string
  title: string
  options: DownloadOption[]
  ready: bool
  none: string

shape DownloadGroup
  id: string
  title: string
  why: string
  jobs: DownloadJob[]
  total: string
  host: string
  ready: bool
  busy: bool
  status: string
  onWiFi: bool
  mobileLine: string
  startLabel: string
  mobileLabel: string
  hostLine: string
  canStart: bool

shape DownloadsView
  groups: DownloadGroup[]
  rev: number
  voiceReady: bool
  hearingReady: bool
  setupTotal: string
  voiceNote: string
