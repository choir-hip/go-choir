// The expanded player: a layer (elevation 3) that rises from the bar while the page behind steps back (plan section 1,
// "The expanded player"). Lane 1 owns this file. It shows what the radio plays and what it is saying right now:
//   - the document's title, the position, the passage being read with the current sentence lit (the sentence is an
//     estimate from the play clock, BarState.swift), the next passage dimmed;
//   - the programme as segments (tap one to jump) and as rows (tap one to jump);
//   - transport: previous, play and pause, next, and the reading speed;
//   - the talk status: the listener's words, the holding line, and when the programme yields to the listener ("Radio
//     lowered/paused while you speak");
//   - the talk mode as the engine has it (hold / just speak / hold or speak). The prompt is the bar's, not the player's.
// Design pass (lane autoradio-design, 2026-11-15): top to bottom, what is playing (kind, title, position), its progress (the scrubber with
// elapsed and remaining for audio, the segments for a programme), then what is happening and what is read, Up next, and the programme; the
// transport and the speed are always at the foot. Nothing is hidden by a state: the five transport buttons and the speed are always there
// (for remote audio the two skip buttons are -15 s and +15 s, for a story one passage back and forward). Same testIds as before.
// Pull the header down to put it away. Everything is declarative motion (keyframes and transitions), off under Reduce Motion.
// A programme (station P1): the title is the segment's, "NOW PLAYING · STORY" names its kind (player-kind), its labelled sources are
// chips (player-sources, player-source-<k>), the position counts segments, the segments and rows are segments, previous and next skip
// by segment. One article: as before.
// testIds: player, player-scrim, player-layer, player-title, player-position, player-status, player-yield, player-passage,
// player-sentence-<k>, player-next-passage, player-segments, player-seg-<i>, player-item-<i>, player-prev, player-play,
// player-next, player-prev-story, player-next-story, player-speed, player-speed-slider, player-speed-down, player-speed-up,
// player-speed-reset, player-mode, player-close.
// Owner QA round 1 (2026-11-15): previous and next STORY flank the two skip buttons (the skip buttons still move one passage, or one
// segment in a programme); the speed is a slider from 0.5x to 3x in steps of 0.05, dragged anywhere along the track (the move is
// relative: `pan` gives the move since its last event), with a minus and a plus for one step and 1x to reset. The speed is sent when
// the finger lifts, so the voice does not stutter while it is dragged.
use Theme, BarInfo, RadioInfo from "@choir/autoradio"
use Layer, Card, SectionHeader from "./ui.contract"
use QueueInfo from "@choir/autoradio"
use QueueAudio, QueueScrub, UpNext from "./queue.contract"

keyframes playerRise
  from opacity=0 translate="0px 56px"
keyframes playerLeave
  to opacity=0 translate="0px 56px" animation-timing-function="ease-in"
keyframes playerFade
  from opacity=0
keyframes playerIn
  from opacity=0 translate="0px 6px"
keyframes playerBlink
  50% opacity=0.25

component PlayerLayer
  inject
    th: Theme
    bi: BarInfo
    ri: RadioInfo
    qv: QueueInfo
    queueDo: action
    hideLayer: action
    radioPlay: action
    previous: action
    next: action
    previousStory: action
    nextStory: action
    jumpTo: action
    speedShown: number
    speedPct: number
    speedMove: action
    speedEnd: action
    speedNudge: action
    speedReset: action
    sheetMove: action
    sheetEnd: action
  derive still = th.reducedMotion
  derive calm = still ? 0 : 1
  derive listener = bi.state == "listening" or bi.state == "talking" or bi.state == "heard"
  derive statusLine = listener ? (ri.heard == "" ? "Listening…" : `You: ${ri.heard}`) : (bi.state == "holding" ? bi.text : (bi.state == "revised" ? "Revised. Reading the new passage" : ""))
  derive yieldNote = ri.level == "dip" ? "Radio lowered while you speak" : (ri.level == "pause" ? "Radio paused while you speak" : "")
  view
    Layer(testId="player-layer")
      column flex=1 min-height=0 width="100%"
        // what is playing: pull this down to put the player away
        column pan=sheetMove panrelease=sheetEnd padding="8px 20px 4px" gap=6
          row justify-content="center"
            box width=36 height=3 background-color=th.rule
          row align-items="center" gap=8
            column flex=1 min-width=0 gap=2
              text (ri.kind == "" ? "NOW PLAYING" : `NOW PLAYING · ${ri.kind.toUpperCase()}`) testId="player-kind" font-family=th.fontUi font-size=12 font-weight=700 letter-spacing=0.9 color=th.muted line-clamp=1
              text (ri.title == "" ? "Autoradio" : ri.title) testId="player-title" role="heading" aria-level=2 line-clamp=2
                font-size=22 font-weight=700 font-family=th.fontRead color=th.fg
              if qv.audio == false and ri.position != ""
                text ri.position testId="player-position" font-size=13 font-family=th.fontUi color=th.muted
            button press=hideLayer testId="player-close" aria-label="Close the player" appearance="none" width=44 height=44
              image "symbol:close" color=th.muted
        // progress: the scrubber with elapsed and remaining for remote audio, the segments of a programme otherwise
        if qv.audio
          column padding="0px 20px 4px" width="100%" box-sizing="border-box"
            QueueScrub()
        if qv.audio == false and ri.items.length > 0
          row gap=3 testId="player-segments" padding="0px 20px 4px" width="100%" box-sizing="border-box"
            for it in ri.items key=it.i
              column flex=1 min-width=0
                button press=jumpTo(it.i) testId=`player-seg-${it.i}` appearance="none" width="100%" height=28 aria-label=`Go to passage ${it.i + 1}`
                  column height=28 justify-content="center" width="100%"
                    box width="100%" height=(it.current ? 6 : 4)
                      background-color=(it.current ? th.accent : (it.done ? th.muted : th.rule))
                      transition=`height ${th.motionFastMs * calm}ms ease, background-color ${th.motionFastMs * calm}ms ease`
        scroll overflow-x="hidden" flex=1 min-height=0 width="100%"
          column width="100%" box-sizing="border-box" min-width=0 padding="4px 20px 12px" gap=16
            // what is happening now: the listener's words, the holding line, the yield
            if statusLine != "" or yieldNote != ""
              column testId="player-status" gap=6 justify-content="center" min-height=40
                if statusLine != ""
                  text statusLine font-family=th.fontUi font-size=15 color=(listener ? th.fg : th.muted) font-style=(listener ? "italic" : "normal") line-clamp=3
                    animation=(still ? "none" : "playerIn 200ms ease-out both")
                if yieldNote != ""
                  row gap=6 align-items="center" testId="player-yield"
                    box width=3 height=12 background-color=th.accent animation=(still ? "none" : "playerBlink 1.1s ease-in-out infinite")
                    text yieldNote font-family=th.fontUi font-size=13 font-weight=600 color=th.muted
            // a clip: keep listening to the episode it is cut from
            QueueAudio()
            // the passage being read, the current sentence lit
            if ri.sentences.length > 0
              Card(level=2, testId="player-card", minHeight=0)
                column padding=18 gap=10
                  column testId="player-passage" gap=6
                    for s, k in ri.sentences key=k
                      text s testId=`player-sentence-${k}` font-family=th.fontRead font-size=19 line-height=1.5
                        color=(k == ri.sentenceIndex ? th.fg : th.muted) font-weight=(k == ri.sentenceIndex ? 600 : 400)
                        transition=`color ${th.motionFastMs * calm}ms ease`
            // Up next: the one queue, with who added each item
            UpNext()
            // the sources of the segment, as the server labelled them (a programme only; never raw refs)
            if ri.sources.length > 0
              column gap=8 width="100%"
                SectionHeader(label="Sources")
                row gap=16 flex-wrap="wrap" testId="player-sources"
                  for src, k in ri.sources key=k
                    row align-items="center" min-height=28 testId=`player-source-${k}`
                      text src font-family=th.fontUi font-size=13 color=th.muted line-clamp=1
            if ri.next != ""
              column gap=4 testId="player-next-passage"
                SectionHeader(label="Next passage")
                text ri.next font-family=th.fontRead font-size=16 line-height=1.4 color=th.muted line-clamp=3
            // the programme: tap a row to jump
            if ri.items.length > 0
              column gap=4 width="100%"
                SectionHeader(label="Programme")
                column gap=0
                  for it in ri.items key=it.i
                    button press=jumpTo(it.i) testId=`player-item-${it.i}` appearance="none" width="100%"
                      row gap=10 align-items="flex-start" padding="8px 0" width="100%"
                        text `${it.i + 1}` font-family=th.fontMono font-size=13 color=th.muted width=22
                        text it.text flex=1 min-width=0 line-clamp=2 text-align="left" font-family=th.fontRead font-size=15
                          color=(it.current ? th.fg : th.muted) font-weight=(it.current ? 600 : 400)
                        if it.kind == "you"
                          text "You" font-family=th.fontUi font-size=12 font-weight=700 color=th.muted
        // transport: always the same five buttons in the same places; the two skips are 15 seconds for remote audio, a passage otherwise
        column gap=8 padding="8px 20px 4px" align-items="center"
          row gap=14 justify-content="center" align-items="center"
            button press=previousStory testId="player-prev-story" aria-label="Previous story" appearance="none" width=44 height=44
              row width=44 height=44 align-items="center" justify-content="center"
                image "symbol:sf/backward.end.fill" color=th.fg
            if qv.audio
              button press=queueDo("back15", "") testId="queue-back15" appearance="none" aria-label="Back 15 seconds" width=44 height=44
                image "symbol:skip-back-15" color=th.fg
            else
              button press=previous testId="player-prev" aria-label="Previous passage" appearance="none" width=44 height=44
                image "symbol:skip-back-15" color=th.fg
            button press=radioPlay testId="player-play" aria-label=(ri.playing ? "Pause" : "Play") appearance="none" width=60 height=60
              row width=56 height=56 align-items="center" justify-content="center"
                if ri.playing
                  image "symbol:pause-fill" width=36 height=36 color=th.accent
                else
                  image "symbol:play-fill" width=36 height=36 color=th.accent
            if qv.audio
              button press=queueDo("fwd15", "") testId="queue-fwd15" appearance="none" aria-label="Forward 15 seconds" width=44 height=44
                image "symbol:skip-forward-15" color=th.fg
            else
              button press=next testId="player-next" aria-label="Next passage" appearance="none" width=44 height=44
                image "symbol:skip-forward-15" color=th.fg
            button press=nextStory testId="player-next-story" aria-label="Next story" appearance="none" width=44 height=44
              row width=44 height=44 align-items="center" justify-content="center"
                image "symbol:sf/forward.end.fill" color=th.fg
          // the speed: its value and a reset, then the slider from 0.5x to 3x between a minus and a plus (the drag maths in members-bar.contract
          // assumes this track, the width less 120)
          row gap=8 width="100%" align-items="center"
            text "Speed" font-family=th.fontUi font-size=13 font-weight=600 color=th.muted
            text `${speedShown}×` testId="player-speed" font-family=th.fontUi font-size=14 font-weight=700 color=th.fg flex=1
            button press=speedReset testId="player-speed-reset" appearance="none" aria-label="Reset the speed to 1 times"
              row min-height=44 padding="0px 4px" align-items="center" justify-content="center"
                text "1×" font-family=th.fontUi font-size=15 font-weight=600 color=th.accent
          row gap=6 width="100%" align-items="center"
            button press=speedNudge(0 - 0.05) testId="player-speed-down" appearance="none" aria-label="Slower" width=44 height=44
              row width=44 height=44 align-items="center" justify-content="center"
                text "−" font-family=th.fontUi font-size=22 font-weight=600 color=th.fg
            column flex=1 min-width=0 height=44 justify-content="center" pan=speedMove panrelease=speedEnd testId="player-speed-slider" aria-label="Speed"
              row width="100%" height=22 align-items="center" padding-left=11
                box width=`${speedPct}%` height=4 background-color=th.accent
                row width=22 height=22 margin-left=-11 justify-content="center"
                  box width=3 height=22 background-color=th.accent
                box flex=1 height=4 background-color=th.rule
            button press=speedNudge(0.05) testId="player-speed-up" appearance="none" aria-label="Faster" width=44 height=44
              row width=44 height=44 align-items="center" justify-content="center"
                text "+" font-family=th.fontUi font-size=22 font-weight=600 color=th.fg
        // the prompt is the bar's (one field, not two), so the player has none
