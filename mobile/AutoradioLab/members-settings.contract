// Lane members file (settings): this lane's states, derives, resources, mutations and actions, as if written in the root.
// Owned by the settings lane (lane 7). Shapes are in exact-package/interface/settings.json; the theme sources are answered by app.ts (themes.ts); the module is
// exact-package/apple/AutoradioModule+Settings.swift. Every name a child component injects is in the lane 7 band of `provide`.
use settingsFacts from "@choir/autoradio"
use ThemeCards, ThemeExtras, SettingsAck, LearnedInfo, SettingsFacts from "@choir/autoradio"

use SettingsAccount, AboutBuild, SettingsComputer, ActivityInfo, AboutInfo, SettingsTime from "./settings-types.contract"
use DeleteView, DeleteEnd from "./account-types.contract"

members Autoradio
  // Themes: themes.ts (shared code); the same two host facts as the theme itself (spine.contract).
  resource tc = themeCards(vp.prefersColorScheme, vp.prefersReducedMotion) as shape ThemeCards else empty(mode="system", themeID="chrome-pastel", scheme="light")
  resource tx = themeExtras(vp.prefersColorScheme, vp.prefersReducedMotion) as shape ThemeExtras else empty(sizeNameplate=36, sizeHeadline=28, sizeH2=19, sizeBody=18, sizeLabel=15, sizeMeta=13, lineBody=1.6, lineHeadline=1.12, weightHeadline=700, weightUi=600, flipStiffness=300, flipDamping=22, markTumbleAS=3.3, markTumbleBS=5.9, markStatic=false, pressTint=false, reduceMotion=false, contrast="AA")
  // The account is answered by app.ts (settings.ts): signed in (the Swift sign-in) and a tick the Refresh button moves.
  state acctTick = 0
  resource acctInfo = settingsAccount(au.signedIn, acctTick) as shape SettingsAccount else empty()
  // The Computer page (computer.ts): its state is one process's; the Restart to update poll is the task below.
  resource cmpt = settingsComputer(au.signedIn, acctTick) as shape SettingsComputer else empty()
  mutation cmm as shape SettingsComputer refreshes cmpt, act
  state actTick = 0
  // What only native code knows for these pages (the app's version, the radio engine's phase and kept turns): one source.
  resource sfacts = settingsFacts(tick=actTick) as shape SettingsFacts else empty()
  // "What the paper has learned" (cards.ts): the acts the listener told the paper, kept under app:/data.
  resource learnt = learnedInfo(0) as shape LearnedInfo else empty()
  // Activity (activity.ts): the changelog, with the radio's rows from the native facts and the computer's line from computer.ts.
  // The date the rows' ages are measured from is Exact's own (`stime`), passed after `with` (it differs at every ask); whether it has answered (`current`) is a call argument, so the rows are asked again when it turns true and no age is shown from a placeholder.
  resource stime = exactTime() as shape SettingsTime else empty()
  resource act = activityPage(sfacts, au.signedIn, actTick, cmpt.state, cmpt.updateAvailable, cmpt.checked, current(stime)) with stime.epochAtZero + performanceNow() as shape ActivityInfo else empty()
  resource about = aboutPage(sfacts, au.signedIn) as shape AboutInfo else empty()
  // The commits (shared code, about.ts): the app's own and the server's. The tick is the Refresh button's.
  resource bld = aboutBuild(acctTick) as shape AboutBuild else empty()
  mutation sm as shape SettingsAck

  // The id of a theme Texture typed in Appearance.
  state themeDoc = ""
  action editThemeDoc(v: string)
    themeDoc = v
  action loadThemeDoc
    send thm = themeFromTexture(themeDoc)
  action removeTheme(id: string)
    send thm = themeRemove(id)

  action refreshAccount
    acctTick = acctTick + 1
  action refreshComputer
    send cmm = computerAct("refresh", au.signedIn)
  action wakeComputer
    send cmm = computerAct("wake", au.signedIn)
  action updateComputer
    send cmm = computerAct("update", au.signedIn)
  state cpTick = 0
  action pollComputer
    cpTick = cpTick + 1
    send cmm = computerAct("poll", au.signedIn)
  // Restart to update: look at the update signal again every 1.5 s while it runs (computer.ts C3; at most 40 looks).
  task computerPoll when cmpt.phase == "updating" key=cpTick
    after(1500, pollComputer)
  mutation lm as shape SettingsAck refreshes learnt
  action resetLearned
    send lm = learnedReset()
  action refreshActivity
    actTick = actTick + 1
    send cmm = computerAct("refresh", au.signedIn)

  // DELETE ACCOUNT (account-delete.ts, owner 2026-11-23): one run with a state machine owned in shared code; this file renders its view and sends the person's presses. The confirmation step
  // (`delAsk`) is only this page's: nothing is asked of the server until "Delete with passkey". A press answers with the run's `rev`; settling bumps the tick so the last change is read.
  mutation delRun as shape DeleteEnd then bumpDel
  mutation delOpen as shape DeleteEnd then bumpDel
  state delAsk = false
  state delTick = 0
  action bumpDel
    delTick = delTick + 1
  derive delKey = `${delTick}|${match delRun { case some(r) => r.rev, case none => 0 }}|${match delOpen { case some(r) => r.rev, case none => 0 }}`
  resource delv = accountDeleteView(delKey) as shape DeleteView else empty()
  // Asked again twice a second while the passkey screen or the server is awaited (the run changes under a running answer, with no event to carry it), and not at all otherwise.
  task delWatch when pending(delRun) key=delTick
    after(500, bumpDel)
  action askDelete
    delAsk = true
  // "Keep my account" and "Back": the confirmation goes away and an old failure is forgotten.
  action keepAccount
    delAsk = false
    send delOpen = accountDeleteOpen()
    delTick = delTick + 1
  action confirmDelete
    send delRun = accountDeleteRun(hpg.platform)
    delTick = delTick + 1
