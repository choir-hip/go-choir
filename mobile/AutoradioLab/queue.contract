// The queue's screens (lane autoradio-queue): "Up next" and the audio controls in the expanded player, and the page a URL typed in the bar
// opens in place. Built from the design components in ui.contract (SectionHeader, PlainList, RowRule, EmptyState).
// testIds: queue-audio, queue-elapsed, queue-remaining, queue-scrub, player-keep, queue-up-next, queue-row-<i>, queue-remove-<i>,
// queue-note-<i>, queue-empty, bar-web, bar-web-close, bar-web-read, bar-web-add, bar-web-host.
use Theme, QueueInfo from "@choir/autoradio"
use Card, Btn, SectionHeader, PlainList, RowRule, EmptyState, BarClear, sentence from "./ui.contract"

// The scrubber of remote audio, under the player's title: elapsed, the track, remaining. Dragged like the speed slider (the move is relative,
// the position is sent when the finger lifts). The track is the width less 120 (`scrubMove` in members-queue.contract).
component QueueScrub
  inject
    th: Theme
    qv: QueueInfo
    scrubMove: action
    scrubEnd: action
    scrubPct: number
  view
    row gap=8 align-items="center" width="100%" testId="queue-audio-progress"
      text qv.elapsedLabel testId="queue-elapsed" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted width=52 font-variant-numeric="tabular-nums"
      column flex=1 min-width=0 height=44 justify-content="center" pan=scrubMove panrelease=scrubEnd testId="queue-scrub" aria-label="Position"
        row width="100%" height=22 align-items="center" padding-left=11
          box width=`${scrubPct}%` height=4 background-color=th.accent
          row width=22 height=22 margin-left=-11 justify-content="center"
            box width=3 height=22 background-color=th.accent
          box flex=1 height=4 background-color=th.rule
      text qv.remainingLabel testId="queue-remaining" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted width=60 text-align="right" font-variant-numeric="tabular-nums"

// A clip: it says what it is cut from and offers Keep listening (the episode carries on past the clip's end). The 15 second skips are the
// player's transport (player.contract); the scrubber is QueueScrub. Nothing is drawn when the audio is a whole episode.
component QueueAudio
  inject
    th: Theme
    qv: QueueInfo
    queueDo: action
  view
    if qv.audio and qv.clip
      Card(level=1, testId="queue-audio", minHeight=0)
        column padding=16 gap=12
          column gap=2
            text "CLIP" font-family=th.fontLabel font-size="-exact-caption1" font-weight=600 letter-spacing=0.9 color=th.muted
            text `From ${qv.keepTitle}` font-family=th.fontLabel font-size="-exact-subheadline" color=th.fg line-clamp=2
          button press=queueDo("keep", "") testId="player-keep" appearance="none" width="100%" aria-label=`Keep listening to ${qv.keepTitle}`
            Btn(label="Keep listening", primary=false, wide=false)
          // lane autoradio-joins: the clip's episode page, opened at the clip's time (the queue's `openEpisode` op)
          if qv.canOpenEpisode
            button press=queueDo("openEpisode", "") testId="queue-open-episode" appearance="none" aria-label=`Open the episode ${qv.keepTitle}`
              row min-height=44 align-items="center"
                text "Open episode" font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.muted
    // lane autoradio-joins: a whole episode has its page too
    if qv.audio and qv.clip == false and qv.canOpenEpisode
      button press=queueDo("openEpisode", "") testId="queue-open-episode" appearance="none" aria-label="Open the episode"
        row min-height=44 align-items="center"
          text "Open episode" font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=th.accent

// Up next: what is queued, in order. Tap a row to play it now; the remove button takes it out. Each row has its title, what it is
// (kind, and the show for audio) and one quiet caption: the DJ's own reason when it moved or added the item, else who added it.
component UpNext
  inject
    th: Theme
    qv: QueueInfo
    queueDo: action
  view
    column gap=8 testId="queue-up-next" width="100%"
      SectionHeader(label=(qv.upcoming.length > 0 ? `Up next · ${qv.upcoming.length}` : "Up next"))
      if qv.notice != ""
        text qv.notice testId="sheet-notice" font-family=th.fontLabel font-size="-exact-footnote" color=th.muted
      if qv.upcoming.length == 0
        EmptyState(message=(qv.writing ? "The desk is writing what comes next." : (qv.notice != "" ? "Nothing is coming up yet." : (qv.dry ? "Nothing is coming up. Add a story, a page or a podcast and it plays next." : "The desk will write more shortly."))), detail="", testId="queue-empty")
      else
        PlainList(testId="queue-list")
          for r, k in qv.upcoming key=r.id
            if k > 0
              RowRule(indent=0)
            row align-items="center" width="100%" testId=`sheet-ahead-${k}`
              button press=queueDo("playAt", `${r.i}`) testId=`queue-row-${r.i}` appearance="none" flex=1 min-width=0 aria-label=`Play ${r.title} now`
                row align-items="center" gap=8 width="100%"
                  column gap=2 align-items="flex-start" box-sizing="border-box" min-height=52 justify-content="center" padding="8px 0px 8px 0px" flex=1 min-width=0
                    text r.title font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg text-align="left" line-clamp=2
                    // one quiet caption (one size): what it is (the show for audio, else the kind) and why it is here (the DJ's reason, else who added it)
                    text `${r.detail != "" ? r.detail : sentence(r.kind)} · ${r.note != "" ? r.note : r.by}` testId=`queue-note-${r.i}` font-family=th.fontLabel font-size="-exact-footnote" color=th.muted text-align="left" line-clamp=2
                  image "symbol:forward-chevron" color=th.muted
              button press=queueDo("remove", `${r.i}`) testId=`queue-remove-${r.i}` appearance="none" width=44 height=44 aria-label=`Remove ${r.title}`
                row width=44 height=44 align-items="center" justify-content="center"
                  image "symbol:close" color=th.muted

keyframes barWebGrow
  from opacity=0 scale=0.96

// The page a URL typed in the bar opens, in place above the bar (the bar stays live). It fills the screen from the status bar down to the top
// of the lens; its host, Loading, Read aloud, Add to queue, Open in Safari and Close are the content row in the lens (content.contract).
component BarWebLayer
  inject
    th: Theme
    qv: QueueInfo
    webMsg: action
    ctlClear: number
  view
    column testId="bar-web" position="absolute" left=0 right=0 top=0 bottom=`calc(env(safe-area-inset-bottom) + ${ctlClear}px)` z-index=8
      background-color=th.paper box-shadow=th.shadow2 border-bottom-left-radius=th.radiusCard border-bottom-right-radius=th.radiusCard overflow="hidden"
      padding-top="env(safe-area-inset-top)" box-sizing="border-box"
      animation=(th.reducedMotion ? "none" : `barWebGrow ${th.motionEnterMs * 2}ms ease-out both`)
      web-page page=qv.webUrl message=webMsg testId="bar-web-view" width="100%" flex=1 min-height=0
