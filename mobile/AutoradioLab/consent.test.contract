// Signed out (the web build has no account), asking opens the sign-in sheet with its one sentence of why; nothing is sent and no microphone is touched; Not now puts it away and the field keeps the text.
test "a typed ask while signed out opens the sign-in sheet"
  clock data
  type "bar-field" "what happened at the harbour"
  clock settle
  tap "bar-send"
  clock settle
  expect tree has "gate-sheet"
  expect tree has "gate-signin-title"
  expect tree has "gate-signin-why"
  expect tree has "gate-signin"
  expect tree has "gate-make"
  expect tree missing "consent-title"
  tap "gate-later"
  clock settle
  expect tree missing "gate-sheet"

test "the voice button while signed out opens the sign-in sheet"
  clock data
  tap "bar-mic"
  clock settle
  expect tree has "gate-signin-why"
  tap "gate-scrim"
  clock settle
  expect tree missing "gate-sheet"

// The sheet's two buttons lead to the sign-in screen (SignInScreen), which owns the passkey screen's waiting, cancel and failure: if it were not up, a cancelled or failed attempt would show nothing.
test "Sign in in the sheet puts the sign-in screen up, with the attempt's message when it cannot go on"
  clock data
  tap "bar-mic"
  clock settle
  expect tree has "gate-signin"
  tap "gate-signin"
  clock data
  expect tree missing "gate-sheet"
  expect state authOpen == true
  expect tree has "signin-close"
  expect tree has "signup-email"
  expect tree has "signin-message"
  tap "signin-close"
  clock settle
  expect state authOpen == false

test "Make an account in the sheet puts the create-account screen up"
  clock data
  tap "bar-mic"
  clock settle
  tap "gate-make"
  clock settle
  expect tree missing "gate-sheet"
  expect state authOpen == true
  expect tree has "signup-email"
  expect tree has "signup-consent"
  expect tree has "signup-create"

// Leaving the sign-in screen puts the attempt away: the machine is idle again, so opening sign-in later never starts from the last attempt's failure.
test "Leaving the sign-in screen after a failed attempt leaves the machine idle"
  clock data
  tap "bar-mic"
  clock settle
  tap "gate-signin"
  clock data
  expect tree has "signin-message"
  expect state siv.phase == "failed"
  tap "signin-close"
  clock data
  expect state authOpen == false
  expect state siv.phase == "idle"
