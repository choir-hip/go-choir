// The Components page (the Lab: stages, parameters, configurations, kept turns, the audio switch) and the Trace page. The
// integrator lane owns this file: these are the screens it had as tabs, now pages ("lab:components", "lab:trace"). The
// bodies are the originals; only the frame (PageScroll, `inject`) is the spine's. testIds are unchanged.
use StatBar from "exact:content"
use LabState, StageList, ParamList, Trace, TurnList, Lines, Names, AudioInfo, ChoirAuth, Theme from "@choir/autoradio"
use ToolScroll, Btn from "./ui.contract"

component ComponentsPage
  inject
    th: Theme
    st: LabState
    aud: AudioInfo
    au: ChoirAuth
    stages: StageList
    params: ParamList
    events: Lines
    configs: Names
    cfgName: string
    cfgUrl: string
    modeLabel: string
    yieldLabel: string
    openPage: action
    signOut: action
    start: action
    stop: action
    setPolicy: action
    setAckTiming: action
    talkDown: action
    talkUp: action
    inject: action
    replay: action
    editCfgName: action
    saveCfg: action
    editCfgUrl: action
    loadCfg: action
    loadUrl: action
    pick: action
    setParam: action
  view
    ToolScroll(id="components")
      text "Components" role="heading" aria-level=1 font-family=th.fontRead font-size=28 font-weight=700 testId="page-title"
      text `${st.residentMB.toFixed(0)} MB · ${st.thermal}` testId="resources" color=th.muted
      column gap=12 font-family=th.fontUi
        text "Account" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        text (au.signedIn ? `Signed in to ${au.baseURL}` : "Not signed in") testId="account" color=th.muted
        if au.signedIn
          button press=signOut testId="signout" appearance="none"
            Btn(label="Sign out", primary=false, wide=false)
        button press=openPage("lab:trace", "Trace") testId="open-trace" appearance="none"
          Btn(label="Open the trace of the last turn", primary=false, wide=false)
        row gap=8
          button press=start testId="start" appearance="none"
            Btn(label=(st.running ? "Restart audio" : "Start audio"), primary=false, wide=false)
          button press=stop testId="stop" appearance="none"
            Btn(label="Stop", primary=false, wide=false)
        text "Audio" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        text `State ${aud.state} · engine ${aud.engine} · voice processing ${aud.voiceProcessing ? "on" : "off"}` testId="audio-state"
        text `Programme ${aud.audible ? "audible" : "silent"} at volume ${aud.volume.toFixed(2)} · last switch ${aud.lastSwitchMs.toFixed(0)} ms` testId="audio-level" color=th.muted
        text aud.route testId="audio-route" font-family=th.fontMono font-size=12 color=th.muted width="100%" min-width=0
        for pol in aud.policies key=pol
          button press=setPolicy(pol) role="radio" aria-checked=(aud.policy == pol) testId=`policy-${pol}` appearance="none"
            Btn(label=`${aud.policy == pol ? "● " : "○ "}${pol}`, primary=false, wide=false)
        text "Acknowledgement" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        for tm in aud.ackTimings key=tm
          button press=setAckTiming(tm) role="radio" aria-checked=(aud.ackTiming == tm) testId=`ack-${tm}` appearance="none"
            Btn(label=`${aud.ackTiming == tm ? "● " : "○ "}${tm == "immediate" ? "Say it at once" : "Wait for System 1"}`, primary=false, wide=false)
        text yieldLabel testId="yield"
        text modeLabel testId="mode" color=th.muted
        text `Phase: ${st.phase} · mic ${st.micActive ? "on" : "off"} · config ${st.configName}` testId="phase" color=th.muted
        text st.message testId="lab-message" color=th.muted
        text (st.transcript == "" ? "(listening)" : st.transcript) testId="lab-transcript"
        button pointerdown=talkDown pointerup=talkUp testId="lab-talk" appearance="none"
          width="100%" box-sizing="border-box" padding=40 background-color=th.paper2 border-radius=th.radiusControl box-shadow=th.shadow1
          text (st.phase == "playing" ? "Hold to talk" : st.phase)
        row gap=8 align-items="center"
          button press=inject testId="inject" appearance="none"
            Btn(label="Inject fixture turn", primary=false, wide=false)
          button press=replay("fixture-plain") testId="replay-fixture" appearance="none"
            Btn(label="Replay fixture turn", primary=false, wide=false)
        text "Configuration" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        text `Current: ${st.configName}` testId="config"
        row gap=8 align-items="center"
          input value=cfgName input=editCfgName placeholder="Name to save as" aria-label="Configuration name" testId="cfg-name" flex=1 min-width=0
          button press=saveCfg testId="cfg-save" appearance="none"
            Btn(label="Save", primary=false, wide=false)
        for n in configs.names key=n
          button press=loadCfg(n) testId=`cfg-${n}` appearance="none"
            Btn(label=`Load ${n}`, primary=false, wide=false)
        row gap=8 align-items="center"
          input value=cfgUrl input=editCfgUrl placeholder="Load from URL" aria-label="Configuration URL" testId="cfg-url" flex=1 min-width=0
          button press=loadUrl testId="cfg-url-load" appearance="none"
            Btn(label="Fetch", primary=false, wide=false)
        text "Stages" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        for r in stages.rows key=`${r.kind}.${r.id}`
          button press=pick(r.kind, r.id) role="radio" aria-checked=r.selected testId=`stage-${r.kind}-${r.id}` appearance="none"
            Btn(label=`${r.selected ? "● " : "○ "}${r.kindLabel}: ${r.name}${r.network ? " (network)" : ""}`, primary=false, wide=false)
        text "Parameters" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        for p, i in params.rows key=i
          column gap=2
            text `${p.stage} · ${p.label}` color=th.muted
            input value=p.value input=setParam(p.kind, p.name) aria-label=p.label testId=`param-${p.kind}-${p.name}`
            text p.hint color=th.muted
        text "Events" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        for l, i in events.lines key=i
          text l font-family=th.fontMono font-size=12

component TracePage
  inject
    th: Theme
    trace: Trace
    other: Trace
    turns: TurnList
    cmp: string
    expPath: string
    expName: string
    exportTurn: action
    shareExport: action
    choose: action
    compare: action
    replay: action
  view
    ToolScroll(id="trace")
      text "Trace" role="heading" aria-level=1 font-family=th.fontRead font-size=28 font-weight=700 testId="page-title"
      column gap=12 font-family=th.fontUi
        text "Last turn" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        text `"${trace.transcript}"` testId="trace-transcript"
        text `${trace.configName} · addressed by ${trace.addressedBy} · outcome ${trace.outcome}` color=th.muted
        text `Acknowledgement ${trace.ackMs.toFixed(0)} ms · revision ${trace.revisionMs.toFixed(0)} ms after the turn ended` testId="trace-times"
        text `${trace.id}` testId="trace-id" font-family=th.fontMono font-size=12 color=th.muted
        text `Audio switch ${trace.audioSwitchMs.toFixed(0)} ms · ${trace.timings.length} stage timings` testId="trace-switch" color=th.muted
        row gap=8 align-items="center"
          button press=exportTurn(trace.id) testId="trace-export" appearance="none"
            Btn(label="Export JSON", primary=false, wide=false)
          button press=exportTurn("last") testId="trace-export-last" appearance="none"
            Btn(label="Export last 5 turns", primary=false, wide=false)
          if expPath != ""
            button press=shareExport(expPath) testId="trace-share" appearance="none"
              Btn(label="Share", primary=false, wide=false)
        if expName != ""
          text `Saved ${expName} in Documents/AutoradioExports` testId="trace-exported" font-family=th.fontMono font-size=12 color=th.muted
        for t2, j in trace.timings key=j
          StatBar(label=`${t2.stage} (+${t2.startMs.toFixed(0)} ms)`, value=`${t2.durMs.toFixed(0)} ms`, fraction=(trace.totalMs > 0 ? t2.durMs / trace.totalMs : 0), tint=none)
        text "Events" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        for l2, k in trace.lines key=k
          text l2 font-family=th.fontMono font-size=12
        if cmp != ""
          text "Compared with" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
          text `${other.configName}: ack ${other.ackMs.toFixed(0)} ms, revision ${other.revisionMs.toFixed(0)} ms` testId="compare-times"
          for t3, m in other.timings key=m
            StatBar(label=t3.stage, value=`${t3.durMs.toFixed(0)} ms`, fraction=(other.totalMs > 0 ? t3.durMs / other.totalMs : 0), tint=none)
        text "Kept turns" role="heading" aria-level=2 font-family=th.fontUi font-size=13 font-weight=700 color=th.accent2 text-transform="uppercase" margin-top=8
        for r2 in turns.rows key=r2.id
          column gap=4
            text `${r2.transcript} (${r2.configName}, ${r2.outcome})`
            row gap=8
              button press=choose(r2.id) testId=`show-${r2.id}` appearance="none"
                Btn(label="Show", primary=false, wide=false)
              button press=compare(r2.id) testId=`cmp-${r2.id}` appearance="none"
                Btn(label="Compare", primary=false, wide=false)
              button press=replay(r2.id) testId=`replay-${r2.id}` appearance="none"
                Btn(label="Replay with current configuration", primary=false, wide=false)
