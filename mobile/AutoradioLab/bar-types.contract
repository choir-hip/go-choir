// The bar's shapes. Declared here and answered by `app.ts` (bar.ts: `barInfo`); they were the Swift package's (interface/spine.json `BarInfo`, source `barState`)
// before the bar's page model moved to shared code. The native side hands over only the facts (`BarFacts`, interface/bar.json, source `barFacts`).

shape BarInfo
  state: string
  text: string
  playing: bool
  talking: bool
  handsFree: bool
  progress: number
  question: string
  answerId: string
  answerText: string
  answerLabel: string
  answerState: string
  answerNote: string
  canRetry: bool
  // The answer is still streaming: the card offers Cancel.
  answering: bool
  until: number

// What plays, as the bar shows it (radio-follow.ts `runOf`, source `barRun`): the run sheet's on-air entry and the deck's state. Native says none of it.
shape BarRun
  // The run has answered (the contract's empty form has not: the bar then says nothing is playing).
  ready: bool
  onAir: bool
  // The deck is held for the audio session.
  waiting: bool
  // The deck is playing the entry on air / paused on it (by the listener or the system).
  playing: bool
  paused: bool
  // The entry on air's title.
  title: string
  // How far through the entry: 0 to 1.
  progress: number
