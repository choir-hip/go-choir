// The bar's shapes. Declared here and answered by `app.ts` (bar.ts: `barInfo`); they were the Swift package's (interface/spine.json `BarInfo`, source `barState`)
// before the bar's page model moved to shared code. The native side hands over only the facts (`BarFacts`, interface/bar.json, source `barFacts`).

shape BarInfo
  state: string
  text: string
  playing: bool
  talking: bool
  handsFree: bool
  progress: number
  question: string
  answerId: string
  answerText: string
  answerLabel: string
  answerState: string
  answerNote: string
  canRetry: bool
  // The answer is still streaming: the card offers Cancel.
  answering: bool
  until: number

// What the run sheet says to the bar (radio-bridge.ts `barRun`): something on air, held for the audio session, audio of its own (a clip, an episode) and where it is.
shape BarRun
  // The run sheet has answered (an empty one has not: the bar then trusts the player's own facts).
  ready: bool
  onAir: bool
  waiting: bool
  remote: bool
  remotePlaying: bool
  remoteTitle: string
  remoteFraction: number
