// Settings (settings:<screen>). Lane 7 owns this file. One page component, SettingsPage, shows the screen the address names:
//   settings:root (or settings:)  the list, with the theme picker and light/dark/system inline
//   settings:appearance           themes as preview cards, light/dark/system, a theme from a Texture, the type and depth specimens
//   settings:account              who am I, the device's key label, sign out
//   settings:voice                voice and models: Components, and the voice setup card (lane 8)
//   settings:computer             status, Wake, Restart to update
//   settings:learned              what the paper has learned, with Reset
//   settings:about                app and server builds (commit rows: about.ts)
// testIds: settings-theme-<id>, settings-mode-<light|dark|system>, settings-components, settings-theme-problems,
//   settings-nav-<screen>, settings-back, settings-theme-doc, settings-theme-load,
//   settings-theme-status, settings-theme-remove-<id>, settings-signout, settings-account-*,
//   settings-choice-<setting>-<option>, settings-wake, settings-update, settings-computer-*, settings-learned-reset, settings-learned-row,
//   settings-about-*, settings-voice-components.
// Every colour, face, radius and shadow is a theme token (th.*, tx.*); a theme's own preview card paints from the card's data.
use Theme, ThemeList, ThemeCard, ThemeExtras, LearnedInfo, ThemeCards, ChoirAuth, VoiceProfile from "@choir/autoradio"
use SettingsAccount, AboutBuild, SettingsComputer, AboutInfo from "./settings-types.contract"
use AccountView from "./account-state-types.contract"
use ToolScroll, Card, Btn, SegmentedTrack, SegmentFace, SelectMark, RowRule, PlainList, dyn from "./ui.contract"
use VoiceCardsList from "./voice.contract"
use SkeletonLine from "./transitions.contract"

component SettingsPage
  props
    address: string
    title: string
  derive screen = address == "settings:" ? "root" : address.replaceAll("settings:", "")
  view
    if screen == "appearance"
      AppearanceScreen()
    if screen == "account"
      AccountScreen()
    if screen == "voice"
      VoiceScreen()
    if screen == "computer"
      ComputerScreen()
    if screen == "learned"
      LearnedScreen()
    if screen == "about"
      AboutScreen()
    if screen != "appearance" and screen != "account" and screen != "voice" and screen != "computer" and screen != "learned" and screen != "about"
      RootScreen()

// ---------------------------------------------------------------- shared pieces

component ScreenTitle
  inject
    th: Theme
    tx: ThemeExtras
    openPage: action
  props
    label: string
    back: bool
  view
    column gap=6 width="100%"
      if back
        button press=openPage("settings:root", "Settings") testId="settings-back" appearance="none" aria-label="Back to Settings"
          text "‹ Settings" font-family=th.fontAction font-size=dyn(tx.sizeLabel) font-weight=600 color=th.accent
      text label role="heading" aria-level=1 font-family=th.fontHead font-size=dyn(tx.sizeHeadline) font-weight=tx.weightHeadline color=th.fg testId="page-title"

component SectionLabel
  inject
    th: Theme
    tx: ThemeExtras
  props
    label: string
  view
    text label font-family=th.fontLabel font-size=dyn(tx.sizeMeta) font-weight=600 letter-spacing=0.9 color=th.muted text-transform="uppercase" margin-top=10

component Hairline
  inject
    th: Theme
  view
    box height=1 width="100%" background-color=th.rule

// A list row that opens another settings screen (or any page).
component NavRow
  inject
    th: Theme
    tx: ThemeExtras
    openPage: action
  props
    address: string
    title: string
    subtitle: string
    testId: string
  view
    button press=openPage(address, title) testId=testId appearance="none" width="100%" box-sizing="border-box" padding="14px 0px"
      row align-items="center" gap=12 width="100%"
        column flex=1 min-width=0 gap=2 align-items="flex-start"
          text title font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg
          if subtitle != ""
            text subtitle font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
        text "›" font-family=th.fontLabel font-size="-exact-title2" color=th.muted

// A label and a value, on one line of a card.
component FactRow
  inject
    th: Theme
    tx: ThemeExtras
  props
    label: string
    value: string
    mono: bool
    testId: string
  view
    row width="100%" box-sizing="border-box" gap=12 padding="10px 0px" align-items="flex-start" justify-content="space-between"
      text label font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted
      text value testId=testId font-family=(mono ? th.fontMono : th.fontLabel) font-size=dyn(tx.sizeLabel) color=th.fg text-align="right" flex=1 min-width=0 overflow-wrap="anywhere"

// An action: the primary is a flat accent block (radius 4 to 6), the others text actions (the accent, or the danger colour); no outline.
component ActionButton
  inject
    th: Theme
    tx: ThemeExtras
  props
    label: string
    testId: string
    primary: bool
    danger: bool
  view
    column testId=testId align-items="center" justify-content="center" padding=(primary ? "12px 18px" : "12px 4px") min-height=44
      border-radius=(primary ? th.radiusControl : 0)
      background-color=(primary ? th.accent : "transparent")
      text label font-family=th.fontAction font-size=dyn(tx.sizeLabel) font-weight=600 color=(primary ? th.onAccent : (danger ? th.danger : th.accent))

// light / dark / system: a segmented control in the theme's own colours and radius (the native button styles tint blue and
// ignore the theme). The three buttons keep their test ids.
component ModeSegment
  inject
    th: Theme
    thl: ThemeList
    setMode: action
  props
    mode: string
    label: string
    testId: string
  derive picked = thl.mode == mode
  view
    button press=setMode(mode) testId=testId role="radio" aria-checked=picked appearance="none" flex=1 min-width=0
      SegmentFace(label=label, selected=picked)

component ModePicker
  inject
    th: Theme
  view
    SegmentedTrack(testId="settings-mode")
      ModeSegment(mode="light", label="Light", testId="settings-mode-light")
      ModeSegment(mode="dark", label="Dark", testId="settings-mode-dark")
      ModeSegment(mode="system", label="System", testId="settings-mode-system")

// One theme as a preview card, painted from the card's own colours, faces, radius and shadow (not the app's), so each theme
// is seen as it will look. `compact` drops the sample paragraph.
component ThemePreview
  inject
    th: Theme
    setTheme: action
    removeTheme: action
  props
    t: ThemeCard
    compact: bool
  view
    column width="100%" gap=6 box-sizing="border-box"
      button press=setTheme(t.id) testId=`settings-theme-${t.id}` role="radio" aria-checked=t.current appearance="none" width="100%" box-sizing="border-box"
        aria-label=`${t.name}${t.current ? ", selected" : ""}`
        column width="100%" box-sizing="border-box" align-items="stretch" gap=10 padding=16 background-color=t.paper border-radius=th.radiusCard box-shadow=t.shadow
          row align-items="center" gap=8 width="100%"
            text t.name font-family=th.fontHead font-size="-exact-title2" font-weight=700 color=t.fg text-align="left" flex=1 min-width=0
            if t.contrast == "AAA"
              text "AAA contrast" font-family=th.fontLabel font-size="-exact-caption1" color=t.muted
            if t.current
              row align-items="center" gap=4
                image "symbol:checkmark" width=14 height=14 color=t.accent
                text "In use" font-family=th.fontLabel font-size="-exact-footnote" color=t.accent
          if compact == false
            text "The harbor barrier vote moves to Thursday, and the council wants the storm-surge figures first." font-family=th.fontText font-size="-exact-subheadline" line-height=1.45 color=t.fg
          row gap=8 align-items="center" width="100%"
            box width=22 height=22 background-color=t.accent border-radius=t.radiusControl
            box width=22 height=22 background-color=t.accent2 border-radius=t.radiusControl
            box width=22 height=22 background-color=t.fg border-radius=t.radiusControl
            box width=22 height=22 background-color=t.muted border-radius=t.radiusControl
            box width=22 height=22 background-color=t.paper2 border-radius=t.radiusControl
            row flex=1 min-width=0 justify-content="flex-end"
              text `${t.scale} · ${t.schemes.replaceAll(",", " + ")}${t.origin == "bundled" ? "" : " · " + t.origin}` font-family=th.fontLabel font-size="-exact-caption1" color=t.muted
          if compact == false
            row gap=8 align-items="center"
              row padding="8px 4px"
                text "Listen" font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=t.accent
              row padding="8px 4px"
                text "Ask the desk" font-family=th.fontAction font-size="-exact-subheadline" font-weight=600 color=t.accent
      if t.origin != "bundled" and compact == false
        button press=removeTheme(t.id) testId=`settings-theme-remove-${t.id}` appearance="none"
          text "Remove this theme" font-family=th.fontLabel font-size="-exact-footnote" color=th.danger padding="2px 6px"

// ---------------------------------------------------------------- root

component RootScreen
  inject
    th: Theme
    tx: ThemeExtras
    tc: ThemeCards
    acctInfo: SettingsAccount
    cmpt: SettingsComputer
    voicep: VoiceProfile
    learnVoice: action
    forgetVoice: action
  view
    ToolScroll(id="settings")
      ScreenTitle(label="Settings", back=false)
      SectionLabel(label="Your edition")
      PlainList(testId="settings-card-edition")
        NavRow(address="onboarding:edit", title="Edit my edition", subtitle="Topics you follow", testId="settings-edit-edition")
      SectionLabel(label="Appearance")
      ModePicker()
      for t in tc.rows key=t.id
        ThemePreview(t=t, compact=true)
      for p in tc.problems key=p
        text p testId="settings-theme-problems" font-family=th.fontMono font-size="-exact-caption1" color=th.danger
      PlainList(testId="settings-card-appearance")
        NavRow(address="settings:appearance", title="Appearance in detail", subtitle="Type, depth, a theme from a Texture", testId="settings-nav-appearance")
      text `Showing ${th.name} (${th.scheme})` testId="settings-current" font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
      SectionLabel(label="You and your computer")
      PlainList(testId="settings-card-you")
        NavRow(address="settings:account", title="Account and devices", subtitle=(acctInfo.handle == "" ? "Who is signed in on this phone" : acctInfo.handle), testId="settings-nav-account")
        Hairline()
        NavRow(address="settings:computer", title="Computer", subtitle=(cmpt.updateAvailable ? "An update is waiting" : (cmpt.state == "" ? "Status, wake, restart to update" : cmpt.state)), testId="settings-nav-computer")
      SectionLabel(label="Listening")
      PlainList(testId="settings-card-listening")
        NavRow(address="onboarding:setup", title="Voice setup", subtitle="Download the voice models and check the microphone", testId="settings-setup-voice")
        Hairline()
        NavRow(address="settings:voice", title="Voice and models", subtitle="The voice, and the models that hear you", testId="settings-nav-voice")
        Hairline()
        // Lane autoradio-talk: the reader's voice, learned on this phone so the radio can tell you from a TV.
        column width="100%" box-sizing="border-box" padding="14px 16px" gap=8 align-items="flex-start" testId="settings-my-voice"
          text (voicep.learned ? "Your voice is learned" : (voicep.heard > 0 ? `Learning your voice: ${voicep.heard} of ${voicep.needed}` : "Your voice is not learned yet")) font-family=th.fontHead font-size="-exact-body" font-weight=600 color=th.fg testId="settings-voice-state"
          text (voicep.line != "" ? voicep.line : "The radio learns your voice from what you say to it. It stays on this phone and is never uploaded.") font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
          row gap=10
            button press=learnVoice testId="settings-voice-learn" appearance="none"
              Btn(label=(voicep.learned ? "Learn it again" : "Learn my voice"), primary=false, wide=false)
            if voicep.learned or voicep.heard > 0
              button press=forgetVoice testId="settings-voice-forget" appearance="none"
                Btn(label="Forget my voice", primary=false, wide=false)
          if voicep.credit != ""
            text voicep.credit font-family=th.fontLabel font-size="-exact-caption2" color=th.muted
      SectionLabel(label="The paper")
      PlainList(testId="settings-card-paper")
        NavRow(address="settings:learned", title="What the paper has learned", subtitle="Your more and less of this, with Reset", testId="settings-nav-learned")
        Hairline()
        NavRow(address="activity:", title="Activity", subtitle="What the computer and the desk are doing", testId="settings-nav-activity")
      SectionLabel(label="About")
      PlainList(testId="settings-card-about")
        NavRow(address="settings:about", title="About", subtitle="Builds and server", testId="settings-nav-about")
// ---------------------------------------------------------------- appearance

component AppearanceScreen
  inject
    th: Theme
    tx: ThemeExtras
    tc: ThemeCards
    themeDoc: string
    editThemeDoc: action
    loadThemeDoc: action
  view
    ToolScroll(id="settings")
      ScreenTitle(label="Appearance", back=true)
      ModePicker()
      text `Showing ${th.name} in ${th.scheme}${th.reducedMotion ? ", with reduced motion" : ""}.` testId="settings-current" font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
      for t in tc.rows key=t.id
        ThemePreview(t=t, compact=false)
      for p in tc.problems key=p
        text p testId="settings-theme-problems" font-family=th.fontMono font-size="-exact-caption1" color=th.danger
      SectionLabel(label="A theme from a Texture")
      PlainList(testId="settings-card-texture")
        column gap=10 padding="8px 0px" width="100%" box-sizing="border-box"
          text "A theme is a Texture with one choir-theme block. Paste its id to add it here; the server checks it and so does the phone." font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
          row gap=8 align-items="center" width="100%"
            column flex=1 min-width=0
              input value=themeDoc input=editThemeDoc placeholder="Theme Texture id" aria-label="Theme Texture id" testId="settings-theme-doc" min-width=0
                font-family=th.fontText font-size=16 color=th.fg min-height=44 padding="8px 0px" border-width=0 background-color="transparent"
              RowRule(indent=0)
            button press=loadThemeDoc testId="settings-theme-load" appearance="none"
              Btn(label="Add", primary=false, wide=false)
          if tc.status != ""
            text tc.status testId="settings-theme-status" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.fg
      SectionLabel(label="Type")
      Card(level=1, testId="settings-card-type", minHeight=0)
        column gap=8 padding=16 width="100%" box-sizing="border-box"
          text "Headline" font-family=th.fontHead font-size=dyn(tx.sizeHeadline) font-weight=tx.weightHeadline color=th.fg
          text "The body face is the theme's own. This is a line of body text, set the way a story reads." font-family=th.fontText font-size=dyn(tx.sizeBody) line-height=tx.lineBody color=th.fg
          text "Labels and controls use the interface face." font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted
          text "Mono: 12 of 14 sources read" font-family=th.fontMono font-size=dyn(tx.sizeMeta) color=th.muted
          text `Scale ${th.scale} · body ${tx.sizeBody.toFixed(0)} pt · contrast ${tx.contrast}` font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
      SectionLabel(label="Depth")
      Card(level=1, testId="settings-card-depth", minHeight=0)
        column gap=14 padding=16 width="100%" box-sizing="border-box"
          row gap=12 width="100%"
            column flex=1 min-width=0
              Card(level=1, testId="settings-depth-1", minHeight=56)
                text "1" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted padding="16px 0px"
            column flex=1 min-width=0
              Card(level=2, testId="settings-depth-2", minHeight=56)
                text "2" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted padding="16px 0px"
            column flex=1 min-width=0
              Card(level=3, testId="settings-depth-3", minHeight=56)
                text "3" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted padding="16px 0px"
          text `Cards ${th.material1}, the bar ${th.material2}, layers ${th.material3}. Corners ${th.radiusCard.toFixed(0)} pt.` font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted

// ---------------------------------------------------------------- account

component AccountScreen
  inject
    th: Theme
    tx: ThemeExtras
    acctInfo: SettingsAccount
    au: ChoirAuth
    signOutNote: string
    refreshAccount: action
    signOut: action
    signIn: action
    acs: AccountView
  view
    ToolScroll(id="settings")
      ScreenTitle(label="Account and devices", back=true)
      PlainList(testId="settings-card-account")
        column width="100%" box-sizing="border-box" padding="6px 0"
          FactRow(label="Signed in", value=(acs.state == "rejected" ? "No" : au.signedIn ? "Yes" : (acs.state == "locked" or acs.state == "unknown" ? "Not known" : "No")), mono=false, testId="settings-account-signed")
          Hairline()
          FactRow(label="You are", value=(acctInfo.handle == "" ? "Not shown yet" : acctInfo.handle), mono=false, testId="settings-account-handle")
          Hairline()
          FactRow(label="This device", value=(acctInfo.keyLabel == "" ? "Not shown yet" : acctInfo.keyLabel), mono=false, testId="settings-account-device")
          Hairline()
          FactRow(label="Key", value=(acctInfo.keyID == "" ? "-" : acctInfo.keyID), mono=true, testId="settings-account-keyid")
          Hairline()
          FactRow(label="Can", value=(acctInfo.scopes == "" ? "-" : acctInfo.scopes), mono=true, testId="settings-account-scopes")
          Hairline()
          FactRow(label="Computer", value=(acctInfo.computerID == "" ? "-" : acctInfo.computerID), mono=true, testId="settings-account-computer")
          Hairline()
          FactRow(label="Server", value=(acctInfo.baseURL == "" ? "-" : acctInfo.baseURL), mono=true, testId="settings-account-server")
      // one sentence from the account state (acs); the account's own failure line stays quiet when the state already says it
      if acctInfo.message != "" and acs.state != "locked" and acs.state != "unknown" and acs.state != "rejected"
        text acctInfo.message testId="settings-account-message" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted
      if acctInfo.status == "loading"
        SkeletonLine(testId="settings-account-skeleton")
      // A sign-out that did not finish says so here (account.ts answers the words; a clean one leaves the page, so nothing shows).
      if signOutNote != ""
        text signOutNote testId="settings-signout-message" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.danger
      if acs.message != ""
        text acs.message testId="settings-account-state" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.fg
      text "This phone holds its own key. Signing out removes the key from this phone and ends it on the server. Your computer and your documents stay where they are." font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
      row gap=12 width="100%"
        button press=refreshAccount testId="settings-account-refresh" appearance="none"
          ActionButton(label="Refresh", testId="settings-account-refresh-box", primary=false, danger=false)
        // Signed out (or refused): the way in is HERE, where it says "Signed in: No". A locked phone has none (it says to unlock).
        if acs.action == "signIn"
          button press=signIn testId="settings-signin" appearance="none"
            ActionButton(label="Sign in", testId="settings-signin-box", primary=false, danger=false)
        // one Sign in and one Sign out, worded so they do not contradict: a refused phone signs in again, or clears its stored key (sign-out is local first: it removes the key and this phone's data)
        if au.signedIn
          button press=signOut testId="settings-signout" appearance="none"
            ActionButton(label=(acs.state == "rejected" ? "Clear this phone" : "Sign out"), testId="settings-signout-box", primary=false, danger=true)

// ---------------------------------------------------------------- voice and models

component VoiceScreen
  inject
    th: Theme
    tx: ThemeExtras
  view
    ToolScroll(id="settings")
      ScreenTitle(label="Voice and models", back=true)
      text "The voice that reads the paper, and the models that hear you, run on this phone." font-family=th.fontText font-size=dyn(tx.sizeBody) line-height=tx.lineBody color=th.fg
      VoiceCardsList()
      text "Voice setup, with the model downloads and the checks for this device, opens from here once first run has it." testId="settings-voice-note" font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted

// ---------------------------------------------------------------- computer

component ComputerScreen
  inject
    th: Theme
    tx: ThemeExtras
    cmpt: SettingsComputer
    refreshComputer: action
    wakeComputer: action
    updateComputer: action
  view
    ToolScroll(id="settings")
      ScreenTitle(label="Computer", back=true)
      PlainList(testId="settings-card-computer")
        column width="100%" box-sizing="border-box" padding="6px 0"
          FactRow(label="State", value=(cmpt.state == "" ? (cmpt.checked ? "Not reported" : "Checking…") : cmpt.state), mono=false, testId="settings-computer-state")
          Hairline()
          FactRow(label="Computer", value=(cmpt.id == "" ? "-" : cmpt.id), mono=true, testId="settings-computer-id")
          Hairline()
          FactRow(label="Update", value=(cmpt.updateAvailable ? `Waiting: ${cmpt.target}` : "Up to date"), mono=false, testId="settings-computer-update")
      if cmpt.message != ""
        text cmpt.message testId="settings-computer-message" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=(cmpt.phase == "failed" ? th.danger : th.fg)
      if cmpt.phase == "updating"
        text "Your computer restarts while it updates. This can take a minute." font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
      text "Restart to update asks your computer to restart onto the newest version. It waits if the computer is in the middle of a change." font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
      column gap=12 width="100%"
        button press=updateComputer testId="settings-update" appearance="none" width="100%"
          ActionButton(label=(cmpt.updateAvailable ? "Restart to update" : "Check for an update"), testId="settings-update-box", primary=false, danger=false)
        button press=wakeComputer testId="settings-wake" appearance="none" width="100%"
          ActionButton(label="Wake the computer", testId="settings-wake-box", primary=false, danger=false)
        button press=refreshComputer testId="settings-computer-refresh" appearance="none" width="100%"
          ActionButton(label="Refresh", testId="settings-computer-refresh-box", primary=false, danger=false)

// ---------------------------------------------------------------- what the paper has learned

component LearnedScreen
  inject
    th: Theme
    tx: ThemeExtras
    learnt: LearnedInfo
    resetLearned: action
  view
    ToolScroll(id="settings")
      ScreenTitle(label="What the paper has learned", back=true)
      text "Each time you asked for more or less of a story, in your own words. Your front page leans on these; the shared paper does not change." font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted
      PlainList(testId="settings-card-learned")
        column width="100%" box-sizing="border-box" padding="6px 0"
          for r, i in learnt.rows key=i
            column gap=2 padding="10px 0px" width="100%" box-sizing="border-box" testId="settings-learned-row"
              text r.line font-family=th.fontText font-size=dyn(tx.sizeBody) line-height=1.4 color=th.fg
              text r.ago font-family=th.fontLabel font-size=dyn(tx.sizeMeta) color=th.muted font-variant-numeric="tabular-nums"
          if learnt.count == 0
            text learnt.message testId="settings-learned-empty" font-family=th.fontLabel font-size=dyn(tx.sizeLabel) color=th.muted padding="16px 0px"
      if learnt.count > 0
        button press=resetLearned testId="settings-learned-reset" appearance="none"
          ActionButton(label="Reset what the paper has learned", testId="settings-learned-reset-box", primary=false, danger=true)

// ---------------------------------------------------------------- about

component AboutScreen
  inject
    th: Theme
    tx: ThemeExtras
    about: AboutInfo
    bld: AboutBuild
  view
    ToolScroll(id="settings")
      ScreenTitle(label="About", back=true)
      PlainList(testId="settings-card-about-info")
        column width="100%" box-sizing="border-box" padding="6px 0"
          FactRow(label="Autoradio", value=(about.app == "" ? "-" : about.app), mono=false, testId="settings-about-app")
          Hairline()
          FactRow(label="Build", value=(bld.build == "" ? "unknown" : bld.build), mono=true, testId="settings-about-build")
          Hairline()
          FactRow(label="Server build", value=(bld.server == "" ? "not reported" : bld.server), mono=true, testId="settings-about-server")
          Hairline()
          FactRow(label="Server", value=(about.base == "" ? "-" : about.base), mono=true, testId="settings-about-base")
