+    // the package's own manifest never named.
+    const packageDir = realpathSync(resolve(dir, '..'));
+    const real = realpathSync(dir);
+    if (real !== packageDir && !real.startsWith(packageDir + '/')) throw new Error(`${dir}: a package's jniLibs is a link outside its package`);
