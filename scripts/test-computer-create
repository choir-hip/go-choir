#!/usr/bin/env bash
# Create a fresh test computer on staging with no person
# (docs/design/email-sign-in-2026-10-31.md, "Fresh test computers").
#
#   scripts/test-computer-create --name <label> [--state <path>] [--dry-run]
#   scripts/test-computer-create --print-scopes
#
# Runs the email sign-in bootstrap (frontend/tests/email-signin-bootstrap-deployed.spec.js):
# reserve a numbered test address on node-b, register an account with a
# virtual WebAuthn passkey, bind the number, mint an API key from the passkey
# session, verify the address, wait for the account's computer. The computer
# boots the stock image: a fresh ComputerID is on no per-computer ring.
#
# The key carries EVERY scope in the auth registry (validScopes in
# internal/auth/handlers.go, read from the source at run time; owner,
# 2026-11-03: "for now, we should just grant all access"). The virtual
# passkey dies with the browser, so the key is the account's only durable
# credential.
#
# State: $CHOIR_E2E_STATE_DIR/test-computer-<label>.json (default dir
# ~/.config/choir-e2e), mode 0600: stage, name, account_id, computer_id,
# address, api_key, api_key_id, api_key_scopes. Printed: only the computer id
# and the state path. A finished state file is reported and nothing runs; a
# half-finished one is refused (its passkey is gone; move it aside).
#
# Env: CHOIR_BACKEND (default https://choir.news), E2E_NODE_B_SSH (default
# node-b), CHOIR_E2E_STATE_DIR. Needs ssh to node-b and Playwright chromium
# (cd frontend && npm ci && npx playwright install chromium).
set -euo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
spec="tests/email-signin-bootstrap-deployed.spec.js"
backend="${CHOIR_BACKEND:-https://choir.news}"
state_dir="${CHOIR_E2E_STATE_DIR:-$HOME/.config/choir-e2e}"

name="" state="" dry=0 print_scopes=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --name) [[ $# -ge 2 ]] || { echo "--name needs a value" >&2; exit 2; }; name="$2"; shift ;;
    --state) [[ $# -ge 2 ]] || { echo "--state needs a value" >&2; exit 2; }; state="$2"; shift ;;
    --dry-run) dry=1 ;;
    --print-scopes) print_scopes=1 ;;
    *) echo "unknown argument $1 (every key gets all scopes; there is no --scopes)" >&2; exit 2 ;;
  esac
  shift
done

# Every scope the auth service accepts, from the registry source.
scopes="$(awk '/^var validScopes = map\[string\]bool\{/{p=1;next} p&&/^\}/{exit} p' "$repo/internal/auth/handlers.go" \
  | grep -oE '^[[:space:]]*"[^"]+"' | tr -d ' \t"' | sort -u | paste -sd, -)"
for must in admin owner:acts; do
  [[ ",$scopes," == *",$must,"* ]] || { echo "FAIL scope registry parse lost $must; read internal/auth/handlers.go validScopes" >&2; exit 1; }
done
if [[ $print_scopes == 1 ]]; then
  echo "$scopes"
  exit 0
fi

[[ "$name" =~ ^[a-z0-9][a-z0-9-]{0,62}$ ]] || { echo "--name must match [a-z0-9][a-z0-9-]{0,62}" >&2; exit 2; }
state="${state:-$state_dir/test-computer-$name.json}"

field() { python3 -c 'import json,sys;print(json.load(open(sys.argv[1])).get(sys.argv[2],""))' "$state" "$1"; }
report() {
  echo "computer_id: $(field computer_id)"
  echo "state: $state"
}

stage=""
if [[ -f "$state" ]]; then
  mode="$(stat -c '%a' "$state" 2>/dev/null || stat -f '%Lp' "$state")"
  [[ "$mode" == 600 ]] || { echo "state file mode is $mode, want 600: chmod 600 $state" >&2; exit 2; }
  stage="$(field stage)"
  if [[ "$stage" == done ]]; then
    [[ $dry == 1 ]] && echo "dry run: state file done; nothing would run"
    report
    exit 0
  fi
  echo "state file $state holds a half-finished bootstrap (stage ${stage:-unknown}): its passkey lived only in the browser that registered it." >&2
  echo "move it aside and run again; a new account and address are made." >&2
  exit 2
fi

if [[ $dry == 1 ]]; then
  echo "dry run: name=$name backend=$backend state=$state (absent: bootstrap would run)"
  echo "dry run: key scopes ($(tr ',' '\n' <<<"$scopes" | wc -l | tr -d ' ')): $scopes"
  echo "dry run: steps reserve-test-number (ssh), register (virtual passkey), bind-number, mint key, verify-address, wait for computer"
  node --check "$repo/frontend/$spec" && echo "dry run: bootstrap spec parses"
  echo "dry run: no network calls made"
  exit 0
fi

mkdir -p "$(dirname "$state")"
chmod 700 "$(dirname "$state")"
log="$(mktemp "${TMPDIR:-/tmp}/test-computer-$name.XXXXXX")"
node_b="${E2E_NODE_B_SSH:-node-b}"
address="$(ssh -o ConnectTimeout=15 -o BatchMode=yes "$node_b" 'maildctl reserve-test-number' \
  | python3 -c 'import json,sys;print(json.load(sys.stdin)["address"])')" \
  || { echo "FAIL could not reserve a test number on $node_b" >&2; exit 1; }
[[ "$address" =~ ^[0-9]{8}@choir\.news$ ]] || { echo "FAIL reserve-test-number answered an unexpected address shape" >&2; exit 1; }
echo "bootstrap: test number reserved; registering $name (log $log)" >&2
set +e
(cd "$repo/frontend" && E2E_ADDRESS="$address" E2E_STATE_FILE="$state" BASE_URL="$backend" \
  E2E_KEY_SCOPES="$scopes" E2E_KEY_LABEL="test-computer $name (all scopes)" E2E_KEY_FIELD=api_key \
  npx playwright test "$spec" --project=chromium --workers=1 --reporter=list) >"$log" 2>&1
rc=$?
set -e
address=""
if [[ $rc != 0 ]]; then
  echo "FAIL bootstrap (log $log):" >&2
  tail -25 "$log" | sed -E 's/[0-9]{8}@/<8-digit>@/g; s/choir_sk_[A-Za-z0-9_-]+/<key>/g' >&2
  exit 1
fi
[[ "$(field stage)" == done ]] || { echo "FAIL bootstrap ended at stage $(field stage)" >&2; exit 1; }
python3 - "$state" "$name" <<'PY'
import json, os, sys
path, name = sys.argv[1:3]
st = json.load(open(path))
st["name"] = name
tmp = path + ".tmp"
fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, "w") as f:
    json.dump(st, f, indent=2)
    f.write("\n")
os.replace(tmp, path)
os.chmod(path, 0o600)
PY
report
