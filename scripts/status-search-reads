#!/usr/bin/env python3
"""status-search-reads: how many web searches a research run sends, and whether it
USES AND BUILDS ON the paper's corpus: the deployed proof of the graph-first change
(docs/design/semantic-layer-2026-11-20.md section 4; owner, 2026-11-22: "the goal of any
run shouldnt just be to write the best story, but to be building on and using our
corpus, and then the story adds to our corpus"). There is no refusal to count: no
search is refused for what the run holds; the run is given a digest of the paper's graph
and told to search it first.

Read only against Node B (one ssh, `sudo -n` reads; nothing is written there).
Counts and ids only, with one exception: a Report's gap_text, the run's own clipped words from
its "missing:" line about the corpus (never a query, never article text by design; the
run is told so, the log clips and quotes it). The gateway's and the corpus search's query
text is cut on the host and never printed or stored.

  status-search-reads [--since T] [--until T] [--node HOST] [--json] [--fixture FILE]

T is YYYY-MM-DDTHH:MMZ (UTC); default: the start of today (UTC). The window is
[since, until).

Sources:
  gateway journal   `gateway: search request from autoputer <vm> (... run= desk=research ...)`
                    one line per web search sent: runs, searches, mean, the 1/2/3/4+
                    distribution, the 7-or-more tail, searches by desk.
  paper console     `corpus read run=` (one per page read by a run, held=true for a capture
                    the corpus had before the run), `corpus search ... run= ... caller=cell`
                    (the run's own graph searches; caller=brief is the host's),
                    `runtime: research brief run= ... digest_tokens= digest_captures=`
                    (what the run was handed), `runtime: research report run= final=
                    sources= from_corpus= by_run= gap= gap_text=` (what its Report cites and whether
                    it names what the corpus lacked: gap is true only for a "missing:" line that
                    says something other than "none" or the old placeholder; gap_text is that
                    line's words, clipped. Lines written before 2026-11-22 carry no gap_text and
                    their gap= is a template echo: any "missing:" line) and `runtime: search run= desk=`
                    (one per ended run). The console keeps about 2.5 hours, so the console
                    figures cover only that span.

Printed: runs, searches, mean per run, the 1/2/3/4+ distribution, the 7+ tail, searches by
desk; later searches with no successful read since the run's previous search; pages
returned and read; THEN the measures of using and building on the corpus: the digest (runs
handed one, median tokens), the share of runs whose first search was a graph search, graph
searches per web search, the share of runs with no web search at all, the share of the
digest's captures the runs read, the share of cited sources that were in the corpus before
the run versus captured by it, and the share of runs whose Report names a gap (what the
corpus lacked).
The reformulation measures (2026-11-22): the mean web searches per run over ALL runs (a run with a
brief line or a search; the mean over searching runs is kept and labelled), the share of the
searches sent by the five heaviest runs, the share of later searches sent with no read since the
previous one, and the real gaps: Reports whose gap_text says something, with the texts listed so a
gap table can be made. Never use the per-searching-run mean to judge a change: it hides the runs
that sent none.
"No successful read since the previous search" compares the paper console's clock (corpus
read lines) with the gateway's (search request lines): the two may differ by a few
seconds, so a read within seconds of a search can fall on either side; the figure is a
count, not a gate.
Exit 0, or 2 when the fetch failed. --fixture FILE reads the sections (##READS, ##SUM,
##BRIEF, ##GRAPH, ##REPORT, ##GW) that fetch() builds, with no network.
"""
import argparse
import calendar
import json
import re
import subprocess
import sys
import time

PAPER_VM = "vm-1669020adcece51c2f5ff9b6df399ef5"
NODE = "node-b"
STAMP = r"(\d{4}/\d\d/\d\d \d\d:\d\d:\d\d)"
# desk=research and desk=research_web (a choir.Research child's searches carry the latter)
GW_RE = re.compile("^" + STAMP + r" gateway: search request from autoputer (\S+) \(.*run=(\S+) desk=(research(?:_web)?) ")  # greedy: the LAST run= desk= is the fixed tail
READ_RE = re.compile(STAMP + r" corpus read run=(\S+) desk=\S+ conv=\S+ capture=(\S+) held=(\S+) via=(\S+)")
SUM_RE = re.compile(STAMP + r" runtime: search run=(\S+) desk=research(?:_web)? (.*)$")
BRIEF_RE = re.compile(STAMP + r" runtime: research brief run=(\S+) .*? digest_tokens=(\d+).*? digest_captures=(\S*)")
GRAPH_RE = re.compile(STAMP + r" corpus search .*? run=(\S+) desk=research .*? caller=cell")
REPORT_RE = re.compile(STAMP + r" runtime: research report run=(\S+) final=(true|false) sources=(\d+) from_corpus=(\d+) by_run=(\d+) no_capture=(\d+) claims=(\d+) adds=(true|false) gap=(true|false)(?: gap_text=\"((?:[^\"\\]|\\.)*)\")?")
KV_RE = re.compile(r"(\w+)=(\d+)")


def epoch(s):
    return calendar.timegm(time.strptime(s, "%Y/%m/%d %H:%M:%S"))


def arg_time(s):
    return calendar.timegm(time.strptime(s, "%Y-%m-%dT%H:%MZ"))


def median(xs):
    xs = sorted(xs)
    if not xs:
        return None
    return xs[len(xs) // 2] if len(xs) % 2 else (xs[len(xs) // 2 - 1] + xs[len(xs) // 2]) / 2.0


def unquote(s):
    """The gap_text a Go %q wrote, as text; None for a line with no gap_text (written before it existed)."""
    if s is None:
        return None
    try:
        return json.loads('"' + s + '"')
    except ValueError:
        return s


def pct(a, b):
    return round(100.0 * a / b, 1) if b else None


def show(v):
    """A figure for the text report: n/a for one that has no denominator."""
    return "n/a" if v is None else v


def pc(v):
    """A percentage for the text report."""
    return "n/a" if v is None else "%s%%" % v


def compute(text, since, until):
    sec = ""
    gw, reads, sums = [], {}, []
    by_desk = {}
    briefs = {}   # run -> (digest tokens, set of the digest's capture ids)
    graph = {}    # run -> times of the run's own graph searches
    reports = {}  # run -> (final, sources, from_corpus, by_run, gap, gap_text or None) of its last (final preferred) report line
    capture_reads = {}  # run -> set of capture ids read via read_capture
    console_first = None  # the console's earliest line of any section: where its span starts

    def seen(t):
        nonlocal console_first
        if console_first is None or t < console_first:
            console_first = t

    for ln in text.splitlines():
        if ln.startswith("##"):
            sec = ln
            continue
        if sec == "##GW":
            m = GW_RE.search(ln)
            # only the paper's own computer (other computers' searches are not the
            # paper's), and a search with no run (run=-) belongs to no run
            if m and m.group(2) == PAPER_VM and m.group(3) != "-":
                t = epoch(m.group(1))
                if t >= since and t < until:
                    gw.append((t, m.group(3)))
                    by_desk[m.group(4)] = by_desk.get(m.group(4), 0) + 1
        elif sec == "##READS":
            m = READ_RE.search(ln)
            if m:
                t = epoch(m.group(1))
                seen(t)
                reads.setdefault(m.group(2), []).append(t)
                if m.group(5) == "read_capture":
                    capture_reads.setdefault(m.group(2), set()).add(m.group(3))
        elif sec == "##BRIEF":
            m = BRIEF_RE.search(ln)
            if m:
                t = epoch(m.group(1))
                seen(t)
                if since <= t < until:
                    briefs[m.group(2)] = (int(m.group(3)), set(x for x in m.group(4).split(",") if x and x != "-"))
        elif sec == "##GRAPH":
            m = GRAPH_RE.search(ln)
            if m:
                t = epoch(m.group(1))
                seen(t)
                if since <= t < until:
                    graph.setdefault(m.group(2), []).append(t)
        elif sec == "##REPORT":
            m = REPORT_RE.search(ln)
            if m:
                t = epoch(m.group(1))
                seen(t)
                if since <= t < until:
                    run, final = m.group(2), m.group(3) == "true"
                    prev = reports.get(run)
                    if prev is None or final or not prev[0]:
                        reports[run] = (final, int(m.group(4)), int(m.group(5)), int(m.group(6)), m.group(10) == "true", unquote(m.group(11)))
        elif sec == "##SUM":
            m = SUM_RE.search(ln)
            if m:
                t = epoch(m.group(1))
                seen(t)
                if t >= since and t < until:
                    sums.append(m.group(3))
    gw.sort()
    by_run = {}
    for t, r in gw:
        by_run.setdefault(r, []).append(t)
    n = len(gw)
    runs = len(by_run)
    dist = {"1": 0, "2": 0, "3": 0, "4+": 0}
    tail_runs = tail_searches = 0
    for ts in by_run.values():
        k = len(ts)
        dist[str(k) if k < 4 else "4+"] += 1
        if k >= 7:
            tail_runs += 1
            tail_searches += k
    # reads: a gap between two searches of a run is judged when the earlier search is
    # at or after the console's first line (its reads are then all in the console). A
    # read in the same second as either search counts: the console and the gateway
    # clocks are read to the second.
    later = zero = 0
    win_runs = 0
    for r, ts in by_run.items():
        if console_first is None:
            break
        counted = False
        for i in range(1, len(ts)):
            if ts[i - 1] < console_first:
                continue
            counted = True
            later += 1
            if not any(ts[i - 1] <= rt <= ts[i] for rt in reads.get(r, [])):
                zero += 1
        win_runs += counted
    tot = {"returned": 0, "read": 0, "started": 0, "children": 0}
    started_by_desk = {}
    for body in sums:
        kv = dict(KV_RE.findall(body))
        tot["returned"] += int(kv.get("pages_returned", 0))
        tot["read"] += int(kv.get("pages_read", 0))
        tot["started"] += int(kv.get("started", 0))
        tot["children"] += int(kv.get("children", 0))
        for k, v in kv.items():
            if k.startswith("started_"):
                started_by_desk[k[len("started_"):]] = started_by_desk.get(k[len("started_"):], 0) + int(v)

    # Using and building on the corpus.
    digest_tokens = [tok for tok, _ in briefs.values() if tok > 0]
    searched = set(graph) | set(by_run)
    graph_first = sum(1 for r in searched if graph.get(r) and (not by_run.get(r) or min(graph[r]) <= min(by_run[r])))
    graph_searches = sum(len(v) for v in graph.values())
    web_searches_graph_runs = n  # the gateway's searches in the window
    console_runs = set(briefs)
    zero_web = sum(1 for r in console_runs if not by_run.get(r))
    named = read_named = 0
    for r, (_, ids) in briefs.items():
        named += len(ids)
        read_named += len(ids & capture_reads.get(r, set()))
    corpus_src = sum(v[2] for v in reports.values())
    run_src = sum(v[3] for v in reports.values())
    gap_runs = sum(1 for v in reports.values() if v[4])
    with_text = [v for v in reports.values() if v[5] is not None]
    real_gaps = [v for v in with_text if v[4] and v[5].strip()]
    gap_texts = sorted(v[5] for v in real_gaps)
    # All runs: those that searched and those that had a brief line (a research run with a
    # digest) and sent no search. The brief lines cover the console's span only.
    all_runs = set(by_run) | set(briefs)
    top5 = sorted((len(ts) for ts in by_run.values()), reverse=True)[:5]
    return {
        "since": time.strftime("%Y-%m-%dT%H:%MZ", time.gmtime(since)),
        "runs": runs, "searches": n, "mean_per_run": round(n / runs, 2) if runs else None,
        "mean_per_searching_run": round(n / runs, 2) if runs else None,
        "runs_all": len(all_runs), "mean_per_run_all": round(n / len(all_runs), 2) if all_runs else None,
        "heaviest5_searches": sum(top5), "heaviest5_share_pct": pct(sum(top5), n),
        "later_no_read_pct": pct(zero, later),
        "runs_by_searches": dist, "runs_7plus": tail_runs, "searches_from_7plus": tail_searches,
        "console_empty": console_first is None,
        "console_span_runs": win_runs, "later_searches": later, "later_no_successful_read": zero,
        "ended_runs": len(sums), "ended_runs_started": tot["started"],
        "pages_returned": tot["returned"], "pages_read": tot["read"],
        "searches_by_desk": by_desk, "children": tot["children"], "started_by_desk": started_by_desk,
        "digest_runs": len(digest_tokens), "brief_runs": len(briefs), "digest_tokens_median": median(digest_tokens),
        "searched_runs": len(searched), "graph_first_runs": graph_first, "graph_first_pct": pct(graph_first, len(searched)),
        "graph_searches": graph_searches, "graph_per_web_search": round(graph_searches / web_searches_graph_runs, 2) if web_searches_graph_runs else None,
        "zero_web_runs": zero_web, "zero_web_pct": pct(zero_web, len(console_runs)),
        "digest_captures_named": named, "digest_captures_read": read_named, "digest_captures_read_pct": pct(read_named, named),
        "report_runs": len(reports), "cited_from_corpus": corpus_src, "cited_by_run": run_src,
        "cited_from_corpus_pct": pct(corpus_src, corpus_src + run_src),
        "gap_runs": gap_runs, "gap_pct": pct(gap_runs, len(reports)),
        "reports_with_gap_text": len(with_text), "real_gap_runs": len(real_gaps),
        "real_gap_pct": pct(len(real_gaps), len(with_text)), "gap_texts": gap_texts,
    }


def render(r):
    o = ["status-search-reads since %s" % r["since"]]
    o.append("runs %d  searches %d  mean per run %s (over searching runs only)" % (r["runs"], r["searches"], r["mean_per_run"]))
    d = r["runs_by_searches"]
    o.append("runs sending 1 / 2 / 3 / 4+ searches: %d / %d / %d / %d" % (d["1"], d["2"], d["3"], d["4+"]))
    o.append("runs sending 7+: %d, %d searches (%s of all)" % (
        r["runs_7plus"], r["searches_from_7plus"],
        "%.0f%%" % (100.0 * r["searches_from_7plus"] / r["searches"]) if r["searches"] else "n/a"))
    o.append("searches by desk (gateway): %s" % (" ".join("%s=%d" % kv for kv in sorted(r["searches_by_desk"].items())) or "-"))
    top = "%d of %d searches (%s)" % (r["heaviest5_searches"], r["searches"], pc(r["heaviest5_share_pct"])) if r["searches"] else "n/a"
    o.append("mean over searching runs (%d runs): %s; the five heaviest runs sent %s" % (r["runs"], r["mean_per_searching_run"], top))
    if r["console_empty"]:
        o.append("console window empty: the guest console holds no line, so the read and corpus figures are unavailable, not zero")
        return "\n".join(o)
    o.append("console span: %d runs; later searches %d, sent with no SUCCESSFUL read since the run's previous search: %d (the corpus read line is written only when a read succeeds; a failed attempt is not counted)" % (
        r["console_span_runs"], r["later_searches"], r["later_no_successful_read"]))
    o.append("ended runs %d (console span): searches started %d, pages returned %d, pages read %d; children %d; searches started by desk: %s" % (
        r["ended_runs"], r["ended_runs_started"], r["pages_returned"], r["pages_read"], r["children"],
        " ".join("%s=%d" % kv for kv in sorted(r["started_by_desk"].items())) or "-"))
    o.append("all runs: %d (%d searched), mean web searches per run %s; searches sent with no SUCCESSFUL read since the previous search (console clock): %s of %d later searches" % (
        r["runs_all"], r["runs"], r["mean_per_run_all"], pc(r["later_no_read_pct"]), r["later_searches"]))
    o.append("USING THE CORPUS (console span):")
    o.append("  digest: %d of %d runs with a brief line were handed one; median %s tokens" % (r["digest_runs"], r["brief_runs"], show(r["digest_tokens_median"])))
    o.append("  runs whose first search was a graph search: %d of %d that searched (%s)" % (r["graph_first_runs"], r["searched_runs"], pc(r["graph_first_pct"])))
    o.append("  graph searches %d, per web search %s; runs with no web search at all: %d of %d (%s)" % (
        r["graph_searches"], show(r["graph_per_web_search"]), r["zero_web_runs"], r["brief_runs"], pc(r["zero_web_pct"])))
    o.append("  the digest's captures the runs then read by capture id: %d of %d (%s)" % (r["digest_captures_read"], r["digest_captures_named"], pc(r["digest_captures_read_pct"])))
    o.append("BUILDING ON IT:")
    o.append("  cited sources in the runs' Reports: %d were in the corpus before the run, %d captured by it (%s from the corpus; %d Reports)" % (
        r["cited_from_corpus"], r["cited_by_run"], pc(r["cited_from_corpus_pct"]), r["report_runs"]))
    o.append("  Reports naming a gap (what the corpus lacked): %d of %d (%s; older Reports count any missing: line, newer ones only a line that says something)" % (r["gap_runs"], r["report_runs"], pc(r["gap_pct"])))
    o.append("  real gaps (a missing line that says something): %d of %d Reports that carry a gap_text (%s; %d older Reports carry none and their gap= is a template echo)" % (
        r["real_gap_runs"], r["reports_with_gap_text"], pc(r["real_gap_pct"]), r["report_runs"] - r["reports_with_gap_text"]))
    for t in r["gap_texts"]:
        o.append("    missing: %s" % t[:160])
    return "\n".join(o)


# One read-only pass over the console files and the gateway journal, through pipes
# only: nothing is written on Node B. Each kept line leaves with a one-letter tag
# (R read, S run summary, B research brief, C corpus search by a run's cell, P research
# report, G gateway request) that fetch() turns into the sections compute() reads.
REMOTE = r"""
dir=/var/lib/go-choir/vm-state/@VM@
sudo -n true 2>/dev/null || echo "##NOSUDO"
sudo -n sh -c "cd $dir && for f in console.log.4 console.log.3 console.log.2 console.log.1 console.log; do [ -f \$f ] && cat \$f; done" 2>/dev/null |
  sed -E 's/ query="([^"\\]|\\.)*"//' |
  awk '/ corpus read run=/ {print "R|" $0; next}
       / runtime: search run=/ {print "S|" $0; next}
       / runtime: research brief run=/ {print "B|" $0; next}
       / corpus search computer=/ && / caller=cell/ {print "C|" $0; next}
       / runtime: research report run=/ {print "P|" $0; next}'
sudo -n journalctl --no-pager -o cat --utc --since "@DAY@ 00:00:00 UTC" -u go-choir-gateway 2>/dev/null |
  grep -a 'gateway: search request from autoputer' | sed -E 's/query="([^"\\]|\\.)*"//; s/^/G|/'
echo "##END"
""".replace("@VM@", PAPER_VM)


def fetch(node, since):
    day = time.strftime("%Y-%m-%d", time.gmtime(since))
    p = subprocess.run(["ssh", "-C", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", node, REMOTE.replace("@DAY@", day)],
                       capture_output=True, text=True, timeout=300)
    if "##END" not in p.stdout:
        raise RuntimeError("ssh %s failed or replied incompletely (rc=%d)" % (node, p.returncode))
    if "##NOSUDO" in p.stdout:
        raise RuntimeError("sudo -n is not allowed on %s" % node)
    secs = {"R": [], "S": [], "B": [], "C": [], "P": [], "G": []}
    for ln in p.stdout.splitlines():
        if len(ln) > 2 and ln[1] == "|" and ln[0] in secs:
            secs[ln[0]].append(ln[2:])
    return "\n".join(["##READS"] + secs["R"] + ["##SUM"] + secs["S"] + ["##BRIEF"] + secs["B"] + ["##GRAPH"] + secs["C"] + ["##REPORT"] + secs["P"] + ["##GW"] + secs["G"])


def main(argv):
    ap = argparse.ArgumentParser(prog="status-search-reads")
    ap.add_argument("--since")
    ap.add_argument("--until")
    ap.add_argument("--node", default=NODE)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--fixture")
    a = ap.parse_args(argv)
    try:
        now = time.time()
        since = arg_time(a.since) if a.since else now - now % 86400
        until = arg_time(a.until) if a.until else 1 << 62
        if a.fixture:
            with open(a.fixture) as f:
                text = f.read()
        else:
            text = fetch(a.node, since)
        r = compute(text, since, until)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as e:
        print("status-search-reads: unavailable: %s" % e, file=sys.stderr)
        return 2
    print(json.dumps(r, sort_keys=True) if a.json else render(r))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
