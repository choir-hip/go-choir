#!/usr/bin/env python3
"""The Autoradio native-boundary gate (docs/definitions/choir-autoradio-exact-cutover-2026-11-18.md,
station XG). Owner rule (CLAUDE.md, Product): the phone app is Exact; only voice is native.

It counts, on the tree it is run in:
  files, lines  Swift (and Kotlin) source under mobile/AutoradioKit/, mobile/exact-package/apple/ and mobile/AutoradioLab/modules/ (the app's own native module, ModelsEntry.swift),
                Tests/ excluded, that is NOT on the voice-and-deck list;
  names         names in the native interface (mobile/exact-package/exact.json plus the lane
                fragments in mobile/exact-package/interface/) that are NOT on the list.
Kotlin: every .kt/.kts file under mobile/ is counted the same way.

The voice-and-deck list is scripts/autoradio-native-voice-list.txt (one entry per line, each with
the reason it is native). The ceiling is scripts/autoradio-native-ceiling.txt. A count above its
ceiling fails (native code grew). A count below its ceiling also fails, until the ceiling is lowered
in the same tree: the ceiling only falls and always equals the truth. A list entry that matches
nothing fails (a stale list is not a list).

  scripts/check-autoradio-native-boundary [--root D] [--voice-list F] [--ceiling F] [--update]

--update rewrites the ceiling file to today's counts, and refuses when any count is above it.
Run with python3 -I (scripts/gates does).
"""
import argparse, fnmatch, json, os, subprocess, sys

ROOTS = ("mobile/AutoradioKit/", "mobile/exact-package/apple/", "mobile/AutoradioLab/modules/")
EXACT_JSON = "mobile/exact-package/exact.json"
FRAGMENTS = "mobile/exact-package/interface/"
KEYS = ("files", "lines", "names")


def die(msg):
    print("autoradio-native-boundary: " + msg, file=sys.stderr)
    sys.exit(2)


def tracked(root):
    # the working tree as it will be committed: tracked and new files, not ignored ones (the gitignored
    # copy of the kit in exact-package/apple/Kit is a build product), and not files deleted but not yet staged
    out = subprocess.run(["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, text=True, check=True).stdout
    return sorted(p for p in out.split("\0") if p and os.path.isfile(os.path.join(root, p)))


def parse_list(path):
    paths, names = [], []
    for n, raw in enumerate(open(path, encoding="utf-8"), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = line.split(None, 2)
        if len(parts) < 3 or parts[0] not in ("path", "name"):
            die("%s:%d: want `path <prefix> <why>` or `name <name or prefix*> <why>`: %s" % (path, n, line))
        (paths if parts[0] == "path" else names).append((parts[1], parts[2]))
    return paths, names


def path_hit(entry, p):
    return p == entry or (entry.endswith("/") and p.startswith(entry))


def name_hit(entry, n):
    return n == entry or (entry.endswith("*") and n.startswith(entry[:-1]))


def interface_names(root):
    names = set()
    try:
        for n in json.load(open(os.path.join(root, EXACT_JSON))).get("names", []):
            names.add(n.get("source") or n.get("send"))
    except FileNotFoundError:
        pass
    d = os.path.join(root, FRAGMENTS)
    if os.path.isdir(d):
        for f in sorted(os.listdir(d)):
            if f.endswith(".json"):
                for n in json.load(open(os.path.join(d, f))).get("names", []):
                    names.add(n.get("source") or n.get("send"))
    names.discard(None)
    return sorted(names)


def count(root, paths, names):
    nonvoice, listed_hits, name_hits = [], {e: 0 for e, _ in paths}, {e: 0 for e, _ in names}
    for p in tracked(root):
        is_src = (p.endswith(".swift") and p.startswith(ROOTS) and "/Tests/" not in p) or \
                 (p.startswith("mobile/") and p.endswith((".kt", ".kts")))
        if not is_src:
            continue
        hit = [e for e, _ in paths if path_hit(e, p)]
        for e in hit:
            listed_hits[e] += 1
        if hit:
            continue
        with open(os.path.join(root, p), "rb") as f:
            nonvoice.append((p, sum(1 for _ in f)))
    nonvoice_names = []
    for n in interface_names(root):
        hit = [e for e, _ in names if name_hit(e, n)]
        for e in hit:
            name_hits[e] += 1
        if not hit:
            nonvoice_names.append(n)
    stale = [e for e, c in list(listed_hits.items()) + list(name_hits.items()) if c == 0]
    return nonvoice, nonvoice_names, stale


def read_ceiling(path):
    c = {}
    for raw in open(path, encoding="utf-8"):
        line = raw.split("#", 1)[0].split()
        if len(line) == 2 and line[0] in KEYS and line[1].isdigit():
            c[line[0]] = int(line[1])
    for k in KEYS:
        if k not in c:
            die("%s: no `%s <number>` line" % (path, k))
    return c


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root")
    ap.add_argument("--voice-list")
    ap.add_argument("--ceiling")
    ap.add_argument("--update", action="store_true")
    a = ap.parse_args()
    root = a.root or subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                                    check=True).stdout.strip()
    vl = a.voice_list or os.path.join(root, "scripts/autoradio-native-voice-list.txt")
    cf = a.ceiling or os.path.join(root, "scripts/autoradio-native-ceiling.txt")
    paths, names = parse_list(vl)
    files, nnames, stale = count(root, paths, names)
    got = {"files": len(files), "lines": sum(n for _, n in files), "names": len(nnames)}
    ceil = read_ceiling(cf) if os.path.exists(cf) else None

    print("non-voice native code: %d files, %d lines, %d interface names" % (got["files"], got["lines"], got["names"]))
    print("ceiling:               %s" % ("none" if ceil is None else
          "%d files, %d lines, %d interface names" % (ceil["files"], ceil["lines"], ceil["names"])))
    print("ten largest non-voice files:")
    for p, n in sorted(files, key=lambda x: (-x[1], x[0]))[:10]:
        print("  %6d  %s" % (n, p))

    bad = []
    for e in stale:
        bad.append("voice list entry matches nothing (delete it): " + e)
    if a.update:
        if ceil is not None and any(got[k] > ceil[k] for k in KEYS):
            bad.append("refusing to raise the ceiling: " + ", ".join(
                "%s %d > %d" % (k, got[k], ceil[k]) for k in KEYS if got[k] > ceil[k]))
        if not bad:
            with open(cf, "w", encoding="utf-8") as f:
                f.write("# The Autoradio native-boundary ceiling: non-voice native code that may exist. It only falls.\n"
                        "# Lower it with `scripts/check-autoradio-native-boundary --update` in the change that deletes the code.\n")
                for k in KEYS:
                    f.write("%s %d\n" % (k, got[k]))
            print("ceiling written")
            return 0
    elif ceil is None:
        bad.append("no ceiling file: " + cf)
    else:
        for k in KEYS:
            if got[k] > ceil[k]:
                bad.append("%s is %d, above the ceiling %d: native code outside the voice list grew "
                           "(the phone app is Exact; only voice is native, CLAUDE.md)" % (k, got[k], ceil[k]))
            elif got[k] < ceil[k]:
                bad.append("%s is %d, below the ceiling %d: lower the ceiling in this same change "
                           "(scripts/check-autoradio-native-boundary --update)" % (k, got[k], ceil[k]))
    if bad:
        for b in bad:
            print("FAIL: " + b)
        return 1
    print("native boundary holds")
    return 0


sys.exit(main())
