#!/usr/bin/env python3
"""A landing that touches the phone app's shared code runs its tests the way CI runs them.

CI has a job, "Autoradio Shared-Code Tests" (.github/workflows/ci.yml): no Exact checkout, a stub
package for @exact/passkeys, `bun install --frozen-lockfile`, `bun test` in mobile/AutoradioLab, with
the pinned Bun. A landing turned main red because nothing local ran it
(docs/problems/a-landing-turned-main-red-because-landings-do-not-run-the-shared-code-tests-2026-11-28.md).

  scripts/check-shared-code-tests --changed-from <ref>          the landing step (the landing script runs it after the gates)
  scripts/check-shared-code-tests --needed --changed-from <ref> exit 0 when the diff <ref>..HEAD needs it, 1 when not
  scripts/check-shared-code-tests --selftest

When no changed path is one the tests read, it prints one line and exits 0. Otherwise it unpacks HEAD
(mobile/ and the files outside it that the tests read) into a scratch directory with `git archive`, writes the
CI stub for the Exact package (the real one lives in the gitignored mobile/.exact-src, which the scratch
copy does not have, as on a CI runner), runs `bun install --frozen-lockfile` then `bun test` with the
pinned Bun, and removes the scratch directory whatever happens. 900 s for both. It fails on any failing
test and prints each failing test's name. It never touches the tree it runs in.

The pinned Bun is $HOME/.bun-<pin>/bin/bun. If it is absent the step fails and says how to install it;
it never falls back to another Bun. No way to skip it. The runner the selftest uses is a parameter of
run_check; the command line has no way to name one.

Not done here: the same suite with Exact present, as a lane runs it (about six minutes, and it needs the
build tree's Exact checkout). The problem record says so.
"""
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile

BUN_PIN = "1.4.2"  # .github/workflows/ci.yml (npm install --global bun@...), mobile/AutoradioLab/exact.mjs ensureBun
TIMEOUT = 900
# What the tests read, and so what a changed path must be to need the run (the same list as ci-impact-classify's `mobile`
# case, plus the interface and scripts they read). Prefixes end in /, the rest are whole paths.
NEEDED = [
    "mobile/AutoradioLab/",
    "mobile/exact-package/",
    "mobile/scripts/",
    "mobile/fixtures/",
    "mobile/layouts/",
    "mobile/themes/",
    "mobile/docs/typography.md",
    "internal/autoradioqueue/queue.go",
    "internal/texturedoc/golden/",
    "scripts/android-deck-tests/",  # android-package.test.ts checks that the Kotlin deck test exists
]
# unpacked into the scratch copy: all of mobile/, and the Go-side files the tests read by relative path
ARCHIVE = ["mobile", "internal/autoradioqueue/queue.go", "internal/texturedoc/golden", "scripts/android-deck-tests"]
STUB = '{"name":"@exact/passkeys","version":"1.0.0","private":true}\n'
FAILING = re.compile(r"^\s*\(fail\)\s+(.*?)(?:\s+\[[\d.]+ ?m?s\])?\s*$")


def needed(files):
    return [f for f in files if any(f.startswith(p) if p.endswith("/") else f == p for p in NEEDED)]


def changed_files(ref, cwd=None):
    r = subprocess.run(["git", "diff", "--name-only", "--no-renames", ref, "HEAD"], capture_output=True, text=True, cwd=cwd)
    if r.returncode:
        raise SystemExit("check-shared-code-tests: git diff %s HEAD failed: %s" % (ref, r.stderr.strip()))
    return [l for l in r.stdout.splitlines() if l]


def pinned_bun():
    return os.path.join(os.path.expanduser("~"), ".bun-%s" % BUN_PIN, "bin", "bun")


def failing_names(log):
    return sorted({m.group(1) for l in log.splitlines() for m in [FAILING.match(l)] if m})


def real_runner(scratch, bun, timeout):
    """Runs install then test in the scratch copy. Returns (exit code, log, timed out)."""
    lab = os.path.join(scratch, "mobile", "AutoradioLab")
    env = dict(os.environ, CI="true")
    log = ""
    for cmd in ([bun, "install", "--frozen-lockfile"], [bun, "test"]):
        p = subprocess.Popen(cmd, cwd=lab, env=env, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, start_new_session=True)
        try:
            out, _ = p.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            try:
                os.killpg(p.pid, signal.SIGKILL)  # the group this run started, nothing else
            except OSError:
                pass
            out, _ = p.communicate()
            return 1, log + (out or ""), True
        log += "$ %s\n%s" % (" ".join(cmd[1:]), out)
        if p.returncode:
            return p.returncode, log, False
    return 0, log, False


def unpack(top, scratch):
    a = subprocess.Popen(["git", "-C", top, "archive", "HEAD", *ARCHIVE], stdout=subprocess.PIPE)
    t = subprocess.run(["tar", "-x", "-C", scratch], stdin=a.stdout, capture_output=True, text=True)
    a.stdout.close()
    if a.wait() or t.returncode:
        raise RuntimeError("could not unpack HEAD into the scratch copy: %s" % t.stderr.strip())
    stub = os.path.join(scratch, "mobile", ".exact-src", "packages", "passkeys")
    os.makedirs(stub)
    with open(os.path.join(stub, "package.json"), "w") as f:
        f.write(STUB)


def run_check(top, bun, runner=real_runner, timeout=TIMEOUT, tmpdir=None, out=None):
    """Returns 0 on pass, 1 on fail. bun and runner are parameters so the selftest can fake them."""
    out = out or sys.stdout
    if not os.path.isfile(bun) or not os.access(bun, os.X_OK):
        print("check-shared-code-tests: FAILED: the pinned Bun %s is not at %s. CI runs the suite with it; no other Bun is used. "
              "Install it: npm install --global --prefix %s bun@%s" % (BUN_PIN, bun, os.path.dirname(os.path.dirname(bun)), BUN_PIN), file=out)
        return 1
    scratch = tempfile.mkdtemp(prefix="shared-code-tests.", dir=tmpdir)
    try:
        try:
            unpack(top, scratch)
        except RuntimeError as e:
            print("check-shared-code-tests: FAILED: %s" % e, file=out)
            return 1
        code, log, timed_out = runner(scratch, bun, timeout)
        if timed_out:
            print("check-shared-code-tests: FAILED: no result in %d s; killed.\n--- last 30 lines\n%s" % (timeout, "\n".join(log.splitlines()[-30:])), file=out)
            return 1
        if code:
            names = failing_names(log)
            print("check-shared-code-tests: FAILED (exit %d), bun %s, as CI runs it (no Exact checkout)" % (code, BUN_PIN), file=out)
            print("--- last 25 lines\n%s" % "\n".join(log.splitlines()[-25:]), file=out)
            if names:  # last, so a caller that shows the tail of this output shows them
                print("--- failing tests\n" + "\n".join("  " + n for n in names[:30]), file=out)
            return 1
        tail = [l.strip() for l in log.splitlines() if re.match(r"^\s*\d+ (pass|fail|skip)\b", l)]
        print("check-shared-code-tests: passed (bun %s, as CI runs it, no Exact checkout): %s" % (BUN_PIN, ", ".join(tail) or "no count in the log"), file=out)
        return 0
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def main(argv):
    if argv == ["--selftest"]:
        return selftest()
    if "--changed-from" not in argv or argv.index("--changed-from") + 1 >= len(argv):
        print("usage: scripts/check-shared-code-tests [--needed] --changed-from <ref> | --selftest", file=sys.stderr)
        return 2
    ref = argv[argv.index("--changed-from") + 1]
    top = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True).stdout.strip()
    if not top:
        print("check-shared-code-tests: not in a git checkout", file=sys.stderr)
        return 2
    hit = needed(changed_files(ref, top))
    if "--needed" in argv:
        return 0 if hit else 1
    if not hit:
        print("check-shared-code-tests: not needed: no path the shared-code tests read changed since %s" % ref[:12])
        return 0
    print("check-shared-code-tests: needed, changed: %s%s" % (", ".join(hit[:5]), " ..." if len(hit) > 5 else ""), flush=True)
    return run_check(top, pinned_bun())


# ------------------------------------------------------------------ selftest
def selftest():
    passed = failed = 0

    def check(name, cond, detail=""):
        nonlocal passed, failed
        if cond:
            passed += 1
        else:
            failed += 1
            print("FAIL: %s %s" % (name, detail))

    class Buf:
        def __init__(self):
            self.s = ""

        def write(self, x):
            self.s += x

        def flush(self):
            pass

    T = tempfile.mkdtemp(prefix="shared-code-selftest.")
    try:
        # the path list
        check("app code needs it", needed(["mobile/AutoradioLab/api.ts"]))
        check("interface and scripts need it", all(needed([f]) for f in ["mobile/exact-package/interface/a.json", "mobile/exact-package/apple/A.swift", "mobile/scripts/gen-build-info.sh"]))
        check("fixtures, golden docs, queue struct need it", all(needed([f]) for f in ["mobile/fixtures/a.json", "internal/texturedoc/golden/a.json", "internal/autoradioqueue/queue.go", "mobile/docs/typography.md", "scripts/android-deck-tests/kotlin/a.kt"]))
        check("other paths do not", not needed(["docs/a.md", "internal/x.go", "internal/autoradioqueue/other.go", "mobile/docs/other.md", "mobile/AutoradioKit/Sources/k.swift"]))
        ci = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", ".github", "workflows", "ci.yml")
        if os.path.exists(ci):
            check("the pin is the one ci.yml installs", ("bun@%s" % BUN_PIN) in open(ci).read())

        # a fake tree: a repo with mobile/AutoradioLab and the two Go-side files
        repo = os.path.join(T, "repo")
        os.makedirs(os.path.join(repo, "mobile/AutoradioLab"))
        os.makedirs(os.path.join(repo, "internal/autoradioqueue"))
        os.makedirs(os.path.join(repo, "internal/texturedoc/golden"))
        os.makedirs(os.path.join(repo, "scripts/android-deck-tests"))
        for f, c in [("mobile/AutoradioLab/a.test.ts", "x"), ("mobile/AutoradioLab/package.json", "{}"), ("internal/autoradioqueue/queue.go", "package q"), ("internal/texturedoc/golden/g.json", "{}"), ("scripts/android-deck-tests/k.kt", "k"), ("docs.md", "d")]:
            with open(os.path.join(repo, f), "w") as h:
                h.write(c)
        env = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@t", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@t")
        g = lambda *a: subprocess.run(["git", "-C", repo, *a], capture_output=True, text=True, check=True, env=env).stdout.strip()
        g("init", "-q")
        g("add", "-A")
        g("commit", "-q", "-m", "base")
        base = g("rev-parse", "HEAD")
        with open(os.path.join(repo, "docs.md"), "a") as h:
            h.write("more")
        g("commit", "-qam", "docs")
        check("docs only: not needed", not needed(changed_files(base, repo)))
        with open(os.path.join(repo, "mobile/AutoradioLab/a.test.ts"), "a") as h:
            h.write("y")
        g("commit", "-qam", "app")
        check("an app change: needed", bool(needed(changed_files(base, repo))))
        me = [sys.executable, "-I", os.path.abspath(__file__)]
        r = subprocess.run(me + ["--needed", "--changed-from", base], cwd=repo, capture_output=True, text=True)
        check("--needed exits 0 for an app change", r.returncode == 0)
        r = subprocess.run(me + ["--needed", "--changed-from", "HEAD"], cwd=repo, capture_output=True, text=True)
        check("--needed exits 1 for nothing", r.returncode == 1)
        r = subprocess.run(me + ["--changed-from", "HEAD"], cwd=repo, capture_output=True, text=True)
        check("nothing changed: one line, exit 0", r.returncode == 0 and "not needed" in r.stdout and len(r.stdout.strip().splitlines()) == 1, r.stdout)

        fakebun = os.path.join(T, "bin", "bun")
        os.makedirs(os.path.dirname(fakebun))
        with open(fakebun, "w") as h:
            h.write("#!/bin/sh\n")
        os.chmod(fakebun, 0o755)
        scratches = []
        tmp = os.path.join(T, "tmp")
        os.makedirs(tmp)

        def runner_for(code, log, timed_out=False):
            def run(scratch, bun, timeout):
                scratches.append(scratch)
                seen = {
                    "test": os.path.isfile(os.path.join(scratch, "mobile/AutoradioLab/a.test.ts")),
                    "stub": os.path.isfile(os.path.join(scratch, "mobile/.exact-src/packages/passkeys/package.json")),
                    "queue": os.path.isfile(os.path.join(scratch, "internal/autoradioqueue/queue.go")),
                    "golden": os.path.isfile(os.path.join(scratch, "internal/texturedoc/golden/g.json")),
                    "deck": os.path.isfile(os.path.join(scratch, "scripts/android-deck-tests/k.kt")),
                    "bun": bun == fakebun,
                }
                run.seen = seen
                return code, log, timed_out
            return run

        b = Buf()
        run = runner_for(0, "bun test v1.4.2\n 100 pass\n 3 skip\n 0 fail\nRan 103 tests\n")
        rc = run_check(repo, fakebun, run, 5, tmp, b)
        check("pass: exit 0 with the counts", rc == 0 and "100 pass" in b.s and "0 fail" in b.s, b.s)
        check("the scratch copy has the tests, the stub, the Go and Kotlin files, and the pinned bun was handed over", all(run.seen.values()), str(run.seen))
        check("pass: scratch removed", not os.path.exists(scratches[-1]) and os.listdir(tmp) == [])

        b = Buf()
        run = runner_for(1, "(pass) a\n(fail) reader parse > reads a golden [3.00ms]\n(fail) other test\n 1 pass\n 2 fail\n")
        rc = run_check(repo, fakebun, run, 5, tmp, b)
        check("fail: exit 1, names each failing test", rc == 1 and "reader parse > reads a golden" in b.s and "other test" in b.s and "(pass) a\n" not in b.s.split("--- last 25")[0], b.s)
        check("fail: scratch removed", not os.path.exists(scratches[-1]) and os.listdir(tmp) == [])

        b = Buf()
        rc = run_check(repo, os.path.join(T, "nope", "bun"), runner_for(0, ""), 5, tmp, b)
        check("missing bun: fails with the message", rc == 1 and "pinned Bun" in b.s and "Install it" in b.s and os.listdir(tmp) == [], b.s)

        b = Buf()
        rc = run_check(repo, fakebun, runner_for(1, "partial\n", True), 7, tmp, b)
        check("timeout: fails and says so", rc == 1 and "no result in 7 s" in b.s, b.s)
        check("timeout: scratch removed", not os.path.exists(scratches[-1]) and os.listdir(tmp) == [])

        # the real runner kills a hung child at the timeout (a fake bun that sleeps)
        sl = os.path.join(T, "bin2", "bun")
        os.makedirs(os.path.dirname(sl))
        with open(sl, "w") as h:
            h.write("#!/bin/sh\nsleep 30\n")
        os.chmod(sl, 0o755)
        b = Buf()
        rc = run_check(repo, sl, real_runner, 1, tmp, b)
        check("real runner: a hung bun is killed at the timeout", rc == 1 and "no result in 1 s" in b.s and os.listdir(tmp) == [], b.s)
        # and a fake bun that fails install stops before test
        fl = os.path.join(T, "bin3", "bun")
        os.makedirs(os.path.dirname(fl))
        with open(fl, "w") as h:
            h.write('#!/bin/sh\necho "ran $1"; [ "$1" = install ] && exit 3; exit 0\n')
        os.chmod(fl, 0o755)
        b = Buf()
        rc = run_check(repo, fl, real_runner, 5, tmp, b)
        check("real runner: a failed install fails the step and test is not run", rc == 1 and "ran install" in b.s and "ran test" not in b.s, b.s)
    finally:
        shutil.rmtree(T, ignore_errors=True)
    print("selftest: %d passed, %d failed" % (passed, failed))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
