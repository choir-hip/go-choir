#!/usr/bin/env bash
# Prints (or installs) the systemd --user unit that keeps cmd/podcast-worker
# running on a shared host (docs/design/podcast-clips-2026-11-15.md 3.1).
#
#   scripts/podcast-worker-user-unit --worker-bin B --key-file K --model M \
#       --vad-model V --ffmpeg F --parakeet P --feeds FEEDS [--ld-library-path L]
#   ... --install   writes ~/.config/systemd/user/choir-podcast-worker.service
#                   and reloads the user manager; it does not enable or start it
#
# The unit runs one worker at the lowest CPU weight and idle I/O class with a
# memory ceiling, restarts it after a crash, and never touches the host's own
# configuration. The key file is read by the worker; this script never reads it.
set -euo pipefail
worker="" key="" model="" vad="" ffmpeg="" parakeet="" feeds="" ld="" install=0
while [ $# -gt 0 ]; do
  case "$1" in
    --worker-bin) worker=$2; shift 2 ;;
    --key-file) key=$2; shift 2 ;;
    --model) model=$2; shift 2 ;;
    --vad-model) vad=$2; shift 2 ;;
    --ffmpeg) ffmpeg=$2; shift 2 ;;
    --parakeet) parakeet=$2; shift 2 ;;
    --feeds) feeds=$2; shift 2 ;;
    --ld-library-path) ld=$2; shift 2 ;;
    --install) install=1; shift ;;
    *) echo "unknown argument: $1" >&2; exit 2 ;;
  esac
done
for v in worker key model vad ffmpeg parakeet feeds; do
  [ -n "${!v}" ] || { echo "missing --${v//_/-}" >&2; exit 2; }
done
unit=$(cat <<UNIT
[Unit]
Description=Choir podcast worker: transcribes news episodes for the paper's clips
After=network-online.target

[Service]
Type=simple
ExecStart=$worker serve --server https://choir.news --api-key-file $key --feeds $feeds --ffmpeg $ffmpeg --parakeet $parakeet --model $model --vad-model $vad --threads 4
${ld:+Environment=LD_LIBRARY_PATH=$ld}
Restart=on-failure
RestartSec=30
Nice=19
IOSchedulingClass=idle
CPUWeight=1
MemoryMax=2G
TimeoutStopSec=30

[Install]
WantedBy=default.target
UNIT
)
if [ "$install" = 1 ]; then
  dir="$HOME/.config/systemd/user"
  mkdir -p "$dir"
  printf '%s\n' "$unit" > "$dir/choir-podcast-worker.service"
  systemctl --user daemon-reload
  echo "installed $dir/choir-podcast-worker.service (not enabled, not started)"
  echo "start: systemctl --user start choir-podcast-worker   logs: journalctl --user -u choir-podcast-worker"
  echo "survive logout: loginctl enable-linger \$USER (an act on the host; see the design note)"
else
  printf '%s\n' "$unit"
fi
