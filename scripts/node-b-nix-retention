#!/usr/bin/env bash
# Node B Nix store retention: the one place that decides which system
# generations and which builder-release GC roots stay
# (docs/problems/node-b-nix-store-and-host-disk-policy-2026-10-22.md).
# Callers: the go-choir-nix-gc unit (every 4 hours), the go-choir-disk-gc
# sweep (daily) and scripts/node-b-deploy-disk-preflight. It never runs
# `nix store gc` itself; each caller does after it.
#
# What stays, and why:
# - System generations: nix's own `nix-env --delete-generations +N` rule, with
#   N = NIX_RETENTION_KEEP_GENERATIONS (2): every generation newer than the
#   current one, the current one and the N-1 below it (the previous one is
#   the deploy rollback target in deploy-receipt-previous.json). Owner,
#   2026-10-31: two, not three; each generation roots a 4.4 GB guest image. After a rollback the generations below the
#   rolled-back current stay. The booted system is a GC root of its own
#   (/run/booted-system).
# - Builder releases under /var/lib/go-choir/builder/releases: out-links of
#   ci.yml's app-layer release push (e527c1698, 2026-10-04, to a47122de0,
#   2026-10-09) and of the S2 acceptance probe (scripts/s2_station_acceptance.sh,
#   deleted 2026-10-12 in b9f195b1c). Nothing reads or writes them now: corpusd's host-build service builds
#   under host-build/work and drops its own root, and guests replay the
#   exported closure into their own store. The newest NIX_RETENTION_BUILDER_KEEP
#   stay, and any younger than NIX_RETENTION_BUILDER_MIN_AGE_DAYS, and any
#   whose store path the current system, the booted system or the current
#   guest image is. Only the out-link symlink is removed; the release
#   directory, its receipt and closure blob stay.
# - Never touched: prebuild-results, /tmp deploy result links, host-build
#   work. They are one link per attribute, overwritten by each build, and the
#   service links are the only roots of a service-pointer deploy's closure
#   (the service pointer is a copy whose binaries name store paths).
#
# GO_CHOIR_NIX_RETENTION_MODE: observe (default; any other value is logged and
# read as observe) runs exactly the legacy `nix-env --delete-generations +4`
# and logs what enforce would add; enforce runs `+N` and unroots builder
# releases as above.
# Fails closed: a step that cannot read its input deletes nothing.
set -u

mode="${GO_CHOIR_NIX_RETENTION_MODE:-observe}"
case "$mode" in
  observe|enforce) ;;
  *) echo "nix retention: unknown mode \"$mode\"; using observe"; mode=observe ;;
esac
profile="${NIX_RETENTION_PROFILE:-/nix/var/nix/profiles/system}"
keep="${NIX_RETENTION_KEEP_GENERATIONS:-2}"
legacy_keep=4
auto_dir="${NIX_RETENTION_GCROOTS_AUTO:-/nix/var/nix/gcroots/auto}"
builder_root="${NIX_RETENTION_BUILDER_ROOT:-/var/lib/go-choir/builder/releases}"
builder_keep="${NIX_RETENTION_BUILDER_KEEP:-2}"
builder_min_age_days="${NIX_RETENTION_BUILDER_MIN_AGE_DAYS:-7}"
store_prefix="${NIX_RETENTION_STORE_PREFIX:-/nix/store/}"
protect="${NIX_RETENTION_PROTECT:-/run/current-system /run/booted-system /var/lib/go-choir/guest}"

echo "nix retention: mode=$mode keep_generations=$keep builder_root=$builder_root builder_keep=$builder_keep builder_min_age_days=$builder_min_age_days"

# ---- system generations --------------------------------------------------

# deleted_by_plus <k> prints, oldest first, the generations
# `nix-env --delete-generations +k` deletes: nix keeps every generation newer
# than the current one, the current one and the k-1 below it, and deletes the
# rest (deleteGenerationsGreaterThan). Only the log lines use this model; the
# deletion itself is nix's own `+k`. Reads $listing and $current.
deleted_by_plus() {
  printf '%s\n' "$listing" | awk -v k="$1" -v cur="$current" '
    /^[[:space:]]*[0-9]+[[:space:]]/ { n[++c] = $1 + 0 }
    END {
      for (i = 1; i <= c; i++) for (j = i + 1; j <= c; j++) if (n[j] > n[i]) { t = n[i]; n[i] = n[j]; n[j] = t }
      for (i = 1; i <= c && n[i] != cur + 0; i++) ;
      out = ""
      for (j = c; j >= i + k; j--) out = out (out == "" ? "" : " ") n[j]
      print out
    }'
}

prune_generations() {
  local valid_keep=true
  if ! [[ "$keep" =~ ^[0-9]+$ ]] || [ "$keep" -lt 2 ]; then
    valid_keep=false
    echo "nix retention: keep_generations=\"$keep\" refused (needs a number of at least 2: the current system and the rollback target)"
    if [ "$mode" = enforce ]; then
      echo "nix retention: no generation deleted"
      return 0
    fi
  fi
  if ! listing="$(nix-env -p "$profile" --list-generations 2>&1)"; then
    echo "nix retention: generations skipped: cannot list $profile"
    return 0
  fi
  current="$(printf '%s\n' "$listing" | awk '/^[[:space:]]*[0-9]+[[:space:]].*\(current\)/ {print $1; exit}')"
  if [ -z "$current" ]; then
    echo "nix retention: generations skipped: no current generation in the listing"
    return 0
  fi
  local n deleted
  if [ "$mode" = enforce ]; then
    n="$keep"
  else
    n="$legacy_keep"
    if [ "$valid_keep" = true ]; then
      local extra
      extra="$(comm -13 <(tr ' ' '\n' <<<"$(deleted_by_plus "$legacy_keep")" | sort) <(tr ' ' '\n' <<<"$(deleted_by_plus "$keep")" | sort) | sed '/^$/d' | sort -n | tr '\n' ' ' | sed 's/ $//')"
      if [ -n "$extra" ]; then
        echo "nix retention: observe: would delete system generations: $extra (keep $keep, current $current)"
      fi
    fi
  fi
  deleted="$(deleted_by_plus "$n")"
  if [ -z "$deleted" ]; then
    echo "nix retention: no system generation to delete (nix-env +$n, current $current)"
    return 0
  fi
  echo "nix retention: deleting system generations (nix-env +$n): $deleted (current $current)"
  nix-env -p "$profile" --delete-generations "+$n" || echo "nix retention: nix-env --delete-generations +$n failed"
}

# ---- builder-release GC roots ---------------------------------------------

prune_builder_roots() {
  case "$builder_root" in
    /?*) ;;
    *) echo "nix retention: builder roots refused: builder root \"$builder_root\" is not an absolute path below /"; return 0 ;;
  esac
  case "$builder_root/" in
    *//*|*/./*|*/../*)
      echo "nix retention: builder roots refused: builder root \"$builder_root\" is not a plain absolute path"; return 0 ;;
  esac
  if [ ! -d "$auto_dir" ]; then
    echo "nix retention: builder roots skipped: no $auto_dir"
    return 0
  fi
  if ! [[ "$builder_keep" =~ ^[0-9]+$ ]] || ! [[ "$builder_min_age_days" =~ ^[0-9]+$ ]]; then
    echo "nix retention: builder roots refused: builder_keep and builder_min_age_days must be numbers"
    return 0
  fi
  local protected=() p entry link target class now candidates=""
  for p in $protect; do
    p="$(readlink -f -- "$p" 2>/dev/null)" && [ -n "$p" ] && protected+=("$p")
  done
  now="$(date +%s)"
  for entry in "$auto_dir"/*; do
    [ -L "$entry" ] || continue
    link="$(readlink -- "$entry")"
    if [ -L "$link" ]; then
      target="$(readlink -- "$link")"
    elif [ -e "$link" ]; then
      target="(not a link)"
    else
      target="(gone)"
    fi
    class=other
    case "$link" in
      */../*|*/./*|*/..|*/.) ;;
      "$builder_root"/*)
        if [ -L "$link" ]; then
          case "$target" in
            "$store_prefix"*)
              class=builder-release
              for p in "${protected[@]}"; do
                if [ "$(readlink -f -- "$link" 2>/dev/null)" = "$p" ]; then class=builder-release-protected; fi
              done
              ;;
          esac
        fi
        ;;
    esac
    echo "nix retention: root $link -> $target ($class)"
    if [ "$class" = builder-release ]; then
      local mtime
      if ! mtime="$(stat -c %Y -- "$link" 2>/dev/null)" || ! [[ "$mtime" =~ ^[0-9]+$ ]]; then
        echo "nix retention: cannot stat $link; kept"
        continue
      fi
      candidates+="$mtime"$'\t'"$link"$'\n'
    fi
  done
  [ -n "$candidates" ] || return 0
  local i=0 age
  while IFS=$'\t' read -r mtime link; do
    [ -n "$link" ] || continue
    i=$((i + 1))
    if [ "$i" -le "$builder_keep" ]; then
      continue
    fi
    age=$(( (now - mtime) / 86400 ))
    if [ "$age" -lt "$builder_min_age_days" ]; then
      continue
    fi
    if [ "$mode" = enforce ]; then
      if [ -L "$link" ] && rm -f -- "$link"; then
        echo "nix retention: unrooted $link (${age}d old)"
      else
        echo "nix retention: could not unroot $link"
      fi
    else
      echo "nix retention: observe: would unroot $link (${age}d old)"
    fi
  done < <(printf '%s' "$candidates" | sort -t $'\t' -k1,1nr)
}

prune_generations
prune_builder_roots
exit 0
