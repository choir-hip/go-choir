#!/usr/bin/env python3
"""The desk-names gate (modular architecture plan MA2.5, R3 "no special desks").

No privilege keys on a desk name: a desk is a row in the deskmanifest registry
and code asks the registry, not a literal. This gate counts, per non-test Go
file, the hard-coded desk names:

  ref:  agentprofile.X / deskmanifest.X for a built-in desk constant;
  lit:  a quoted exact desk name ("texture", "management_task", ...).

scripts/desk-names-allowlist.json holds the residue per file. The gate FAILS
when a file has more references than its allowlist entry (a new file has an
entry of zero), so a new hard-coded desk name is refused. A file below its
entry only warns; run `scripts/check-desk-names --tighten` to lower the
entries. The allowlist must reach zero over time (MA4.11 cuts it to Texture's
residue; Phase 5 to zero). The declaring packages (internal/deskmanifest,
internal/agentprofile) and the kernel are not counted: they are the registry.

Usage: scripts/check-desk-names [--root DIR] [--allowlist FILE] [--tighten]
"""
import argparse, json, os, re, sys

NAMES = "Texture|Management|Engineering|Research|Conductor|Email|ManagementTask|ResearchChild"
REF = re.compile(r"\b(?:agentprofile|deskmanifest)\.(?:%s)\b" % NAMES)
LIT = re.compile(r'"(?:texture|management|engineering|research|conductor|email|management_task|management-task|research_child)"')
SKIP_DIRS = ("internal/deskmanifest/", "internal/agentprofile/", "internal/kernel/")


def scan(root):
    counts = {}
    for top in ("internal", "cmd"):
        for dp, dns, fns in os.walk(os.path.join(root, top)):
            dns[:] = [d for d in dns if d != "testdata"]
            for fn in fns:
                if not fn.endswith(".go") or fn.endswith("_test.go"):
                    continue
                path = os.path.join(dp, fn)
                rel = os.path.relpath(path, root).replace(os.sep, "/")
                if rel.startswith(SKIP_DIRS):
                    continue
                with open(path, encoding="utf-8") as f:
                    text = f.read()
                n = len(REF.findall(text)) + len(LIT.findall(text))
                if n:
                    counts[rel] = n
    return counts


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root", default=None)
    ap.add_argument("--allowlist", default=None)
    ap.add_argument("--tighten", action="store_true")
    a = ap.parse_args()
    root = a.root or os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
    allow_path = a.allowlist or os.path.join(root, "scripts", "desk-names-allowlist.json")
    counts = scan(root)
    try:
        with open(allow_path) as f:
            allow = json.load(f)["files"]
    except FileNotFoundError:
        allow = {}
    if a.tighten:
        with open(allow_path, "w") as f:
            json.dump({"files": dict(sorted(counts.items()))}, f, indent=1, sort_keys=True)
            f.write("\n")
        print("check-desk-names: allowlist written: %d files, %d references" % (len(counts), sum(counts.values())))
        return 0
    bad = [(p, n, allow.get(p, 0)) for p, n in sorted(counts.items()) if n > allow.get(p, 0)]
    for p, n, cap in bad:
        print("FAIL %s: %d hard-coded desk names, allowlist %d (ask the deskmanifest registry instead)" % (p, n, cap), file=sys.stderr)
    slack = [(p, allow[p], counts.get(p, 0)) for p in sorted(allow) if counts.get(p, 0) < allow[p]]
    for p, cap, n in slack:
        print("warn %s: allowlist %d, now %d (run --tighten)" % (p, cap, n))
    if bad:
        return 1
    print("check-desk-names: ok (%d files, %d references, allowlist %d)" % (len(counts), sum(counts.values()), sum(allow.values())))
    return 0


sys.exit(main())
