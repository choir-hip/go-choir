#!/usr/bin/env python3
"""Proof: the server run sheet (slice D1).

Against a deployed computer it
  1. posts a batch of ops (three places, a remove of a ghost, a place of a
     repeated entry id),
  2. reads the sheet,
  3. opens the stream (after=<version before the batch>) and checks it begins
     with ": autoradio" and carries the batch as one sheet_ops event,
  4. replays the same batch and checks the answers are identical and the
     version did not move,
  5. posts one more op while the stream is open and checks the echo,
  6. prints every version and result.

The run's op ids and entry ids carry a fresh prefix, so the script can be run
again on the same computer. It never prints the key: it is read from
--api-key-file and goes only in the Authorization header. An owner-wide key
names no computer: pass --computer (sent as X-Choir-Computer).

Exit status: 0 when every check holds; 1 when one does not; 2 on bad arguments
or an unreadable key file.

  scripts/prove-autoradio-sheet --host choir.news --api-key-file ~/key --computer <id>

After a planned restart of the computer, run it again with --read-only to read
the sheet and compare it with the one printed before (--expect-version N).
Shapes: docs/reference/AUTORADIO-SHEET.md.
"""
import argparse
import http.client
import json
import sys
import threading
import time
import uuid


def read_key(path):
    try:
        with open(path) as f:
            key = "".join(f.read().split())
    except OSError as err:
        print(f"cannot read --api-key-file: {err.strerror}", file=sys.stderr)
        sys.exit(2)
    if not key:
        print("--api-key-file is empty", file=sys.stderr)
        sys.exit(2)
    return key


class Client:
    def __init__(self, args, key):
        self.args = args
        self.headers = {"Authorization": "Bearer " + key}
        if args.computer:
            self.headers["X-Choir-Computer"] = args.computer

    def conn(self, timeout=30):
        cls = http.client.HTTPConnection if self.args.insecure_http else http.client.HTTPSConnection
        return cls(self.args.host, timeout=timeout)

    def call(self, method, path, body=None):
        c = self.conn()
        h = dict(self.headers)
        data = None
        if body is not None:
            data = json.dumps(body).encode()
            h["Content-Type"] = "application/json"
        c.request(method, path, body=data, headers=h)
        r = c.getresponse()
        raw = r.read()
        c.close()
        try:
            return r.status, json.loads(raw)
        except ValueError:
            return r.status, raw[:200].decode("utf-8", "replace")


class Stream(threading.Thread):
    def __init__(self, client, after):
        super().__init__(daemon=True)
        self.client, self.after = client, after
        self.text = ""
        self.status = None
        self.lock = threading.Lock()
        self.conn = None

    def run(self):
        try:
            self.conn = self.client.conn(timeout=60)
            self.conn.request("GET", f"/api/autoradio/sheet/stream?after={self.after}", headers=self.client.headers)
            r = self.conn.getresponse()
            self.status = r.status
            while True:
                chunk = r.read1(4096)
                if not chunk:
                    return
                with self.lock:
                    self.text += chunk.decode("utf-8", "replace")
        except Exception:
            return

    def events(self):
        with self.lock:
            text = self.text
        out, name = [], None
        for line in text.split("\n"):
            if line.startswith("event: "):
                name = line[7:]
            elif line.startswith("data: ") and name:
                try:
                    out.append((name, json.loads(line[6:])))
                except ValueError:
                    pass
        return out

    def wait_for(self, name, secs=10):
        end = time.time() + secs
        while time.time() < end:
            for ev in self.events():
                if ev[0] == name:
                    return ev
            time.sleep(0.1)
        return None

    def close(self):
        try:
            self.conn.close()
        except Exception:
            pass


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--host", required=True)
    ap.add_argument("--api-key-file", required=True)
    ap.add_argument("--computer", default="")
    ap.add_argument("--insecure-http", action="store_true")
    ap.add_argument("--read-only", action="store_true", help="only read the sheet (after a restart)")
    ap.add_argument("--expect-version", type=int, default=None, help="with --read-only: the version to find")
    args = ap.parse_args()
    cl = Client(args, read_key(args.api_key_file))
    failures = []

    def check(ok, what):
        print(("ok    " if ok else "FAIL  ") + what)
        if not ok:
            failures.append(what)

    st, sheet0 = cl.call("GET", "/api/autoradio/sheet")
    check(st == 200 and isinstance(sheet0, dict) and "version" in sheet0, f"GET sheet -> {st}")
    if st != 200:
        return 1
    print(f"sheet: version {sheet0['version']}, {len(sheet0.get('entries', []))} entries, on_air {sheet0.get('on_air', '')!r}")
    if args.read_only:
        if args.expect_version is not None:
            check(sheet0["version"] == args.expect_version, f"version {sheet0['version']} == expected {args.expect_version}")
        return 1 if failures else 0

    run = uuid.uuid4().hex[:8]

    def entry(n):
        return {"id": f"p-{run}-e{n}", "kind": "story", "placed_by": "phone", "state": "ahead",
                "title": f"Proof story {n}", "text": f"Proof words {n}.", "est_seconds": 5}

    def place(n, entry_n=None):
        return {"op_id": f"p-{run}-o{n}", "by": "phone", "op": "place", "at": "end",
                "entry": entry(n if entry_n is None else entry_n), "base_version": 0}

    batch = [place(1), place(2), place(3),
             {"op_id": f"p-{run}-o4", "by": "phone", "op": "remove", "id": "ghost", "base_version": 0},
             place(5, entry_n=1)]
    v0 = sheet0["version"]
    stream = Stream(cl, v0)
    stream.start()
    first = stream.wait_for("sheet_ops", 1)  # nothing yet: after == version sends no event
    check(first is None, "stream with after=<current> sends no event before a change")

    st, ans1 = cl.call("POST", "/api/autoradio/sheet/ops", {"ops": batch})
    check(st == 200, f"POST batch -> {st}")
    if st != 200:
        print(ans1)
        return 1
    for r in ans1["results"]:
        print(f"  {r['op_id']}: applied={r['applied']} dropped={r.get('dropped', '')} version={r['version']}")
    res = ans1["results"]
    check([r["applied"] for r in res] == [True, True, True, False, False], "three placed, ghost remove and repeated entry id dropped")
    check(res[3].get("dropped") == "not_ahead" and res[4].get("dropped") == "duplicate_id", "dropped reasons are the reducer's own")
    check(ans1["version"] == v0 + 3, f"version {v0} -> {ans1['version']} (three applied)")

    st, sheet1 = cl.call("GET", "/api/autoradio/sheet")
    ids = [e["id"] for e in sheet1.get("entries", [])]
    check(sheet1["version"] == v0 + 3 and ids[-3:] == [f"p-{run}-e{n}" for n in (1, 2, 3)], "sheet holds the three entries in order")

    ev = stream.wait_for("sheet_ops", 10)
    check(stream.text.startswith(": autoradio"), "stream begins with ': autoradio'")
    check(ev is not None and ev[1]["from_version"] == v0 and ev[1]["to_version"] == v0 + 3 and len(ev[1]["ops"]) == 3,
          "stream echoes the batch as one sheet_ops event")

    st, ans2 = cl.call("POST", "/api/autoradio/sheet/ops", {"ops": batch})
    check(st == 200 and ans2 == ans1, "replay of the batch answers identically")
    st, sheet2 = cl.call("GET", "/api/autoradio/sheet")
    check(sheet2["version"] == sheet1["version"], f"replay did not move the version ({sheet2['version']})")

    one = {"op_id": f"p-{run}-o6", "by": "phone", "op": "remove", "id": f"p-{run}-e3", "base_version": 0}
    st, ans3 = cl.call("POST", "/api/autoradio/sheet/ops", {"ops": [one]})
    check(st == 200 and ans3["results"][0]["applied"] and ans3["results"][0]["version"] == v0 + 4, "a later op takes the next version")
    end = time.time() + 10
    echoed = False
    while time.time() < end and not echoed:
        echoed = any(n == "sheet_ops" and d["to_version"] == v0 + 4 and d["ops"][0]["op_id"] == one["op_id"] for n, d in stream.events())
        time.sleep(0.1)
    check(echoed, "stream echoes the later op with the server's version")
    stream.close()

    print(f"final version {sheet2['version'] + 1}; to check a restart run again with --read-only --expect-version {sheet2['version'] + 1}")
    return 1 if failures else 0


if __name__ == "__main__":
    sys.exit(main())
