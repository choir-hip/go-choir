#!/bin/bash
# spend-report: spend from the gateway journal on node-b, corrected for prompt caching.
#
# What the gateway log says (internal/gateway/handlers.go inferenceSuccessLine):
#   tokens=IN+OUT cached=C   IN = whole prompt = uncached + cache READ + cache WRITE
#                            C  = cache READ tokens only (a subset of IN)
#   cache_write=W            cache WRITE tokens, 5m + 1h (subset of IN-C)       [newer lines only]
#   cache_write_1h=W1        the 1-hour part of W (5m part = W-W1)              [newer lines only]
#   model=M                  the served model                                   [newer lines only]
# MEASURED (newer lines): IN, OUT, C, W, W1, model, provider, VM, all from the journal.
# FALLBACK (older lines without cache_write=): IN-C is uncached + cache write and cannot be split;
#   - model: taken from the "inference request" lines of the same window (the price table assumes one paid
#            model per provider; the models seen are listed).
#   - Bedrock split of IN-C: measured from CloudWatch (AWS/Bedrock CacheWriteInputTokenCount vs InputTokenCount)
#            for the same window when `aws` works; otherwise ASSUMED all cache write (upper bound).
#   - write TTL ASSUMED 5-minute for old lines (mixed 5m/1h lifetimes landed later; newer lines carry the split).
# ASSUMED always: the price table below (list prices; edit when they change); prompts over 100,000 tokens
#   use Haiku 5.5's higher long-context tier (priced per call).
# Bedrock CloudWatch totals are printed as the authoritative account-wide figure for that model.
# Reads only the gateway journal over ssh (read-only journalctl), plus optional read-only `aws cloudwatch`.
# Env: BEDROCK_MULT (default 1.0; 1.10 if the us. geo profile carries the 10% regional premium).
#      NODE (default node-b), REGION (default us-east-1).
NODE=${NODE:-node-b}; REGION=${REGION:-us-east-1}; MULT=${BEDROCK_MULT:-1.0}
MODEL_ID=us.anthropic.claude-haiku-5-5
NOW=$(python3 -c 'import datetime as d;print(d.datetime.now(d.timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ"))')
TODAY0=$(python3 -c 'import datetime as d;print(d.datetime.now(d.timezone.utc).strftime("%Y-%m-%dT00:00:00Z"))')
HOUR0=$(python3 -c 'import datetime as d;print((d.datetime.now(d.timezone.utc)-d.timedelta(minutes=60)).strftime("%Y-%m-%dT%H:%M:%SZ"))')
echo "now=$NOW  bedrock regional multiplier=$MULT"

cw() { # metric start end -> sum, or empty on failure
  aws cloudwatch get-metric-statistics --region "$REGION" --namespace AWS/Bedrock --metric-name "$1" \
    --dimensions Name=ModelId,Value=$MODEL_ID --start-time "$2" --end-time "$3" --period 300 --statistics Sum \
    --query 'sum(Datapoints[].Sum)' --output text 2>/dev/null
}

for w in "today UTC|$TODAY0" "last 60 min|$HOUR0"; do
  label=${w%%|*}; start=${w##*|}
  echo; echo "================ $label  ($start .. $NOW)"
  since=$(echo "$start" | sed -E 's/T/ /; s/Z//'); until_=$(echo "$NOW" | sed -E 's/T/ /; s/Z//')
  # CloudWatch (account-wide, this model) for the Bedrock split
  cwU=$(cw InputTokenCount "$start" "$NOW"); cwR=$(cw CacheReadInputTokenCount "$start" "$NOW")
  cwW=$(cw CacheWriteInputTokenCount "$start" "$NOW"); cwO=$(cw OutputTokenCount "$start" "$NOW"); cwN=$(cw Invocations "$start" "$NOW")
  if [ -n "$cwU" ] && [ -n "$cwW" ]; then
    WF=$(python3 -c "u=float('$cwU');w=float('$cwW');print(w/(u+w) if u+w>0 else 1.0)"); WSRC="MEASURED (CloudWatch)"
  else WF=1.0; WSRC="ASSUMED all cache write (CloudWatch unavailable)"; fi

  ssh -o BatchMode=yes $NODE "journalctl -u go-choir-gateway --since '$since' --until '$until_' --no-pager -o cat --utc 2>/dev/null > /tmp/.spend2.$$; \
    echo '##LINES'; grep 'inference succeeded for autoputer' /tmp/.spend2.$$ | sed -E 's/.*autoputer ([^ ]+) \(provider=([a-z-]+) tokens=([0-9]+)\+([0-9]+) cached=([0-9]+)(.*)/\2 \1 \3 \4 \5\6/' | sed -E 's/ text_len=[0-9]+//; s/ cache_write=([0-9]+)/ W=\1/; s/ cache_write_1h=([0-9]+)/ W1=\1/; s/ model=([^ )]+)/ M=\1/; s/\)$//'; \
    echo '##MODELS'; grep 'inference request from autoputer' /tmp/.spend2.$$ | grep -o 'provider=[a-z-]* model=[^ ]*' | sort | uniq -c; rm -f /tmp/.spend2.$$" 2>/dev/null > /tmp/.spend2.local.$$

  echo "-- models seen in request lines (fallback for success lines without model=):"
  sed -n '/##MODELS/,$p' /tmp/.spend2.local.$$ | grep -v '##' | sed 's/^/     /'
  echo "-- priced with: bedrock claude-haiku-5-5 \$0.10 in / \$0.125 5m-write / \$0.01 read / \$0.50 out (>100K-token prompt: 0.50/0.625/0.05/2.50) x$MULT;"
  echo "   synthetic deepseek-v4.1-flash-1017 0.60/0.03(read)/1.20; chatgpt gpt-6-luna 0.10/0.01/0.50 (list; route is a flat subscription);"
  echo "   opencode-go and openrouter models seen are free previews = \$0 (llmcost/pricing.go)."
  echo "-- Bedrock components: in/out/cache-read MEASURED (log); uncached-vs-write split of IN-C: $WSRC, write fraction=$(printf %.4f $WF); write TTL: measured on lines with cache_write_1h=, else 5m ASSUMED."

  sed -n '/##LINES/,/##MODELS/p' /tmp/.spend2.local.$$ | grep -v '##' | awk -v WF="$WF" -v M="$MULT" '
   BEGIN{
     # name: in write read out ; long-context tier for bedrock
     bi=0.10;bw=0.125;br=0.01;bo=0.50; Li=0.50;Lw=0.625;Lr=0.05;Lo=2.50
     si=0.60;sr=0.03;so=1.20
     gi=0.10;gr=0.01;go=0.50
   }
   {p=$1;v=$2;I=$3;O=$4;C=$5; X=I-C; cost=0; n[p]++; ti[p]+=I; to[p]+=O; tc[p]+=C
    hasW=0; W=0; W1=0; MD="-"
    for(i=6;i<=NF;i++){ if($i~/^W=/){W=substr($i,3)+0; hasW=1} else if($i~/^W1=/){W1=substr($i,4)+0} else if($i~/^M=/){MD=substr($i,3)} }
    if(hasW) nm[p]++
    if(MD!="-") pm[p" "MD]++
    if(p=="bedrock"){
      long=(I>100000); a=long?Li:bi; w=long?Lw:bw; r=long?Lr:br; o=long?Lo:bo
      if(hasW){ h=long?1.00:0.20; cw=(W-W1)*w+W1*h; cu=(I-C-W)*a }
      else { cw=X*WF*w; cu=X*(1-WF)*a }
      cr=C*r; co=O*o
      cost=(cr+cw+cu+co)*M/1e6; Bc[p]+=cr*M/1e6; Bw[p]+=cw*M/1e6; Bu[p]+=cu*M/1e6; Bo[p]+=co*M/1e6
      if(long) nl++
    } else if(p=="synthetic"){ cost=(X*si+C*sr+O*so)/1e6 }
    else if(p=="chatgpt"){ cost=(X*gi+C*gr+O*go)/1e6 }
    d[p]+=cost; dv[p" "v]+=cost; nv[p" "v]++; ivi[p" "v]+=I; ivc[p" "v]+=C; ivo[p" "v]+=O}
   END{
     for(p in n) printf "%-10s calls=%-6d in=%.2fM (cached %.2fM, %.0f%%) out=%.2fM  $%.2f\n", p,n[p],ti[p]/1e6,tc[p]/1e6,(ti[p]>0?100*tc[p]/ti[p]:0),to[p]/1e6,d[p]
     if(n["bedrock"]) printf "   bedrock split: cache-read $%.2f  cache-write $%.2f  uncached $%.2f  output $%.2f   (long-context calls: %d)\n", Bc["bedrock"],Bw["bedrock"],Bu["bedrock"],Bo["bedrock"],nl
     for(p in n) printf "-- %s: %d of %d calls carry measured cache_write (rest use the fallback estimate)\n", p, nm[p], n[p]
     for(k in pm) printf "-- served model (measured): %-40s calls=%d\n", k, pm[k]
     print "-- per VM (cost > $0.005):"
     for(k in dv) if(dv[k]>0.005) printf "   %-62s calls=%-5d in=%.2fM cached=%.0f%% out=%.2fM $%.2f\n", k,nv[k],ivi[k]/1e6,(ivi[k]>0?100*ivc[k]/ivi[k]:0),ivo[k]/1e6,dv[k]}'
  if [ -n "$cwU" ]; then
    python3 - "$cwU" "$cwR" "$cwW" "$cwO" "$cwN" "$MULT" <<'PY'
import sys
u,r,w,o,n,m=map(float,sys.argv[1:7])
c=(u*0.10+w*0.125+r*0.01+o*0.50)*m/1e6
print(f"-- CloudWatch AWS/Bedrock {('us.anthropic.claude-haiku-5-5')} (account-wide, this model, MEASURED by AWS): invocations={n:.0f} uncached_in={u/1e6:.3f}M cache_read={r/1e6:.2f}M cache_write={w/1e6:.2f}M out={o/1e6:.2f}M  => ${c:.2f}  (flat-rate old formula on the same tokens: ${((u+w+r)*0.10+o*0.50)/1e6:.2f})")
PY
  else echo "-- CloudWatch unavailable (aws CLI/credentials/permission); Bedrock figures above are log-derived only."; fi
  rm -f /tmp/.spend2.local.$$
done
echo; echo "NOT measured on older log lines: cache-write count (folded into IN), cache TTL, model per call. Never measured: service tier."
