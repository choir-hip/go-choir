#!/usr/bin/env bash
# Materialize a guest image as a release directory
# (docs/design/density-d2-snapshots-survive-deploys-2026-10-26.md 4.1, slice S2).
#
#   node-b-guest-release-materialize SRC RELEASES_DIR
#
# SRC is the guest image's Nix store path; its release id is the first 32
# characters of the basename (the Nix store hash). The files are reflink copies
# in RELEASES_DIR/<id>/, root-owned and read-only, so the bytes outlive the
# store path's garbage collection. Called from the go-choir-guest-release
# activation snippet in nix/node-b.nix, before the guest link moves.
#
# It never fails the NixOS switch: every step is checked, any failure removes
# the temporary tree, logs the reason, and the script exits 0 (a release that
# is not materialized only means its snapshots cold boot). It never falls back
# to a full copy: --reflink=always, because a silent copy is GBs per deploy.
# GO_CHOIR_RELEASE_REFLINK=auto exists for the tests on filesystems without
# reflinks.
#
# Layered images (docs/design/layered-guest-image-2026-10-31.md): a source
# with storedisk-app.erofs and no storedisk.erofs is layered. Its base layer
# (storedisk-base.erofs, named by the source's layers.json) is copied once into
# GO_CHOIR_GUEST_BASES_DIR/<base_id>/ (default: guest-bases beside RELEASES_DIR;
# reflink, 0444, never rewritten, an existing base is kept), the app layer goes
# into the release as storedisk-app.erofs, and the release gets a normalized
# layers.json. The release has no file named storedisk.erofs on purpose: an
# older vmctl then refuses it (release_missing) instead of launching it with
# one drive. A single-image source is materialized exactly as before.
# After the install it starts node-b-guest-release-dedupe detached
# (GO_CHOIR_GUEST_RELEASE_DEDUPE names it) to share blocks with the previous
# release; cp --reflink from the previous release first would not help, since
# the new bytes come from the store path and would be overwritten anyway.
(
	set +e +u +o pipefail
	src="$1"
	rel="$2"
	mode="${GO_CHOIR_RELEASE_REFLINK:-always}"
	id=$(basename "$src" | cut -c1-32)
	note() { echo "go-choir guest release $id not materialized ($1); snapshots of it will cold boot" >&2; }
	if ! printf '%s' "$id" | grep -Eq '^[0-9a-df-np-sv-z]{32}$'; then
		note "not a store path"
		exit 0
	fi
	[ -d "$rel/$id" ] && exit 0
	tmp="$rel/.tmp-$id"
	[ -e "$tmp" ] && { chmod -R u+w "$tmp" 2>/dev/null; rm -rf "$tmp"; }
	mkdir -p "$tmp" || { note "mkdir"; rm -rf "$tmp"; exit 0; }
	disk=storedisk.erofs
	if [ ! -e "$src/storedisk.erofs" ] && [ -e "$src/storedisk-app.erofs" ]; then
		# Layered image: see the header. The base is installed first; a release
		# that then fails leaves a young unreferenced base, which retention
		# sweeps once it is old enough.
		disk=storedisk-app.erofs
		base_store=$(sed -n 's/.*"base" *: *"\([^"]*\)".*/\1/p' "$src/layers.json" 2>/dev/null | head -1)
		base_id=$(basename "$base_store" | cut -c1-32)
		if ! printf '%s' "$base_id" | grep -Eq '^[0-9a-df-np-sv-z]{32}$'; then
			note "layers.json names no base"
			rm -rf "$tmp"
			exit 0
		fi
		bases="${GO_CHOIR_GUEST_BASES_DIR:-$(dirname "$rel")/guest-bases}"
		if [ ! -d "$bases/$base_id" ]; then
			btmp="$bases/.tmp-$base_id"
			[ -e "$btmp" ] && { chmod -R u+w "$btmp" 2>/dev/null; rm -rf "$btmp"; }
			mkdir -p "$btmp" \
				&& cp --reflink="$mode" "$src/storedisk-base.erofs" "$btmp/storedisk-base.erofs" \
				&& chmod 0444 "$btmp/storedisk-base.erofs" \
				&& chmod 0555 "$btmp" \
				&& { sync -f "$btmp/storedisk-base.erofs" 2>/dev/null || sync; } \
				&& mv -T "$btmp" "$bases/$base_id" \
				|| { note "base $base_id"; chmod -R u+w "$btmp" 2>/dev/null; rm -rf "$btmp" "$tmp"; exit 0; }
		fi
		printf '{"schema":1,"layout":"layered","base_id":"%s","base_store_path":"%s"}\n' "$base_id" "$base_store" >"$tmp/layers.json" \
			|| { note "layers.json"; rm -rf "$tmp"; exit 0; }
	fi
	for f in vmlinux initrd rootfs.ext4 "$disk" kernel-params build.json guest-image-manifest release.json; do
		cp --reflink="$mode" "$src/$f" "$tmp/$f" || { note "reflink $f"; rm -rf "$tmp"; exit 0; }
	done
	printf '{"store_path":"%s","first_current_at":"%s"}\n' "$src" "$(date -u +%FT%TZ)" >"$tmp/installed.json" \
		&& chmod 0444 "$tmp"/* \
		&& chmod 0555 "$tmp" \
		&& { sync -f "$tmp/installed.json" 2>/dev/null || sync; } \
		&& mv -T "$tmp" "$rel/$id" \
		|| { note "finish"; chmod -R u+w "$tmp" 2>/dev/null; rm -rf "$tmp"; exit 0; }
	# Share the new release's blocks with the previous release's (storage
	# growth per deploy is then the changed blocks, not 3.7 GB). Detached, idle
	# IO, capped memory; a failure to start it is logged and ignored, and the
	# retention timer runs it again within 30 minutes.
	dedupe="${GO_CHOIR_GUEST_RELEASE_DEDUPE:-}"
	if [ -n "$dedupe" ] && [ -x "$dedupe" ]; then
		sr=$(command -v systemd-run || echo /run/current-system/sw/bin/systemd-run)
		if [ "${GO_CHOIR_DEDUPE_SPAWN:-systemd}" = direct ]; then
			"$dedupe" "$rel" "$id" || true
		elif [ -x "$sr" ]; then
			"$sr" --no-block --collect --quiet --unit="go-choir-guest-release-dedupe-$id" \
				-p Nice=19 -p IOSchedulingClass=idle -p CPUWeight=1 -p MemoryMax=384M \
				"$dedupe" "$rel" "$id" || echo "go-choir guest release $id dedupe not started; the retention timer will run it" >&2
		fi
	fi
	exit 0
) || true
exit 0
