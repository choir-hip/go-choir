#!/usr/bin/env bash
# choir-mac-pull: copy a computer's tape off the host onto this Mac (S5a of
# docs/design/one-tape-durability-2026-10-31.md; owner, 2026-10-31: long-term
# history lives on the user's synced machine, on by default).
#
#   scripts/choir-mac-pull <computer-id> [<computer-id> ...]
#
# The first pull of a computer is a full bundle (its newest snapshot plus the
# tape after it); every later pull is a delta of the events since the newest
# bundle this Mac holds. The Mac is the only record of what was pulled: each
# run uploads its newest verified manifest to the host as the --since base, so
# the host keeps nothing between runs and a pull that fails part way never
# advances the chain. A bundle is verified on the host, copied, verified again
# here with a choir-bundle built from this checkout, and only then renamed
# into place. Bundles stay sealed: nothing here can read their contents.
#
# Environment: CHOIR_PULL_HOST (default node-b), CHOIR_PULL_DEST (default
# ~/ChoirBackups). The host side runs under sudo at idle IO priority; the
# platform database password is read into a temporary pgpass file there and
# never put on a command line.
set -euo pipefail

HOST=${CHOIR_PULL_HOST:-node-b}
DEST=${CHOIR_PULL_DEST:-$HOME/ChoirBackups}
REPO=$(cd "$(dirname "$0")/.." && pwd)
[ $# -ge 1 ] || { echo "usage: $0 <computer-id> [...]" >&2; exit 2; }

VERIFY=$(mktemp -d)/choir-bundle
trap 'rm -rf "$(dirname "$VERIFY")"' EXIT
(cd "$REPO" && go build -o "$VERIFY" ./cmd/choir-bundle)

pull() {
	local computer=$1
	case $computer in computer-[0-9a-f]*) ;; *) echo "not a computer id: $computer" >&2; return 2 ;; esac
	local dir=$DEST/$computer stamp prev="" kind=full
	mkdir -p "$dir"
	stamp=$(date -u +%Y%m%dT%H%M%SZ)
	# The newest verified bundle here is the delta's base.
	prev=$(ls -1d "$dir"/*-full-* "$dir"/*-delta-* 2>/dev/null | grep -v '\.partial$' | sort | tail -1 || true)
	local remote=/var/lib/go-choir-measure/pull-$computer-$stamp
	ssh "$HOST" "sudo mkdir -p $remote/since && sudo chmod 700 $remote"
	if [ -n "$prev" ]; then
		kind=delta
		ssh "$HOST" "sudo tee $remote/since/manifest.json >/dev/null" < "$prev/manifest.json"
	fi
	echo "== $computer: $kind export on $HOST"
	ssh "$HOST" "sudo bash -s -- $computer $remote $kind" <<'REMOTE'
set -euo pipefail
computer=$1 remote=$2 kind=$3
umask 077
pass=$(mktemp)
trap 'rm -f "$pass"' EXIT
printf '127.0.0.1:5432:control:choir:%s\n' "$(cat /var/lib/go-choir/secrets/pg-app-password)" > "$pass"
bin=/var/lib/go-choir/services/corpusd/bin/choir-bundle
since=()
[ "$kind" = delta ] && since=(--since "$remote/since")
PGPASSFILE=$pass ionice -c3 nice -n19 "$bin" export --computer "$computer" --out "$remote/bundle" \
	--dsn 'postgres://choir@127.0.0.1:5432/control?sslmode=disable' "${since[@]}"
ionice -c3 nice -n19 "$bin" verify "$remote/bundle"
REMOTE
	local head
	head=$(ssh "$HOST" "sudo cat $remote/bundle/manifest.json" | python3 -c 'import sys,json; print(json.load(sys.stdin)["tape"]["head_seq"])')
	if [ -n "$prev" ] && [ "$head" = "${prev##*-}" ]; then
		ssh "$HOST" "sudo rm -rf $remote"
		echo "== $computer: nothing new since head $head"
		return 0
	fi
	local final=$dir/$stamp-$kind-$head
	echo "== copying to $final"
	rsync -a --partial --rsync-path="sudo rsync" "$HOST:$remote/bundle/" "$final.partial/"
	"$VERIFY" verify "$final.partial"
	mv "$final.partial" "$final"
	ssh "$HOST" "sudo rm -rf $remote"
	echo "== $computer: $kind to head $head verified here ($(du -sh "$final" | cut -f1))"
}

for c in "$@"; do pull "$c"; done
