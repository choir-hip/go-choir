#!/usr/bin/env bash
# Sharded non-runtime Go test runner for CI.
#
# Runs every non-runtime package (all but internal/agentcore and
# internal/textureowner, which scripts/go-test-runtime-shards runs) on
# TOTAL_SHARDS runners, each test exactly once. When TOTAL_SHARDS >= 4:
#
# - Every shard runs a weighted share of the split packages listed in
#   scripts/go-test-split-packages (internal/store and the other packages
#   whose serial test binary would otherwise set a shard's length), sharded
#   by test name. A test name goes to one shard for every split package that
#   has it, so one `go test -run` over all split packages runs each
#   (package, test) pair on exactly one shard, and the package binaries run
#   in parallel on the runner's CPUs. The deal is heaviest first by the
#   weights in scripts/go-test-split-weights (see plan_split).
# - The last two shards also run every other package whole, dealt by list
#   index, before their split share; the weights file says how much time that
#   costs them, so they take a smaller share of the split tests.
#
# Below 4 shards every package runs whole, dealt by list index. Without
# SHARD_INDEX one process runs every package whole.
#
# A failed `go list` or test discovery, a split list entry that go list
# does not report as a non-runtime package, a bad weights line, or a shard
# whose selection is empty (TOTAL_SHARDS larger than the packages or test
# names it deals) fails the shard: a shard never passes having tested less
# than its share (docs/problems/ci-critical-path-race-shards-2026-10-22.md,
# docs/problems/ci-wall-clock-2026-10-24.md).
#
# Usage in CI:
#   env:
#     TOTAL_SHARDS: 8
#     SHARD_INDEX: ${{ matrix.shard }}
#   run: scripts/go-test-non-runtime-shards
#
# Any extra args (e.g. -race) are forwarded to go test, discovery included.
set -euo pipefail

total_shards="${TOTAL_SHARDS:-6}"
if ! [[ "$total_shards" =~ ^[1-9][0-9]*$ ]]; then
  echo "TOTAL_SHARDS must be a positive integer, got: $total_shards" >&2
  exit 2
fi

module="github.com/yusefmosiah/go-choir"
split_list="$(dirname "$0")/go-test-split-packages"
weights_list="$(dirname "$0")/go-test-split-weights"
[[ -f "$weights_list" ]] || weights_list=""
whole_shards=2

# Capture first: process substitution hides a failed go list, which would
# leave every shard with nothing to test and a passing exit.
if ! package_listing=$(go list ./...); then
  echo "go list ./... failed; refusing to run a partial package set" >&2
  exit 1
fi
mapfile -t all_packages < <(grep -Ev "^${module}/internal/(agentcore|textureowner)$" <<<"$package_listing" | grep -v '^$' || true)
if (( ${#all_packages[@]} == 0 )); then
  echo "go list ./... reported no non-runtime packages" >&2
  exit 1
fi

declare -A is_package=()
for package in "${all_packages[@]}"; do
  is_package["$package"]=1
done

split_packages=()
declare -A is_split=()
if [[ -f "$split_list" ]]; then
  while IFS= read -r line || [[ -n "$line" ]]; do
    line="${line%%#*}"
    line="${line//[[:space:]]/}"
    [[ -z "$line" ]] && continue
    package="${module}/${line#./}"
    if [[ -z "${is_package[$package]:-}" ]]; then
      echo "${split_list#./}: ${line#./} is not a non-runtime package go list reports; fix the list" >&2
      exit 2
    fi
    if [[ -z "${is_split[$package]:-}" ]]; then
      is_split["$package"]=1
      split_packages+=("$package")
    fi
  done <"$split_list"
fi

whole_packages=()
for package in "${all_packages[@]}"; do
  if [[ -z "${is_split[$package]:-}" ]]; then
    whole_packages+=("$package")
  fi
done

split_mode=0
if (( total_shards >= 4 && ${#split_packages[@]} > 0 )); then
  split_mode=1
fi

timeout_args=(-timeout=60m)

# Deal the split tests over all shards. Prints "K <distinct names>" and then the
# names for shard $1. A package's tests run serially and the packages run side
# by side, so a shard takes about as long as its heaviest package; each test
# name (one shard for every split package that has it) goes, heaviest first,
# to the shard where that estimate ends lowest, ties to the lighter total and
# then the lower index. Weights come from scripts/go-test-split-weights
# ("<seconds> <package>:<Test>", unlisted weighs 1; "@whole <seconds>" is the
# load the two whole-package shards start with). Every shard plans the same
# deal from the same discovery and weights.
plan_split() {
  awk -v shards="$2" -v me="$1" -v wholes="$3" -v wfile="$weights_list" -v module="$module" '
    function fail(msg) { printf "%s: %s\n", wfile, msg > "/dev/stderr"; bad = 1; exit 2 }
    BEGIN {
      whole_base = 0
      if (wfile != "") {
        while ((r = (getline line < wfile)) > 0) {
          sub(/#.*/, "", line)
          if (line ~ /^[ \t]*$/) continue
          if (line ~ /^[ \t]*@whole[ \t]+[0-9]+[ \t]*$/) { split(line, f); whole_base = f[2] + 0; continue }
          if (split(line, f) != 2 || f[1] !~ /^[0-9]+$/ || f[2] !~ /^[A-Za-z0-9_.\/-]+:[A-Za-z0-9_]+$/)
            fail("bad line \"" line "\" (want: <seconds> <package>:<TestName>, or @whole <seconds>)")
          weight[f[2]] += f[1]
        }
        if (r < 0) fail("cannot read")
      }
    }
    /^(Test|Example|Fuzz)/ { pend[++np] = $1; next }
    $1 == "ok" || $1 == "FAIL" || $1 == "?" {
      pkg = $2
      if (index(pkg, module "/") == 1) pkg = substr(pkg, length(module) + 2)
      for (i = 1; i <= np; i++) {
        n = pend[i]
        if (!(n in first)) { first[n] = ++nn; order[nn] = n }
        j = ++cnt[n]; ipkg[n, j] = pkg
        w = ((pkg ":" n) in weight) ? weight[pkg ":" n] : 1
        iw[n, j] = w; tw[n] += w
      }
      np = 0
    }
    END {
      if (bad) exit 2
      print "K " nn
      for (i = 1; i <= nn; i++) idx[i] = order[i]
      for (i = 2; i <= nn; i++) {
        v = idx[i]; j = i - 1
        while (j >= 1 && tw[idx[j]] < tw[v]) { idx[j + 1] = idx[j]; j-- }
        idx[j + 1] = v
      }
      for (s = 0; s < shards; s++) { base[s] = (s >= shards - wholes) ? whole_base : 0; mx[s] = 0; tot[s] = 0 }
      for (i = 1; i <= nn; i++) {
        n = idx[i]; best = -1
        for (s = 0; s < shards; s++) {
          m = mx[s]
          for (j = 1; j <= cnt[n]; j++) { l = load[s, ipkg[n, j]] + iw[n, j]; if (l > m) m = l }
          after = base[s] + m
          if (best < 0 || after < best_after || (after == best_after && tot[s] < tot[best])) { best = s; best_after = after }
        }
        for (j = 1; j <= cnt[n]; j++) { load[best, ipkg[n, j]] += iw[n, j]; if (load[best, ipkg[n, j]] > mx[best]) mx[best] = load[best, ipkg[n, j]] }
        tot[best] += tw[n]
        if (best == me) print n
      }
    }'
}

# Lists the split tests once (discovery, a go test -list) into $split_listing;
# fails on a discovery failure or an empty discovery.
discover_split() {
  # Match execution's build mode (especially -race) so discovery warms the
  # right cache. Fuzz targets are listed too: -run executes their seeds.
  if ! split_listing=$(go test "${split_packages[@]}" "$@" -list '^(Test|Example|Fuzz)'); then
    echo "Test discovery failed for split packages: ${split_packages[*]#"${module}/"}" >&2
    return 1
  fi
  if ! grep -qE '^(Test|Example|Fuzz)' <<<"$split_listing"; then
    echo "Test discovery found no tests in split packages: ${split_packages[*]#"${module}/"}" >&2
    return 1
  fi
}

# Runs one virtual shard's split tests ($1 label, $2 plan from plan_split).
run_split_plan() {
  local label="$1"
  local plan="$2"
  shift 2
  local -a selected=()
  mapfile -t selected < <(tail -n +2 <<<"$plan")
  local k="${plan%%$'\n'*}"
  k="${k#K }"
  local regex
  regex="$(IFS='|'; echo "^(${selected[*]})$")"
  echo "Running ${#selected[@]} of ${k} test names of ${#split_packages[@]} split packages (${split_packages[*]#"${module}/"}) in ${label}"
  "$(dirname "$0")/go-test-with-timing" -count=1 "${timeout_args[@]}" "${split_packages[@]}" -run "$regex" "$@"
}

if [[ -z "${SHARD_INDEX:-}" ]]; then
  echo "SHARD_INDEX not set; running all ${#all_packages[@]} non-runtime packages in one process"
  "$(dirname "$0")/go-test-with-timing" -count=1 "${all_packages[@]}" "$@"
  exit $?
fi

if ! [[ "$SHARD_INDEX" =~ ^[0-9]+$ ]] || (( SHARD_INDEX >= total_shards )); then
  echo "SHARD_INDEX must be an integer in [0, $((total_shards - 1))], got: ${SHARD_INDEX:-}" >&2
  exit 2
fi
shard_index="$SHARD_INDEX"

if (( split_mode )); then
  # Every shard takes a weighted share of the split tests; the last
  # whole_shards shards also run their share of the other packages whole.
  # SPLIT_PROCS=P (default 2; 1 restores a single process) runs the share as
  # P concurrent go test processes: the deal
  # is made over total_shards*P virtual shards and this shard takes P of them.
  procs="${SPLIT_PROCS:-2}"
  if ! [[ "$procs" =~ ^[1-8]$ ]]; then
    echo "SPLIT_PROCS must be an integer in [1, 8], got: $procs" >&2
    exit 2
  fi
  split_listing=""
  discover_split "$@" || exit 1
  declare -a plans=()
  for (( j = 0; j < procs; j++ )); do
    plan=$(plan_split $(( shard_index * procs + j )) $(( total_shards * procs )) $(( whole_shards * procs )) <<<"$split_listing") || {
      echo "Weighted deal of split tests failed (${weights_list#./})" >&2
      exit 1
    }
    if [[ -n "$(tail -n +2 <<<"$plan")" ]]; then
      plans+=("$plan")
    fi
  done
  whole_selected=()
  if (( shard_index >= total_shards - whole_shards )); then
    deal_index=$(( shard_index - (total_shards - whole_shards) ))
    for i in "${!whole_packages[@]}"; do
      if (( i % whole_shards == deal_index )); then
        whole_selected+=("${whole_packages[$i]}")
      fi
    done
  fi
  if (( ${#plans[@]} == 0 && ${#whole_selected[@]} == 0 )); then
    echo "Nothing selected for shard ${shard_index}/${total_shards}: TOTAL_SHARDS exceeds the split test names and the packages to deal" >&2
    exit 1
  fi
  if (( ${#plans[@]} < procs && shard_index < total_shards - whole_shards )); then
    echo "No split-package tests selected for part of shard ${shard_index}/${total_shards} (${#plans[@]} of ${procs} processes): TOTAL_SHARDS*SPLIT_PROCS exceeds the split test names" >&2
    exit 1
  fi
  status=0
  if (( ${#whole_selected[@]} > 0 )); then
    echo "Running ${#whole_selected[@]} of ${#whole_packages[@]} packages whole in shard ${shard_index}/${total_shards}"
    "$(dirname "$0")/go-test-with-timing" -count=1 "${timeout_args[@]}" "${whole_selected[@]}" "$@" || status=1
  fi
  if (( ${#plans[@]} == 1 )); then
    run_split_plan "split shard ${shard_index}/${total_shards}" "${plans[0]}" "$@" || status=1
  elif (( ${#plans[@]} > 1 )); then
    # Concurrent processes: each writes its own log, printed in order after.
    logdir="$(mktemp -d)"
    trap 'rm -rf "$logdir"' EXIT
    pids=()
    for idx in "${!plans[@]}"; do
      ( run_split_plan "split shard ${shard_index}/${total_shards} process $((idx + 1))/${#plans[@]}" "${plans[$idx]}" "$@" ) >"$logdir/$idx.log" 2>&1 &
      pids+=("$!")
    done
    for idx in "${!pids[@]}"; do
      wait "${pids[$idx]}" || status=1
      echo "::group::split shard ${shard_index} process $((idx + 1))/${#plans[@]} output"
      cat "$logdir/$idx.log"
      echo "::endgroup::"
    done
  fi
  exit "$status"
fi

selected=()
for i in "${!all_packages[@]}"; do
  if (( i % total_shards == shard_index )); then
    selected+=("${all_packages[$i]}")
  fi
done
if (( ${#selected[@]} == 0 )); then
  echo "No packages selected for shard ${shard_index}/${total_shards}: TOTAL_SHARDS exceeds the ${#all_packages[@]} packages to deal" >&2
  exit 1
fi
echo "Running ${#selected[@]} of ${#all_packages[@]} packages whole in shard ${shard_index}/${total_shards}"
"$(dirname "$0")/go-test-with-timing" -count=1 "${timeout_args[@]}" "${selected[@]}" "$@"
