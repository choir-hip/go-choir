#!/usr/bin/env bash
# Selftest for scripts/check-guest-security-epoch (D2 design 6.6, S1c): builds
# throwaway git repos and checks the verdicts, including the gate's own
# protection (rule 6). Touches nothing in this tree except reading the real
# surfaces and floor lists for the list-sanity case.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
script=$here/check-guest-security-epoch
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
fails=0
n=0

GIT_AUTHOR_NAME=t GIT_AUTHOR_EMAIL=t@t GIT_COMMITTER_NAME=t GIT_COMMITTER_EMAIL=t@t
export GIT_AUTHOR_NAME GIT_AUTHOR_EMAIL GIT_COMMITTER_NAME GIT_COMMITTER_EMAIL

OK_EFFECT='Security-Effect: none; the change only renames a local variable'
OK_REVIEW='Security-Effect-Reviewed-By: devin; review 313'
GATE_EFFECT='Security-Effect: gate change; narrows the list on purpose, reviewed'

policy() { printf '{"security_epoch":%s,"guest_abi":1,"guest_abi_min":1}\n' "$1"; }

ci_yml() { # with the step, the check job's wiring and the deploy gate
	cat <<'YML'
name: CI
jobs:
  plan:
    runs-on: ubuntu-latest
    steps:
      - run: echo plan
  v1-inventory:
    runs-on: ubuntu-latest
    needs: plan
    if: needs.plan.outputs.non_docs == 'true'
    steps:
      - run: scripts/check-guest-security-epoch --base "$BASE" --head HEAD
  check:
    runs-on: ubuntu-latest
    needs: [plan, v1-inventory]
    steps:
      - run: |
          require_success "${{ needs.plan.outputs.non_docs }}" v1-inventory "${{ needs.v1-inventory.result }}"
  deploy-staging:
    runs-on: ubuntu-latest
    needs: [check]
    if: always() && needs.check.result == 'success'
    steps:
      - run: echo deploy
YML
}

# new_repo DIR: a repo with the lists, the policy at epoch 1, the script, CI.
new_repo() {
	local d=$1
	git init -q "$d"
	mkdir -p "$d/nix" "$d/scripts" "$d/.github/workflows" "$d/.github/scripts" "$d/internal/agentcore" "$d/internal/capsule" "$d/internal/other" "$d/internal/server"
	printf 'internal/agentcore/\ninternal/server/\n' >"$d/nix/guest-security-surfaces.txt"
	printf '# floor\nflake.nix\ninternal/capsule\n' >"$d/nix/guest-floor-paths.txt"
	policy 1 >"$d/nix/guest-release-policy.json"
	cp "$script" "$d/scripts/check-guest-security-epoch"
	echo '#!/bin/sh' >"$d/scripts/selftest-guest-security-epoch"
	echo '#!/bin/sh' >"$d/.github/scripts/deploy-base-select"
	echo '#!/bin/sh' >"$d/.github/scripts/ci-impact-classify"
	echo '#!/bin/sh' >"$d/.github/scripts/ci-docs-like-paths"
	ci_yml >"$d/.github/workflows/ci.yml"
	echo 'package agentcore' >"$d/internal/agentcore/a.go"
	echo 'package other' >"$d/internal/other/o.go"
	echo 'package server' >"$d/internal/server/s.go"
	echo 'package capsule' >"$d/internal/capsule/c.go"
	git -C "$d" add -A
	git -C "$d" commit -q -m init
}

# commit DIR MESSAGE: commit all changes (or an empty commit).
commit() { git -C "$1" add -A && git -C "$1" commit -q --allow-empty -m "$2"; }
msg() { printf '%s\n\n%s\n%s\n' "$1" "$2" "$3"; } # subject, trailer, trailer
rev() { git -C "$1" rev-parse "${2:-HEAD}"; }

# ci_run DIR BASE HEAD: what the CI step does: the base's copy of the script
# when the base has one, and the head's copy; both must pass.
ci_run() {
	local d=$1 base=$2 head=$3 rc=0
	rm -f "$tmp/out-base" "$tmp/out-head"
	# Review 318 DeepSeek 3: a base that is not in the checkout is fetched
	# before "first adoption" is decided, and an unreadable base fails the step.
	if ! git -C "$d" cat-file -e "$base^{commit}" 2>/dev/null; then
		git -C "$d" fetch --no-tags --depth=1 origin "$base" >/dev/null 2>&1 || true
		if ! git -C "$d" cat-file -e "$base^{commit}" 2>/dev/null; then
			echo "guest-security-epoch: FAIL: base $base cannot be read here"
			return 1
		fi
	fi
	if git -C "$d" cat-file -e "$base:scripts/check-guest-security-epoch" 2>/dev/null; then
		git -C "$d" show "$base:scripts/check-guest-security-epoch" >"$tmp/base-copy"
		chmod +x "$tmp/base-copy"
		(cd "$d" && "$tmp/base-copy" --base "$base" --head "$head") >"$tmp/out-base" 2>&1 || rc=1
	fi
	(cd "$d" && ./scripts/check-guest-security-epoch --base "$base" --head "$head") >"$tmp/out-head" 2>&1 || rc=1
	cat "$tmp/out-base" "$tmp/out-head" 2>/dev/null || true
	return $rc
}

expect() { # NAME WANT_EXIT DIR BASE HEAD
	local name=$1 want=$2 d=$3 base=$4 head=$5 got=0 out
	n=$((n + 1))
	out=$(ci_run "$d" "$base" "$head" 2>&1) || got=$?
	if [ "$got" != "$want" ]; then
		echo "FAIL: $name: exit $got, want $want"
		echo "$out" | sed 's/^/    /'
		fails=$((fails + 1))
	else
		echo "ok:   $name"
	fi
}

expect_head_only() { # NAME WANT_EXIT DIR BASE HEAD: the head's copy alone
	local name=$1 want=$2 d=$3 base=$4 head=$5 got=0 out
	n=$((n + 1))
	out=$(cd "$d" && ./scripts/check-guest-security-epoch --base "$base" --head "$head" 2>&1) || got=$?
	if [ "$got" != "$want" ]; then
		echo "FAIL: $name: exit $got, want $want"
		echo "$out" | sed 's/^/    /'
		fails=$((fails + 1))
	else
		echo "ok:   $name"
	fi
}

touch_surface() { echo "// $RANDOM$RANDOM" >>"$1/internal/agentcore/a.go"; }

# --- surface coverage -------------------------------------------------------
r=$tmp/r1
new_repo "$r"
base=$(rev "$r")
expect "empty range passes" 0 "$r" "$base" "$base"

touch_surface "$r"; commit "$r" "surface change, no trailer"
expect "a surface change with no raise and no trailer fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r2; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'surface change, both trailers' "$OK_EFFECT" "$OK_REVIEW")"
expect "the same with both trailers passes" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/r3; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'refused seat' "$OK_EFFECT" 'Security-Effect-Reviewed-By: sol; review 313')"
expect "a trailer naming a seat that does not run review fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r3b; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'second agent' "$OK_EFFECT" 'Security-Effect-Reviewed-By: gemini; review 1')"
expect "a trailer naming any other second agent passes" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/r4; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'malformed ref' "$OK_EFFECT" 'Security-Effect-Reviewed-By: devin; looked fine')"
expect "a malformed review ref fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r5; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'owner ref' "$OK_EFFECT" 'Security-Effect-Reviewed-By: owner; owner 2026-10-26')"
expect "an owner ref with a date passes" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/r6; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'short why' 'Security-Effect: none; fine' "$OK_REVIEW")"
expect "a why under 20 characters fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r7; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'only one trailer' "$OK_EFFECT" "Signed-off-by: t <t@t>")"
expect "a missing Reviewed-By fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r8; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"
commit "$r" "$(msg 'trailers in a later commit' "$OK_EFFECT" "$OK_REVIEW")"
expect "a trailer in a later commit does not cover an earlier one" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r9; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"
policy 2 >"$r/nix/guest-release-policy.json"; commit "$r" "raise the epoch"
expect "a raise later in the range passes the range" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/r10; new_repo "$r"; base=$(rev "$r")
policy 2 >"$r/nix/guest-release-policy.json"; commit "$r" "raise the epoch"
touch_surface "$r"; commit "$r" "surface change after the raise"
expect "a raise earlier in the range passes the range" 0 "$r" "$base" "$(rev "$r")"
# a later range, based after the raise, is not covered by it
base2=$(rev "$r" HEAD~1)
touch_surface "$r"; commit "$r" "another surface change"
expect "a later range starting after the raise is not covered by it" 1 "$r" "$base2" "$(rev "$r")"

r=$tmp/r1b; new_repo "$r"
expect "the CI step fails closed on an unreadable base (no first-adoption escape)" 1 "$r" deadbeefdeadbeefdeadbeefdeadbeefdeadbeef "$(rev "$r")"

# --- exclusions -------------------------------------------------------------
r=$tmp/r11; new_repo "$r"; base=$(rev "$r")
echo 'package agentcore' >"$r/internal/agentcore/a_test.go"
mkdir -p "$r/internal/agentcore/testdata"; echo x >"$r/internal/agentcore/testdata/f.json"
echo '# notes' >"$r/internal/agentcore/README.md"
echo 'package other' >>"$r/internal/other/o.go"
commit "$r" "tests, testdata, markdown and a non-surface package"
expect "tests, testdata, markdown and non-surface paths pass" 0 "$r" "$base" "$(rev "$r")"

# --- monotone ---------------------------------------------------------------
r=$tmp/r12; new_repo "$r"; base=$(rev "$r")
policy 2 >"$r/nix/guest-release-policy.json"; commit "$r" "raise to 2"
policy 1 >"$r/nix/guest-release-policy.json"; commit "$r" "$(msg 'lower to 1' "$OK_EFFECT" "$OK_REVIEW")"
expect "a fall fails even with trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r13; new_repo "$r"
policy 2 >"$r/nix/guest-release-policy.json"; commit "$r" "raise to 2"; base=$(rev "$r")
policy 1 >"$r/nix/guest-release-policy.json"; commit "$r" "$(msg 'lower below the base' "$OK_EFFECT" "$OK_REVIEW")"
expect "an epoch below the base's fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r14; new_repo "$r"; base=$(rev "$r")
printf '{"security_epoch":1,"guest_abi":2,"guest_abi_min":1}\n' >"$r/nix/guest-release-policy.json"; commit "$r" "abi bump, same epoch"
expect "a policy change that keeps the epoch passes" 0 "$r" "$base" "$(rev "$r")"

# --- fail closed ------------------------------------------------------------
r=$tmp/r15; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "$(msg 'covered' "$OK_EFFECT" "$OK_REVIEW")"
expect_head_only "an unreadable base fails closed" 1 "$r" deadbeefdeadbeefdeadbeefdeadbeefdeadbeef "$(rev "$r")"
expect_head_only "an all-zero base fails closed" 1 "$r" 0000000000000000000000000000000000000000 "$(rev "$r")"

r=$tmp/r16; new_repo "$r"; base=$(rev "$r")
echo '{ not json' >"$r/nix/guest-release-policy.json"; commit "$r" "break the policy"
expect "an unparsable policy file fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r17; new_repo "$r"; base=$(rev "$r")
echo '{"guest_abi":1}' >"$r/nix/guest-release-policy.json"; commit "$r" "policy without an epoch"
expect "a policy file without security_epoch fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/r18; new_repo "$r"; base=$(rev "$r")
git -C "$r" rm -q nix/guest-release-policy.json; commit "$r" "delete the policy"
expect "a deleted policy file fails" 1 "$r" "$base" "$(rev "$r")"

# a shallow clone that lacks the base: fetched once, then decided
r=$tmp/r19; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"
git clone -q --depth=1 "file://$r" "$tmp/shallow"
cp "$script" "$tmp/shallow/scripts/check-guest-security-epoch"
expect_head_only "a shallow clone: the base is fetched and the uncovered change is still caught" 1 "$tmp/shallow" "$base" "$(rev "$tmp/shallow")"

# --- merge commits ----------------------------------------------------------
r=$tmp/r20; new_repo "$r"; base=$(rev "$r")
git -C "$r" checkout -q -b side
touch_surface "$r"; commit "$r" "$(msg 'side: covered' "$OK_EFFECT" "$OK_REVIEW")"
git -C "$r" checkout -q -
echo x >"$r/internal/other/o2.go"; commit "$r" "main: unrelated"
git -C "$r" merge -q --no-ff side -m "merge side, no trailers"
expect "a merge commit is skipped (its side commit is covered)" 0 "$r" "$base" "$(rev "$r")"

# --- list sanity ------------------------------------------------------------
for case_prefix in "internal/capsule/" "internal/" "internal/capsule/transaction/"; do
	r=$tmp/r21; rm -rf "$r"; new_repo "$r"; base=$(rev "$r")
	printf 'internal/agentcore/\n%s\n' "$case_prefix" >"$r/nix/guest-security-surfaces.txt"
	commit "$r" "$(msg "surface $case_prefix" "$GATE_EFFECT" "$OK_REVIEW")"
	expect "a surface prefix $case_prefix that is equal to, contains or lies under a floor path fails" 1 "$r" "$base" "$(rev "$r")"
done
r=$tmp/r22; new_repo "$r"; base=$(rev "$r")
git -C "$r" rm -q nix/guest-security-surfaces.txt; commit "$r" "$(msg 'drop the list' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a missing surfaces file at the head fails" 1 "$r" "$base" "$(rev "$r")"

n=$((n + 1))
got=0
out=$(cd "$root" && "$script" --lists-only 2>&1) || got=$?
if [ "$got" != 0 ]; then
	echo "FAIL: the real surfaces and floor lists: exit $got"
	echo "$out" | sed 's/^/    /'
	fails=$((fails + 1))
else
	echo "ok:   the real surfaces and floor lists pass the sanity rule"
fi

# --- a file entry in the surfaces list (docs/problems/guest-reach-file-is-not-a-security-surface-2026-11-23.md)
r=$tmp/f1; new_repo "$r"
mkdir -p "$r/internal/proxy"; echo 'package proxy' >"$r/internal/proxy/guest_authority.go"
printf 'internal/agentcore/\ninternal/proxy/guest_authority.go\n' >"$r/nix/guest-security-surfaces.txt"
commit "$r" "$(msg 'list a file' "$GATE_EFFECT" "$OK_REVIEW")"; base=$(rev "$r")
mkdir -p "$r/internal/proxy"; echo 'package proxy // touched' >"$r/internal/proxy/guest_authority.go"; commit "$r" "touch the listed file, no trailer"
expect "a file entry: the listed file, touched with no trailer, fails" 1 "$r" "$base" "$(rev "$r")"
r=$tmp/f2; new_repo "$r"
mkdir -p "$r/internal/proxy"; echo 'package proxy' >"$r/internal/proxy/guest_authority.go"
printf 'internal/agentcore/\ninternal/proxy/guest_authority.go\n' >"$r/nix/guest-security-surfaces.txt"
commit "$r" "$(msg 'list a file' "$GATE_EFFECT" "$OK_REVIEW")"; base=$(rev "$r")
mkdir -p "$r/internal/proxy"; echo 'package proxy // touched' >"$r/internal/proxy/guest_authority.go"
commit "$r" "$(msg 'touch the listed file' "$OK_EFFECT" "$OK_REVIEW")"
expect "a file entry: the listed file, touched with the trailers, passes" 0 "$r" "$base" "$(rev "$r")"
r=$tmp/f3; new_repo "$r"
mkdir -p "$r/internal/proxy"; echo 'package proxy' >"$r/internal/proxy/guest_authority.go"
printf 'internal/agentcore/\ninternal/proxy/guest_authority.go\n' >"$r/nix/guest-security-surfaces.txt"
commit "$r" "$(msg 'list a file' "$GATE_EFFECT" "$OK_REVIEW")"; base=$(rev "$r")
mkdir -p "$r/internal/proxy"; echo 'package proxy' >"$r/internal/proxy/guest_authority_other.go"; echo 'package proxy' >"$r/internal/proxy/other.go"; commit "$r" "touch siblings, no trailer"
expect "a file entry names that file only: a sibling, even one sharing its stem, passes" 0 "$r" "$base" "$(rev "$r")"

# Every entry of the REAL list, touched alone with no trailer, fails; the file
# that decides what a guest may call is among them.
r=$tmp/real; new_repo "$r"
cp "$root/nix/guest-security-surfaces.txt" "$r/nix/guest-security-surfaces.txt"
# every entry must exist at the head: a file for a file entry, x.go under a directory
real_entries() { sed -e 's/#.*//' -e 's/[[:space:]]//g' -e 's/^host://' "$root/nix/guest-security-surfaces.txt" | grep -v '^$' | sed 's|/*$||'; }
for p in $(real_entries); do
	case $p in *.go) f=$p ;; *) f=$p/x.go ;; esac
	mkdir -p "$r/$(dirname "$f")"; echo 'package y' >"$r/$f"
done
commit "$r" "$(msg 'the real list' "$GATE_EFFECT" "$OK_REVIEW")"
r2=$tmp/real-ga; cp -R "$r" "$r2"; base=$(rev "$r2")
mkdir -p "$r2/internal/proxy"; echo 'package proxy // touched' >"$r2/internal/proxy/guest_authority.go"; commit "$r2" "grant every guest a host route, no trailer"
expect "a commit touching internal/proxy/guest_authority.go with no trailer fails against the real list" 1 "$r2" "$base" "$(rev "$r2")"
for p in $(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e 's/^host://' "$root/nix/guest-security-surfaces.txt" | grep -v '^$' | sed 's|/*$||'); do
	r2=$tmp/real-$(printf '%s' "$p" | tr '/.' '__'); rm -rf "$r2"; cp -R "$r" "$r2"; base=$(rev "$r2")
	case $p in *.go) f=$p ;; *) f=$p/x.go ;; esac
	mkdir -p "$r2/$(dirname "$f")"; echo 'package x // touched' >"$r2/$f"; commit "$r2" "touch $f, no trailer"
	expect "the real list: $f touched with no trailer fails" 1 "$r2" "$base" "$(rev "$r2")"
done

# --- the entry must exist, and a host: entry is not excused by an epoch raise
r=$tmp/e1; new_repo "$r"
printf 'internal/agentcore/\ninternal/proxy/guest_authorit.go\n' >"$r/nix/guest-security-surfaces.txt"
mkdir -p "$r/internal/proxy"; echo 'package proxy' >"$r/internal/proxy/guest_authority.go"
base=$(rev "$r"); commit "$r" "$(msg 'list a typo' "$GATE_EFFECT" "$OK_REVIEW")"
expect "an entry naming a path that does not exist at the head fails (typo)" 1 "$r" "$base" "$(rev "$r")"
r=$tmp/e2; new_repo "$r"
printf 'internal/agentcore/\ninternal/gone/\n' >"$r/nix/guest-security-surfaces.txt"
base=$(rev "$r"); commit "$r" "$(msg 'list a dead directory' "$GATE_EFFECT" "$OK_REVIEW")"
expect "an entry naming a directory that does not exist at the head fails" 1 "$r" "$base" "$(rev "$r")"
r=$tmp/e3; new_repo "$r"
printf 'internal/agentcore/\nhost:internal/proxy/guest_authorit.go\n' >"$r/nix/guest-security-surfaces.txt"
base=$(rev "$r"); commit "$r" "$(msg 'list a host typo' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a host: entry naming a path that does not exist fails" 1 "$r" "$base" "$(rev "$r")"
n=$((n + 1)); got=0
r=$tmp/e4; new_repo "$r"; printf 'internal/agentcore/\ninternal/proxy/typo.go\n' >"$r/nix/guest-security-surfaces.txt"
out=$(cd "$r" && ./scripts/check-guest-security-epoch --lists-only 2>&1) || got=$?
if [ "$got" = 1 ]; then echo "ok:   --lists-only fails for an entry that does not exist"; else echo "FAIL: --lists-only passes a dead entry: exit $got"; fails=$((fails + 1)); fi

# An entry that can never match, or that git resolves but the matcher does not,
# is a dead entry: the check refuses it loudly (full run and --lists-only).
bad_entry() { # NAME ENTRY [FILE]: the list names ENTRY; FILE exists at the head
	local name=$1 entry=$2 file=${3:-} d
	d=$tmp/bad-$(printf '%s' "$name" | tr -c 'a-z0-9' '_')
	new_repo "$d"
	[ -z "$file" ] || { mkdir -p "$d/$(dirname "$file")"; echo 'package proxy' >"$d/$file"; }
	printf 'internal/agentcore/\n%s\n' "$entry" >"$d/nix/guest-security-surfaces.txt"
	base=$(rev "$d"); commit "$d" "$(msg "list $name" "$GATE_EFFECT" "$OK_REVIEW")"
	expect "a dead entry ($name) fails the full run" 1 "$d" "$base" "$(rev "$d")"
	n=$((n + 1)); local got=0
	(cd "$d" && ./scripts/check-guest-security-epoch --lists-only >/dev/null 2>&1) || got=$?
	if [ "$got" = 1 ]; then echo "ok:   a dead entry ($name) fails --lists-only"; else echo "FAIL: --lists-only passes a dead entry ($name): exit $got"; fails=$((fails + 1)); fi
}
bad_entry "dot-slash" "./internal/proxy/a.go" internal/proxy/a.go
bad_entry "bare host marker" "host:"
bad_entry "dot-dot segment" "internal/agentcore/../proxy/a.go" internal/proxy/a.go
bad_entry "double slash" "internal//proxy/a.go" internal/proxy/a.go
bad_entry "absolute path" "/internal/proxy/a.go" internal/proxy/a.go
bad_entry "test file never matches" "host:internal/proxy/a_test.go" internal/proxy/a_test.go
bad_entry "markdown never matches" "host:internal/proxy/a.md" internal/proxy/a.md
bad_entry "testdata never matches" "host:internal/proxy/testdata" internal/proxy/testdata/x.go
bad_entry "root as a prefix" "." internal/proxy/a.go
bad_entry "one slash" "/"
bad_entry "two slashes" "//"
bad_entry "three slashes" "///"
bad_entry "host marker and a slash" "host:/"
bad_entry "host marker and slashes" "host://"
bad_entry "host marker and a space" "host: "
bad_entry "host marker and a dot" "host:."
bad_entry "host marker and a dot slash" "host:./"

host_repo() { # DIR: a list with one guest file and one host file, both present
	local d=$1
	new_repo "$d"
	mkdir -p "$d/internal/proxy"; echo 'package proxy' >"$d/internal/proxy/hostside.go"; echo 'package server' >"$d/internal/server/s.go"
	printf 'internal/agentcore/\nhost:internal/proxy/hostside.go\n' >"$d/nix/guest-security-surfaces.txt"
	commit "$d" "$(msg 'list a host file' "$GATE_EFFECT" "$OK_REVIEW")"
}
r=$tmp/h1; host_repo "$r"; base=$(rev "$r")
echo 'package proxy // touched' >"$r/internal/proxy/hostside.go"; policy 2 >"$r/nix/guest-release-policy.json"
commit "$r" "touch the host file and raise the epoch, no trailer"
expect "a host: entry touched with an epoch raise and no trailer fails" 1 "$r" "$base" "$(rev "$r")"
r=$tmp/h2; host_repo "$r"; base=$(rev "$r")
echo 'package proxy // touched' >"$r/internal/proxy/hostside.go"; policy 2 >"$r/nix/guest-release-policy.json"
commit "$r" "$(msg 'touch the host file and raise the epoch' "$OK_EFFECT" "$OK_REVIEW")"
expect "a host: entry touched with an epoch raise and the trailers passes" 0 "$r" "$base" "$(rev "$r")"
r=$tmp/h3; host_repo "$r"; base=$(rev "$r")
echo 'package proxy // touched' >"$r/internal/proxy/hostside.go"; commit "$r" "touch the host file, no trailer, no raise"
expect "a host: entry touched with no trailer and no raise fails" 1 "$r" "$base" "$(rev "$r")"
r=$tmp/h4; host_repo "$r"; base=$(rev "$r")
echo 'package agentcore // touched' >"$r/internal/agentcore/a.go"; policy 2 >"$r/nix/guest-release-policy.json"
commit "$r" "touch a guest surface and raise the epoch, no trailer"
expect "a guest surface touched with an epoch raise and no trailer still passes" 0 "$r" "$base" "$(rev "$r")"
r=$tmp/h5; host_repo "$r"; base=$(rev "$r")
echo 'package agentcore // touched' >"$r/internal/agentcore/a.go"; echo 'package proxy // touched' >"$r/internal/proxy/hostside.go"
policy 2 >"$r/nix/guest-release-policy.json"; commit "$r" "touch both and raise the epoch, no trailer"
expect "a commit touching a guest surface and a host: entry, with a raise and no trailer, fails" 1 "$r" "$base" "$(rev "$r")"
r=$tmp/h6; host_repo "$r"
printf 'internal/agentcore/\nhost:internal/proxy/hostside.go\ninternal/proxy/hostside.go\n' >"$r/nix/guest-security-surfaces.txt"
commit "$r" "$(msg 'list the file both ways' "$GATE_EFFECT" "$OK_REVIEW")"; base=$(rev "$r")
echo 'package proxy // touched' >"$r/internal/proxy/hostside.go"; policy 2 >"$r/nix/guest-release-policy.json"; commit "$r" "touch with a raise, no trailer"
expect "a file listed both plain and host: counts as host-side: a raise does not excuse it" 1 "$r" "$base" "$(rev "$r")"

# --- rule 6: the gate protects itself ---------------------------------------
r=$tmp/g1; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"; commit "$r" "$(msg 'drop agentcore from the list' "$GATE_EFFECT" "$OK_REVIEW")"
mid=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change under the removed prefix"
expect "a removed prefix still covers the same range (the base's list is read)" 1 "$r" "$base" "$(rev "$r")"
expect "after the removal deployed, the range no longer matches the prefix" 0 "$r" "$mid" "$(rev "$r")"

r=$tmp/g2; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"; commit "$r" "narrow the list, no trailers"
expect "a gate-file change with no trailers fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g3; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"
policy 2 >"$r/nix/guest-release-policy.json"; commit "$r" "narrow the list and raise the epoch"
expect "a gate-file change with only an epoch raise fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g4; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"; commit "$r" "$(msg 'narrow the list, gate trailers' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a gate-file change with the gate trailers passes" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/g5; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"; commit "$r" "$(msg 'narrow the list, none-form trailer' "$OK_EFFECT" "$OK_REVIEW")"
expect "a gate-file change with the none-form trailer fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g6; new_repo "$r"; base=$(rev "$r")
printf '#!/bin/sh\nexit 0\n' >"$r/scripts/check-guest-security-epoch"; commit "$r" "neuter the script"
touch_surface "$r"; commit "$r" "surface change, no trailer"
expect_head_only "the neutered head script alone passes" 0 "$r" "$base" "$(rev "$r")"
expect "a head script edited to always pass still fails against the base's copy" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g7; new_repo "$r"; base=$(rev "$r")
grep -v check-guest-security-epoch "$r/.github/workflows/ci.yml" >"$r/ci.new"; echo '      - run: echo gone' >>"$r/ci.new"
mv "$r/ci.new" "$r/.github/workflows/ci.yml"; commit "$r" "drop the step from ci.yml"
expect "a ci.yml that drops the step fails" 1 "$r" "$base" "$(rev "$r")"
git -C "$r" commit -q --amend -m "$(msg 'drop the step, gate trailers' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a ci.yml that drops the step fails even with the gate trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g8; new_repo "$r"; base=$(rev "$r")
sed 's|run: scripts/check-guest-security-epoch|run: true # scripts/check-guest-security-epoch|' "$r/.github/workflows/ci.yml" >"$r/ci.new"
mv "$r/ci.new" "$r/.github/workflows/ci.yml"; commit "$r" "$(msg 'comment the step out' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a ci.yml that comments the step out fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g9; new_repo "$r"; base=$(rev "$r")
awk '{print} /^  v1-inventory:/{print "    continue-on-error: true"}' "$r/.github/workflows/ci.yml" >"$r/ci.new"
mv "$r/ci.new" "$r/.github/workflows/ci.yml"; commit "$r" "$(msg 'v1-inventory may fail' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a v1-inventory job that may fail fails" 1 "$r" "$base" "$(rev "$r")"

# review 318 (both seats, HIGH): ANY ci.yml change is a gate change, because a
# step `if:`, an `exit 0` in the run block, or a dropped needs: line disables
# the gate without touching a line that names the script.
r=$tmp/g10; new_repo "$r"; base=$(rev "$r")
sed 's|echo plan|echo plan2|' "$r/.github/workflows/ci.yml" >"$r/ci.new"; mv "$r/ci.new" "$r/.github/workflows/ci.yml"; commit "$r" "unrelated ci.yml change"
expect "any ci.yml change needs the gate trailers" 1 "$r" "$base" "$(rev "$r")"
git -C "$r" commit -q --amend -m "$(msg 'unrelated ci.yml change, gate trailers' "$GATE_EFFECT" "$OK_REVIEW")"
expect "an unrelated ci.yml change with the gate trailers passes" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/g10a; new_repo "$r"; base=$(rev "$r")
# a step-level if: must sit between the "- run" and a sibling key; build it explicitly
cat >"$r/ci.new" <<'YML'
name: CI
jobs:
  plan:
    runs-on: ubuntu-latest
    steps:
      - run: echo plan
  v1-inventory:
    runs-on: ubuntu-latest
    needs: plan
    if: needs.plan.outputs.non_docs == 'true'
    steps:
      - if: ${{ false }}
        run: scripts/check-guest-security-epoch --base "$BASE" --head HEAD
  check:
    runs-on: ubuntu-latest
    needs: [plan, v1-inventory]
    steps:
      - run: |
          require_success "${{ needs.plan.outputs.non_docs }}" v1-inventory "${{ needs.v1-inventory.result }}"
  deploy-staging:
    runs-on: ubuntu-latest
    needs: [check]
    if: always() && needs.check.result == 'success'
    steps:
      - run: echo deploy
YML
mv "$r/ci.new" "$r/.github/workflows/ci.yml"; commit "$r" "$(msg 'skip the step with if false, gate trailers' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a step-level if on the check step fails even with the gate trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g10b; new_repo "$r"; base=$(rev "$r")
sed 's|needs: \[plan, v1-inventory\]|needs: [plan]|' "$r/.github/workflows/ci.yml" >"$r/ci.new"; mv "$r/ci.new" "$r/.github/workflows/ci.yml"
commit "$r" "$(msg 'check no longer needs v1-inventory' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a check job that no longer needs v1-inventory fails even with the gate trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g10c; new_repo "$r"; base=$(rev "$r")
grep -v 'require_success' "$r/.github/workflows/ci.yml" >"$r/ci.new"; mv "$r/ci.new" "$r/.github/workflows/ci.yml"
commit "$r" "$(msg 'check stops requiring v1-inventory' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a check job that no longer requires v1-inventory's success fails even with the gate trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g10d; new_repo "$r"; base=$(rev "$r")
sed "s|needs.check.result == 'success'|true|" "$r/.github/workflows/ci.yml" >"$r/ci.new"; mv "$r/ci.new" "$r/.github/workflows/ci.yml"
commit "$r" "$(msg 'deploy no longer requires check' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a deploy job that no longer requires check's success fails even with the gate trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g11; new_repo "$r"; base=$(rev "$r")
echo '# changed' >>"$r/.github/scripts/deploy-base-select"; commit "$r" "change the base selection"
expect "a change to deploy-base-select needs the gate trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g11b; new_repo "$r"; base=$(rev "$r")
echo '# changed' >>"$r/.github/scripts/ci-impact-classify"; commit "$r" "change the CI classifier"
expect "a change to ci-impact-classify (the non_docs off-switch) needs the gate trailers" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g11c; new_repo "$r"; base=$(rev "$r")
echo '# changed' >>"$r/.github/scripts/ci-docs-like-paths"; commit "$r" "change the docs-like rule"
expect "a change to ci-docs-like-paths (the shared docs-only rule) needs the gate trailers" 1 "$r" "$base" "$(rev "$r")"

# review 331: the check job's own block is checked too
r=$tmp/g13; new_repo "$r"; base=$(rev "$r")
awk '{print} /^  check:/{print "    continue-on-error: true"}' "$r/.github/workflows/ci.yml" >"$r/ci.new"; mv "$r/ci.new" "$r/.github/workflows/ci.yml"
commit "$r" "$(msg 'check may fail' "$GATE_EFFECT" "$OK_REVIEW")"
expect "a check job that may fail fails even with the gate trailers" 1 "$r" "$base" "$(rev "$r")"

# review 331 DeepSeek 1: ONE commit that weakens the check (the step skipped,
# the script neutered) and changes a surface fails: the base's copy of the
# script reads the head's wiring and the head's surface change, whatever the
# head's own copy and ci.yml say.
r=$tmp/g14; new_repo "$r"; base=$(rev "$r")
cat >"$r/.github/workflows/ci.yml" <<'YML'
name: CI
jobs:
  plan:
    runs-on: ubuntu-latest
    steps:
      - run: echo plan
  v1-inventory:
    runs-on: ubuntu-latest
    needs: plan
    if: needs.plan.outputs.non_docs == 'true'
    steps:
      - if: ${{ false }}
        run: scripts/check-guest-security-epoch --base "$BASE" --head HEAD
  check:
    runs-on: ubuntu-latest
    needs: [plan, v1-inventory]
    steps:
      - run: |
          require_success "${{ needs.plan.outputs.non_docs }}" v1-inventory "${{ needs.v1-inventory.result }}"
  deploy-staging:
    runs-on: ubuntu-latest
    needs: [check]
    if: always() && needs.check.result == 'success'
    steps:
      - run: echo deploy
YML
printf '#!/bin/sh\nexit 0\n' >"$r/scripts/check-guest-security-epoch"
touch_surface "$r"
commit "$r" "$(msg 'weaken the check and change a surface, gate trailers only' "$GATE_EFFECT" "$OK_REVIEW")"
expect_head_only "the neutered head copy alone passes this commit" 0 "$r" "$base" "$(rev "$r")"
expect "one commit that skips the step, neuters the script and changes a surface fails (the base's copy)" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/g12; new_repo "$r"; base=$(rev "$r")
sed 's|--base "$BASE"|--base "${{ plan.outputs.base }}"|' "$r/.github/workflows/ci.yml" >"$r/ci.new"; mv "$r/ci.new" "$r/.github/workflows/ci.yml"; commit "$r" "change the base the step uses"
expect "a ci.yml change to the line that carries the check needs the gate trailers" 1 "$r" "$base" "$(rev "$r")"

# first adoption: the base has no script, no lists and no policy
r=$tmp/a1; git init -q "$r"; echo x >"$r/readme"; commit "$r" init; base=$(rev "$r")
mkdir -p "$r/nix" "$r/scripts" "$r/.github/workflows" "$r/internal/agentcore"; echo 'package agentcore' >"$r/internal/agentcore/a.go"
printf 'internal/agentcore/\n' >"$r/nix/guest-security-surfaces.txt"; printf 'internal/capsule\n' >"$r/nix/guest-floor-paths.txt"
policy 1 >"$r/nix/guest-release-policy.json"; cp "$script" "$r/scripts/check-guest-security-epoch"; ci_yml >"$r/.github/workflows/ci.yml"
commit "$r" "$(msg 'adopt the gate' "$GATE_EFFECT" "$OK_REVIEW")"
expect "first adoption (nothing at the base) passes with the gate trailers" 0 "$r" "$base" "$(rev "$r")"

# --- rule 7: a later commit covers an earlier one by its sha -----------------
cover() { printf 'Security-Effect-Covers: %s; %s; reviewed after it landed, see the review ref' "$1" "$2"; }

r=$tmp/c1; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"; bad=$(rev "$r")
commit "$r" "$(msg 'cover it' "$(cover "$bad" none)" "$OK_REVIEW")"
expect "a later commit naming the sha with a cover and a review covers a surface change" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/c2; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"; bad=$(rev "$r")
commit "$r" "$(msg 'cover without review' "$(cover "$bad" none)" "Signed-off-by: t <t@t>")"
expect "a cover without a Reviewed-By in its own message fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/c3; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"; commit "$r" "narrow the list, no trailers"; bad=$(rev "$r")
commit "$r" "$(msg 'cover with none' "$(cover "$bad" none)" "$OK_REVIEW")"
expect "a none-form cover of a gate-file change fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/c4; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"; commit "$r" "narrow the list, no trailers"; bad=$(rev "$r")
commit "$r" "$(msg 'cover with gate change' "$(cover "$bad" 'gate change')" "$OK_REVIEW")"
expect "a gate-change cover of a gate-file change passes" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/c4b; new_repo "$r"; base=$(rev "$r")
printf 'internal/server/\n' >"$r/nix/guest-security-surfaces.txt"; commit "$r" "narrow the list, no trailers"; bad=$(rev "$r")
commit "$r" "$(msg 'wrong-kind cover' "$(cover "$bad" none)" "$OK_REVIEW")"
commit "$r" "$(msg 'right-kind cover' "$(cover "$bad" 'gate change')" "$OK_REVIEW")"
expect "a wrong-kind cover is fixed by a later right-kind cover" 0 "$r" "$base" "$(rev "$r")"

r=$tmp/c5; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"; bad=$(rev "$r")
commit "$r" "$(msg 'cover a short sha' "$(cover "${bad:0:12}" none)" "$OK_REVIEW")"
expect "a cover naming a short sha is malformed and fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/c6; new_repo "$r"; base=$(rev "$r")
commit "$r" "$(msg 'cover first' "$(cover 0123456789abcdef0123456789abcdef01234567 none)" "$OK_REVIEW")"
touch_surface "$r"; commit "$r" "surface change, no trailer"
expect "a cover of a sha that is not an earlier commit of the range fails" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/c7; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"; bad=$(rev "$r")
policy 0 >"$r/nix/guest-release-policy.json"
commit "$r" "$(msg 'cover it and lower the epoch' "$(cover "$bad" none)" "$OK_REVIEW")"
expect "a cover does not excuse a fall of the epoch" 1 "$r" "$base" "$(rev "$r")"

r=$tmp/c8; new_repo "$r"; base=$(rev "$r")
touch_surface "$r"; commit "$r" "surface change, no trailer"; bad=$(rev "$r")
commit "$r" "$(msg 'cover it' "$(cover "$bad" none)" "$OK_REVIEW")"
expect "a later range starting after the cover sees neither commit" 0 "$r" "$(rev "$r")" "$(rev "$r")"
touch_surface "$r"; commit "$r" "another surface change, no trailer"
expect "a cover reaches only the sha it names" 1 "$r" "$base" "$(rev "$r")"

if [ "$fails" -ne 0 ]; then
	echo "selftest-guest-security-epoch: $fails of $n FAILED" >&2
	exit 1
fi
echo "selftest-guest-security-epoch: PASS ($n cases)"
