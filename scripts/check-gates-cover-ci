#!/usr/bin/env python3
"""The landing script and CI must run the same gates, or say why not.

scripts/gates (run by the land script before a push) is a hand-kept copy of the
gate steps in .github/workflows/ci.yml. Three times in a week a CI gate it did
not run refused a landing after the push
(docs/problems/podcast-clips-landed-and-was-backed-out-ci-jev-entry-gate-2026-11-16.md).
This check compares them, in both directions.

Forward: EVERY job's `run:` steps are scanned (no job is excluded; a build job
that gains `scripts/check-x` is seen). Each repo program a step invokes
(scripts/..., frontend/scripts/..., .github/scripts/..., `go run ./cmd/...`)
must be run by scripts/gates or by the land script, or be exempted by name in
scripts/gates-ci-exemptions.txt with a reason. `go build`, `go vet` and
`go test` are not repo programs and need nothing.

Converse: every executable scripts/check-*, scripts/selftest-*,
scripts/test-* and .github/scripts/*-test must be run by CI, by scripts/gates or by the land script,
or be exempted by name with a reason (an orphan guard is a gate nothing runs:
docs/problems/store-schema-floor-guard-is-not-run-2026-11-15.md).

What the land script runs, it runs only under a condition (`.github/scripts/*-test`
on a .github/ change, the shard runners when agentcore and textureowner both
change). The checker cannot read those conditions reliably, so each such
program or glob needs a `land-conditional <key> <condition>` line, which
is printed on success; a line for something land does not run, or the gates do
run, fails.

An exemption fails when it is stale (the program is neither run by a CI job
nor an existing orphan candidate), when it has no reason, or when
scripts/gates or the land script runs the program. Exemption keys: a program
path, `./cmd/x`, `job:<id>` (a job that `uses:` a reusable workflow and has no
steps) and `./.github/actions/x` (a local action step).

"Invoked" is the same rule on every side: split the text into commands (on
newlines outside quotes, ; & && || | and $( ), skip comments, heredoc bodies,
and the wrappers `run if then else do ! time timeout N env VAR=x bash sh
python3 node` with their flags, `go run`; the next word, with a leading ./,
$VAR/ or "$var"/ removed, is the program. A path that is only an argument, an
assignment, an echo or a comment is not invoked. In the land script the
payload of an `echo` is scanned too (it writes the runner), and a
`for x in .github/scripts/*-test` line covers the programs its glob matches.

Fail closed, never skip: a tab or a shape the workflow reader does not know, a
command word or script path built from `${{ }}`, a job with no steps, a local
action, an unbalanced quote, and in scripts/gates a `run` line whose command
is not a program or one of go test, go list, go vet, go build. The workflow
is read by hand (PyYAML is not guaranteed on a runner or the Mac): `jobs:`,
jobs at two spaces, `steps:` at four, items at six, keys at eight; `run:` plain
or as a `|` / `>` block.

  scripts/check-gates-cover-ci [--ci] [--workflow F] [--gates F] [--land F] [--exemptions F] [--root D]

--ci (CI's step): the land script is not opened; the land-conditional lines of
the exemption file are the statement of what it runs. Without it (the local
run in scripts/gates) the land script is read and those lines are verified
against it, so an edit that drops a program fails the next local run, never
CI's verdict.
"""
import argparse
import fnmatch
import os
import re
import sys

PROG_RE = re.compile(r"^(?:\.github/scripts|frontend/scripts|scripts)/[A-Za-z0-9_][A-Za-z0-9._-]*$")
REPO_LIKE_RE = re.compile(r"(?<![\w.-])(?:\.github/scripts/|frontend/scripts/|scripts/|\./cmd/)[A-Za-z0-9_*?]")
GLOB_RE = re.compile(r"^(?:\.github/scripts|frontend/scripts|scripts)/[A-Za-z0-9_.*?-]*[*?][A-Za-z0-9_.*?-]*$")
VARPFX_RE = re.compile(r"^\$\{?[A-Za-z_][A-Za-z0-9_]*\}?/")
ASSIGN_RE = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
SKIP = {"run", "if", "then", "else", "elif", "do", "while", "until", "!", "{", "}", "time", "exec", "command", "sudo", "nohup", "setsid", "env"}
INTERP = {"bash", "sh", "python3", "python", "node"}
KNOWN_TOOLS = {("go", "test"), ("go", "list"), ("go", "vet"), ("go", "build")}


class ParseError(Exception):
    pass


# ---------------------------------------------------------------- shell text
def strip_heredocs(text):
    out, lines, i = [], text.split("\n"), 0
    while i < len(lines):
        line = lines[i]
        out.append(line)
        m = re.search(r"<<-?\s*(['\"]?)([A-Za-z_][A-Za-z0-9_]*)\1", line)
        i += 1
        if m:
            tag = m.group(2)
            while i < len(lines) and lines[i].strip() != tag:
                i += 1
            i += 1
    return "\n".join(out)


def commands(text):
    """Split shell text into commands, each a list of words (quotes removed)."""
    text = strip_heredocs(text.replace("\\\n", " "))
    cmds, words, cur = [], [], None
    stack = []  # quote state saved at each open $( or (
    q = None  # None, "'" or '"'
    i, n = 0, len(text)

    dbl = False  # inside [[ ... ]], where && and || are test operators

    def end_word():
        nonlocal cur, dbl
        if cur is not None:
            if cur == "[[":
                dbl = True
            elif cur == "]]":
                dbl = False
            words.append(cur)
            cur = None

    def end_cmd():
        nonlocal words
        end_word()
        if words:
            cmds.append(words)
        words = []

    while i < n:
        c = text[i]
        if q == "'":
            if c == "'":
                q = None
            else:
                cur = (cur or "") + c
            i += 1
            continue
        if q == '"':
            if c == '"':
                q = None
            elif c == "\\" and i + 1 < n:
                cur = (cur or "") + text[i + 1]
                i += 1
            elif c == "$" and text[i + 1:i + 2] == "(":
                end_cmd(); stack.append('"'); q = None; i += 1
            elif c == "`":
                end_cmd(); q = None; stack.append("`"); 
            else:
                cur = (cur or "") + c
            i += 1
            continue
        if c in "'\"":
            q = c
            cur = cur or ""
        elif c == "\\" and i + 1 < n:
            cur = (cur or "") + text[i + 1]
            i += 1
        elif c == "#" and cur is None:
            while i < n and text[i] != "\n":
                i += 1
            continue
        elif c in " \t":
            end_word()
        elif c == "\n" or c == ";":
            end_cmd()
        elif c in "&|":
            if dbl:
                end_word()
            else:
                end_cmd()
        elif c == "$" and text[i + 1:i + 2] == "(":
            end_cmd(); stack.append(q); i += 1
        elif c == "(":
            end_cmd(); stack.append(None)
        elif c == ")":
            end_cmd()
            if stack:
                prev = stack.pop()
                if prev == '"':
                    q = '"'
        elif c == "`":
            end_cmd()
        else:
            cur = (cur or "") + c
        i += 1
    if q is not None:
        raise ParseError("an unbalanced %s quote" % ("single" if q == "'" else "double"))
    end_cmd()
    return cmds


def clean(word):
    w = word
    if w.startswith("./") and PROG_RE.match(w[2:]):
        return w[2:]
    if VARPFX_RE.match(w) and PROG_RE.match(VARPFX_RE.sub("", w, 1)):
        return VARPFX_RE.sub("", w, 1)
    return w


def repo_like(w):
    return REPO_LIKE_RE.search(w) is not None


def interpreter(words, i, name):
    """words[i:] follow an interpreter word. -> (kind, value, next index)."""
    n = len(words)
    c_flag = syntax = mod = code = False
    while i < n and words[i][:1] in "-+" and len(words[i]) > 1:
        opt = words[i]
        i += 1
        if opt == "--":
            break
        if opt.startswith("--"):
            if opt in ("--eval", "--print"):
                code = True
                i += 1
            elif opt in ("--require", "--import", "--rcfile", "--init-file"):
                i += 1
            continue
        letters = opt[1:]
        shell = name in ("bash", "sh")
        if shell:
            if "c" in letters:
                c_flag = True
            if "n" in letters:
                syntax = True
            if "o" in letters or "O" in letters:
                i += 1  # -o NAME and -O NAME take an argument (-euo pipefail)
        elif name in ("python3", "python"):
            if "c" in letters:
                code = True
                i += 1
            elif "m" in letters:
                mod = True
                i += 1
            elif "W" in letters or "X" in letters:
                i += 1
        else:  # node
            if letters in ("e", "p"):
                code = True
                i += 1
            elif letters == "r":
                i += 1
    if syntax:
        return ("syntax", None, n)
    if c_flag:
        if i < n:
            return ("payload", words[i], n)
        return ("opaque", "%s -c with no command" % name, n)
    if code or mod:
        return ("opaque", "%s with -c, -e or -m" % name, n)
    return ("go", None, i)


def resolve(words):
    """-> (kind, value): prog, tool, none, payload (value is shell text),
    opaque (an interpreter form whose program cannot be determined) or
    other (an ordinary command; value is its command word)."""
    i, n = 0, len(words)
    while i < n:
        w = words[i]
        if "${{" in w and not ASSIGN_RE.match(w):
            raise ParseError("a command word is built from an expression: %r (the checker cannot know what runs; failing closed)" % w)
        if w == "timeout":
            i += 1
            while i < n and (words[i].startswith("-") or re.match(r"^[0-9.]+[smhd]?$", words[i])):
                i += 1
            continue
        if w == "env":
            i += 1
            while i < n and words[i].startswith("-"):
                i += 2 if words[i] in ("-u", "-C", "-S") else 1
            continue
        if w in SKIP or ASSIGN_RE.match(w):
            i += 1
            continue
        if w in INTERP:
            kind, val, i = interpreter(words, i + 1, w)
            if kind == "syntax":
                return ("none", None)
            if kind != "go":
                return (kind, val)
            continue
        if w == "go" and i + 1 < n:
            if words[i + 1] == "run":
                j = i + 2
                while j < n and words[j].startswith("-"):
                    j += 1
                if j < n and re.match(r"^\./cmd/[A-Za-z0-9_-]+$", words[j]):
                    return ("prog", words[j])
                return ("none", None)
            if (w, words[i + 1]) in KNOWN_TOOLS:
                return ("tool", (w, words[i + 1]))
            return ("none", None)
        w = clean(w)
        if PROG_RE.match(w):
            return ("prog", w)
        return ("other", w)
    return ("none", None)


def scan(text, strict=False, echo_payload=False, in_payload=False):
    """Programs invoked in shell text, and glob patterns from for-in lines."""
    progs, globs = [], []
    for words in commands(text):
        for w in words:
            if "${{" in w and re.search(r"(?:scripts|\./cmd)/\S*\$\{\{", w):
                raise ParseError("a script path is built from an expression: %r (failing closed)" % w)
        if words[0] == "for" and len(words) > 3 and words[2] == "in":
            globs += [w for w in words[3:] if GLOB_RE.match(w)]
            continue
        if echo_payload and words[0] == "echo" and len(words) > 1:
            p, g = scan(words[1], strict=False, echo_payload=False)
            progs += p
            globs += g
            continue
        kind, val = resolve(words)
        if kind == "prog":
            progs.append(val)
        elif kind == "payload":
            if re.match(r"^\$", val.strip()):
                raise ParseError("an interpreter runs a command taken from a variable: `%s` (failing closed)" % " ".join(words))
            p, g = scan(val, strict=strict, in_payload=True)
            progs += p
            globs += g
        elif kind == "opaque":
            if any(repo_like(w) for w in words):
                raise ParseError("cannot determine the program of `%s` and it names a repo path (failing closed)" % " ".join(words))
        elif kind == "other":
            if repo_like(val) and not val.startswith("$RUNNER_TEMP"):
                raise ParseError("a repo path in command position that is not a recognised program form: `%s` (failing closed)" % val)
            if (strict or in_payload) and (words[0] == "run" or in_payload) and val.startswith("$"):
                raise ParseError("not understood: `%s` (the command is a variable; failing closed)" % " ".join(words))
            if strict and words[0] == "run":
                raise ParseError("not understood: `%s` (a `run` line must name a program or go test, list, vet or build; failing closed)" % " ".join(words))
    return progs, globs


# ------------------------------------------------------------------ workflow
def indent_of(line):
    return len(line) - len(line.lstrip(" "))


def parse_workflow(text):
    """-> job ids, [(job, step label, run text)], [(job, step label, local action)], job ids with uses and no steps."""
    if "\t" in text:
        raise ParseError("workflow contains a tab")
    lines = text.split("\n")
    n = len(lines)
    i = 0
    while i < n and lines[i].rstrip() != "jobs:":
        i += 1
    if i >= n:
        raise ParseError("no top-level 'jobs:' line")
    i += 1
    jobs, runs, locals_, has_steps, has_uses = [], [], [], set(), set()
    cur = None
    in_steps = False
    step_name = None
    step_idx = 0
    while i < n:
        line = lines[i]
        s = line.strip()
        if s == "" or s.startswith("#"):
            i += 1
            continue
        ind = indent_of(line)
        if ind == 0:
            break
        if ind == 2:
            m = re.match(r"^  ([A-Za-z0-9_-]+):\s*(#.*)?$", line)
            if not m:
                raise ParseError("line %d: cannot read job header: %r" % (i + 1, line))
            cur = m.group(1)
            jobs.append(cur)
            in_steps = False
            i += 1
            continue
        if cur is None:
            raise ParseError("line %d: content before the first job" % (i + 1))
        if ind == 4:
            in_steps = re.match(r"^    steps:\s*(#.*)?$", line) is not None
            if in_steps:
                has_steps.add(cur)
                j = i + 1
                while j < n and (lines[j].strip() == "" or lines[j].strip().startswith("#")):
                    j += 1
                if j >= n or not lines[j].startswith("      - "):
                    raise ParseError("line %d: steps not in the 6-space list form" % (i + 1))
                step_idx = 0
                step_name = None
            elif re.match(r"^    uses:", line):
                has_uses.add(cur)
            i += 1
            continue
        if not in_steps:
            i += 1
            continue
        if ind < 6:
            raise ParseError("line %d: unexpected indent inside steps" % (i + 1))
        item = line.startswith("      - ")
        if item:
            step_idx += 1
            step_name = None
            body = line[8:]
        elif ind == 8:
            body = line[8:]
        else:
            i += 1
            continue
        m = re.match(r"^([A-Za-z_-]+):\s*(.*)$", body)
        if not m:
            i += 1
            continue
        key, val = m.group(1), m.group(2)
        label = step_name or "step %d" % step_idx
        if key == "name":
            step_name = val.strip().strip("'\"")
        elif key == "uses":
            u = re.sub(r"\s+#.*$", "", val).strip().strip("'\"")
            if u.startswith("./") or u.startswith("."):
                locals_.append((cur, label, u))
        elif key == "run":
            if re.match(r"^[|>][+-]?\s*(#.*)?$", val):
                j = i + 1
                block = []
                while j < n and (lines[j].strip() == "" or indent_of(lines[j]) > 8):
                    block.append(lines[j])
                    j += 1
                runs.append((cur, label, "\n".join(block)))
                i = j
                continue
            if val == "" or val[0] in "\"'[{&*!%@`":
                raise ParseError("line %d: run value form not understood: %r" % (i + 1, val))
            runs.append((cur, label, re.sub(r"\s+#.*$", "", val)))
        i += 1
    if not jobs:
        raise ParseError("no jobs found")
    if not runs:
        raise ParseError("no run steps found")
    return jobs, runs, locals_, sorted(has_uses - has_steps), sorted(set(jobs) - has_steps - has_uses)


def parse_exemptions(text):
    ex, errs = {}, []
    ex_land = {}
    for no, raw in enumerate(text.split("\n"), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        if line.split(None, 1)[0] == "land-conditional":
            lp = line.split(None, 2)
            if len(lp) < 3 or len(lp[2].strip()) < 10:
                errs.append("exemptions line %d: land-conditional %s needs the condition (10+ characters)" % (no, lp[1] if len(lp) > 1 else "?"))
            else:
                ex_land[lp[1]] = lp[2]
            continue
        parts = line.split(None, 1)
        if len(parts) < 2 or len(parts[1].strip()) < 10:
            errs.append("exemptions line %d: %s has no reason (10+ characters)" % (no, parts[0]))
            continue
        ex[parts[0]] = parts[1]
    return ex, ex_land, errs


def normalise(path, root):
    if path.startswith("./"):
        return path
    if not os.path.exists(os.path.join(root, path)) and os.path.exists(os.path.join(root, "frontend", path)):
        return "frontend/" + path  # a step that cd'd into frontend/
    return path


def candidates(root):
    out = []
    for d, pat in (("scripts", ("check-*", "selftest-*", "test-*")), (".github/scripts", ("*-test",))):
        full = os.path.join(root, d)
        if not os.path.isdir(full):
            continue
        for name in sorted(os.listdir(full)):
            p = os.path.join(full, name)
            if os.path.isfile(p) and os.access(p, os.X_OK) and any(fnmatch.fnmatch(name, g) for g in pat):
                out.append(d + "/" + name)
    return out


def main():
    root = os.path.abspath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
    ap = argparse.ArgumentParser()
    ap.add_argument("--workflow", default=os.path.join(root, ".github/workflows/ci.yml"))
    ap.add_argument("--gates", default=os.path.join(root, "scripts/gates"))
    # The land script's path is built from parts on purpose. CI runs this check
    # with --ci and does not read the land script: CI's verdict must not depend
    # on a file whose edits do not trigger CI. The path is not spelled whole
    # because .github/scripts/ci-impact-classify-test traces script names
    # textually, and its case nix-docs-and-dev-scripts-do-not-select-it keeps the
    # land script a developer script. The local run (no flag, from scripts/gates)
    # opens it and verifies the land-conditional lines against it.
    ap.add_argument("--land", default=os.path.join(root, "scripts", "land"))
    ap.add_argument("--ci", action="store_true", help="do not open the land script; its land-conditional lines in the exemption file say what it runs")
    ap.add_argument("--exemptions", default=os.path.join(root, "scripts/gates-ci-exemptions.txt"))
    ap.add_argument("--root", default=root)
    a = ap.parse_args()
    try:
        wf = open(a.workflow).read()
        gates_text = open(a.gates).read()
        land_text = "" if a.ci else open(a.land).read()
        ex_text = open(a.exemptions).read()
    except OSError as e:
        print("check-gates-cover-ci: FAIL: cannot read %s" % e, file=sys.stderr)
        return 1
    errs = []
    try:
        jobs, runs, local_actions, reusable, stepless = parse_workflow(wf)
    except ParseError as e:
        print("check-gates-cover-ci: FAIL: cannot parse the workflow (failing closed): %s" % e, file=sys.stderr)
        return 1
    exempt, exempt_land, e2 = parse_exemptions(ex_text)
    errs += e2
    covering, globs, by_file = set(), [], {}
    for label, text, strict, echo in (("scripts/gates", gates_text, True, False), ("the land script", land_text, False, True)):
        try:
            p, g = scan(text, strict=strict, echo_payload=echo)
            by_file[label] = ({normalise(x, a.root) for x in p}, set(g))
        except ParseError as e:
            print("check-gates-cover-ci: FAIL: cannot read %s (failing closed): %s" % (label, e), file=sys.stderr)
            return 1
        covering |= {normalise(x, a.root) for x in p}
        globs += g
    if a.ci:
        for key in exempt_land:
            if "*" in key or "?" in key:
                globs.append(key)
            else:
                covering.add(normalise(key, a.root))

    gates_progs = by_file["scripts/gates"][0]
    land_items = (by_file["the land script"][0] | by_file["the land script"][1]) - gates_progs
    for item in sorted([] if a.ci else land_items):
        if item not in exempt_land:
            errs.append("%s is run only by the land script, and only under a condition: add `land-conditional %s <the condition, read from the land script>` to scripts/gates-ci-exemptions.txt (conditional in the land script)" % (item, item))
    for key in sorted(exempt_land):
        if key in gates_progs:
            errs.append("land-conditional %s: scripts/gates runs it (delete the exemption)" % key)
        elif not a.ci and key not in land_items:
            errs.append("land-conditional %s: stale (the land script does not run it)" % key)

    def covered(p):
        return p in covering or any(fnmatch.fnmatch(p, g) for g in globs)

    needed = {}
    for job, step, text in runs:
        try:
            progs, _ = scan(text)
        except ParseError as e:
            print("check-gates-cover-ci: FAIL: job %s, step \"%s\": cannot read the run text (failing closed): %s" % (job, step, e), file=sys.stderr)
            return 1
        for p in progs:
            needed.setdefault(normalise(p, a.root), (job, step))
    for job in reusable:
        needed.setdefault("job:" + job, (job, "uses a reusable workflow, the checker cannot see its steps"))
    for job in stepless:
        errs.append("job %s has neither steps nor uses (failing closed: the checker cannot know what it runs)" % job)
    for job, step, u in local_actions:
        needed.setdefault(u, (job, "local action %s, the checker cannot see its steps" % u))
    orphans = [c for c in candidates(a.root)]
    for p, (job, step) in sorted(needed.items()):
        if p.startswith("job:") or p.startswith("./.github/actions"):
            if p not in exempt:
                errs.append("job %s, step \"%s\": %s (a reusable workflow or local action) is not in scripts/gates-ci-exemptions.txt" % (job, step, p))
        elif covered(p) and p in exempt:
            errs.append("%s: exempted, but scripts/gates or the land script runs it (delete the exemption)" % p)
        elif not covered(p) and p not in exempt:
            errs.append("job %s, step \"%s\": %s is run by CI but not by scripts/gates or the land script, and is not in scripts/gates-ci-exemptions.txt" % (job, step, p))
    for c in orphans:
        if c in needed or covered(c):
            continue
        if c not in exempt:
            errs.append("%s is not run by CI, scripts/gates or the land script, and is not in scripts/gates-ci-exemptions.txt (an orphan guard)" % c)
        # an exempt orphan is checked below
    for p in sorted(exempt):
        if p in needed or p in orphans:
            if p not in needed and covered(p):
                errs.append("%s: exempted, but scripts/gates or the land script runs it (delete the exemption)" % p)
            continue
        errs.append("%s: stale exemption (no CI job runs it and it is not an existing orphan check; delete it)" % p)
    if errs:
        for e in errs:
            print("check-gates-cover-ci: FAIL: " + e, file=sys.stderr)
        return 1
    print("check-gates-cover-ci: ok (%d jobs, %d programs, %d exempt)" % (len(jobs), len(needed), len(exempt)))
    for key in sorted(exempt_land):
        print("  conditional in the land script: %s: %s" % (key, exempt_land[key]))
    return 0


if __name__ == "__main__":
    sys.exit(main())
