#!/usr/bin/env bash
# scripts/land [--dry-run] [--no-push] [--local] <branch-or-sha>...
#
# Makes landing mechanical (docs/design/sdlc-audit-2026-11-10.md items 1 and 2):
# cherry-pick the named lanes in order onto fresh origin/main (a train), compute
# the test set from the import graph, run build + vet + gates + the whole suites
# uncached on the build VM, then push the train to main.
#
# Steps: 1 guards  2 train  3 plan (packages + why)  4 local build/vet/gates/nix
#        5 suites (VM by default, --local here)  6 fail loud, push nothing
#        7 fetch again, rebase if main moved (rerun once if it touched a tested
#          package or its dependencies), push, report Ring-Expedite status.
#        Step 4 also compiles the iPhone app in the build tree when the train touches
#        app-side Swift or what it compiles against (scripts/check-app-compiles), and runs
#        the phone-app shared-code tests as CI does (scripts/check-shared-code-tests).
#
# A conflict only in docs/changes.md or the calibration ledger (every lane adds
# at the top) keeps both sides; any other conflict stops. A changed agentcore or
# textureowner runs its race suite in LAND_RACE_SHARDS shards side by side
# (default 4; 1 keeps one process). Several lanes given to one run are one train:
# one verify, one push. To land lanes that may not all be good (it finds the bad
# one and lands the rest in as few pushes as it can), use scripts/land-queue.
#
# Why a run ended, for a caller that splits a train (scripts/land-queue): the
# result is written to the file named by LAND_RESULT_FILE (and printed as a line
# "land-result: <kind> ..." for people; output is never the source, since a build
# or a test can print any line). The first line is one of landed sha=<sha>,
# conflict lane=<lane> (a cherry-pick conflict, the only failure that names a
# lane), failed step=<step> (build, go vet, gates, nix eval, suites),
# bad-lane lane=<lane> (does not resolve), empty-train, main-moved (origin/main
# moved and the rebase or the push could not take it), refused reason=<why> (a guard
# stopped it before any lane was tried: usage, primary, dirty, lock, fetch, checkout,
# vm, vm-lost), pushing head=<sha> (written, with its skipped lane=<lane> lines,
# just before git push and replaced by landed after it: a run that dies in between leaves this, and the caller asks
# origin/main whether the sha arrived). Exit codes are unchanged:
# 1 for all of those, 3 and 4 for the VM, 6 from the after-verify hook.
#
# Hidden modes (used by scripts/land.test.sh): --select <from-ref> prints the
# test plan for the diff <from-ref>..HEAD of the current tree and exits;
# --print-runner prints the VM runner for the train and exits.
#
# Environment: LAND_VM (ssh host, default choir-agents), LAND_VM_MIRROR (a bare
# repository on the VM that is its checkout's origin; set it for a VM with no
# GitHub login, such as choir-runner with go-choir-mirror.git, and the lane
# ref is pushed there over ssh as well), LAND_PRIMARY (checkout
# to refuse), LAND_GATES (gate command, default scripts/gates), LAND_POLL
# (seconds between polls, 20), LAND_POLL_FAILS (consecutive failed polls
# tolerated, 90), LAND_PG_BIN (a directory on the VM, put first on the suites'
# PATH so dbxtest's initdb and pg_ctl come from it: a copy of the system
# PostgreSQL with pgvector added, for the vector tests; the VM's own
# PostgreSQL is not touched), LAND_HOOK_AFTER_VERIFY (shell text run after the checks pass
# and before the final fetch; the selftest uses it to move main).
#
# After a successful push the script prints, for each lane whose every commit went into
# the train, the command that removes it (the lane tool compares commits and a cherry-pick
# has other hashes, so "lane rm" alone refuses a landed lane), and for a lane that was
# skipped or only partly picked a line saying not to remove it. It never removes anything.
#
# The script never adds, edits or invents a commit trailer.
set -uo pipefail

# Run from a staged copy: checking out origin/main replaces this very file (and
# scripts/gates) in the worktree, and bash reads a running script lazily.
if [ -z "${LAND_STAGE_DIR:-}" ]; then
  stage=$(mktemp -d "${TMPDIR:-/tmp}/land-stage.XXXXXX") || exit 1
  echo $$ >"$stage/.stage-owner" || exit 1
  src=$(cd "$(dirname "$0")" && pwd -P)
  cp "$src/land" "$stage/land" && { cp "$src/gates" "$stage/gates" 2>/dev/null || true; cp "$src/check-app-compiles" "$stage/check-app-compiles" 2>/dev/null || true; cp "$src/check-shared-code-tests" "$stage/check-shared-code-tests" 2>/dev/null || true; }
  cp "$src/land-timing.sh" "$stage/land-timing.sh" 2>/dev/null || true
  LAND_STAGE_DIR=$stage exec bash "$stage/land" "$@"
fi
# A LAND_STAGE_DIR the caller set is not trusted: it must be a stage this script made
# (a marker with a live creator pid, and the directory this file lives in).
_opid=$(cat "$LAND_STAGE_DIR/.stage-owner" 2>/dev/null)
if [ -z "$_opid" ] || ! kill -0 "$_opid" 2>/dev/null \
   || [ "$(cd "$LAND_STAGE_DIR" 2>/dev/null && pwd -P)" != "$(cd "$(dirname "$0")" && pwd -P)" ]; then
  echo "land: LAND_STAGE_DIR=$LAND_STAGE_DIR is not a stage directory this script made; refusing to run (nothing removed)" >&2
  exit 2
fi
SELF_DIR=$LAND_STAGE_DIR
# The result of this run for scripts/land-queue: a line printed for people, and the
# same line written to the file named by LAND_RESULT_FILE. The variable is unset
# at once, so no build, gate, test or hook this script runs can see the path; the
# queue reads only the file, never the output.
RESULT_FILE=${LAND_RESULT_FILE:-}; unset LAND_RESULT_FILE
SKIPPED_LANES=""
result() {
  echo "land-result: $*"
  [ -z "$RESULT_FILE" ] || printf '%s\n' "$*" >"$RESULT_FILE" 2>/dev/null || true
  return 0
}
LAND_LOCK=""  # set once this run holds the tree's lock (guards, below)
# Step timings (scripts/land-timing.sh, staged beside this file). They only observe:
# without the helper file they are no-ops, and nothing they do can fail a landing.
if [ -f "$SELF_DIR/land-timing.sh" ]; then . "$SELF_DIR/land-timing.sh"; else
  lt_init() { :; }; lt_step() { :; }; lt_set_head() { :; }; lt_set_lanes() { :; }; lt_off() { :; }; lt_finish() { :; }
  lt_suite_name() { printf 'suite'; }
fi
# The gates (a child process) append their own "gates" line to the log this run's "land"
# line goes to, whatever its HOME or its copy of the helper.
if command -v lt_log_path >/dev/null 2>&1; then LAND_TIMING_LOG=$(lt_log_path); export LAND_TIMING_LOG; fi
land_exit() {
  local rc=$?
  lt_finish "$rc" || true
  rm -rf "$LAND_STAGE_DIR"; [ -z "$LAND_LOCK" ] || rm -rf "$LAND_LOCK"
}
trap land_exit EXIT
VM=${LAND_VM:-choir-agents}
PRIMARY=${LAND_PRIMARY:-/Users/wiz/Dev/go-choir}
POLL=${LAND_POLL:-20}
POLL_FAILS=${LAND_POLL_FAILS:-90}
HEAVY="internal/agentcore internal/textureowner internal/store"

die() { echo "land: $*" >&2; exit 1; }
say() { echo "land: $*"; }

# select_packages <from-ref> [to-ref]: print the test plan for the diff <from>..<to>
# (to defaults to HEAD; the import graph is always the current tree's).
# Lines: "NOTE\t<text>" or "PKG\t<./rel>\t<changed|test|importer|testimporter>\t<why>".
# A package is selected when it has a changed non-test file ("changed"), only
# changed _test.go/testdata files ("test": its importers are NOT selected), imports
# a changed package transitively ("importer"), or its tests import a package that
# depends on a change ("testimporter"). The graph is the union of linux/amd64 and
# darwin/arm64 so build-tagged files and imports of either count.
select_packages() {
  local from=$1 to=${2:-HEAD} mod files graph out
  mod=$(go list -m 2>/dev/null) || { echo "land: go list -m failed" >&2; return 2; }
  files=$(git diff --name-only --no-renames "$from" "$to") || return 2
  if [ -z "$files" ]; then printf 'NOTE\tno files changed\n'; return 0; fi
  if ! printf '%s\n' "$files" | grep -qvE '^docs/|\.md$'; then
    printf 'NOTE\tdocs-only change: no tests, docs landing\n'; return 0
  fi
  graph=$(mktemp "${TMPDIR:-/tmp}/land-graph.XXXXXX") || return 2
  GOOS=linux GOARCH=amd64 go list -e -f '{{.ImportPath}}|{{join .Imports " "}}|{{join .TestImports " "}} {{join .XTestImports " "}}' ./... >"$graph" 2>/dev/null
  GOOS=darwin GOARCH=arm64 go list -e -f '{{.ImportPath}}|{{join .Imports " "}}|{{join .TestImports " "}} {{join .XTestImports " "}}' ./... >>"$graph" 2>/dev/null
  out=$(printf '%s\n' "$files" | awk -v mod="$mod" -v graph="$graph" '
    function dirname(p) { if (!sub(/\/[^\/]*$/, "", p)) return "."; return p }
    function rel(ip) { return ip == mod ? "." : substr(ip, length(mod) + 2) }
    BEGIN {
      while ((getline line < graph) > 0) {
        split(line, f, "|"); id = f[1]; if (id == "") continue
        if (!(id in P)) { P[id] = 1; order[++np] = id }
        imp[id] = imp[id] " " f[2]; tst[id] = tst[id] " " f[3]
        dirpkg[rel(id)] = id
      }
    }
    {
      file = $0
      if (file ~ /^(go\.mod|go\.sum|go\.work|go\.work\.sum)$/) { allflag = 1; next }
      d = dirname(file)
      if (file ~ /\.go$/ && file !~ /(^|\/)testdata\// && !(d in dirpkg)) {
        print "NOTE\tno Go package at " d " on linux/darwin (deleted, or every file build-tagged out): " file
        next
      }
      while (!(d in dirpkg)) { if (d == ".") break; d = dirname(d) }
      if (!(d in dirpkg)) next
      p = dirpkg[d]
      if (file ~ /_test\.go$/ || file ~ /(^|\/)testdata\//) { if (!(p in code)) tonly[p] = 1 }
      else { code[p] = 1; delete tonly[p] }
    }
    END {
      if (allflag) for (i = 1; i <= np; i++) { code[order[i]] = 1; reason[order[i]] = "go.mod/go.sum changed" }
      for (p in code) { inN[p] = 1; root[p] = p; if (!(p in reason)) reason[p] = "changed" }
      do {
        ch = 0
        for (i = 1; i <= np; i++) { p = order[i]; if (inN[p]) continue
          n = split(imp[p], a, " ")
          for (j = 1; j <= n; j++) if (a[j] != p && inN[a[j]]) { inN[p] = 1; root[p] = root[a[j]]; via[p] = a[j]; ch = 1; break } }
      } while (ch)
      for (i = 1; i <= np; i++) { p = order[i]
        if (p in code) printf "PKG\t./%s\tchanged\t%s\n", rel(p), reason[p]
        else if (inN[p]) printf "PKG\t./%s\timporter\timports ./%s (./%s changed)\n", rel(p), rel(via[p]), rel(root[p])
        else {
          n = split(tst[p], a, " "); hit = ""
          for (j = 1; j <= n; j++) if (a[j] != p && inN[a[j]]) { hit = a[j]; break }
          if (hit != "") printf "PKG\t./%s\ttestimporter\ttests import ./%s (./%s changed)\n", rel(p), rel(hit), rel(root[hit])
          else if (p in tonly) printf "PKG\t./%s\ttest\ttest files changed (importers unaffected)\n", rel(p)
        } }
    }' | sort)
  rm -f "$graph"
  printf '%s\n' "$out"
}

if [ "${1:-}" = "--select" ]; then
  select_packages "${2:?usage: land --select <from-ref> [to-ref]}" "${3:-HEAD}"; exit $?
fi

# ---------------------------------------------------------------- arguments
DRY=0; NOPUSH=0; LOCAL=0; PRINT_RUNNER=0; LANES=()
for a in "$@"; do
  case "$a" in
    --dry-run) DRY=1 ;;
    --no-push) NOPUSH=1 ;;
    --local) LOCAL=1 ;;
    --print-runner) PRINT_RUNNER=1 ;;  # hidden (scripts/land.test.sh): print the VM runner for the train and exit
    -h|--help) sed -n 2,5p "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    -*) result "refused reason=usage"; die "unknown flag $a (usage: scripts/land [--dry-run] [--no-push] [--local] <branch-or-sha>...)" ;;
    *) LANES+=("$a") ;;
  esac
done
[ "${#LANES[@]}" -gt 0 ] || { result "refused reason=usage"; die "usage: scripts/land [--dry-run] [--no-push] [--local] <branch-or-sha>..."; }

lt_init land "$(IFS=,; echo "${LANES[*]}")"; lt_step guards
# ------------------------------------------------------------ 1. guards
top=$(git rev-parse --show-toplevel 2>/dev/null) || { result "refused reason=notrepo"; die "not in a git checkout"; }
cd "$top" || exit 1
gd=$(cd "$(git rev-parse --git-dir)" && pwd -P); cgd=$(cd "$(git rev-parse --git-common-dir)" && pwd -P)
[ "$gd" != "$cgd" ] || { result "refused reason=primary"; die "refusing to run in a primary checkout ($top); use a worktree"; }
[ "$(pwd -P)" != "$(cd "$PRIMARY" 2>/dev/null && pwd -P)" ] || { result "refused reason=primary"; die "refusing to run in the primary checkout $PRIMARY"; }
[ -z "$(git status --porcelain --untracked-files=normal)" ] || { result "refused reason=dirty"; die "dirty tree; commit or remove: $(git status --short | head -5 | tr '\n' ' ')"; }
ORIG=$(git symbolic-ref -q --short HEAD || git rev-parse HEAD)
# One landing per tree. A run identifies its train by this tree's HEAD, so a second
# run here (or one left waiting in LAND_HOOK_AFTER_VERIFY) can push the other's
# commits before their suites ran: docs/problems/two-landings-in-one-tree-pushed-an-unverified-train-2026-11-19.md.
lockdir="$gd/land.lock"
if ! mkdir "$lockdir" 2>/dev/null; then
  opid=$(cat "$lockdir/pid" 2>/dev/null || true)
  if [ -n "$opid" ] && kill -0 "$opid" 2>/dev/null; then
    result "refused reason=lock"; die "another scripts/land (pid $opid) holds this tree ($top); one landing per tree. It may be waiting in LAND_HOOK_AFTER_VERIFY. Stop that pid, or use another worktree."
  fi
  say "removing the lock of a landing that is gone (pid ${opid:-unknown})"
  rm -rf "$lockdir"; mkdir "$lockdir" || { result "refused reason=lock"; die "cannot take the lock $lockdir"; }
fi
echo $$ > "$lockdir/pid"; LAND_LOCK=$lockdir
# Default: the gates beside this script, so a train based on a main that lacks them still runs them.
GATES=${LAND_GATES:-$SELF_DIR/gates}

restore() { git cherry-pick --abort >/dev/null 2>&1; git rebase --abort >/dev/null 2>&1; git checkout -q "$ORIG" 2>/dev/null; }
fail_step() { # name file
  result "failed step=${1%% (*}"
  echo; echo "land: FAILED at $1; nothing pushed to main. HEAD stays at the train for inspection."
  [ -n "${2:-}" ] && { echo "--- last 40 lines ($2)"; tail -n 40 "$2"; }
  exit 1
}

lt_step fetch
say "fetching origin"
git fetch -q origin main "+refs/heads/lane/*:refs/remotes/origin/lane/*" 2>/dev/null || git fetch -q origin main || { result "refused reason=fetch"; die "git fetch origin failed (stale origin would mislead the plan)"; }
BASE=$(git rev-parse origin/main) || { result "refused reason=fetch"; die "no origin/main"; }

# ------------------------------------------------------------ 2. the train
# Every lane adds its entry at the top of the change log and its row to the
# ledger, so two lanes in a row conflict there and nowhere else. union_docs
# resolves a cherry-pick whose only conflicts are in those two append-only files
# by keeping both sides (ours, then theirs) and continues; any other conflict
# returns 1 and the caller stops.
UNION_DOCS="docs/changes.md docs/calibration/claude-ledger.md"
union_docs() {
  local f u
  u=$(git diff --name-only --diff-filter=U)
  [ -n "$u" ] || return 1
  for f in $u; do case " $UNION_DOCS " in *" $f "*) ;; *) return 1 ;; esac; done
  for f in $u; do
    awk '/^<<<<<<< /{s=1;next} s==1&&/^\|\|\|\|\|\|\| /{s=3;next} (s==1||s==3)&&/^=======$/{if(last!="")print "";s=2;next} s==2&&/^>>>>>>> /{s=0;next} s==3{next} {print;last=$0}' "$f" >"$f.union" && mv "$f.union" "$f" || return 1
    grep -qE '^(<<<<<<<|>>>>>>>) ' "$f" && return 1
    git add "$f" || return 1
  done
  GIT_EDITOR=true git -c core.editor=true cherry-pick --continue >/dev/null 2>&1 || return 1
  say "lane $lane: kept both sides of a conflict in $(printf '%s ' $u)"
}
lt_step train
git checkout -q --detach "$BASE" || { result "refused reason=checkout"; die "cannot check out origin/main"; }
TRAIN_LANES=(); TRAIN_WHOLE=(); skipped=0
for lane in "${LANES[@]}"; do
  sha=$(git rev-parse --verify -q "$lane^{commit}" || git rev-parse --verify -q "origin/$lane^{commit}") || { restore; result "bad-lane lane=$lane"; die "lane '$lane' does not resolve to a commit"; }
  commits=$(git rev-list --reverse --no-merges --right-only --cherry-pick "$BASE...$sha")
  # whole: every non-merge commit of the lane is one this train picks (none already on main) and it has no merge commits
  allc=$(git rev-list --no-merges "$BASE..$sha" | wc -l | tr -d ' '); mrg=$(git rev-list --merges "$BASE..$sha" | wc -l | tr -d ' ')
  if [ -z "$commits" ]; then say "lane $lane ($(git rev-parse --short "$sha")): nothing to land (already on main or empty); skipped"; skipped=$((skipped+1)); SKIPPED_LANES="$SKIPPED_LANES $lane"; continue; fi
  n=$(printf '%s\n' "$commits" | wc -l | tr -d ' ')
  say "lane $lane: cherry-picking $n commit(s)"
  for c in $commits; do
    if ! git cherry-pick --empty=drop "$c" >/dev/null 2>&1 && ! union_docs; then
      files=$(git diff --name-only --diff-filter=U | tr '\n' ' ')
      git cherry-pick --abort >/dev/null 2>&1; restore
      result "conflict lane=$lane"
      die "CONFLICT in lane '$lane' at $(git log -1 --format='%h %s' "$c"): $files(rebase that lane onto origin/main and retry)"
    fi
  done
  TRAIN_LANES+=("$lane")
  if [ "$allc" = "$n" ] && [ "$mrg" = 0 ]; then TRAIN_WHOLE+=(1); else TRAIN_WHOLE+=(0); fi
done
[ "$(git rev-list --count "$BASE..HEAD")" -gt 0 ] || { restore; result "empty-train"; die "empty train: no lane has commits that are not already on origin/main"; }

lt_set_lanes "$(IFS=,; echo "${TRAIN_LANES[*]}")"; lt_set_head "$(git rev-parse HEAD 2>/dev/null)"
lt_step plan
# ------------------------------------------------------------ 3. the plan
PKGS_CHANGED=""; PKGS_ALL=""; SEL=""; NOTES=""
make_plan() { # $1 = base
  local files
  SEL=$(select_packages "$1") || fail_step "package selection"
  NOTES=$(printf '%s\n' "$SEL" | awk -F'\t' '$1=="NOTE"{print $2}')
  PKGS_ALL=$(printf '%s\n' "$SEL" | awk -F'\t' '$1=="PKG"{print $2}' | tr '\n' ' ')
  PKGS_CHANGED=$(printf '%s\n' "$SEL" | awk -F'\t' '$1=="PKG" && ($3=="changed"||$3=="test"){print $2}' | tr '\n' ' ')
  files=$(git diff --name-only --no-renames "$1" HEAD)
  NIX=0; FE=0; GH=0; DOCS=0; APP=0; SCT=0
  # app-side Swift, or what the app compiles against, changed: the app is compiled in the build tree (verify, below)
  python3 -I "$SELF_DIR/check-app-compiles" --needed --changed-from "$1" >/dev/null 2>&1 && APP=1
  # a path the shared-code tests read changed: they run as CI runs them (verify, below)
  python3 -I "$SELF_DIR/check-shared-code-tests" --needed --changed-from "$1" >/dev/null 2>&1 && SCT=1
  printf '%s\n' "$files" | grep -qE '^(nix/|flake\.)' && NIX=1
  printf '%s\n' "$files" | grep -q '^frontend/' && FE=1
  printf '%s\n' "$files" | grep -q '^\.github/' && GH=1
  printf '%s\n' "$files" | grep -qvE '^docs/|\.md$' || DOCS=1
}
print_plan() {
  echo "=== train onto origin/main $(git rev-parse --short "$BASE") ==="
  git log --reverse --format='  %h %s' "$BASE..HEAD" | cut -c1-150
  echo "=== test plan ==="
  [ -n "$NOTES" ] && printf '%s\n' "$NOTES" | sed 's/^/  note: /'
  if [ -n "$PKGS_ALL" ]; then
    printf '%s\n' "$SEL" | awk -F'\t' '$1=="PKG"{printf "  %-44s %-12s %s\n",$2,$3,$4}'
  elif [ "$DOCS" = 0 ]; then echo "  no Go packages selected"; fi
  [ "$DOCS" = 1 ] && echo "  docs only: no tests"
  [ "$NIX" = 1 ] && echo "  nix/flake changed: will nix eval both nixosConfigurations"
  [ "$FE" = 1 ] && echo "  frontend/ changed: will run the frontend build (pnpm install --frozen-lockfile && pnpm run build)"
  [ "$GH" = 1 ] && echo "  .github/ changed: will run .github/scripts/*-test"
  [ "$APP" = 1 ] && echo "  app-side Swift (or what it compiles against) changed: will compile the iPhone app in the build tree (about 10 min, under the Mac build lock; refused if that tree is dirty)"
  [ "$SCT" = 1 ] && echo "  the phone-app shared-code tests read a changed path: will run them as CI does (pinned Bun, no Exact checkout, scratch copy; several minutes)"
  if [ "$LOCAL" = 1 ]; then echo "  suites run: locally ($(pwd -P))"; else echo "  suites run: on $VM (ssh), -race only for changed packages"; fi
}
make_plan "$BASE"
print_plan
if [ "$DRY" = 1 ]; then lt_off; restore; echo "land: --dry-run: nothing run, nothing pushed, back on $ORIG"; exit 0; fi

# --------------------------------------------------- runner for step 5
is_heavy() { case " $HEAVY " in *" ${1#./} "*) return 0;; esac; return 1; }
write_runner() { # $1 = file
  local p L_PLAIN="" L_RACE="" H_PLAIN="" H_RACE="" SHARD=0
  for p in $PKGS_ALL; do
    if printf ' %s ' "$PKGS_CHANGED" | grep -q " $p "; then
      if is_heavy "$p"; then H_RACE="$H_RACE $p"; else L_RACE="$L_RACE $p"; fi
    else
      if is_heavy "$p"; then H_PLAIN="$H_PLAIN $p"; else L_PLAIN="$L_PLAIN $p"; fi
    fi
  done
  # agentcore + textureowner as importers only: shard the way CI does (2 shards in
  # parallel = at most 2 heavy packages at once). Not on --local (needs bash 4).
  # As in CI, the load-sensitive tests in scripts/go-test-scale-tests stay out of
  # the shards and run alone afterwards; half of agentcore per shard needs more
  # than go test's default 10 minutes, so the shards get 30.
  if [ "$LOCAL" = 0 ] && printf ' %s ' "$H_PLAIN" | grep -q ' ./internal/agentcore ' && printf ' %s ' "$H_PLAIN" | grep -q ' ./internal/textureowner '; then
    SHARD=1; H_PLAIN=$(printf ' %s ' "$H_PLAIN" | sed 's# ./internal/agentcore # #; s# ./internal/textureowner # #')
  fi
  cat >"$1" <<EOF
#!/usr/bin/env bash
# generated by scripts/land; last line of the output is "EXIT <code>"
cd "\$1" || exit 2
ulimit -n 65536 2>/dev/null || true
export GOMAXPROCS=\${GOMAXPROCS:-4}
# macOS sets TMPDIR with a trailing slash; a "//" in the path makes the files
# API tests refuse every request (seen 2026-11-10), so strip it.
T0=\${TMPDIR:-/tmp}; TD=\$(mktemp -d "\${T0%/}/land-XXXXXX"); export TMPDIR=\$TD
fin() { rc=\$?; rm -rf "\$TD"; echo "EXIT \$rc"; }
trap fin EXIT
run() { echo "## \$*"; "\$@"; rc=\$?; [ \$rc -eq 0 ] || { echo "STEP FAILED (\$rc): \$*"; exit \$rc; }; }
use=\$(df -P "\$HOME" 2>/dev/null | awk 'NR==2{gsub("%","",\$5);print \$5}'); [ "\${use:-0}" -gt 85 ] && go clean -cache
EOF
  # LAND_PG_BIN (a path on the VM; $HOME and ~ are expanded there) goes first on PATH.
  if [ -n "${LAND_PG_BIN:-}" ]; then
    case "$LAND_PG_BIN" in *[!A-Za-z0-9_./\$~-]*) die "LAND_PG_BIN has characters a path does not" ;; esac
    printf 'export PATH="%s:$PATH"\n' "${LAND_PG_BIN/#\~/\$HOME}" >>"$1"
  fi
  # The script self-tests take seconds; they run before the suites, so a gate that
  # refuses does so in the first minute and not after the 100-minute race suites
  # (seen 2026-11-15).
  [ "$GH" = 1 ] && echo 'for t in .github/scripts/*-test; do run timeout 300 bash "$t"; done' >>"$1"
  [ -n "$L_PLAIN" ] && echo "run go test -count=1 -timeout 30m -p=2$L_PLAIN" >>"$1"
  [ -n "$L_RACE" ] && echo "run go test -race -count=1 -timeout 30m -p=2$L_RACE" >>"$1"
  if [ "$SHARD" = 1 ]; then
    echo "run env QUARANTINE_FILE=scripts/go-test-scale-tests TOTAL_SHARDS=2 PARALLEL_SHARDS=1 scripts/go-test-runtime-shards -timeout 30m" >>"$1"
    echo 'run scripts/go-test-with-timing ./internal/agentcore -count=1 -timeout 15m -run "$(grep -v '"'"'^\s*$'"'"' scripts/go-test-scale-tests | grep -v '"'"'^#'"'"' | paste -sd'"'"'|'"'"')"' >>"$1"
  fi
  for p in $H_PLAIN; do echo "run go test -count=1 -timeout 90m -p=1 $p" >>"$1"; done
  # Changed agentcore/textureowner: the race run is dealt into RACE_SHARDS shards
  # run side by side, each with its share of the VM's cores (one process of
  # agentcore -race took 65 minutes on 4 of choir-runner's 8 cores, 2026-11-24).
  # The test binaries are built once first, so the shards' discovery does not
  # compile the same package RACE_SHARDS times. The load-sensitive tests stay out
  # of the shards and run alone afterwards, as in CI.
  local RT="" RS=${LAND_RACE_SHARDS:-4}
  case "$RS" in ''|*[!0-9]*|0) die "LAND_RACE_SHARDS must be a positive integer, got: $RS" ;; esac
  if [ "$LOCAL" = 0 ] && [ "$RS" -gt 1 ]; then
    for p in ./internal/agentcore ./internal/textureowner; do
      if printf ' %s ' "$H_RACE" | grep -q " $p "; then RT="$RT $p"; H_RACE=$(printf ' %s ' "$H_RACE" | sed "s# $p # #"); fi
    done
  fi
  if [ -n "$RT" ]; then
    for p in $RT; do echo "run go test -race -count=1 -c -o /dev/null $p" >>"$1"; done
    echo "run env SHARD_PACKAGES=\"${RT# }\" QUARANTINE_FILE=scripts/go-test-scale-tests TOTAL_SHARDS=$RS PARALLEL_SHARDS=1 GOMAXPROCS=\$(( \$(nproc) / $RS > 0 ? \$(nproc) / $RS : 1 )) scripts/go-test-runtime-shards -race -timeout 60m" >>"$1"
    if printf ' %s ' "$RT" | grep -q ' ./internal/agentcore '; then
      echo 'run scripts/go-test-with-timing ./internal/agentcore -race -count=1 -timeout 30m -run "$(grep -v '"'"'^\s*$'"'"' scripts/go-test-scale-tests | grep -v '"'"'^#'"'"' | paste -sd'"'"'|'"'"')"' >>"$1"
    fi
  fi
  for p in $H_RACE; do echo "run go test -race -count=1 -timeout 90m -p=1 $p" >>"$1"; done
  [ "$FE" = 1 ] && echo '(cd frontend && run pnpm install --frozen-lockfile && run pnpm run build) || exit $?' >>"$1"
  echo "exit 0" >>"$1"
}
have_work() { [ -n "$PKGS_ALL" ] || [ "$GH" = 1 ] || [ "$FE" = 1 ]; }
if [ "$PRINT_RUNNER" = 1 ]; then lt_off; LOCAL=0; write_runner /dev/stdout; restore; exit 0; fi

run_suites_remote() {
  local short sha runner R W out last prog fails=0 code
  lt_step "suites: vm preflight"
  sha=$(git rev-parse HEAD); short=$(git rev-parse --short=10 HEAD)
  R="\$HOME/mirror/land-$short.result"; W="\$HOME/mirror/land-$short"
  ssh -o ConnectTimeout=10 -o BatchMode=yes "$VM" true 2>/dev/null || {
    echo "land: build VM '$VM' unreachable. Fix ssh, or rerun with --local to run the suites on this machine (slower, no sharding)." >&2; result "refused reason=vm"; exit 4; }
  lt_step "suites: ship to vm"
  runner=$(mktemp "${TMPDIR:-/tmp}/land-runner.XXXXXX"); write_runner "$runner"
  say "pushing lane ref lane/land-$short and starting the run on $VM"
  git push -q -f origin "HEAD:refs/heads/lane/land-$short" || die "push of the lane ref failed"
  if [ -n "${LAND_VM_MIRROR:-}" ]; then
    git push -q -f --no-verify "$VM:$LAND_VM_MIRROR" "HEAD:refs/heads/lane/land-$short" || die "push of the lane ref to $VM:$LAND_VM_MIRROR failed"
  fi
  ssh -o BatchMode=yes "$VM" "mkdir -p ~/mirror && cd ~/go-choir && flock ~/mirror/.fetch.lock git fetch -q origin '+refs/heads/lane/land-$short:refs/remotes/origin/lane/land-$short' && git worktree remove --force $W 2>/dev/null; rm -rf $W; git worktree add -q --detach $W $sha" || die "could not prepare the worktree on $VM"
  ssh -o BatchMode=yes "$VM" "cat > ~/mirror/land-$short.run.sh" <"$runner" || die "could not ship the runner"
  rm -f "$runner"
  # Detached: a dropped ssh cannot kill it. The PID is ours, recorded here.
  out=$(ssh -o BatchMode=yes "$VM" "rm -f $R; nohup setsid bash ~/mirror/land-$short.run.sh $W >$R 2>&1 </dev/null & echo \$!") || die "could not start the run"
  pid=$out
  say "run started on $VM (pid $out); result file ~/mirror/land-$short.result"
  last=""
  lt_step "suites: vm start"
  while :; do
    if out=$(ssh -o ConnectTimeout=15 -o BatchMode=yes -o ServerAliveInterval=15 -o ServerAliveCountMax=3 "$VM" "echo C:\$(tail -n1 $R 2>/dev/null | sed -E 's/.*(EXIT [0-9]+)\$/\\1/'); echo A:\$(kill -0 $pid 2>/dev/null && echo 1 || echo 0); echo P:\$(grep '^## ' $R 2>/dev/null | tail -n1)") ; then
      fails=0
      code=$(printf '%s\n' "$out" | sed -n 's/^C://p'); prog=$(printf '%s\n' "$out" | sed -n 's/^P://p')
      alive=$(printf '%s\n' "$out" | sed -n 's/^A://p')
      case "$code" in "EXIT "*) code=${code#EXIT }; break ;; esac
      if [ "$alive" = 0 ]; then
        sleep 3   # the exit line may land just after the process ends
        if ssh -o ConnectTimeout=15 -o BatchMode=yes "$VM" "tail -n1 $R" 2>/dev/null | grep -q 'EXIT [0-9]'; then continue; fi
        echo "land: the run on $VM died without an EXIT line:" >&2; ssh -o BatchMode=yes "$VM" "tail -n 40 $R" >&2; exit 1
      fi
      # the suite is named when a poll first sees it, so a step's seconds are good to one poll (LAND_POLL)
      [ "$prog" != "$last" ] && { lt_step "$(lt_suite_name "$prog")"; say "$(date +%H:%M:%S) running: $prog"; last=$prog; }
    else
      fails=$((fails+1)); say "$(date +%H:%M:%S) ssh poll failed ($fails/$POLL_FAILS); the run on the VM is unaffected, retrying"
      if [ "$fails" -ge "$POLL_FAILS" ]; then
        echo "land: lost the VM for too long. The run may still finish: ssh $VM 'tail -n 40 ~/mirror/land-$short.result'. Nothing pushed to main." >&2; result "refused reason=vm-lost"; exit 3; fi
    fi
    sleep "$POLL"
  done
  lt_step "suites: fetch result"
  RESULT_TMP=$(mktemp "${TMPDIR:-/tmp}/land-result.XXXXXX")
  until ssh -o ConnectTimeout=15 -o BatchMode=yes "$VM" "cat $R" >"$RESULT_TMP" 2>/dev/null; do sleep "$POLL"; done
  return "$code"
}
run_suites_local() {
  local c runner; runner=$(mktemp "${TMPDIR:-/tmp}/land-runner.XXXXXX"); write_runner "$runner"
  RESULT_TMP=$(mktemp "${TMPDIR:-/tmp}/land-result.XXXXXX")
  bash "$runner" "$(pwd -P)" 2>&1 | tee "$RESULT_TMP" | grep --line-buffered '^## ' | sed 's/^/land: /'
  rm -f "$runner"
  c=$(tail -n1 "$RESULT_TMP" | awk '{print ($1=="EXIT")?$2:1}')
  return "${c:-1}"
}

# ---------------------------------------------- 4+5. verify (one attempt)
verify() { # $1 = run suites (1/0)
  local t out=/tmp/none
  out=$(mktemp "${TMPDIR:-/tmp}/land-step.XXXXXX")
  if [ "$DOCS" = 0 ]; then
    lt_step build; say "go build ./..."; go build ./... >"$out" 2>&1 || fail_step "go build ./..." "$out"
    if [ -n "$PKGS_CHANGED" ]; then
      lt_step vet; say "go vet (changed packages)"; go vet $PKGS_CHANGED >"$out" 2>&1 || fail_step "go vet" "$out"
    fi
  fi
  lt_step gates; say "gates ($GATES)"
  $GATES >"$out" 2>&1 || fail_step "gates (a missing reviewer trailer is reported by check-guest-security-epoch; land never adds one)" "$out"
  tail -n1 "$out"
  if [ "$NIX" = 1 ]; then
    if command -v nix >/dev/null 2>&1; then
      lt_step "nix eval"
      say "nix eval go-choir-autoputer-vm toplevel"
      nix eval --raw '.#nixosConfigurations.go-choir-autoputer-vm.config.system.build.toplevel.drvPath' >"$out" 2>&1 || fail_step "nix eval go-choir-autoputer-vm" "$out"
      say "nix eval go-choir-b gateway environment"
      nix eval '.#nixosConfigurations.go-choir-b.config.systemd.services.go-choir-gateway.serviceConfig.Environment' >"$out" 2>&1 || fail_step "nix eval go-choir-b" "$out"
    else say "WARNING: nix changed but nix is not installed here; evals SKIPPED (CI evaluates them)"; fi
  fi
  # The iPhone app is compiled only by the app build, in the one build tree (scripts/check-app-compiles;
  # docs/problems/main-broke-the-iphone-app-build-for-a-day-and-no-check-saw-it-2026-11-28.md). It runs after the
  # gates and before anything is pushed; it prints one line and passes when no path it cares about changed.
  lt_step "app compile"; say "app compile (scripts/check-app-compiles)"
  python3 -I "$SELF_DIR/check-app-compiles" --changed-from "$BASE" >"$out" 2>&1 || fail_step "app compile (the iPhone app does not compile, or the build tree is not free: see below)" "$out"
  tail -n1 "$out"
  # The phone-app shared-code tests, as CI runs them (scripts/check-shared-code-tests; docs/problems/a-landing-turned-main-red-because-landings-do-not-run-the-shared-code-tests-2026-11-28.md).
  lt_step "shared-code tests"; say "shared-code tests (scripts/check-shared-code-tests)"
  python3 -I "$SELF_DIR/check-shared-code-tests" --changed-from "$BASE" >"$out" 2>&1 || fail_step "shared-code tests (the phone-app bun test fails as CI runs it: the failing tests are named below)" "$out"
  tail -n1 "$out"
  rm -f "$out"
  [ "$1" = 1 ] || return 0
  have_work || { say "no suites to run"; return 0; }
  RESULT_TMP=""
  if [ "$LOCAL" = 1 ]; then lt_step "suites (local)"; run_suites_local; else run_suites_remote; fi
  t=$?
  if [ "$t" -ne 0 ]; then
    result "failed step=suites"
    echo; echo "land: suites FAILED (exit $t); nothing pushed to main."
    echo "--- failing packages / tests"; grep -E '^(FAIL|--- FAIL|panic:|WARNING: DATA RACE|STEP FAILED)' "$RESULT_TMP" | sort -u | head -30
    echo "--- last 40 lines"; tail -n 40 "$RESULT_TMP"
    exit 1
  fi
  say "suites passed"
}

# ------------------------------------------------ 7. push (with one rebase)
moves=0
verify 1
if [ "$NOPUSH" = 1 ]; then LT_OK=no-push; echo "land: --no-push: verified train at $(git rev-parse HEAD); HEAD is the train on a detached head (was $ORIG)"; exit 0; fi
TRAIN_HEAD=$(git rev-parse HEAD); lt_set_head "$TRAIN_HEAD"
same_train() { [ "$(git rev-parse HEAD)" = "$TRAIN_HEAD" ] || die "this tree's HEAD is $(git rev-parse --short HEAD), not the train this run verified ($(git rev-parse --short "$TRAIN_HEAD")): something else moved the tree. Nothing pushed."; }
while :; do
  if [ -n "${LAND_HOOK_AFTER_VERIFY:-}" ]; then
    lt_step "after-verify hook"
    say "running LAND_HOOK_AFTER_VERIFY (pid $$; the push waits for it)"
    eval "$LAND_HOOK_AFTER_VERIFY"
    say "LAND_HOOK_AFTER_VERIFY returned"
  fi
  same_train
  lt_step "final fetch"
  git fetch -q origin main || die "git fetch origin main failed before push"
  NEW=$(git rev-parse origin/main)
  [ "$NEW" != "$BASE" ] || break
  moves=$((moves+1))
  [ "$moves" -le 1 ] || { result "main-moved"; die "origin/main moved again after one rebase and rerun; giving up. Nothing pushed. Run scripts/land again."; }
  lt_step rebase
  say "origin/main moved $(git rev-parse --short "$BASE") -> $(git rev-parse --short "$NEW"); rebasing the train"
  if ! git rebase -q "$NEW" >/dev/null 2>&1; then
    files=$(git diff --name-only --diff-filter=U | tr '\n' ' '); git rebase --abort >/dev/null 2>&1
    result "main-moved"
    die "rebase onto moved origin/main conflicted in: $files(nothing pushed)"
  fi
  OLD=$BASE; BASE=$NEW; TRAIN_HEAD=$(git rev-parse HEAD); lt_set_head "$TRAIN_HEAD"
  prev_all=$PKGS_ALL
  # What the moved commits (OLD..NEW) affect, seen through the rebased tree's graph.
  hit=""
  for p in $(select_packages "$OLD" "$NEW" | awk -F'\t' '$1=="PKG"{print $2}'); do
    case " $prev_all " in *" $p "*) hit="$hit $p" ;; esac
  done
  make_plan "$BASE"
  if [ -n "$hit" ]; then
    say "the moved commits touch tested packages or their dependencies ($hit ); rerunning from the plan"
    print_plan; verify 1
  else
    say "the moved commits touch nothing under test; build + gates only"
    verify 0
  fi
done

# ------------------------------------------------------------- push + report
same_train
lt_step push
result "pushing head=$(git rev-parse HEAD)"
for l in $SKIPPED_LANES; do [ -z "$RESULT_FILE" ] || printf 'skipped lane=%s\n' "$l" >>"$RESULT_FILE" 2>/dev/null || true; done
git push origin HEAD:main || { result "main-moved"; die "push to main was rejected (main moved at the last instant?). Nothing landed; run scripts/land again."; }
short=$(git rev-parse --short=10 HEAD)
git push -q origin ":refs/heads/lane/land-$short" 2>/dev/null || true
lt_step report
echo "=== pushed to origin/main ==="
result "landed sha=$(git rev-parse HEAD)"
for l in $SKIPPED_LANES; do [ -z "$RESULT_FILE" ] || printf 'skipped lane=%s\n' "$l" >>"$RESULT_FILE" 2>/dev/null || true; done
echo "land: main is now $(git rev-parse HEAD)"
re=""
[ -f .github/scripts/node-b-ci-deploy ] && re=$(awk -F"'" '/loop_hit=\$\(printf/ {print $4; exit}' .github/scripts/node-b-ci-deploy)
[ -n "$re" ] || echo "  (path-based expedite rule not found in .github/scripts/node-b-ci-deploy; path column unknown)"
for c in $(git rev-list --reverse "$BASE..HEAD"); do
  tr=$(git log -1 --format='%(trailers:key=Ring-Expedite,valueonly,separator=%x20)' "$c" | tr -d '\n')
  if [ -n "$tr" ]; then trs="Ring-Expedite: yes"; else trs="Ring-Expedite: NO"; fi
  pe="path-expedite: unknown"
  if [ -n "$re" ]; then
    m=$(git diff-tree --no-commit-id --name-only -r "$c" | grep -E "$re" | head -1)
    if [ -n "$m" ]; then pe="path-expedite: yes ($m)"; else pe="path-expedite: no"; fi
  fi
  echo "  $(git log -1 --format='%H %s' "$c" | cut -c1-120)"
  echo "      $trs; $pe"
done
# Advice only: nothing here removes anything or changes the exit status (the last command stays the checkout).
i=0
while [ "$i" -lt "${#TRAIN_LANES[@]}" ]; do
  if [ "${TRAIN_WHOLE[$i]:-0}" = 1 ]; then
    echo "land: landed: ${TRAIN_LANES[$i]}; remove it with: (cd ${PRIMARY:-.} && lane rm ${TRAIN_LANES[$i]} --force)"
  else
    echo "land: ${TRAIN_LANES[$i]} was not fully landed here (some commit was already on main, or it has a merge commit); do not remove it"
  fi
  i=$((i+1))
done
for l in ${SKIPPED_LANES:-}; do echo "land: $l was not fully landed here (already on main, nothing of it picked); do not remove it"; done
git checkout -q "$ORIG" 2>/dev/null
