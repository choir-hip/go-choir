#!/usr/bin/env bash
# node-b-log-age: the job that keeps every host log on Node B under the
# promised age (docs/problems/host-logs-kept-a-day-or-for-ever-2026-11-24.md).
# It runs daily and a few minutes after every boot. The promise is an UPPER
# bound only: deleting early never breaks it.
#
#  1 The journal (every service's log, and the web access log) is closed
#    (`journalctl --rotate`, which returns when the rotation is complete:
#    journalctl(1)) and then trimmed. journald deletes a closed file by the
#    time of its OLDEST entry, which is in the file's name (systemd
#    journal-vacuum.c). The job then CHECKS: a closed file whose first entry
#    is still past the limit is a failure, and so is a second journal folder
#    (another machine id, a namespace), which the trim does not reach.
#  2 Access-log files left under CADDY_LOG_DIR from when Caddy wrote files
#    (access-*.log, access-*.log.gz): one is deleted when its FIRST entry
#    (the oldest) is past the limit, dated in the future, or unreadable.
#    Caddy no longer writes there, so no open file is unlinked. Any other
#    file in that folder is left alone and fails the job: nothing ages it.
#  3 The last-login records (who logged in last, from which address): removed
#    every run. They have one record per account and no age to go by.
#  4 Named dead files (DEAD_LOG_FILES): removed.
#
# Any failure exits non-zero (the unit shows in `systemctl --failed`) and is
# printed at error priority ("<3>": `journalctl -u go-choir-log-age -p err`).
#
# Environment: LOG_MAX_DAYS (7 to 28), JOURNAL_DIR, CADDY_LOG_DIR,
# LOGIN_LAST_FILES, DEAD_LOG_FILES (the last two: paths separated by spaces).
# Tested by scripts/test-node-b-log-age.sh.
set -u
days="${LOG_MAX_DAYS:-}"
case "$days" in ''|*[!0-9]*) echo "<3>log age: LOG_MAX_DAYS is not a number of days" >&2; exit 2 ;; esac
if [ "$days" -lt 7 ] || [ "$days" -gt 28 ]; then echo "<3>log age: LOG_MAX_DAYS=$days is outside 7 to 28" >&2; exit 2; fi
failed=0
err() { failed=$((failed + 1)); echo "<3>log age: $*"; }
now=$(date +%s)
cutoff=$(( now - days * 86400 ))

journalctl --rotate || err "journalctl --rotate failed"
journalctl --vacuum-time="${days}d" || err "journalctl --vacuum-time failed"

# The check. A closed file is <who>@<id>-<sequence>-<first entry, microseconds, hex>.journal;
# one set aside as damaged is <who>@<first entry hex>-<random>.journal~.
jroot="${JOURNAL_DIR:-}"
folders=0
if [ -n "$jroot" ] && [ -d "$jroot" ]; then
  for d in "$jroot"/*/; do [ -d "$d" ] && folders=$((folders + 1)); done
fi
if [ "$folders" != 1 ]; then
  err "$folders journal folders under '${jroot}', expected 1: the trim reaches only this machine's own"
else
  for f in "$jroot"/*/*@*.journal "$jroot"/*/*@*.journal~; do
    [ -f "$f" ] || continue
    b="${f##*/}"
    case "$b" in
      *.journal~) hex="${b#*@}"; hex="${hex%%-*}" ;;
      *) hex="${b%.journal}"; hex="${hex##*-}" ;;
    esac
    case "$hex" in ''|*[!0-9a-f]*) err "journal file $b has no first-entry time in its name"; continue ;; esac
    # An hour of slack: the trim's own clock read was a moment before ours.
    if [ $(( 16#$hex / 1000000 )) -lt $(( cutoff - 3600 )) ]; then err "journal file $b is still there and its first entry is past $days days"; fi
  done
fi

remove() { # one regular file; counts it in $went or as a failure
  [ -f "$1" ] && [ ! -L "$1" ] || return 0
  if rm -f -- "$1" 2>/dev/null && [ ! -e "$1" ]; then went=$((went + 1)); else err "could not delete $1"; fi
}

went=0; kept=0; other=0
dir="${CADDY_LOG_DIR:-}"
if [ -n "$dir" ] && [ -d "$dir" ]; then
  if [ ! -r "$dir" ] || [ ! -x "$dir" ]; then
    err "the access-log folder $dir cannot be read"
  else
    for f in "$dir"/*; do
      [ -f "$f" ] && [ ! -L "$f" ] || continue
      case "${f##*/}" in
        access-*.log|access-*.log.gz) ;;
        *) other=$((other + 1)); err "$f is not an access log and nothing ages it"; continue ;;
      esac
      # The first "ts": in the first line is the entry's own (a header that
      # held those characters is written with escaped quotes).
      first="$(gzip -cdf -- "$f" 2>/dev/null | head -n 1 | grep -o '"ts":[0-9][0-9]*' | head -n 1 | cut -d: -f2)"
      if [ -n "$first" ] && [ "$first" -ge "$cutoff" ] && [ "$first" -le $(( now + 86400 )) ]; then kept=$((kept + 1)); continue; fi
      remove "$f"
    done
  fi
fi
deleted=$went

went=0
for f in ${LOGIN_LAST_FILES:-}; do remove "$f"; done
login=$went
went=0
for f in ${DEAD_LOG_FILES:-}; do remove "$f"; done
dead=$went

echo "log age: max_days=$days journal_folders=$folders access_deleted=$deleted access_kept=$kept access_other=$other login_last_removed=$login dead_removed=$dead failed=$failed"
[ "$failed" = 0 ]
