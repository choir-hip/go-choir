#!/usr/bin/env bash
# node-b-log-age: the ONE job whose success means every host log on Node B is
# under the promised age
# (docs/problems/host-logs-kept-a-day-or-for-ever-2026-11-24.md). It runs
# daily and two minutes after every boot. The promise is an UPPER bound
# only: deleting early never breaks it. It deletes what is known to be safe
# to delete, checks the rest, and fails at the end if any check failed.
#
#  1 The journal (every service's log, and the web access log) is closed
#    (`journalctl --rotate`, which returns when the rotation is complete:
#    journalctl(1)) and then trimmed. journald deletes a closed file by the
#    time of its OLDEST entry, which is in the file's name (systemd
#    journal-vacuum.c). The job then CHECKS every journal folder: a closed
#    file whose first entry is past the limit by more than a day (one file's
#    span) is a failure; a file set aside as damaged (.journal~) past the
#    limit is deleted; an open per-user journal is a failure (none exists
#    today, and nothing here was tested against one); and so is a second
#    journal folder (another machine id, a namespace), which the trim does
#    not reach.
#  2 Access-log files left under CADDY_LOG_DIR from when Caddy wrote files
#    (access-*.log, access-*.log.gz): one is deleted when its FIRST entry
#    (the oldest) is past the limit, dated in the future, or unreadable.
#    Caddy no longer writes there, so no open file is unlinked. Anything
#    else in that folder (another file, a folder, a link, a hidden file) is
#    left alone and fails the job: nothing ages it.
#  3 Login records (LOGIN_RECORD_FILES: btmp, wtmp). logrotate, another
#    unit, puts them in daily files. This job deletes a rotated file last
#    written past the limit, and fails when logrotate's own record
#    (LOGROTATE_STATUS) shows a live file not rotated for over two days.
#  4 The last-login records (who logged in last, from which address): removed
#    every run. They have one record per account and no age to go by.
#  5 Named dead files (DEAD_LOG_FILES): removed.
#
# Any failure exits non-zero (the unit shows in `systemctl --failed`) and is
# printed at error priority ("<3>": `journalctl -u go-choir-log-age -p err`).
#
# THE DRY RUN. Run this script directly, never the unit (the unit starts
# logrotate first, which rotates and deletes):
#
#     sudo LOG_AGE_DRY_RUN=1 bash node-b-log-age
#
# With nothing else set it uses the production paths and limit below, so its
# list is what the deploy's first run deletes. It deletes nothing and does
# not call journalctl. It prints three things, kept apart:
#   "would delete <path>"                  this job's own deletions, now;
#   "the journal trim would delete <path>" closed journal files past the limit;
#   "logrotate would rotate <path>"        login-record files logrotate, which
#                                          the unit runs first, puts into a
#                                          dated file (it deletes nothing that
#                                          this job's list does not show).
# A stale rotation record is a "note:" in the dry run, not a failure,
# because on the host logrotate runs before the job. Every other check runs
# and fails as in a real run. Its count line starts "log age: dry_run=1" and
# uses would_ names; only LOG_AGE_DRY_RUN=1 is accepted (any other value is
# refused, so a stray setting cannot make the daily job a silent no-op).
#
# Settings, each with its production default (lists: paths separated by
# spaces). The unit in nix/node-b.nix sets the same values, and
# scripts/test-node-b-log-retention.sh fails if the two differ. Tested by
# scripts/test-node-b-log-age.sh.
set -u
LOG_MAX_DAYS="${LOG_MAX_DAYS-21}"
JOURNAL_DIR="${JOURNAL_DIR-/var/log/journal}"
CADDY_LOG_DIR="${CADDY_LOG_DIR-/var/log/caddy}"
LOGIN_RECORD_FILES="${LOGIN_RECORD_FILES-/var/log/btmp /var/log/wtmp}"
LOGROTATE_STATUS="${LOGROTATE_STATUS-/var/lib/logrotate.status}"
LOGIN_LAST_FILES="${LOGIN_LAST_FILES-/var/log/lastlog /var/log/lastlog.migrated /var/lib/lastlog/lastlog2.db /var/lib/lastlog/lastlog2.db-wal /var/lib/lastlog/lastlog2.db-shm /var/lib/lastlog/lastlog2.db-journal}"
DEAD_LOG_FILES="${DEAD_LOG_FILES-/var/lib/go-choir/rebuild-0333528.log /var/lib/go-choir/rebuild-near-head-20260909.log /var/lib/go-choir/paper-repair-20261029T223916Z.log}"
# Login stores nothing here ages: one appearing fails the job.
LOGIN_OTHER_STORES="${LOGIN_OTHER_STORES-/var/log/wtmpdb /var/lib/wtmpdb/wtmp.db /var/log/faillog /var/log/tallylog}"
PROC_DIR="${PROC_DIR-/proc}"
days="$LOG_MAX_DAYS"
case "$days" in ''|*[!0-9]*) echo "<3>log age: LOG_MAX_DAYS is not a number of days" >&2; exit 2 ;; esac
if [ "$days" -lt 7 ] || [ "$days" -gt 28 ]; then echo "<3>log age: LOG_MAX_DAYS=$days is outside 7 to 28" >&2; exit 2; fi
dry="${LOG_AGE_DRY_RUN:-}"
case "$dry" in ''|1) ;; *) echo "<3>log age: LOG_AGE_DRY_RUN is '$dry': only 1 is a dry run; unset it for a real run" >&2; exit 2 ;; esac
failed=0
err() { failed=$((failed + 1)); echo "<3>log age: $*"; }
now=$(date +%s)
cutoff=$(( now - days * 86400 ))
went=0
remove() { # one regular file; counts it in $went or as a failure
  [ -f "$1" ] && [ ! -L "$1" ] || return 0
  if [ -n "$dry" ]; then echo "would delete $1"; went=$((went + 1)); return 0; fi
  if rm -f -- "$1" 2>/dev/null && [ ! -e "$1" ]; then went=$((went + 1)); else err "could not delete $1"; fi
}
holder() { # the process id that has this file open, if any
  local l
  for l in "$PROC_DIR"/[0-9]*/fd/*; do
    [ -L "$l" ] || continue
    if [ "$(readlink "$l" 2>/dev/null)" = "$1" ]; then l="${l#"$PROC_DIR"/}"; echo "${l%%/*}"; return 0; fi
  done
  return 0
}
ymd() { date -u -d "@$1" +%Y-%-m-%-d 2>/dev/null || date -u -r "$1" +%Y-%-m-%-d; }

if [ -n "$dry" ]; then
  echo "DRY RUN: nothing is deleted and the journal is not touched"
  echo "would run: journalctl --rotate; journalctl --vacuum-time=${days}d"
else
  journalctl --rotate || err "journalctl --rotate failed"
  journalctl --vacuum-time="${days}d" || err "journalctl --vacuum-time failed"
fi

# The journal check, in every folder there is. A closed file is
# <who>@<id>-<sequence>-<first entry, microseconds, hex>.journal; one set
# aside as damaged is <who>@<when set aside, hex>-<random>.journal~ (the
# last two fields before the suffix, as journal-vacuum.c reads them).
jroot="$JOURNAL_DIR"
folders=0; damaged=0
if [ -n "$jroot" ] && [ -d "$jroot" ]; then
  for d in "$jroot"/*/; do [ -d "$d" ] && folders=$((folders + 1)); done
  for f in "$jroot"/*/*.journal "$jroot"/*/*.journal~; do
    [ -f "$f" ] || continue
    b="${f##*/}"
    case "$b" in
      *@*.journal~) hex="${b%.journal~}"; hex="${hex%-*}"; hex="${hex##*[@-]}"; kind=damaged ;;
      *@*.journal) hex="${b%.journal}"; hex="${hex##*-}"; kind=closed ;;
      user-*.journal) err "$b is an open per-user journal: not expected on this host, and its age is not checked"; continue ;;
      *) continue ;; # system.journal, the open file: closed by the rotation above
    esac
    case "$hex" in ''|*[!0-9a-f]*) err "journal file $b has no time in its name"; continue ;; esac
    at=$(( 16#$hex / 1000000 ))
    if [ "$kind" = damaged ]; then
      if [ "$at" -lt "$cutoff" ]; then went=0; remove "$f"; damaged=$((damaged + went)); fi
    elif [ -n "$dry" ]; then
      if [ "$at" -lt "$cutoff" ]; then echo "the journal trim would delete $f"; fi
    elif [ "$at" -lt $(( cutoff - 86400 )) ]; then
      err "journal file $b is still there and its first entry is past $days days"
    fi
  done
fi
if [ "$folders" != 1 ]; then err "$folders journal folders under '${jroot}', expected 1: the trim reaches only this machine's own"; fi

went=0; kept=0; other=0
dir="$CADDY_LOG_DIR"
if [ -n "$dir" ] && [ -d "$dir" ]; then
  if [ ! -r "$dir" ] || [ ! -x "$dir" ]; then
    err "the access-log folder $dir cannot be read"
  else
    for f in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
      [ -e "$f" ] || [ -L "$f" ] || continue
      case "${f##*/}" in access-*.log|access-*.log.gz) named=1 ;; *) named= ;; esac
      if [ -z "$named" ] || [ -L "$f" ] || [ ! -f "$f" ]; then
        other=$((other + 1)); err "$f is not one of our access-log files and nothing ages it"; continue
      fi
      # The first "ts": in the first line is the entry's own (a header that
      # held those characters is written with escaped quotes).
      first="$(gzip -cdf -- "$f" 2>/dev/null | head -n 1 | grep -o '"ts":[0-9][0-9]*' | head -n 1 | cut -d: -f2)"
      if [ -n "$first" ] && [ "$first" -ge "$cutoff" ] && [ "$first" -le $(( now + 86400 )) ]; then kept=$((kept + 1)); continue; fi
      pid="$(holder "$f")"
      if [ -n "$pid" ]; then err "$f is still open in process $pid and its first entry is past $days days: not deleted under its writer"; continue; fi
      remove "$f"
    done
  fi
fi
deleted=$went

# Login records. A rotation is <live>.<n> or <live>-<8 digits>, with or
# without .gz (logrotate's two naming schemes); its last write is its newest
# record. Anything else under the name is not ours to delete and nothing
# ages it: it fails the job.
went=0
status="$LOGROTATE_STATUS"
for live in $LOGIN_RECORD_FILES; do
  for f in "$live".* "$live"-*; do
    [ -e "$f" ] || [ -L "$f" ] || continue
    if [ -L "$f" ] || [ ! -f "$f" ] || ! printf '%s' "${f#"$live"}" | grep -Eq '^(\.[0-9]+|-[0-9]{8})(\.gz)?$'; then
      err "$f is under a login record's name and is not a rotation: nothing ages it"; continue
    fi
    if [ -n "$(find "$f" -maxdepth 0 -mmin +$(( days * 1440 )) 2>/dev/null)" ]; then remove "$f"; fi
  done
  [ -s "$live" ] || continue # absent or empty: nothing to age
  last="$(grep -F "\"$live\" " "$status" 2>/dev/null | head -n 1 | awk '{print $2}' | cut -d- -f1-3)"
  recent=
  for back in -1 0 1 2; do [ -n "$last" ] && [ "$last" = "$(ymd $(( now - back * 86400 )))" ] && recent=1; done
  [ -n "$recent" ] && continue
  if [ -z "$last" ]; then why="$live has never been rotated, by logrotate's record ($status)"
  else why="$live was last rotated on $last, over two days ago: logrotate is not putting it in daily files"; fi
  if [ -n "$dry" ]; then
    # On the host the unit runs logrotate before this job.
    echo "note: $why"; echo "logrotate would rotate $live"
  else err "$why"; fi
done
for f in $LOGIN_OTHER_STORES; do
  if [ -e "$f" ] || [ -L "$f" ]; then err "$f is a login store this job does not age"; fi
done
rotated=$went

went=0
for f in $LOGIN_LAST_FILES; do remove "$f"; done
login=$went
went=0
for f in $DEAD_LOG_FILES; do remove "$f"; done
dead=$went

w=; [ -n "$dry" ] && w=would_
echo "log age: ${dry:+dry_run=1 }max_days=$days journal_folders=$folders ${w}access_deleted=$deleted access_kept=$kept access_other=$other ${w}login_rotated_deleted=$rotated ${w}login_last_removed=$login ${w}dead_removed=$dead ${w}journal_damaged_deleted=$damaged failed=$failed"
[ "$failed" = 0 ]
