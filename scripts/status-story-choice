#!/usr/bin/env python3
"""status-story-choice: how the paper's management tasks chose between feeding
a story and opening one, and what the main-point judgment did
(docs/design/semantic-layer-2026-11-20.md, landing A): per UTC hour and for the
window.

Read only against Node B: one ssh reads the paper VM's guest console files; nothing is
written there. fetch() returns text, compute() is pure. --fixture FILE feeds console
lines with no network (scripts/test-status-scripts.sh).

  status-story-choice [--since T] [--until T] [--node HOST] [--json] [--fixture FILE]

T is YYYY-MM-DDTHH:MMZ; the window is [since, until). Exit 0, or 2 when the fetch failed.

It reads two console lines, written by internal/agentcore management_story_choice.go:
  management story choice run= choice=(open|feed|decline) story= opening_shown= verb_shown=
      candidates_shown= window= page_in_window= page_left_out= offered=(-|doc,doc)
      answers=(-|doc:(next|new|none),...) captures=<n> sources=near:<n>,lead:<n>
      main_point=<chars> succeeds=(-|doc)
  story research cast run= story= round=      (a story's Texture opened a research round)
and prints, per hour and for the window: decisions; captures judged; answers by kind (a
feed is `same`; an open's first capture is `next` when it names a succeeds, else `new`, and
its other captures are `same_as_batch`; a decline is `decline`); candidates offered by
source (vector, entity, lead; entity is not built, captures carry none); stories opened and
fed; successor links written; the share of captures sent to an existing trajectory; research
runs started by cause (a story's first round after an open, after a successor's open, or a
later round after a feed); and how many captures each trajectory took. A line from before
the judgment has no captures= and counts one capture.

The console rotates at about 1 MB and keeps about 1.5 to 2.5 hours; a window before the oldest
line is partial. Ids and counts only; the script prints no title and no query text.
"""
import argparse
import calendar
import json
import re
import statistics
import subprocess
import sys
import time

PAPER_VM = "vm-1669020adcece51c2f5ff9b6df399ef5"
NODE = "node-b"
STAMP = r"(\d{4}/\d\d/\d\d \d\d:\d\d:\d\d)"
LINE_RE = re.compile(STAMP + r" management story choice (.*)$")
KV_RE = re.compile(r"(\w+)=(\S*)")


def stamp_epoch(s):
    return calendar.timegm(time.strptime(s, "%Y/%m/%d %H:%M:%S"))


def parse_arg_time(s):
    return calendar.timegm(time.strptime(s, "%Y-%m-%dT%H:%MZ"))


def hour_label(t):
    return time.strftime("%Y-%m-%dT%HZ", time.gmtime(t - t % 3600))


RESEARCH_RE = re.compile(STAMP + r" story research cast (.*)$")
BUCKETS = ("1", "2", "3", "4-5", "6+")


def bucket(n):
    return "1" if n <= 1 else "2" if n == 2 else "3" if n == 3 else "4-5" if n <= 5 else "6+"


def new_counts():
    return {"decisions": 0, "opens": 0, "feeds": 0, "declines": 0, "captures": 0,
            "same": 0, "next": 0, "same_as_batch": 0, "new": 0, "decline": 0,
            "opens_with_offer": 0, "cand_near": 0, "cand_lead": 0, "cand_entity": 0,
            "left_out": 0, "pages": []}


def compute(text, since=None, until=None):
    """Rows per UTC hour and one summary for the window. A capture's answer is
    read from the decision that disposed of it: a feed is `same` (the capture
    serves a held story's main point), an open's first capture is `next` (the
    line names a succeeds) or `new`, its other captures are `same_as_batch`
    (they share its one story), a decline is `decline`. Lines from before the
    main-point judgment have no captures= and count one capture each."""
    hours, total = {}, new_counts()
    story_captures, opened, succ, fed = {}, set(), set(), set()
    research = []
    for ln in text.splitlines():
        m = LINE_RE.search(ln)
        r = RESEARCH_RE.search(ln) if not m else None
        if r:
            t = stamp_epoch(r.group(1))
            if (since is None or t >= since) and (until is None or t < until):
                kv = dict(KV_RE.findall(r.group(2)))
                research.append((t, kv.get("story", "-"), int(kv.get("round", "0") or 0)))
            continue
        if not m:
            continue
        t = stamp_epoch(m.group(1))
        if (since is not None and t < since) or (until is not None and t >= until):
            continue
        kv = dict(KV_RE.findall(m.group(2)))
        choice = kv.get("choice")
        if choice not in ("open", "feed", "decline"):
            continue
        n = int(kv.get("captures", "1") or 1) if choice != "open" else max(int(kv.get("captures", "1") or 1), 1)
        story = kv.get("story", "-")
        succeeds = kv.get("succeeds", "-") not in ("-", "")
        near, lead = 0, 0
        for part in kv.get("sources", "").split(","):
            k, _, v = part.partition(":")
            if k == "near" and v.isdigit():
                near = int(v)
            if k == "lead" and v.isdigit():
                lead = int(v)
        h = hours.setdefault(hour_label(t), new_counts())
        for c in (h, total):
            c["decisions"] += 1
            c["captures"] += n
            c[{"open": "opens", "feed": "feeds", "decline": "declines"}[choice]] += 1
            c["pages"].append(int(kv.get("page_in_window", kv.get("opening_shown", "0")) or 0))
            if int(kv.get("page_left_out", "0") or 0) > 0:
                c["left_out"] += 1
            c["cand_near"] += near
            c["cand_lead"] += lead
            if choice == "feed":
                c["same"] += n
            elif choice == "decline":
                c["decline"] += n
            else:
                c["next" if succeeds else "new"] += 1
                c["same_as_batch"] += n - 1
                if kv.get("offered", "-") not in ("-", ""):
                    c["opens_with_offer"] += 1
        if choice == "open":
            opened.add(story)
            story_captures[story] = story_captures.get(story, 0) + n
            if succeeds:
                succ.add(story)
        elif choice == "feed":
            fed.add(story)
            story_captures[story] = story_captures.get(story, 0) + n
    rows = []
    for k in sorted(hours):
        h = hours[k]
        pages = h.pop("pages")
        h["hour"] = k
        h["median_page"] = int(statistics.median(pages)) if pages else 0
        rows.append(h)
    pages = total.pop("pages")
    total["median_page"] = int(statistics.median(pages)) if pages else 0
    total["stories_opened"], total["stories_fed"] = len(opened), len(fed)
    total["successor_links"] = len(succ)
    judged = total["captures"]
    total["share_to_existing_trajectory"] = round(total["same"] / judged, 3) if judged else None
    total["share_to_existing_or_shared"] = round((total["same"] + total["same_as_batch"]) / judged, 3) if judged else None
    cause = {"open": 0, "successor": 0, "feed": 0}
    for _, story, rnd in research:
        cause["successor" if story in succ and rnd == 1 else "open" if rnd == 1 else "feed"] += 1
    total["research_runs"] = len(research)
    total["research_by_cause"] = cause
    dist = dict.fromkeys(BUCKETS, 0)
    for n in story_captures.values():
        dist[bucket(n)] += 1
    total["captures_per_trajectory"] = dist
    return {"hours": rows, "summary": total}


def render(res):
    rows, t = res["hours"], res["summary"]
    out = ["hour           decisions  captures  opens  feeds  declines  same  next  same_as_batch  new  decline  cand_near  cand_lead  page_cut  median_page"]
    for r in rows:
        out.append("%-14s %9d %9d %6d %6d %9d %5d %5d %14d %4d %8d %10d %10d %9d %12d" % (
            r["hour"], r["decisions"], r["captures"], r["opens"], r["feeds"], r["declines"], r["same"], r["next"],
            r["same_as_batch"], r["new"], r["decline"], r["cand_near"], r["cand_lead"], r["left_out"], r["median_page"]))
    if not rows:
        out.append("(no management story choice lines in the window)")
    share = t["share_to_existing_trajectory"]
    both = t["share_to_existing_or_shared"]
    out += ["",
            "window: decisions %d, captures judged %d" % (t["decisions"], t["captures"]),
            "answers by kind: same %d, next %d, same_as_batch %d, new %d, decline %d" % (t["same"], t["next"], t["same_as_batch"], t["new"], t["decline"]),
            "candidates offered by source: vector %d, entity %d (not built: captures carry no entities), lead %d" % (t["cand_near"], t["cand_entity"], t["cand_lead"]),
            "stories opened %d, stories fed %d, successor links written %d" % (t["stories_opened"], t["stories_fed"], t["successor_links"]),
            "share of captures sent to an existing trajectory: %s (with captures sharing a new one: %s)" % (
                "-" if share is None else "%.1f%%" % (100 * share), "-" if both is None else "%.1f%%" % (100 * both)),
            "research runs started %d: by an open %d, by a successor %d, by a feed or later round %d" % (
                t["research_runs"], t["research_by_cause"]["open"], t["research_by_cause"]["successor"], t["research_by_cause"]["feed"]),
            "captures per trajectory (stories opened or fed in the window): " + ", ".join("%s: %d" % (k, t["captures_per_trajectory"][k]) for k in BUCKETS)]
    return "\n".join(out)


REMOTE = r"""
dir=/var/lib/go-choir/vm-state/@VM@
sudo -n true 2>/dev/null || echo "##NOSUDO"
echo "##CONSOLE"
sudo -n sh -c "cd $dir && for f in console.log.4 console.log.3 console.log.2 console.log.1 console.log; do [ -f \$f ] && cat \$f; done" 2>/dev/null |
  grep -a -E 'management story choice run=|story research cast run=' | sed -E 's/^.*([0-9]{4}\/[0-9]{2}\/[0-9]{2} [0-9:]{8} (management story choice|story research cast))/\1/'
echo "##END"
""".replace("@VM@", PAPER_VM)


def fetch(node):
    p = subprocess.run(["ssh", "-C", "-o", "BatchMode=yes", "-o", "ConnectTimeout=15", node, REMOTE],
                       capture_output=True, text=True, timeout=240)
    if "##END" not in p.stdout:
        raise RuntimeError("ssh %s failed or replied incompletely (rc=%d)" % (node, p.returncode))
    if "##NOSUDO" in p.stdout:
        raise RuntimeError("sudo -n is not allowed on %s: the guest console cannot be read" % node)
    return "\n".join(ln for ln in p.stdout.splitlines() if not ln.startswith("##"))


def main(argv):
    ap = argparse.ArgumentParser(prog="status-story-choice")
    ap.add_argument("--since")
    ap.add_argument("--until")
    ap.add_argument("--node", default=NODE)
    ap.add_argument("--json", action="store_true")
    ap.add_argument("--fixture")
    a = ap.parse_args(argv)
    try:
        since = parse_arg_time(a.since) if a.since else None
        until = parse_arg_time(a.until) if a.until else None
        if a.fixture:
            with open(a.fixture) as f:
                text = f.read()
        else:
            text = fetch(a.node)
        rows = compute(text, since, until)
    except (OSError, RuntimeError, ValueError, subprocess.SubprocessError) as e:
        print("status-story-choice: unavailable: %s" % e, file=sys.stderr)
        return 2
    print(json.dumps(rows, sort_keys=True) if a.json else render(rows))
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
