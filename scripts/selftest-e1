# B1 flow: a pause, then completion, settles P3 true
def b1_flow():
    saved = e1.STATUS_MIN_GAP_S
    e1.STATUS_MIN_GAP_S = 0
    stub, state, choir, status, repo = three_arm_world()
    counter = os.path.join(os.path.dirname(status), "calls")
    open(status, "w").write("#!/usr/bin/env python3\nimport json,os,sys\nf=%r\nn=int(open(f).read()) if os.path.exists(f) else 0\nopen(f,'w').write(str(n+1))\n"
                            "if n==1: sys.exit(2)\nprint(json.dumps({'now':'x','flags':[],'search':{'by':{},'keenable':{'today_calls':5}}}))\n" % counter)
    code, out = run(pilot_args(state, choir, status, repo))
    check("B1 flow: a failed status read pauses the pilot before an objective", code == 4 and "STOP before" in out, (code, out[-300:]))
    code, out = run(pilot_args(state, choir, status, repo))
    check("B1 flow: the rerun finishes the ten objectives", code == 0 and "PILOT DONE" in out, (code, out[-300:]))
    code, out = run(common(state, choir, status, repo) + ["read", "--verdict"])
    p3 = [l for l in out.splitlines() if l.startswith("P3")]
    check("B1 flow: P3 is true after a pause and a completed pilot", p3 and p3[0].split()[1] == "true", out[-400:])
    e1.STATUS_MIN_GAP_S = saved
    stub.close()


guard("B1flow", b1_flow)


# B2 flow: the live count is persisted; an unreadable live count pauses the pilot until a read succeeds
def b2_flow():
    stub, state, choir, status, repo = three_arm_world()
    stub.fail_events = True
    code, out = run(pilot_args(state, choir, status, repo))
    pl = e1.State(state).load("pilot.json")
    check("B2 flow: a failing live read pauses the pilot after the objective, with the reason", code == 4 and "live" in out and pl.get("pauses"), (code, out[-400:]))
    check("B2 flow: the objective's units are in the state with their bundles' counts", pl["objectives"]["p01"]["done"] and len(pl["objectives"]["p01"]["units"]) == 3)
    code, out = run(pilot_args(state, choir, status, repo))
    check("B2 flow: still failing, the rerun starts no new objective", code == 4 and "p02" not in " ".join(l for l in out.splitlines() if "tally" in l), (code, out[-300:]))
    stub.fail_events = False
    code, out = run(pilot_args(state, choir, status, repo))
    pl = e1.State(state).load("pilot.json")
    check("B2 flow: once a read succeeds the pilot goes on", code == 0 and "PILOT DONE" in out, (code, out[-300:]))
    check("B2 flow: the last live count of each unit is persisted", all(isinstance(pl["objectives"]["p02"].get("live", {}).get(x), int) for x in three), pl["objectives"]["p02"].get("live"))
    stub.close()


guard("B2flow", b2_flow)


# B3 flow: a kill between submit and save does not resubmit
def b3_flow():
    stub, state, choir, status, repo = three_arm_world()
    objs = e1.load_objectives(os.path.join(repo, "docs", "calibration", "e1", "pilot-objectives.jsonl"))[1]
    prompt = objs[0]["prompt"]
    old, fresh = e1.iso(e1.now() - e1.datetime.timedelta(minutes=10)), e1.iso(e1.now() - e1.datetime.timedelta(seconds=5))
    n0 = dict(stub.counter)      # the objectives p02 to p10 add 9 to every arm; p01 adds one only where it is resubmitted
    stub.runs_by_arm["sa"] = [{"run_id": "sub-sa-77", "agent_role": "conductor", "state": "completed", "prompt": prompt,
                               "created_at": e1.iso(e1.now() - e1.datetime.timedelta(seconds=3)), "metadata": {"trajectory_id": "traj-sa-77", "doc_id": "doc-sa-77"}}]
    st = e1.State(state)
    st.save("pilot.json", {"objectives": {"p01": {"position": 1, "kind": "thin_event", "subs": {}, "units": {}, "done": False,
                                                  "intent": {"sa": fresh, "sb": old, "i": old}}}, "stops": [], "started_at": None, "arm_stopped": {}})
    code, out = run(pilot_args(state, choir, status, repo))
    sub = st.load("pilot.json")["objectives"]["p01"]["subs"]
    check("B3 flow: an arm with an intent and a matching run is adopted, not resubmitted", sub["sa"]["submission_id"] == "sub-sa-77" and stub.counter.get("sa", 0) == n0.get("sa", 0) + 9, (sub.get("sa"), stub.counter, n0))
    check("B3 flow: an old intent with no run found is submitted", stub.counter.get("sb", 0) == n0.get("sb", 0) + 10 and stub.counter.get("i", 0) == n0.get("i", 0) + 10, (stub.counter, n0))
    stub.close()
    stub, state, choir, status, repo = three_arm_world()
    st = e1.State(state)
    st.save("pilot.json", {"objectives": {"p01": {"position": 1, "kind": "thin_event", "subs": {}, "units": {}, "done": False,
                                                  "intent": {x: e1.iso(e1.now() - e1.datetime.timedelta(seconds=5)) for x in three}}}, "stops": [], "started_at": None, "arm_stopped": {}})
    n1 = dict(stub.counter)
    code, out = run(pilot_args(state, choir, status, repo))
    check("B3 flow: a fresh intent with no run found cannot be decided: the pilot stops and says so, submitting nothing",
          code == 4 and "cannot be decided" in out and stub.counter == n1, (code, out[-300:], stub.counter))
    stub.close()


guard("B3flow", b3_flow)

shutil.rmtree(tmp, ignore_errors=True)
print("selftest-e1: %d passed, %d failed" % (passed, failed))
sys.exit(1 if failed else 0)
