# F3 and F4 the pilot
def objective_text(arms):
    lines = open(sample).read().splitlines()
    h = json.loads(lines[0])
    h["arms"] = arms
    return "\n".join([json.dumps(h)] + lines[1:]) + "\n"


def make_repo(root, with_ledger=True, arms=None):
    remote = os.path.join(root, "remote.git")
    subprocess.run(["git", "init", "-q", "--bare", "-b", "main", remote], check=True)
    work = os.path.join(root, "work")
    subprocess.run(["git", "clone", "-q", remote, work], check=True, stderr=subprocess.DEVNULL)
    os.makedirs(os.path.join(work, "docs", "calibration", "e1"))
    text = objective_text(arms or list(e1.ARM_ORDER))
    open(os.path.join(work, "docs", "calibration", "e1", "pilot-objectives.jsonl"), "w").write(text)
    osha = hashlib.sha256(text.encode()).hexdigest()
    ledger = open(os.path.join(FX, "ledger-good.md")).read().replace("SHAPLACEHOLDER", osha)
    ledger = ledger if with_ledger else ledger.replace("E1-M pilot", "other")
    open(os.path.join(work, "docs", "calibration", "claude-ledger.md"), "w").write(ledger)
    env = dict(os.environ, GIT_AUTHOR_NAME="t", GIT_AUTHOR_EMAIL="t@invalid", GIT_COMMITTER_NAME="t", GIT_COMMITTER_EMAIL="t@invalid")
    for cmd in (["add", "."], ["commit", "-q", "-m", "x"], ["push", "-q", "origin", "HEAD:main"]):
        subprocess.run(["git", "-C", work] + cmd, check=True, env=env, stderr=subprocess.DEVNULL)
    return work


def pilot_args(state, choir, status, repo, credits=9000):
    return common(state, choir, status, repo) + ["pilot", "--claims", "C901,C902,C903", "--credits", str(credits), "--credits-basis", "selftest",
            "--objectives", os.path.join(repo, "docs", "calibration", "e1", "pilot-objectives.jsonl")]


