# ======= review round (SEND_BACK at 5e4eb1517): each case below failed before its fix =======
def guard(name, fn):
    try:
        fn()
    except Exception as exc:  # a case that crashes is a failed case
        check(name, False, "raised %s: %s" % (type(exc).__name__, exc))


# B1 (blocking) P3 is void only when the pilot did not finish or a terminal stop cut an objective short
base = {"planned": 10, "submitted": 10, "arms": three}
u3 = full3({"sa": 3, "sb": 3, "i": 3})
v = e1.verdicts(u3, dict(base, stops=[{"reason": "status read failed", "terminal": False}]))
check("B1 a pause that later resumed leaves a finished pilot at P3 true", v["P3"][0] == "true", v)
v = e1.verdicts(u3, dict(base, stops=[{"reason": "cost: tally 450 reached 450", "terminal": True, "cut": True, "objective": "p10"}]))
check("B1 a terminal stop that cut an objective short is void", v["P3"][0] == "void", v)
v = e1.verdicts(u3, dict(base, stops=[{"reason": "published: doc-x", "terminal": True, "cut": False, "objective": "p10"}]))
check("B1 a terminal stop after the last objective was whole does not void P3", v["P3"][0] == "true", v)
v = e1.verdicts(u3[:27], dict(base, submitted=9, stops=[{"reason": "deadline", "terminal": True}]))
check("B1 fewer objectives submitted than planned is void", v["P3"][0] == "void", v)

# B9 an arm stopped by the drop-an-arm rule leaves units that never ran: not valid, so P3 is false
dropped = [u for u in full3({"sa": 3, "sb": 3, "i": 3}) if not (u["arm"] == "i" and int(u["objective"][1:]) > 3)]
v = e1.verdicts(dropped, dict(base, stops=[], arm_stopped={"i": True}))
check("B9 a stopped arm makes P3 false (23 of 30 valid) and says so", v["P3"][0] == "false" and "arm stopped" in v["P3"][1] and "i" in v["P3"][1], v)

# B2 the tally never goes blind
def b2_pure():
    check("B2 a unit with a bundle counts the larger of the bundle's calls and the last live count",
          e1.adjust_calls({"calls": 12}, {"trajectory_id": "t", "live_calls": 30}, True)[0] == 30
          and e1.adjust_calls({"calls": 12}, {"trajectory_id": "t", "live_calls": 5}, True)[0] == 12)
    check("B2 a unit with no bundle counts its last live count", e1.adjust_calls({"calls": 0}, {"trajectory_id": "t", "live_calls": 17}, False)[0] == 17)
    c, basis = e1.adjust_calls({"calls": 0}, {"trajectory_id": "t"}, False)
    check("B2 a submitted unit with neither is counted at the stated worst case, not zero", c == e1.UNKNOWN_UNIT_CALLS and e1.UNKNOWN_UNIT_CALLS >= 44 and "worst" in basis, (c, basis))
    check("B2 a unit that was never submitted counts zero", e1.adjust_calls({"calls": 0}, {"submit_error": "x"}, False)[0] == 0)



guard("B2pure", b2_pure)

