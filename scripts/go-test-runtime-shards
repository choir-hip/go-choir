#!/usr/bin/env bash
set -euo pipefail

total_shards="${TOTAL_SHARDS:-6}"
if ! [[ "$total_shards" =~ ^[1-9][0-9]*$ ]]; then
  echo "TOTAL_SHARDS must be a positive integer, got: $total_shards" >&2
  exit 2
fi

packages=(./internal/agentcore ./internal/textureowner)

weights_list="$(dirname "$0")/go-test-runtime-weights"
[[ -f "$weights_list" ]] || weights_list=""

# plan_deal reads "<package> <Test>" lines (discovery order) and prints the
# ones shard $1 of $2 runs. The deal is heaviest first by
# scripts/go-test-runtime-weights ("<seconds> <package>:<Test>"; an unlisted
# test weighs 1): each test goes to the shard with the least load so far, the
# lower index on a tie. A shard runs its packages one after the other, so the
# load is the sum over both packages. Every shard computes the same plan from
# the same discovery and weights, so each test runs exactly once; a stale or
# missing weight only unbalances.
plan_deal() {
  awk -v me="$1" -v shards="$2" -v wfile="$weights_list" '
    BEGIN {
      if (wfile != "") {
        while ((getline line < wfile) > 0) {
          if (line ~ /^[ \t]*(#|$)/) continue
          if (line !~ /^[ \t]*[0-9]+[ \t]+[^ \t:]+:[A-Za-z0-9_]+[ \t]*$/) {
            print "bad weights line \"" line "\" (want: <seconds> <package>:<TestName>)" > "/dev/stderr"; exit 2
          }
          split(line, f, /[ \t]+/); if (f[1] == "") { f[1] = f[2]; f[2] = f[3] }
          weight[f[2]] = f[1] + 0
        }
      }
    }
    { n++; pkg[n] = $1; name[n] = $2; key = $1; sub(/^\.\//, "", key); w[n] = ((key ":" $2) in weight) ? weight[key ":" $2] : 1 }
    END {
      # Order: heavier first, then discovery order (stable, deterministic).
      for (i = 1; i <= n; i++) ord[i] = i
      for (i = 2; i <= n; i++) { v = ord[i]; j = i - 1
        while (j >= 1 && (w[ord[j]] < w[v])) { ord[j + 1] = ord[j]; j-- }
        ord[j + 1] = v }
      for (k = 0; k < shards; k++) load[k] = 0
      for (i = 1; i <= n; i++) { t = ord[i]; best = 0
        for (k = 1; k < shards; k++) if (load[k] < load[best]) best = k
        load[best] += w[t]; if (best == me) chosen[t] = 1 }
      for (i = 1; i <= n; i++) if (i in chosen) print pkg[i], name[i]
    }'
}

run_shard() {
  local shard_index="$1"
  shift
  local status=0

  # Discover every package before dealing any: the deal spans both, and a
  # failed discovery runs nothing.
  local discovered=""
  for package in "${packages[@]}"; do
    # Match execution's build mode (especially -race) so discovery warms
    # the right cache. Capture first: process substitution hides failures.
    local listing
    if ! listing=$(go test "$package" "$@" -list '^(Test|Example)'); then
      echo "Test discovery failed for $package" >&2
      return 1
    fi
    local -a tests=()
    mapfile -t tests < <(grep -E '^(Test|Example)' <<<"$listing" || true)
    if (( ${#tests[@]} == 0 )); then
      echo "No ${package} tests found"
      continue
    fi
    local test
    for test in "${tests[@]}"; do
      discovered+="${package} ${test}"$'\n'
    done
  done

  local plan
  if ! plan=$(printf '%s' "$discovered" | plan_deal "$shard_index" "$total_shards"); then
    echo "Weighted deal of runtime tests failed (${weights_list#./})" >&2
    return 1
  fi

  for package in "${packages[@]}"; do
    local total
    total=$(grep -c "^${package} " <<<"$discovered" || true)
    (( total > 0 )) || continue
    local -a selected=()
    local pkg_name test_name
    while read -r pkg_name test_name; do
      [[ "$pkg_name" == "$package" ]] || continue
      if [[ -n "${QUARANTINE_FILE:-}" && -f "$QUARANTINE_FILE" ]] && grep -Eq -f "$QUARANTINE_FILE" <<<"$test_name"; then
        echo "Skipping quarantined ${package} test ${test_name} (runs in go-test-scale)"
        continue
      fi
      selected+=("$test_name")
    done <<<"$plan"

    if (( ${#selected[@]} == 0 )); then
      echo "No ${package} tests selected for shard ${shard_index}/${total_shards}"
      continue
    fi

    local regex
    regex="$(IFS='|'; echo "^(${selected[*]})$")"
    echo "Running ${#selected[@]} of ${total} ${package} tests in shard ${shard_index}/${total_shards}"
    if ! "$(dirname "$0")/go-test-with-timing" "$package" -count=1 -run "$regex" "$@"; then
      status=1
    fi
  done

  return "$status"
}

if [[ -n "${SHARD_INDEX:-}" ]]; then
  if ! [[ "$SHARD_INDEX" =~ ^[0-9]+$ ]] || (( SHARD_INDEX >= total_shards )); then
    echo "SHARD_INDEX must be an integer in [0, $((total_shards - 1))], got: $SHARD_INDEX" >&2
    exit 2
  fi
  run_shard "$SHARD_INDEX" "$@"
  exit $?
fi

tmpdir="$(mktemp -d)"
trap 'rm -rf "$tmpdir"' EXIT

status=0

if [[ "${PARALLEL_SHARDS:-1}" == "1" ]]; then
  pids=()
  for shard_index in $(seq 0 $((total_shards - 1))); do
    (
      run_shard "$shard_index" "$@"
    ) >"$tmpdir/shard-${shard_index}.log" 2>&1 &
    pids+=("$!")
  done

  for shard_index in $(seq 0 $((total_shards - 1))); do
    pid="${pids[$shard_index]}"
    if ! wait "$pid"; then
      status=1
    fi
    cat "$tmpdir/shard-${shard_index}.log"
  done
else
  for shard_index in $(seq 0 $((total_shards - 1))); do
    if ! run_shard "$shard_index" "$@"; then
      status=1
    fi
  done
fi

exit "$status"
