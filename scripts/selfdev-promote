#!/usr/bin/env bash
# selfdev-promote: turn a computer's frozen self-development patch into a lane
# commit on the current platform base (gap A, the readiness metamission SR0).
#
# The patch is read through `choir self-dev patch`, which verifies its sha256.
# It is applied to --onto (origin/main by default) in --worktree, on branch
# lane/<lane>, and committed with trailers naming the operation, the computer,
# the patch digest and the base it was frozen on. Nothing is pushed: the lane
# goes through review and the landing loop like any other change.
#
# Before committing, the script predicts the source projection's containment
# test (docs/design/computer-update-architecture-rnd-2026-10-24.md, "The
# containment test"): for every path the patch touches, the blob and mode it
# leaves on the frozen base must equal what it leaves on --onto. When they do,
# the computer's stack retires as `upstreamed` once a deploy carrying this
# commit boots it. When they differ, the stack stays `stack_base_moved` and
# needs a rebase (U4); the script says so and stops unless --allow-uncontained.
#
# Usage:
#   scripts/selfdev-promote --computer ID --operation OP --api-key-file F \
#     --lane NAME --worktree DIR [--onto REF] [--patch-file F] [--title T] \
#     [--allow-uncontained] [--trailer "Key: value"]...
#
# --patch-file skips the fetch and reads a patch saved earlier; its sha256 is
# still checked against --sha256 when given.
set -euo pipefail

die() { echo "selfdev-promote: $*" >&2; exit 1; }

computer="" operation="" key_file="" lane="" worktree="" onto="origin/main"
patch_file="" want_sha="" base="" title="" allow_uncontained=0
trailers=""
while [ $# -gt 0 ]; do
  case "$1" in
    --computer) computer="$2"; shift 2 ;;
    --operation) operation="$2"; shift 2 ;;
    --api-key-file) key_file="$2"; shift 2 ;;
    --lane) lane="$2"; shift 2 ;;
    --worktree) worktree="$2"; shift 2 ;;
    --onto) onto="$2"; shift 2 ;;
    --patch-file) patch_file="$2"; shift 2 ;;
    --sha256) want_sha="$2"; shift 2 ;;
    --base) base="$2"; shift 2 ;;
    --title) title="$2"; shift 2 ;;
    --allow-uncontained) allow_uncontained=1; shift ;;
    --trailer) trailers="$trailers$2"$'\n'; shift 2 ;;
    -h|--help) sed -n '2,27p' "$0"; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done
[ -n "$operation" ] || die "--operation is required"
[ -n "$lane" ] || die "--lane is required"
[ -n "$worktree" ] || die "--worktree is required"
[ ! -e "$worktree" ] || die "worktree $worktree already exists"

repo="$(git rev-parse --show-toplevel)"
scratch="$(mktemp -d)"
trap 'rm -rf "$scratch"' EXIT

if [ -z "$patch_file" ]; then
  [ -n "$computer" ] || die "--computer is required to fetch the patch"
  [ -n "$key_file" ] || die "--api-key-file is required to fetch the patch"
  choir_bin="${CHOIR_BIN:-choir}"
  patch_file="$scratch/patch.diff"
  env -u CHOIR_API_KEY "$choir_bin" self-dev patch --api-key-file "$key_file" \
    --computer "$computer" --operation "$operation" --out "$patch_file" > "$scratch/meta.json"
  base="$(jq -r .source_patch_base_commit "$scratch/meta.json")"
  want_sha="$(jq -r .source_patch_sha256 "$scratch/meta.json")"
fi
[ -f "$patch_file" ] || die "patch file $patch_file not found"
[ -n "$base" ] || die "--base is required with --patch-file"
got_sha="$(shasum -a 256 "$patch_file" | cut -d' ' -f1)"
if [ -n "$want_sha" ] && [ "$got_sha" != "$want_sha" ]; then
  die "patch sha256 $got_sha does not match $want_sha"
fi

git -C "$repo" cat-file -e "$base^{commit}" 2>/dev/null || die "base $base is not in this repository (git fetch it first)"
onto_commit="$(git -C "$repo" rev-parse --verify "$onto^{commit}")" || die "cannot resolve --onto $onto"

# Post-image of the patch on a tree, as `git ls-files -s` lines for its paths.
post_image() {
  local commit="$1" out="$2" index="$scratch/index.$3"
  GIT_INDEX_FILE="$index" git -C "$repo" read-tree "$commit"
  GIT_INDEX_FILE="$index" git -C "$repo" apply --cached "$patch_file" 2>"$scratch/apply.$3.err" || return 1
  GIT_INDEX_FILE="$index" git -C "$repo" ls-files -s -- "${paths[@]}" > "$out"
}
mapfile -t paths < <(git -C "$repo" apply --numstat -z "$patch_file" | tr '\0' '\n' |
  awk -F'\t' 'NF>=3 {print $3; next} NF==1 && $1!="" {print $1}' | sort -u)
[ "${#paths[@]}" -gt 0 ] || die "the patch touches no paths"

post_image "$base" "$scratch/on-base" base || die "the patch does not apply to its own base $base: $(cat "$scratch/apply.base.err")"
if ! post_image "$onto_commit" "$scratch/on-onto" onto; then
  die "the patch does not apply to $onto ($onto_commit); it needs a rebase (U4): $(cat "$scratch/apply.onto.err")"
fi
if cmp -s "$scratch/on-base" "$scratch/on-onto"; then
  contained="yes"
else
  contained="no"
  echo "selfdev-promote: the patch leaves different blobs on $onto than on its base:" >&2
  diff "$scratch/on-base" "$scratch/on-onto" >&2 || true
  [ "$allow_uncontained" = 1 ] || die "the computer's stack would not retire as upstreamed; pass --allow-uncontained to promote anyway"
fi

git -C "$repo" worktree add -q -b "lane/$lane" "$worktree" "$onto_commit"
git -C "$worktree" apply --index "$patch_file"
[ -n "$title" ] || title="selfdev: promote $operation"
git -C "$worktree" commit -q -F - <<EOF
$title

Promoted from a computer's frozen self-development patch by
scripts/selfdev-promote. The containment prediction is "$contained": the
computer's applied stack retires as upstreamed once a deploy carrying this
commit boots it.

Choir-Selfdev-Operation: $operation
Choir-Selfdev-Computer: ${computer:-unknown}
Choir-Source-Patch-SHA256: $got_sha
Choir-Source-Patch-Base: $base
${trailers%$'\n'}
EOF
jq -n --arg lane "lane/$lane" --arg worktree "$worktree" --arg commit "$(git -C "$worktree" rev-parse HEAD)" \
  --arg onto "$onto_commit" --arg base "$base" --arg sha "$got_sha" --arg contained "$contained" \
  --argjson paths "$(printf '%s\n' "${paths[@]}" | jq -R . | jq -s .)" \
  '{lane:$lane, worktree:$worktree, commit:$commit, onto:$onto, patch_base:$base, patch_sha256:$sha, contained:$contained, paths:$paths}'
