#!/usr/bin/env bash
set -euo pipefail

json_log="$(mktemp)"
json_only_log="$(mktemp)"
trap 'rm -f "$json_log" "$json_only_log"' EXIT

# Whole-machine CPU use over the run (docs/problems/ci-wall-clock-2026-10-24.md):
# decides whether a shard has idle CPUs to give another process.
cpu_sample() {
  if [[ -r /proc/stat ]]; then
    awk '/^cpu / { idle = $5 + $6; total = 0; for (i = 2; i <= NF; i++) total += $i; print idle, total; exit }' /proc/stat
  fi
}
cpu_before="$(cpu_sample || true)"
started_at="$(date +%s)"

test_status=0
go test -json "$@" 2>&1 | tee "$json_log" || test_status=${PIPESTATUS[0]}

cpu_after="$(cpu_sample || true)"
if [[ -n "$cpu_before" && -n "$cpu_after" ]]; then
  read -r idle0 total0 <<<"$cpu_before"
  read -r idle1 total1 <<<"$cpu_after"
  if (( total1 > total0 )); then
    echo "CPU utilization over this go test run: $(( 100 * ( (total1 - total0) - (idle1 - idle0) ) / (total1 - total0) ))% of $(nproc) CPUs in $(( $(date +%s) - started_at ))s"
  fi
fi

if command -v jq >/dev/null 2>&1; then
  awk '/^[[:space:]]*\{/ { print }' "$json_log" > "$json_only_log"

  echo "::group::Go test timing summary"
  echo "Slowest packages:"
  jq -r '
    select((.Action == "pass" or .Action == "fail") and (.Test == null)) |
    [(.Elapsed // 0), .Package, .Action] | @tsv
  ' "$json_only_log" 2>/dev/null | sort -nr | awk -F '\t' 'NR <= 20 {printf "  %7.2fs  %-70s %s\n", $1, $2, $3}'

  echo
  echo "Slowest tests:"
  jq -r '
    select((.Action == "pass" or .Action == "fail") and (.Test != null)) |
    [(.Elapsed // 0), .Package, .Test, .Action] | @tsv
  ' "$json_only_log" 2>/dev/null | sort -nr | awk -F '\t' 'NR <= 40 {printf "  %7.2fs  %-58s %-80s %s\n", $1, $2, $3, $4}'

  if [[ "$test_status" -ne 0 ]]; then
    echo
    echo "Tests still running when command failed or timed out:"
    jq -r '
      select(.Test != null and (.Action == "run" or .Action == "pass" or .Action == "fail" or .Action == "skip")) |
      [.Package, .Test, .Action] | @tsv
    ' "$json_only_log" 2>/dev/null |
      awk -F '\t' '{key=$1 "\t" $2; status[key]=$3} END {for (key in status) if (status[key] == "run") print key}' |
      sort |
      awk -F '\t' 'NR <= 40 {printf "  %-58s %s\n", $1, $2}'
  fi
  echo "::endgroup::"
else
  echo "jq not found; skipped Go test timing summary" >&2
fi

exit "$test_status"
