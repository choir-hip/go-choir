#!/usr/bin/env python3
"""Proof: do the listener's ops settle the DJ's forecasts, once, by rule?

On the drill computer (d@e) only. Opens a programme and extends it until at
least ten forecast-bearing entries exist (each is on the server's run sheet:
the segment event names its entry_id and claim_id), then posts ops as a phone
would: finish two, finish one with the op's own time set 30 days back (the
server bounds it at seven days and then at the claim's own time, so it still
settles; the seven-day bound alone is TestL11's, a drill claim is minutes old), skip two, cut one
(a real cut: the listener places another entry at now), leave one (outcome "left", entry state "heard"),
and, NOT back to back, put one entry on air and then another before the first
one's end op (the app was killed): the first is closed as no verdict
(superseded), the second finishes; and one bare `aired heard` with no ended
(no_outcome: no verdict, never true). Reads GET /api/autoradio/learning and
asserts for those ten forecasts: seven settled (four true, three false) and
three no verdict. Then posts the same ops again and asserts nothing was settled
twice (the scorecard's settled count and every row are unchanged). Prints the
ledger rows. Then the notebook (docs/reference/AUTORADIO-NOTEBOOK.md): a more/less
tap and a mute become lines of the notebook (the revision is the desk's); the
next stretch's input receipt on the tape (GET /api/autoradio/learning,
notebook.inputs: revision, sha256, bytes, never the text) names a notebook
revision at least as new as the tap's; the page is within budget (at most 12
learned, 3 trying, 1,000 written words); and every lesson line cites ledger
rows that exist. Whether the model proposed a lesson in that one call is its
own choice: it is reported, and --require-lesson makes it a failure.
Then the heard phase (docs/reference/AUTORADIO-PROGRAMME.md, "What the
listener heard, in the input"): this run's story routes carry a per-run suffix,
so what earlier runs finished does not count. It takes one entry the run
FINISHED and one it SKIPPED, opens a stretch that offers both at the same
version plus a never-seen candidate, and reads that stretch's input receipt
(notebook.inputs[].heard: counts and ids, never words): asserts candidates 3,
same 1 (the finished one), not_in_window 2 (the skipped one and the new one),
unavailable false. A second stretch offers the finished story at a HIGHER
version: asserts earlier 1. What the DJ then did is only reported (a new
forecast row citing the finished story at the same version should be
telling:followup or absent; at the higher version it should be telling:followup);
--require-followup makes a departure a failure. The receipts are printed.
Exit 0 when all hold, 1 otherwise, 2 on bad arguments.

Rerun ceiling: each run leaves about ten entries on the sheet's 100 ahead
places, and the heard phase adds two more stretches of at most six entries
each (up to twelve more), so about twenty to thirty in all. The desk removes
only entries older than 12 hours, so about three or four runs in 12 hours
fill them; the next run then fails loudly (unplaced).

The key goes only in the Authorization header and is never printed. An
owner-wide key names no computer: pass --computer (X-Choir-Computer).

  scripts/prove-autoradio-learning --host choir.news --api-key-file ~/key \\
      --computer <the drill computer>

Shapes: docs/reference/AUTORADIO-PROGRAMME.md, AUTORADIO-SHEET.md.
"""
import argparse
import http.client
import json
import sys
import uuid
from datetime import datetime, timedelta, timezone

STORIES = [
    ("harbour-reopens", "Harbour reopens", "Repairs to the harbour wall are finished and ferries sail again."),
    ("ferry-timetable", "Ferry timetable", "Two extra sailings are added on weekdays from Monday."),
    ("budget-vote", "Budget vote", "The council votes on next year's budget on Monday."),
    ("school-strike", "School strike ends", "Staff in Nancy return to work after three weeks."),
    ("rain-weekend", "Rain this weekend", "The weather service expects rain across the region through Sunday."),
    ("bridge-works", "Bridge works", "Night closures of the north bridge begin next week."),
]


def read_key(path):
    try:
        with open(path) as f:
            key = "".join(f.read().split())
    except OSError as e:
        sys.exit("cannot read the key file: %s" % e.strerror)
    if not key:
        sys.exit("the key file is empty")
    return key


class Api:
    def __init__(self, args, key):
        self.args, self.key = args, key
        # A per-run suffix on every story route: the heard index matches by
        # route, so what an earlier run finished must not count in this one.
        self.salt = uuid.uuid4().hex[:6]

    def call(self, method, path, body=None, stream=False):
        a = self.args
        cls = http.client.HTTPConnection if a.insecure_http else http.client.HTTPSConnection
        conn = cls(a.host, timeout=a.timeout or None)
        h = {"Authorization": "Bearer " + self.key, "Content-Type": "application/json"}
        if a.computer:
            h["X-Choir-Computer"] = a.computer
        try:
            conn.request(method, path, json.dumps(body) if body is not None else None, h)
            resp = conn.getresponse()
            raw = resp.read().decode("utf-8", "replace")
            if resp.status != 200:
                sys.exit("%s %s: HTTP %d %s" % (method, path, resp.status, raw[:200]))
            return raw if stream else json.loads(raw)
        finally:
            conn.close()

    def route(self, r):
        return "%s-%s" % (r, self.salt)

    def programme(self, cause, candidates=None):
        now = datetime.now(timezone.utc).astimezone()
        body = {"request_id": "learn-%s-%s" % (cause, uuid.uuid4().hex[:10]), "cause": cause,
                "local_time": now.isoformat(timespec="seconds"), "tz": "Europe/Paris",
                "candidates": candidates if candidates is not None else
                [{"route": self.route(r), "version": 1, "title": t, "dek": d, "text": d} for r, t, d in STORIES]}
        if cause == "extend":
            body["ahead_titles"] = []
        raw = self.call("POST", "/api/autoradio/programme", body, stream=True)
        segs, event = [], None
        self.last_done = {}
        for line in raw.splitlines():
            if line.startswith("event: "):
                event = line[7:]
            elif line.startswith("data: ") and event == "done":
                self.last_done = json.loads(line[6:])
            elif line.startswith("data: ") and event == "segment":
                segs.append(json.loads(line[6:]))
            elif line.startswith("data: ") and event == "error":
                print("  programme error: %s" % line[6:200])
        return segs

    def ops(self, ops):
        return self.call("POST", "/api/autoradio/sheet/ops", {"ops": ops})

    def sheet(self):
        return self.call("GET", "/api/autoradio/sheet")

    def steer(self, body):
        return self.call("POST", "/api/autoradio/steer", body)

    def learning(self, line=None):
        q = "/api/autoradio/learning?limit=200" + ("&line=" + line if line else "")
        return self.call("GET", q)

    def learning_all(self, line=None):
        """Every page of the route (it answers `next` while rows remain): the
        first page's scorecard and notebook, all pages' rows."""
        first = self.learning(line)
        doc, rows = first, list(first["rows"])
        while doc.get("next"):
            doc = self.call("GET", "/api/autoradio/learning?limit=200&after=%s%s" % (doc["next"], ("&line=" + line) if line else ""))
            rows += doc["rows"]
        first["rows"] = rows
        return first


def op_on(tag, entry_id):
    return {"op_id": "pl-%s-on" % tag, "by": "phone", "op": "aired", "id": entry_id, "state": "on_air", "base_version": 0, "position_seconds": 0}


def op_place_now(tag, entry_id):
    """The listener's place at now: it cuts the entry on air and puts this one on air."""
    return {"op_id": "pl-%s-cut" % tag, "by": "listener", "op": "place", "at": "now", "base_version": 0,
            "entry": {"id": entry_id, "kind": "story", "placed_by": "listener", "state": "ahead", "title": "prove cut",
                      "text": "A short note placed by the proof script.", "est_seconds": 5}}


def op_end(tag, entry_id, state, outcome, last, ago_days=0):
    at = (datetime.now(timezone.utc) - timedelta(days=ago_days)).isoformat(timespec="milliseconds").replace("+00:00", "Z")
    return {"op_id": "pl-%s-end" % tag, "by": "phone", "op": "aired", "id": entry_id, "state": state, "base_version": 0,
            "ended": {"outcome": outcome, "at": at, "last_block": last}, "position_seconds": 9.5}


def main():
    ap = argparse.ArgumentParser(description="Prove the Autoradio forecasts settle from the listener's ops, once.")
    ap.add_argument("--host", required=True)
    ap.add_argument("--api-key-file", required=True)
    ap.add_argument("--computer", default="")
    ap.add_argument("--timeout", type=float, default=0.0)
    ap.add_argument("--insecure-http", action="store_true")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--require-lesson", action="store_true", help="fail unless the model proposed a lesson that was written")
    ap.add_argument("--require-followup", action="store_true", help="fail unless the DJ's telling of a heard story was a follow-up (or it left it out)")
    args = ap.parse_args()
    key = read_key(args.api_key_file)
    if args.dry_run:
        print("ok: arguments and key file read; nothing sent")
        return 0
    api = Api(args, key)
    before = api.learning()["scorecard"]
    segs = api.programme("open") + []
    content = []
    for _ in range(5):
        segs += api.programme("extend")
        content = [s for s in segs if s.get("claim_id")]
        if len(content) >= 10:
            break
    print("entries %d, with a forecast %d" % (len(segs), len(content)))
    if len(content) < 10:
        print("FAIL: fewer than ten forecast-bearing entries")
        return 1
    run = uuid.uuid4().hex[:8]
    # name -> (state, outcome, last_block, days back the op's own time is set)
    plan = [("finished", "heard", "finished", 1, 0)] * 2 + [("backdated", "heard", "finished", 1, 30)] \
        + [("skipped", "skipped", "skipped", 0, 0)] * 2 + [("cut", "", "", 0, 0), ("left", "heard", "left", 0, 0)]
    # A stale desk entry already on air (a killed app) is taken over by the
    # first on_air below and adds one superseded no-verdict of its own.
    stale = [e for e in api.sheet().get("entries", []) if e.get("state") == "on_air" and (e.get("forecast") or {}).get("claim_id")]
    ops, claims = [], {}
    for i, (s, (name, state, outcome, last, ago)) in enumerate(zip(content, plan)):
        tag = "%s-%d" % (run, i)
        if name == "cut":
            # A real cut: on air, then the listener places another at now. The
            # placed entry is then ended by the phone like any other.
            lid = "L-prove-%s" % run
            ops += [op_on(tag, s["entry_id"]), op_place_now(tag, lid), op_end(tag + "L", lid, "heard", "finished", 1)]
        else:
            ops += [op_on(tag, s["entry_id"]), op_end(tag, s["entry_id"], state, outcome, last, ago)]
        claims[s["claim_id"]] = name
    # The app was killed with X on air: on_air for Y arrives before X's end, which never comes.
    x, y = content[len(plan)], content[len(plan) + 1]
    ops += [op_on("%s-x" % run, x["entry_id"]), op_on("%s-y" % run, y["entry_id"]),
            op_end("%s-y" % run, y["entry_id"], "heard", "finished", 1)]
    claims[x["claim_id"]], claims[y["claim_id"]] = "superseded", "finished"
    # A bare heard end that says nothing of how it ended: no verdict, never true.
    z = content[len(plan) + 2]
    bare = op_end("%s-z" % run, z["entry_id"], "heard", "finished", 1)
    del bare["ended"]
    ops += [op_on("%s-z" % run, z["entry_id"]), bare]
    claims[z["claim_id"]] = "no_outcome"
    res = api.ops(ops)
    dropped = [r for r in res["results"] if not r.get("applied")]
    mid = api.learning_all()
    again = api.ops(ops)
    after = api.learning_all()

    def rows(doc):
        return {r["claim_id"]: r for r in doc["rows"] if r["claim_id"] in claims}

    r1, r2 = rows(mid), rows(after)
    ok = not dropped
    if dropped:
        print("dropped ops: %s" % [(r["op_id"], r.get("dropped")) for r in dropped])
    want = {"finished": ("settled", "true"), "backdated": ("settled", "true"), "skipped": ("settled", "false"), "cut": ("settled", "false"),
            "left": ("no_verdict", ""), "superseded": ("no_verdict", ""), "no_outcome": ("no_verdict", "")}
    reason = {"left": "left", "superseded": "superseded", "no_outcome": "no_outcome"}
    for cid, name in claims.items():
        r = r1.get(cid)
        good = r is not None and (r["status"], r.get("outcome", "")) == want[name] and r.get("no_verdict_reason") == reason.get(name)
        ok = ok and good
        print("  %-8s %s status=%s outcome=%s title=%r op=%s %s" % (
            name, cid[-12:], r and r["status"], r and r.get("outcome"), r and r["title"], r and r.get("op", {}).get("op_id"), "" if good else "WRONG"))
    delta = mid["scorecard"]["settled"] - before["settled"]
    want_nv = 3 + len(stale)
    print("settled +%d (want 7); no_verdict +%d (want %d, %d stale on-air entries taken over)" % (
        delta, mid["scorecard"]["no_verdict"] - before["no_verdict"], want_nv, len(stale)))
    ok = ok and delta == 7 and mid["scorecard"]["no_verdict"] - before["no_verdict"] == want_nv
    twice = after["scorecard"]["settled"] != mid["scorecard"]["settled"] or r1 != r2
    print("repeat of the same ops: %d applied again, settled %d -> %d, rows %s" % (
        sum(1 for r in again["results"] if r.get("applied")), mid["scorecard"]["settled"], after["scorecard"]["settled"],
        "changed" if r1 != r2 else "unchanged"))
    ok = ok and not twice
    print("scorecard: %s" % json.dumps({k: after["scorecard"][k] for k in ("forecasts", "settled", "heard_through", "heard_through_rate", "brier", "no_verdict")}))
    ok = notebook_phase(api, args, content, ok)
    ok = heard_phase(api, args, content, claims, ok)
    print("PASS" if ok else "FAIL")
    return 0 if ok else 1


def notebook_phase(api, args, content, ok):
    print("-- the notebook")
    nb0 = api.learning().get("notebook") or {}
    tap = api.steer({"entry_id": content[0]["entry_id"], "direction": "less"})
    mute = api.steer({"direction": "mute", "publisher": "voice-d0d0d0"})
    print("  tap: %s %s; mute: %s %s" % (tap["status"], tap["line"], mute["status"], mute["line"]))
    ok = ok and tap["status"] in ("applied", "noop") and mute["status"] in ("applied", "noop")
    nb1 = api.learning()["notebook"]
    lines = nb1.get("lines", [])
    has_tap = any(l["section"] == "Recent steering" and l["text"] == tap["line"] for l in lines)
    has_mute = any(l["section"] == "What you asked for" and l["text"] == mute["line"] for l in lines)
    print("  the tap is a steering line: %s; the mute is the listener's line: %s" % (has_tap, has_mute))
    ok = ok and has_tap and has_mute and nb1.get("found") is True
    # The next stretch is shown the notebook; its input receipt is on the tape.
    api.programme("extend")
    stretch = api.last_done.get("stretch_id", "")
    nb2 = api.learning()["notebook"]
    receipt = next((r for r in nb2.get("inputs", []) if r["stretch_id"] == stretch), None)
    shown = receipt is not None and len(receipt["notebook_sha256"]) == 64 and int(receipt["notebook_bytes"]) > 0
    print("  stretch %s input receipt: %s" % (stretch, json.dumps(receipt)))
    if shown:
        # Revisions are opaque ids; the receipt must name the revision the tap
        # (or a later desk patch) wrote, which is the notebook's head now or
        # an earlier head of this run.
        shown = receipt["notebook_revision_id"] != "" and receipt["notebook_revision_id"] != (nb0.get("revision_id") or "-")
    ok = ok and shown
    print("  the call's input held the notebook: %s" % shown)
    # Budget, and every lesson cites ledger rows that exist.
    learned = [l for l in nb2["lines"] if l["section"] == "What Autoradio has learned"]
    trying = [l for l in nb2["lines"] if l["section"] == "What Autoradio is trying"]
    budget = len(learned) <= 12 and len(trying) <= 3 and nb2.get("written_words", 0) <= 1000
    print("  budget: %d learned, %d trying, %d written words: %s" % (len(learned), len(trying), nb2.get("written_words", 0), "within" if budget else "OVER"))
    ok = ok and budget
    claims = {r["claim_id"] for r in api.learning_all()["rows"]}
    cited_ok, wrote = True, False
    for l in learned + trying:
        cites = l.get("cites", [])
        if cites:
            wrote = True
        if not cites or any(c not in claims for c in cites):
            cited_ok = False
            print("  line %s cites %s: a cite is not a ledger row" % (l.get("id"), cites))
    print("  every lesson cites ledger rows: %s; a lesson was written by this run's model call: %s" % (cited_ok, wrote))
    ok = ok and cited_ok
    # Each line's live count must equal what the ledger rows behind it say
    # (the document's own count may be up to an hour old, so it is not compared);
    # beside it, how many forecasts were made since the line was written.
    for l in learned + trying:
        ref = l["ref"]
        rows = api.learning_all(ref)["rows"]
        settled = [r for r in rows if r["status"] == "settled"]
        heard = [r for r in settled if r.get("heard_through")]
        agree = (l["live_of"], l["live_heard"]) == (len(settled), len(heard))
        print("  %s: document says heard %s of %s; live heard %s of %s; ledger rows %d settled, %d heard through: %s; forecasts since written %s (settled %s)" % (
            ref, l["heard"], l["of"], l["live_heard"], l["live_of"], len(settled), len(heard), "agree" if agree else "DISAGREE",
            l.get("live_forecasts"), l.get("live_settled")))
        ok = ok and agree
    for r in nb2.get("retired", [])[:5]:
        print("  retired %s heard %s of %s%s: %r" % (r["id"], r["heard"], r["of"], (" replaced by " + r["replaced_by"]) if r["replaced_by"] else "", r["text"][:60]))
    if args.require_lesson and not wrote:
        print("  --require-lesson: the model proposed no lesson")
        ok = False
    return ok


def cite_routes(seg):
    """The routes a segment event cites (refs are pub:<route>@v<version>)."""
    out = []
    for c in seg.get("cites") or []:
        ref = c.get("ref", "") if isinstance(c, dict) else str(c)
        if ref.startswith("pub:") and "@v" in ref:
            out.append(ref[4:ref.rindex("@v")])
    return out


def heard_receipt(api, stretch):
    nb = api.learning().get("notebook") or {}
    row = next((r for r in nb.get("inputs", []) if r.get("stretch_id") == stretch), None)
    return (row or {}).get("heard")


def candidate(route, version, title):
    return {"route": route, "version": version, "title": title, "dek": title + ".", "text": title + "."}


def heard_phase(api, args, content, claims, ok):
    print("-- the heard index")
    segs_by_claim = {s["claim_id"]: s for s in content}
    finished = [cid for cid, n in claims.items() if n in ("finished", "backdated") and cid in segs_by_claim]
    skipped = [cid for cid, n in claims.items() if n in ("skipped", "cut") and cid in segs_by_claim]
    heard_routes = {r for cid, n in claims.items() if n in ("finished", "backdated") and cid in segs_by_claim for r in cite_routes(segs_by_claim[cid])}
    fin_route = next((r for cid in finished for r in cite_routes(segs_by_claim[cid])), None)
    skip_route = next((r for cid in skipped for r in cite_routes(segs_by_claim[cid]) if r not in heard_routes), None)
    if not fin_route or not skip_route:
        print("  FAIL: the run's entries do not give a finished story and a skipped one on different routes (finished %r, skipped %r)" % (fin_route, skip_route))
        return False
    print("  the finished story's route %s, the skipped story's route %s" % (fin_route, skip_route))
    new1 = "heard-new-%s" % api.salt
    cands = [candidate(fin_route, 1, "Finished story"), candidate(skip_route, 1, "Skipped story"), candidate(new1, 1, "A story never offered")]
    segs1 = api.programme("extend", cands)
    st1 = api.last_done.get("stretch_id", "")
    r1 = heard_receipt(api, st1)
    print("  same-version stretch %s receipt: %s" % (st1, json.dumps(r1, sort_keys=True)))
    good1 = bool(r1) and r1.get("unavailable") is False and r1.get("candidates") == 3 and r1.get("same") == 1 and r1.get("not_in_window") == 2 and r1.get("earlier") == 0
    print("  want candidates 3, same 1, not_in_window 2, earlier 0, unavailable false: %s" % ("ok" if good1 else "WRONG"))
    ok = ok and good1
    new2 = "heard-new2-%s" % api.salt
    segs2 = api.programme("extend", [candidate(fin_route, 2, "Finished story, a later version"), candidate(new2, 1, "Another story never offered")])
    st2 = api.last_done.get("stretch_id", "")
    r2 = heard_receipt(api, st2)
    print("  higher-version stretch %s receipt: %s" % (st2, json.dumps(r2, sort_keys=True)))
    good2 = bool(r2) and r2.get("unavailable") is False and r2.get("earlier") == 1 and r2.get("same") == 0
    print("  want earlier 1, same 0, unavailable false: %s" % ("ok" if good2 else "WRONG"))
    ok = ok and good2
    # What the DJ did is reported; only --require-followup makes it a failure.
    tellings = {r["claim_id"]: r.get("telling", "") for r in api.learning_all()["rows"]}
    follow_ok = True
    for label, segs, want_row in (("same version", segs1, False), ("higher version", segs2, True)):
        rows = [(s.get("title"), tellings.get(s.get("claim_id"), "(no row)")) for s in segs if s.get("claim_id") and fin_route in cite_routes(s)]
        if not rows:
            print("  DJ, %s: no new forecast row cites the finished story (left out)%s" % (label, "" if not want_row else " [expected a follow-up]"))
            continue
        for title, t in rows:
            good = t == "followup" or (t == "" and not want_row)
            follow_ok = follow_ok and good
            print("  DJ, %s: row %r telling=%r %s" % (label, title, t or "(absent)", "ok" if good else "NOT A FOLLOW-UP"))
    if args.require_followup and not follow_ok:
        print("  --require-followup: the DJ told a heard story in full")
        ok = False
    return ok


if __name__ == "__main__":
    sys.exit(main())
