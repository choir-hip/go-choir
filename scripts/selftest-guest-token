def check_not_vacuous(work):
    """D: run this selftest where the scan has nothing to stand on."""
    if os.environ.get("CHOIR_GUEST_TOKEN_NESTED"):
        return
    env = {**os.environ, "CHOIR_GUEST_TOKEN_NESTED": "1", "GIT_CEILING_DIRECTORIES": work}
    me = os.path.join(HERE, "selftest-guest-token")

    def tree(name):
        root = os.path.join(work, name)
        for rel in ("scripts/selftest-guest-token", "scripts/choir_internal.py",
                    "scripts/lib/choir_internal.sh", *sorted(PROVEN_COPIES)):
            os.makedirs(os.path.dirname(os.path.join(root, rel)), exist_ok=True)
            with open(os.path.join(REPO, rel)) as src, open(os.path.join(root, rel), "w") as dst:
                dst.write(src.read())
        return root

    def last(r):
        return f"exit {r.returncode}: " + ((r.stdout + r.stderr).strip().splitlines() or [""])[-1]

    def run(argv, cwd=None):
        return subprocess.run(argv, capture_output=True, text=True, env=env, cwd=cwd, timeout=120)

    bare = tree("no-git")
    r = run([sys.executable, os.path.join(bare, "scripts/selftest-guest-token")])
    check("outside a git work tree it exits nonzero", r.returncode != 0, last(r))
    r = run([sys.executable, os.path.join(bare, "scripts/selftest-guest-token"), "--rev", "HEAD"])
    check("--rev outside a git work tree exits nonzero", r.returncode != 0, last(r))
    r = run([sys.executable, me, "--rev", "deadbeef"])
    check("--rev deadbeef exits nonzero", r.returncode != 0, last(r))
    empty = tree("no-seeds")
    with open(os.path.join(empty, "README.md"), "w") as f:
        f.write("nothing here names the header\n")
    git_env = {"GIT_AUTHOR_NAME": "t", "GIT_AUTHOR_EMAIL": "t@t", "GIT_COMMITTER_NAME": "t", "GIT_COMMITTER_EMAIL": "t@t"}
    for argv in (["init", "-q"], ["add", "README.md"], ["commit", "-q", "-m", "t"]):
        subprocess.run(["git", "-C", empty, *argv], env={**env, **git_env}, capture_output=True, check=False)
    r = run([sys.executable, os.path.join(empty, "scripts/selftest-guest-token"), "--rev", "HEAD"])
    check("--rev with no file naming the header exits nonzero", r.returncode != 0, last(r))
    r = run([sys.executable, os.path.join(empty, "scripts/selftest-guest-token")])
    check("a work tree with no file naming the header exits nonzero", r.returncode != 0, last(r))


def main():
    if sys.argv[1:2] == ["--rev"]:
        try:
            findings = scan_repo(sys.argv[2])
        except ScanError as e:
            print(f"FAIL {e}")
            return 2
        for p, n, why in findings:
            print(f"{p}:{n}: {why}")
        return 1 if findings else 0
    with tempfile.TemporaryDirectory() as work:
        header_file = os.path.join(work, "internal-service-token.header")
        with open(header_file, "w") as f:
            f.write(f"{TOKEN_NAME}: sekrit-value\n")
        check_python_helper(header_file)
        check_copies(header_file)
        check_urlopen()
        check_shell_helper(header_file, work)
        check_not_vacuous(work)
    for name, (path, text) in SENDERS.items():
        f = scan(path, text)
        check(f"scanner flags the known sender: {name}", bool(f))
    for name, (path, text) in LEGIT.items():
        f = scan(path, text, {"TOKEN_FILE"})  # a holder name from another file
        check(f"scanner passes the loopback use: {name}", not f, repr(f))
    try:
        findings = scan_repo()
    except ScanError as e:
        check("the repository scan has files to scan", False, str(e))
    else:
        for p, n, why in findings:
            print(f"     {p}:{n}: {why}")
        check("no tracked script or doc sends the token outside loopback internal ports", not findings,
              f"{len(findings)} finding(s)")
    print(f"\n{len(PASS)} passed, {len(FAIL)} failed")
    return 1 if FAIL else 0


if __name__ == "__main__":
    sys.exit(main())
