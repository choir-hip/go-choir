#!/usr/bin/env python3
"""Selftest: the host-internal service token never goes to a guest.

docs/problems/host-internal-token-sent-to-guests-by-fp0-probes-2026-10-22.md.
hostauth.MarkInternal (internal/hostauth/hostauth.go) sends the token only to
a loopback host on an internal service port. Host-side scripts and the
commands in docs must keep the same promise. Guest routes gate on the host
source address and guests run hostauth off, so a guest read needs only the
marker header (X-Internal-Caller).

Ways a script or doc could break the promise (written before the helpers):
  1. A curl line attaches the header file (-H @.../internal-service-token.header)
     and names a guest URL (http://<guest-ip>:8085, http://{ip}:8085).
  2. A variable or function holds the header (VMCTL_AUTH, auth, AUTH,
     choir_internal_auth, auth_headers()), and a request two lines away
     uses it with a guest URL.
  3. A function builds its headers from the token and takes the URL as a
     parameter, so the destination is whatever the caller passes
     (density/host_collect.py http_json).
  4. The raw token is sent under its header name (X-Choir-Internal-Token)
     to a URL from the command line (paper_boot_window_probe.py --guest).
  5. The destination is loopback but on a guest DNAT or other port
     (127.0.0.1:8085), or a lookalike host (localhost.evil, 127.0.0.1@guest).
  6. The helpers themselves attach the token to a non-loopback or
     non-internal destination, or drop the marker.
  7. A function sends the token to a destination it takes as a parameter,
     and no call site in its file names an allowed one (or none calls it).
  8. One request statement spans several physical lines (Python implicit
     concatenation), so the verb, the token and the destination are on
     different lines (desk_cell_confinement_probe.py internal_post, found
     2026-10-22 13:33). A destination the check cannot resolve is not
     loopback: it fails.

What it checks:
  A. The Python helper scripts/choir_internal.py (internal_headers,
     internal_curl_flags) and the shell helper scripts/lib/choir_internal.sh
     (choir_internal_curl) over a table of URLs: the token only for
     127.0.0.1, ::1 or localhost on 8083, 8084, 8086, 8087; the marker always.
  B. The scanner on fixtures: each known sender shape (1-5) is flagged, and
     the legitimate loopback shapes in the repo are not.
     The copy in density/host_collect.py (piped alone to the host) is the
     helper's source, verbatim, and passes the same table.
  C. The scanner over every tracked file (except Go, which uses
     MarkInternal): every request that carries the token, directly or
     through a variable or function that holds it, names only allowed
     destinations. A request whose destination it cannot resolve is flagged.
     Calls to the helpers carry no token by this check's reckoning: A
     proves the helpers. A function named like a helper anywhere else is
     scanned like any other, and flagged if it carries the token.

  D. The check cannot pass vacuously (review bunch 44): outside a git
     work tree, at a revision that does not exist, or with no file naming
     the header file or the token header, it exits nonzero.

Run: scripts/selftest-guest-token            (exit 0 when every check passes)
     scripts/selftest-guest-token --rev REV  (scan C only, at a git revision)
"""
import io
import os
import re
import subprocess
import sys
import tempfile
import tokenize
import urllib.parse

HERE = os.path.dirname(os.path.abspath(__file__))
REPO = os.path.dirname(HERE)

TOKEN_PATH = "internal-service-token.header"
TOKEN_NAME = "X-Choir-Internal-Token"
ALLOWED_HOSTS = {"127.0.0.1", "::1", "localhost"}
ALLOWED_PORTS = {"8083", "8084", "8086", "8087"}
# The helpers and this file are proven by A, not scanned by C.
SKIP_FILES = {"scripts/selftest-guest-token", "scripts/choir_internal.py", "scripts/lib/choir_internal.sh"}
# A verbatim copy of the Python helper, for a file piped alone to the host;
# check_copies proves it is the helper.
PROVEN_COPIES = {"scripts/density/host_collect.py"}
HELPER_CALL = re.compile(r"\b(?:internal_headers|internal_curl_flags|internal_urlopen|choir_internal_curl|choir_internal_token_allowed)\b")
HELPER_DEF = re.compile(r"^\s*(?:def\s+(?:internal_headers|internal_curl_flags|internal_urlopen|token_allowed)\s*\(|(?:choir_internal_curl|choir_internal_token_allowed)\s*\(\)\s*\{)")
VERB = re.compile(r"\bcurl\b|\bwget\b|\bRequest\(|\burlopen\(|\bhttp_json\(|(?<![\w.])http\(|(?<![\w.])get\(|\bfetch\(|\brequests\.\w+\(")
URL = re.compile(r"https?://([^/\s'\"`?#]+)")
BARE = re.compile(r"(?<![\w/.@:-])(localhost|127\.0\.0\.1|\[::1\]):(\d+)")
ASSIGN = re.compile(r"(?:^|(?<=[\s;(]))(?:export\s+|const\s+|let\s+|var\s+|local\s+|readonly\s+)?([A-Za-z_]\w*)(?:\[[^\]]*\])?\s*\+?=(?![=~])")


# ------------------------------------------------------------------ the rule

def split_hostport(hostport):
    hostport = hostport.rsplit("@", 1)[-1]
    if hostport.startswith("["):
        host, _, rest = hostport[1:].partition("]")
        return host, rest[1:] if rest.startswith(":") else ""
    host, _, port = hostport.partition(":")
    return host, port


def allowed(host, port):
    return host in ALLOWED_HOSTS and port in ALLOWED_PORTS


# --------------------------------------------------------------- the scanner

def is_python(path, text):
    return path.endswith(".py") or text.startswith("#!/usr/bin/env python")


def python_spans(text):
    """Python statements that span physical lines through brackets: first
    line -> last line. A statement holding a multi-line string is left as
    physical lines, so code embedded in a string (a remote script) is still
    read line by line. Up to the first token error, if any."""
    spans, first, last, multiline_token = {}, None, None, False
    try:
        for tok in tokenize.generate_tokens(io.StringIO(text).readline):
            if tok.type in (tokenize.NL, tokenize.COMMENT, tokenize.INDENT, tokenize.DEDENT, tokenize.ENCODING):
                continue
            if tok.type in (tokenize.NEWLINE, tokenize.ENDMARKER):
                if first is not None and last > first and not multiline_token:
                    spans[first] = last
                first, multiline_token = None, False
                continue
            if first is None:
                first = tok.start[0]
            last = tok.end[0]
            multiline_token = multiline_token or tok.start[0] != tok.end[0]
    except (tokenize.TokenError, SyntaxError):
        pass
    return spans


def logical_lines(text, python=False):
    """(first line number, text) with backslash continuations joined, and in
    Python every bracketed statement joined into one line."""
    phys = text.splitlines()
    if python:
        spans = python_spans(text)
        if spans:
            joined, n = [], 1
            while n <= len(phys):
                end = spans.get(n, n)
                joined.append((n, " ".join(x.strip() if k else x for k, x in enumerate(phys[n - 1:end]))))
                n = end + 1
            return joined
    out, buf, start = [], "", None
    for n, line in enumerate(phys, 1):
        if start is None:
            start = n
        if line.rstrip().endswith("\\"):
            buf += line.rstrip()[:-1] + " "
            continue
        out.append((start, buf + line))
        buf, start = "", None
    if buf:
        out.append((start, buf))
    return out


PY_DEF = re.compile(r"^(\s*)(?:async\s+)?def\s+([A-Za-z_]\w*)\s*\(")
SH_DEF = re.compile(r"^(\s*)(?:function\s+)?([A-Za-z_]\w*)\s*\(\)\s*\{")
JS_DEF = re.compile(r"^(\s*)(?:export\s+)?(?:async\s+)?function\s+([A-Za-z_]\w*)\s*\(")


def blocks(lines):
    """Function definitions: name -> (first index, last index) in lines."""
    found = {}
    for i, (_, line) in enumerate(lines):
        m = PY_DEF.match(line)
        if m:  # Python: the indented body
            indent = len(m.group(1))
            j = i + 1
            while j < len(lines):
                body = lines[j][1]
                if body.strip() and len(body) - len(body.lstrip()) <= indent:
                    break
                j += 1
            found[m.group(2)] = (i, j - 1)
            continue
        m = SH_DEF.match(line) or JS_DEF.match(line)
        if m:  # shell, JS: to the closing brace at the definition's indent
            j = i + 1
            while j < len(lines) - 1 and not re.match(re.escape(m.group(1)) + r"\}", lines[j][1]):
                j += 1
            found[m.group(2)] = (i, j)
    return found


def ref_pattern(name):
    alts = [r"\$\{?" + re.escape(name) + r"\b", r"\{" + re.escape(name) + r"\b"]
    if len(name) >= 2:
        alts.append(r"(?<![\w\-/.$])" + re.escape(name) + r"\b")
    return re.compile("|".join(alts))


def refs(line, names):
    return any(ref_pattern(n).search(line) for n in names)


def holders(lines, skip, defs, seed=()):
    """Names whose value is the token or its header: assigned, on a line
    that makes no request, from something that carries it; or functions
    whose body carries it and makes no request. To a fixed point."""
    names = set(seed)

    def carries(text):
        return TOKEN_PATH in text or TOKEN_NAME in text or refs(text, names)

    while True:
        before = len(names)
        for i, (_, line) in enumerate(lines):
            if i in skip or HELPER_CALL.search(line) or VERB.search(line) or not carries(line):
                continue
            for m in ASSIGN.finditer(line):
                prev = line[:m.start(1)].rstrip()
                if prev.endswith((",", "(")) and not prev.endswith("=("):
                    continue  # a keyword argument, not an assignment
                if carries(line[m.end():]):
                    names.add(m.group(1))
        for name, (a, b) in defs.items():
            if name in names or a in skip:
                continue
            body = [lines[k][1] for k in range(a + 1, b + 1)]
            if any(carries(x) for x in body) and not any(VERB.search(x) and carries(x) for x in body):
                names.add(name)
        if len(names) == before:
            return names


def url_assignments(lines, defs):
    """name -> the literal destinations it names: a variable assigned a URL,
    or a function whose body names one."""
    found = {}
    for _, line in lines:
        m = ASSIGN.search(line)
        if m:
            d = destinations(line[m.end():])
            if d:
                found.setdefault(m.group(1), d)
    for name, (a, b) in defs.items():
        d = [x for k in range(a + 1, b + 1) for x in destinations(lines[k][1])]
        if d:
            found.setdefault(name, d)
    return found


def destinations(line):
    out = []
    for m in URL.finditer(line):
        host, port = split_hostport(m.group(1))
        out.append((host, re.match(r"\d*", port).group(0) if re.match(r"\d", port) else port))
    out += [(m.group(1).strip("[]"), m.group(2)) for m in BARE.finditer(line)]
    return out


def scan(path, text, global_names=()):
    """Findings for one file: (path, line, why)."""
    lines = logical_lines(text, is_python(path, text))
    defs = blocks(lines)
    skip, findings_def = set(), []
    for a, b in defs.values():
        if HELPER_DEF.match(lines[a][1]):
            if path in PROVEN_COPIES:
                skip.update(range(a, b + 1))
            elif any(TOKEN_PATH in lines[k][1] or TOKEN_NAME in lines[k][1] for k in range(a, b + 1)):
                findings_def.append((path, lines[a][0], "defines a helper name that carries the token, outside the proven helpers"))
    # A name this file assigns itself is its own, not another file's holder
    # (claude_delegate_probe.py's TOKEN_FILE is the Claude token's path).
    assigned = {m.group(1) for _, line in lines for m in ASSIGN.finditer(line)}
    names = holders(lines, skip, defs, set(global_names) - assigned)
    def_lines = {a for a, _ in defs.values()}
    urls = url_assignments(lines, defs)

    def enclosing(i):
        inner = None
        for name, (a, b) in defs.items():
            if a < i <= b and (inner is None or a > defs[inner][0]):
                inner = name
        return inner

    # Senders whose destination is a parameter: their callers are checked.
    # sender -> the lines where its destination went unresolved.
    senders = {}
    while True:
        findings, grew = [], False
        for i, (n, line) in enumerate(lines):
            if i in skip or i in def_lines:
                continue
            calls = refs(line, senders)
            if not (TOKEN_PATH in line or TOKEN_NAME in line or refs(line, names) or calls):
                continue
            dests = destinations(line)
            if not dests and (VERB.search(line) or calls):
                for ident in set(re.findall(r"[A-Za-z_]\w*", line)):
                    dests += urls.get(ident, [])
                if not dests:
                    f = enclosing(i)
                    if f:
                        grew = grew or f not in senders
                        senders.setdefault(f, set()).add(n)
                    else:
                        findings.append((path, n, "carries the token to a destination this check cannot resolve"))
                    continue
            for host, port in dests:
                if not allowed(host, port):
                    findings.append((path, n, f"carries the token to {host}:{port or '(no port)'}"))
        if not grew:
            break
    # Fail closed: a sender no call site in this file reaches is never
    # judged by its callers, so its unresolved destination fails here.
    for f, at in sorted(senders.items()):
        a, b = defs[f]
        called = any(refs(lines[i][1], {f}) for i in range(len(lines))
                     if i not in def_lines and not a < i <= b)
        if not called:
            for n in sorted(at):
                findings.append((path, n, f"carries the token from {f}() to a destination it takes from a caller this file does not have"))
    return findings_def + findings


def global_names_of(texts):
    """Long upper-case names that hold the token cross files (imports)."""
    out = set()
    for path, text in texts.items():
        lines = logical_lines(text, is_python(path, text))
        out |= {x for x in holders(lines, set(), blocks(lines)) if re.fullmatch(r"[A-Z][A-Z0-9_]{7,}", x)}
    return out


class ScanError(Exception):
    """The scan has nothing to stand on: it must fail, never pass empty."""


def git(*args, ok=(0,)):
    r = subprocess.run(["git", "-C", REPO, *args], capture_output=True, text=True, check=False)
    if r.returncode not in ok:
        raise ScanError(f"git {args[0]} exited {r.returncode}: {r.stderr.strip()[:200]}")
    return r.stdout


def require_repo(rev):
    if git("rev-parse", "--is-inside-work-tree", ok=(0, 128)).strip() != "true":
        raise ScanError(f"{REPO} is not a git work tree")
    if rev and not git("rev-parse", "--verify", "--quiet", rev + "^{commit}", ok=(0, 1)).strip():
        raise ScanError(f"no such revision: {rev}")


def tracked(rev, patterns):
    args = ["grep", "-l", "-I"]
    for p in patterns:
        args += ["-e", p]
    if rev:
        args.append(rev)
    args += ["--", ".", ":!*.go"]
    # git grep exits 1 for no match; anything else is an error, not "none".
    paths = [p.split(":", 1)[1] if rev else p for p in git(*args, ok=(0, 1)).splitlines()]
    return [p for p in paths if p not in SKIP_FILES]


def read(rev, path):
    if rev:
        return git("show", f"{rev}:{path}")
    with open(os.path.join(REPO, path), errors="replace") as f:
        return f.read()


def scan_repo(rev=None):
    require_repo(rev)
    seeds = tracked(rev, [TOKEN_PATH, TOKEN_NAME])
    if not seeds:
        # The problem record names the header file, so a real tree has one.
        raise ScanError("no tracked file names the header file or the token header: nothing to scan")
    texts = {p: read(rev, p) for p in seeds}
    globals_ = global_names_of(texts)
    if globals_:
        for p in tracked(rev, sorted(globals_)):
            texts.setdefault(p, read(rev, p))
    findings = []
    for p in sorted(texts):
        findings += scan(p, texts[p], globals_)
    return findings


# -------------------------------------------------------------------- checks

PASS, FAIL = [], []


def check(name, ok, detail=""):
    (PASS if ok else FAIL).append(name)
    print(("ok   " if ok else "FAIL ") + name + (f": {detail}" if detail and not ok else ""))


URL_TABLE = [
    ("http://127.0.0.1:8083/internal/vmctl/list", True),
    ("http://localhost:8084/provider/x", True),
    ("http://[::1]:8086/internal/platform/objects", True),
    ("http://127.0.0.1:8087/health", True),
    ("localhost:8083/internal/vmctl/list", True),
    ("http://10.200.4.2:8085/internal/debug/pprof/procmem", False),
    ("http://127.0.0.1:8085/internal/debug/pprof/procmem", False),
    ("http://127.0.0.1/internal/vmctl/list", False),
    ("http://127.0.0.1:80830/x", False),
    ("http://10.201.4.2:8083/internal/vmctl/list", False),
    ("http://127.0.0.2:8083/x", False),
    ("http://localhost.evil.example:8083/x", False),
    ("http://127.0.0.1:8083@10.200.4.2:8085/x", False),
    ("http://127.0.0.1:8083#@10.200.4.2:8085/x", True),  # the fragment is never sent
    ("https://choir.news/api/health", False),
    ("http://[::ffff:127.0.0.1]:8083/x", False),
]


def check_python_helper(header_file):
    try:
        sys.path.insert(0, HERE)
        import choir_internal  # noqa: PLC0415
    except ImportError as e:
        check("python helper scripts/choir_internal.py imports", False, str(e))
        return
    for url, want in URL_TABLE:
        h = choir_internal.internal_headers(url, header_file=header_file)
        got = h.get(TOKEN_NAME) == "sekrit-value"
        check(f"internal_headers({url}) {'attaches' if want else 'omits'} the token", got == want, repr(sorted(h)))
        check(f"internal_headers({url}) sends the marker", h.get("X-Internal-Caller") == "true")
        flags = choir_internal.internal_curl_flags(url, header_file=header_file)
        check(f"internal_curl_flags({url}) {'names' if want else 'omits'} the header file",
              (header_file in flags) == want, flags)
        check(f"internal_curl_flags({url}) sends the marker", "X-Internal-Caller: true" in flags)
        if want:
            check(f"internal_curl_flags({url}) uses no proxy and no redirect",
                  "--noproxy '*'" in flags and "--max-redirs 0" in flags, flags)
    h = choir_internal.internal_headers("http://127.0.0.1:8083/x", header_file=header_file + ".missing")
    check("internal_headers with no readable header file sends the marker only", h == {"X-Internal-Caller": "true"}, repr(sorted(h)))


def check_urlopen():
    """internal_urlopen: a token-bearing request follows no redirect and
    takes no proxy from the environment; a plain one is plain urlopen."""
    import http.server  # noqa: PLC0415
    import threading  # noqa: PLC0415
    import urllib.error  # noqa: PLC0415
    import urllib.request  # noqa: PLC0415
    sys.path.insert(0, HERE)
    try:
        import choir_internal  # noqa: PLC0415
    except ImportError:
        return
    seen = []

    class H(http.server.BaseHTTPRequestHandler):
        def do_GET(self):
            seen.append((self.path, self.headers.get(TOKEN_NAME)))
            if self.path == "/redirect":
                self.send_response(302)
                self.send_header("Location", "/landed")
                self.end_headers()
                return
            self.send_response(200)
            self.end_headers()
            self.wfile.write(b"ok")

        def log_message(self, *a):
            pass

    srv = http.server.HTTPServer(("127.0.0.1", 0), H)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    base = f"http://127.0.0.1:{srv.server_address[1]}"
    saved = {k: os.environ.get(k) for k in ("http_proxy", "HTTP_PROXY", "no_proxy", "NO_PROXY")}
    try:
        os.environ["http_proxy"] = os.environ["HTTP_PROXY"] = "http://127.0.0.1:9"  # nothing listens
        os.environ.pop("no_proxy", None)
        os.environ.pop("NO_PROXY", None)
        tok = {TOKEN_NAME: "sekrit-value", "X-Internal-Caller": "true"}
        try:
            r = choir_internal.internal_urlopen(urllib.request.Request(base + "/direct", headers=tok), timeout=5)
            ok = r.read() == b"ok"
        except Exception as e:  # noqa: BLE001
            ok = False
            print("     ", e)
        check("internal_urlopen sends a token-bearing request direct, past an environment proxy", ok)
        seen.clear()
        try:
            choir_internal.internal_urlopen(urllib.request.Request(base + "/redirect", headers=tok), timeout=5)
            refused = False
        except urllib.error.HTTPError as e:
            refused = e.code == 302
        except Exception:  # noqa: BLE001 - any other error is a failure, not a crash
            refused = False
        check("internal_urlopen refuses a token-bearing request's redirect",
              refused and [p for p, _ in seen] == ["/redirect"], repr(seen))
        os.environ["no_proxy"] = os.environ["NO_PROXY"] = "127.0.0.1"
        seen.clear()
        r = choir_internal.internal_urlopen(urllib.request.Request(base + "/redirect", headers={"X-Internal-Caller": "true"}), timeout=5)
        check("internal_urlopen follows a plain request's redirect, as urlopen does",
              r.read() == b"ok" and [p for p, _ in seen] == ["/redirect", "/landed"], repr(seen))
    finally:
        for k, v in saved.items():
            if v is None:
                os.environ.pop(k, None)
            else:
                os.environ[k] = v
        srv.shutdown()


def check_copies(header_file):
    sys.path.insert(0, HERE)
    try:
        import choir_internal  # noqa: PLC0415
    except ImportError:
        return
    import importlib.util  # noqa: PLC0415
    for rel in sorted(PROVEN_COPIES):
        spec = importlib.util.spec_from_file_location("copy", os.path.join(REPO, rel))
        mod = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(mod)
        with open(choir_internal.__file__) as f:
            helper = f.read()
        block = helper[helper.index("TOKEN_HEADER_FILE = "):helper.index("def internal_curl_flags(")].rstrip()
        with open(os.path.join(REPO, rel)) as f:
            check(f"{rel} carries scripts/choir_internal.py from TOKEN_HEADER_FILE to internal_urlopen, verbatim",
                  block in f.read())
        for const in ("TOKEN_HEADER_FILE", "MARKER", "LOOPBACK_HOSTS", "INTERNAL_PORTS", "TOKEN_HEADER_NAME"):
            check(f"{rel} {const} is the helper's", getattr(mod, const, None) == getattr(choir_internal, const))
        if not hasattr(mod, "internal_headers"):
            continue
        for url, want in URL_TABLE:
            h = mod.internal_headers(url, header_file=header_file)
            check(f"{rel} internal_headers({url}) {'attaches' if want else 'omits'} the token",
                  (h.get(TOKEN_NAME) == "sekrit-value") == want and h.get("X-Internal-Caller") == "true")


def check_shell_helper(header_file, work):
    lib = os.path.join(HERE, "lib", "choir_internal.sh")
    if not os.path.exists(lib):
        check("shell helper scripts/lib/choir_internal.sh exists", False)
        return
    fake = os.path.join(work, "curl")
    with open(fake, "w") as f:
        f.write('#!/bin/sh\nfor a in "$@"; do printf "%s\\n" "$a"; done\n')
    os.chmod(fake, 0o755)
    for url, want in URL_TABLE:
        script = f'. "$1"; CHOIR_INTERNAL_TOKEN_HEADER="$2" choir_internal_curl "$3" -fsS'
        for shell in ("sh", "bash"):
            r = subprocess.run([shell, "-c", script, shell, lib, header_file, url], capture_output=True, text=True,
                               env={**os.environ, "PATH": work + os.pathsep + os.environ["PATH"]})
            argv = r.stdout.splitlines()
            check(f"{shell} choir_internal_curl {url} {'attaches' if want else 'omits'} the token",
                  r.returncode == 0 and (("@" + header_file) in argv) == want, r.stdout + r.stderr)
            check(f"{shell} choir_internal_curl {url} sends the marker and the URL",
                  "X-Internal-Caller: true" in argv and argv[-1:] == [url])
            if want:
                check(f"{shell} choir_internal_curl {url} uses no proxy", argv[:2] == ["--noproxy", "*"], repr(argv[:2]))
    r = subprocess.run(["bash", "-c", f'. "$1"; choir_internal_curl http://127.0.0.1:8083/x -L', "bash", lib],
                       capture_output=True, text=True, env={**os.environ, "PATH": work + os.pathsep + os.environ["PATH"]})
    check("choir_internal_curl refuses -L (curl resends custom headers on a redirect)", r.returncode != 0)


