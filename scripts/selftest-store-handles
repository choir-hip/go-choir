#!/usr/bin/env bash
# Selftest for scripts/check-store-handles: it passes a tree whose raw graph
# reads are in the graph's owners, and fails on a raw read from agentcore.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
F=scripts/testdata/store-handles
fail() { echo "selftest-store-handles FAIL: $*" >&2; exit 1; }
python3 -I scripts/check-store-handles --root $F/good --allowlist $F/good/allowlist.json >/dev/null || fail "refused the good fixture"
python3 -I scripts/check-store-handles --root $F/bad --allowlist $F/bad/allowlist.json >/dev/null 2>&1 && fail "accepted a raw read from agentcore"
tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' EXIT
echo '{"files": {"internal/agentcore/c.go": 1}}' > "$tmp/a.json"
python3 -I scripts/check-store-handles --root $F/bad --allowlist "$tmp/a.json" >/dev/null 2>&1 || fail "refused a read inside its allowlist entry"
echo '{"files": {"internal/agentcore/c.go": 3}}' > "$tmp/t.json"
python3 -I scripts/check-store-handles --root $F/bad --allowlist "$tmp/t.json" --tighten >/dev/null
[ "$(tr -d ' \n' < "$tmp/t.json")" = '{"files":{"internal/agentcore/c.go":1}}' ] || fail "tighten did not lower to 1"
python3 -I scripts/check-store-handles >/dev/null || fail "refused the real tree"
echo "selftest-store-handles: ok"
