#!/usr/bin/env bash
# The CI deploy gate on Node B (SDC SEC-14;
# docs/problems/ci-deploys-to-node-b-as-root-2026-10-21.md).
#
# CI logs in as choir-deploy, whose only authorized key is forced to run
# `sudo -n <this gate> -- "$SSH_ORIGINAL_COMMAND"` (nix/node-b.nix). The
# caller picks a verb and typed values, never a program:
#
#   receipt
#   prebuild DEPLOY_COMMIT=<sha> DEPLOY_FRONTEND=<bool> DEPLOY_HOST=<bool>
#            DEPLOY_HOST_OS=<bool> HOST_SERVICES=<names>
#   deploy   the prebuild keys plus DEPLOY_RUN_ID=<n> DEPLOY_RUN_ATTEMPT=<n>
#            DEPLOY_VMCTL_RESTART=<bool> DEPLOY_ACTIVE_VM_REFRESH=<bool>
#            REFRESH_ACTIVE_COMPUTERS=<bool>
#
# For prebuild and deploy the gate fetches main and the commit, refuses a
# commit that is not an ancestor of origin/main (GitHub serves fork pull
# request heads by SHA too), and runs .github/scripts/node-b-ci-<verb> as
# read from that commit, as root, with only the typed values in its
# environment. Anything else is refused with status 2.
#
# `--print-plan <request>` parses and prints the plan without running it
# (.github/scripts/node-b-ci-gate-test).
set -euo pipefail
export PATH=/run/wrappers/bin:/run/current-system/sw/bin:/usr/bin:/bin
umask 022

repo_url=https://github.com/choir-hip/go-choir.git
receipt=/var/lib/go-choir/deploy-receipt.json
# The host floor (SEC-14; bunch 4b B1, re-review F1 and F2). Prebuild and
# deploy refuse a commit that does not descend from the floor. Commits below
# it may put the CI key back on root (the deploy-1 and deploy-2 commits do).
# A deploy holds an exclusive flock from before the floor check through its
# run, and raises the floor to its commit by compare-and-swap, so the floor
# never goes down. With no floor file the floor is the bootstrap marker,
# which only a NixOS activation writes (nix/node-b.nix; step 3 removes that
# activation) and the first deploy consumes. With neither, everything is
# refused.
floor_file=/var/lib/go-choir/ci-gate-floor
bootstrap_file=/var/lib/go-choir/ci-gate-floor-bootstrap
lock_wait=3600
max_request=2048

refuse() {
  echo "node-b-ci-gate: refused: $*" >&2
  exit 2
}

prebuild_keys=(DEPLOY_COMMIT DEPLOY_FRONTEND DEPLOY_HOST DEPLOY_HOST_OS HOST_SERVICES)
deploy_keys=(DEPLOY_COMMIT DEPLOY_RUN_ID DEPLOY_RUN_ATTEMPT DEPLOY_HOST DEPLOY_FRONTEND
  DEPLOY_VMCTL_RESTART DEPLOY_ACTIVE_VM_REFRESH REFRESH_ACTIVE_COMPUTERS DEPLOY_HOST_OS HOST_SERVICES)

value_ok() {
  local key="$1"
  local value="$2"
  case "$key" in
    DEPLOY_COMMIT) [[ "$value" =~ ^[0-9a-f]{40}$ ]] ;;
    DEPLOY_RUN_ID | DEPLOY_RUN_ATTEMPT) [[ "$value" =~ ^[1-9][0-9]{0,19}$ ]] ;;
    HOST_SERVICES) [[ "$value" =~ ^([a-z][a-z0-9-]{0,39}(,[a-z][a-z0-9-]{0,39}){0,31})?$ ]] ;;
    *) [[ "$value" == true || "$value" == false ]] ;;
  esac
}

# parse REQUEST: sets verb, repo, script and the env array (KEY=value, in
# the verb's fixed key order), or refuses.
parse() {
  local request="$1"
  if ((${#request} > max_request)); then
    refuse "request longer than ${max_request} bytes"
  fi
  # One space between words, no other whitespace, a closed alphabet. This
  # alone keeps every shell metacharacter, glob and newline out.
  if ! [[ "$request" =~ ^[a-z]+(\ [A-Z_]+=[a-z0-9,-]*)*$ ]]; then
    refuse "malformed request"
  fi
  local words
  read -r -a words <<<"$request"
  verb="${words[0]}"
  local keys
  case "$verb" in
    receipt)
      ((${#words[@]} == 1)) || refuse "receipt takes no arguments"
      repo=
      script=
      env=()
      return 0
      ;;
    prebuild)
      repo=/opt/go-choir-prebuild
      keys=("${prebuild_keys[@]}")
      ;;
    deploy)
      repo=/opt/go-choir
      keys=("${deploy_keys[@]}")
      ;;
    *) refuse "unknown verb" ;;
  esac
  script=".github/scripts/node-b-ci-${verb}"

  local -A given=()
  local word key value
  for word in "${words[@]:1}"; do
    key="${word%%=*}"
    value="${word#*=}"
    local known=false k
    for k in "${keys[@]}"; do
      [ "$k" = "$key" ] && known=true
    done
    [ "$known" = true ] || refuse "unknown key ${key} for ${verb}"
    [ -z "${given[$key]+set}" ] || refuse "duplicate key ${key}"
    value_ok "$key" "$value" || refuse "invalid value for ${key}"
    given[$key]="$value"
  done
  env=()
  for key in "${keys[@]}"; do
    [ -n "${given[$key]+set}" ] || refuse "missing key ${key} for ${verb}"
    env+=("${key}=${given[$key]}")
  done
}

print_plan() {
  echo "verb=${verb}"
  [ "$verb" = receipt ] && return 0
  echo "repo=${repo}"
  echo "script=${script}"
  local entry
  for entry in "${env[@]}"; do
    echo "env=${entry}"
  done
}

commit_from_env() {
  local entry
  for entry in "${env[@]}"; do
    case "$entry" in
      DEPLOY_COMMIT=*) printf '%s\n' "${entry#DEPLOY_COMMIT=}" ;;
    esac
  done
}

# read_floor_file FILE: print the single commit FILE holds, or refuse.
read_floor_file() {
  local file="$1"
  local floor
  floor=$(<"$file") || refuse "floor ${file} is unreadable"
  [[ "$floor" =~ ^[0-9a-f]{40}$ ]] || refuse "floor ${file} is malformed"
  printf '%s\n' "$floor"
}

# current_floor: the floor file, else the bootstrap marker, else refuse.
current_floor() {
  if [ -e "$floor_file" ] || [ -L "$floor_file" ]; then
    read_floor_file "$floor_file"
  elif [ -e "$bootstrap_file" ] || [ -L "$bootstrap_file" ]; then
    read_floor_file "$bootstrap_file"
  else
    refuse "no floor (${floor_file}) and no bootstrap marker; root must restore the floor"
  fi
}

# lock_gate: take the gate's exclusive lock on fd 9 for the rest of this
# process. The test modes do not wait.
lock_gate() {
  exec 9>>"${floor_file}.lock" || refuse "cannot open the gate lock"
  if [ "$lock_wait" -eq 0 ]; then
    flock -x -n 9 || refuse "gate busy"
  else
    flock -x -w "$lock_wait" 9 || refuse "gate busy for ${lock_wait}s"
  fi
}

# check_floor REPO COMMIT: refuse unless COMMIT descends from the current
# floor; on success set checked_floor.
check_floor() {
  local repo="$1"
  local commit="$2"
  local floor
  floor=$(current_floor) || exit 2
  git -C "$repo" cat-file -e "${floor}^{commit}" 2>/dev/null ||
    refuse "floor ${floor} is not in ${repo}"
  git -C "$repo" merge-base --is-ancestor "$floor" "$commit" 2>/dev/null ||
    refuse "commit ${commit} is below the floor ${floor}"
  checked_floor="$floor"
}

# advance_floor REPO COMMIT EXPECTED: compare-and-swap, under the lock. The
# floor on disk must still be EXPECTED and COMMIT must descend from it; then
# COMMIT becomes the floor and the bootstrap marker is consumed.
advance_floor() {
  local repo="$1"
  local commit="$2"
  local expected="$3"
  local now
  now=$(current_floor) || exit 2
  [ "$now" = "$expected" ] || refuse "floor moved from ${expected} to ${now}"
  git -C "$repo" merge-base --is-ancestor "$now" "$commit" 2>/dev/null ||
    refuse "commit ${commit} is below the floor ${now}"
  local tmp="${floor_file}.tmp.$$"
  { printf '%s\n' "$commit" >"$tmp" && mv -f "$tmp" "$floor_file"; } ||
    { rm -f "$tmp"; refuse "cannot record floor ${commit}"; }
  rm -f "$bootstrap_file"
}

run() {
  if [ "$verb" = receipt ]; then
    exec cat "$receipt"
  fi
  [ "$(id -u)" -eq 0 ] || refuse "the gate runs as root (through sudo)"
  local commit
  commit=$(commit_from_env)

  # A deploy holds the lock from before its first git command through its
  # run: the floor check (F1), and the clone and fetch of /opt/go-choir,
  # which a running deploy's program resets and cleans under the lock
  # (bunch 33). Prebuild only checks: it never activates and never moves
  # the floor.
  [ "$verb" = deploy ] && lock_gate

  export HOME=/root
  # The clone and the fetch do not inherit the lock fd: an automatic gc or
  # maintenance that git detaches after them must not hold the lock.
  if [ ! -d "$repo/.git" ]; then
    git clone --quiet "$repo_url" "$repo" >&2 9>&-
  fi
  git config --global --add safe.directory "$repo"
  # The origin URL is the trust root for "on main"; never take it from the
  # checkout.
  git -C "$repo" remote set-url origin "$repo_url"
  git -C "$repo" fetch --quiet --no-tags origin \
    "+refs/heads/main:refs/remotes/origin/main" "$commit" >&2 9>&-
  if ! git -C "$repo" merge-base --is-ancestor "$commit" refs/remotes/origin/main; then
    refuse "commit ${commit} is not on main"
  fi
  checked_floor=
  check_floor "$repo" "$commit"

  local program
  program=$(mktemp /run/go-choir-ci-gate.XXXXXX)
  trap 'rm -f "$program"' EXIT
  git -C "$repo" show "${commit}:${script}" >"$program" ||
    refuse "commit ${commit} has no ${script}"
  [ "$verb" = deploy ] && advance_floor "$repo" "$commit" "$checked_floor"

  echo "node-b-ci-gate: ${verb} ${commit} as root from ${script}" >&2
  # A clean root environment, as a NixOS root login would have it, plus the
  # typed values. The program runs from its file with stdin closed, so no
  # command in it can read its later lines; the child does not inherit the
  # lock fd, so nothing it leaves running can hold the lock.
  local status=0
  env -i HOME=/root USER=root LOGNAME=root SHELL=/run/current-system/sw/bin/bash \
    PATH=/run/wrappers/bin:/run/current-system/sw/bin "${env[@]}" \
    /run/current-system/sw/bin/bash -c \
    'if [ -r /etc/set-environment ]; then . /etc/set-environment; fi; exec /run/current-system/sw/bin/bash "$1"' \
    node-b-ci-program "$program" <"/dev/null" 9>&- || status=$?
  exit "$status"
}

mode="${1:-}"
case "$mode" in
  --test-floor | --test-advance | --test-cas)
    # Tests only (.github/scripts/node-b-ci-gate-test): the floor logic on a
    # caller's repo, floor file and bootstrap marker. Never as root.
    [ "$(id -u)" -ne 0 ] || refuse "test modes never run as root"
    want=5
    [ "$mode" = --test-cas ] && want=6
    [ "$#" -eq "$want" ] || refuse "usage: node-b-ci-gate $mode <repo> <floor-file> <bootstrap-file> [<expected>] <commit>"
    floor_file="$3"
    bootstrap_file="$4"
    lock_wait=0
    for sha in "${@:5}"; do
      [[ "$sha" =~ ^[0-9a-f]{40}$ ]] || refuse "invalid commit"
    done
    checked_floor=
    case "$mode" in
      --test-floor) check_floor "$2" "$5" ;;
      --test-advance)
        lock_gate
        check_floor "$2" "$5"
        advance_floor "$2" "$5" "$checked_floor"
        ;;
      --test-cas)
        lock_gate
        advance_floor "$2" "$6" "$5"
        ;;
    esac
    exit 0
    ;;
  --print-plan | --) ;;
  *) refuse "usage: node-b-ci-gate (--print-plan | --) <request>" ;;
esac
[ "$#" -eq 2 ] || refuse "usage: node-b-ci-gate (--print-plan | --) <request>"

verb=
repo=
script=
env=()
parse "$2"
if [ "$mode" = --print-plan ]; then
  print_plan
  exit 0
fi
run
