#!/bin/sh
# removed-computers-sweep: delete the tape segments, snapshot chunks, file
# roots and per-computer rows of an exact list of removed computers, through
# corpusd's destroyed tape sweep (internal/platform/tape_sweep.go). Run as root
# on Node B. The sweep proves each named id destroyed (no ownership record, not
# in the registry, no route, quiet), refuses the whole request by name if any
# named id fails, and lists nothing nobody named.
#
#   removed-computers-sweep dry-run --ids ID[,ID...] [--no-archive]
#   removed-computers-sweep apply   --ids ID[,ID...] --run-id RUN --manifest-sha256 HASH [--no-archive]
#
# dry-run writes nothing but a manifest and prints, per computer, its bytes by
# class, its last head time, the ownership answer and how many chunk digests a
# living computer's snapshot also names. apply deletes exactly that manifest
# and needs the same ids, the run id and the manifest hash the dry run printed;
# its receipt is the report file it prints. A computer that gained an owner in
# between is skipped and the command exits 1. Without --no-archive each
# computer's files are first archived under tape-sweep-archive (decision D1),
# which keeps a compressed copy on the same disk.
#
# CORPUSD_URL defaults to http://127.0.0.1:8086.
set -eu
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=lib/choir_internal.sh
. "$here/lib/choir_internal.sh"
CORPUSD_URL=${CORPUSD_URL:-http://127.0.0.1:8086}

usage() {
	sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' >&2
	exit 2
}

[ $# -ge 1 ] || usage
action=$1
shift
case $action in dry-run | apply) ;; *) usage ;; esac
ids= run= sha= noarchive=false
while [ $# -gt 0 ]; do
	case $1 in
	--ids) ids=${2:-}; shift 2 || usage ;;
	--run-id) run=${2:-}; shift 2 || usage ;;
	--manifest-sha256) sha=${2:-}; shift 2 || usage ;;
	--no-archive) noarchive=true; shift ;;
	*) usage ;;
	esac
done
[ -n "$ids" ] || { echo "removed-computers-sweep: --ids is required: the exact list of removed computers" >&2; exit 2; }
if [ "$action" = apply ]; then
	[ -n "$run" ] && [ -n "$sha" ] || { echo "removed-computers-sweep: apply needs --run-id and --manifest-sha256 from the dry run" >&2; exit 2; }
fi
if [ "$action" = dry-run ] && { [ -n "$run" ] || [ -n "$sha" ]; }; then
	echo "removed-computers-sweep: --run-id and --manifest-sha256 belong to apply" >&2
	exit 2
fi

body=$(IDS=$ids ACTION=$action RUN=$run SHA=$sha NOARCHIVE=$noarchive python3 -I -c '
import json, os
b = {"action": os.environ["ACTION"], "sweeps": ["destroyed"], "accept_unrecorded_fork_lineage": True,
     "computer_ids": [i for i in os.environ["IDS"].split(",")], "no_archive": os.environ["NOARCHIVE"] == "true"}
if os.environ["ACTION"] == "apply":
    b["run_id"], b["manifest_sha256"] = os.environ["RUN"], os.environ["SHA"]
print(json.dumps(b))
')
start=$(choir_internal_curl "$CORPUSD_URL/internal/platform/artifact-gc/tape" -sS -X POST -H 'Content-Type: application/json' -d "$body")
job=$(printf '%s' "$start" | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("job_id",""))' 2>/dev/null || true)
[ -n "$job" ] || { echo "removed-computers-sweep: the sweep did not start: $start" >&2; exit 1; }
echo "job $job started" >&2
while :; do
	sleep 5
	status=$(choir_internal_curl "$CORPUSD_URL/internal/platform/artifact-gc/tape?job=$job" -sS)
	state=$(printf '%s' "$status" | python3 -I -c 'import json,sys; print(json.load(sys.stdin).get("state",""))')
	[ "$state" = running ] || break
done
printf '%s' "$status" | python3 -I -c '
import json, sys
job = json.load(sys.stdin)
rep = job.get("report") or {}
if job.get("state") != "done":
    print("FAILED:", job.get("error", "unknown"))
    sys.exit(1)
print("run_id", rep.get("run_id"), "action", rep.get("action"))
print("manifest_sha256", rep.get("manifest_sha256", ""))
print("ids", ",".join(rep.get("computer_ids") or []))
for pr in rep.get("destroyed_proofs") or []:
    cl = pr.get("classes") or {}
    mib = lambda k: round((cl.get(k) or {}).get("bytes", 0) / 1048576, 1)
    print(pr["computer_id"], "last_head", pr.get("head_updated_at"), "ownership", pr.get("ownership_lookup"),
          "deletable", pr.get("deletable"), "tape-seg_MiB", mib("tape-seg"), "chunks_MiB", mib("file-cas-chunks"),
          "chunk_files", pr.get("snapshot_chunk_files", 0), "digests_also_in_living_snapshots", pr.get("snapshot_chunks_shared_with_living", 0),
          "rows", pr.get("rows", 0))
print("listed", rep.get("destroyed_listed"), "files", rep.get("destroyed_files"), "bytes", rep.get("destroyed_bytes"))
ap = rep.get("apply")
if ap:
    print("deleted", ap.get("deleted"), "bytes_deleted", ap.get("bytes_deleted"), "computers_deleted", ap.get("computers_deleted"),
          "computers_skipped", ap.get("computers_skipped"), "errors", ap.get("errors"))
print("report", rep.get("report_path", ""))
for w in rep.get("warnings") or []:
    print("warning:", w)
'
