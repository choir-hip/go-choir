#!/usr/bin/env bash
# Selftest for scripts/check-guest-floor-paths (D2 design S1, test 1): the
# check fails on a floor list missing internal/capsule, fails on a list
# missing flake.nix, fails on a listed path that does not exist, and passes
# on the real list. Touches nothing in this tree.
set -euo pipefail

here=$(cd "$(dirname "$0")" && pwd)
root=$(cd "$here/.." && pwd)
guard=$here/check-guest-floor-paths
real=$root/nix/guest-floor-paths.txt
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
fails=0

expect() { # NAME WANT_EXIT ARGS...
	local name=$1 want=$2
	shift 2
	local got=0 out
	out=$(cd "$root" && "$guard" "$@" 2>&1) || got=$?
	if [ "$got" != "$want" ]; then
		echo "FAIL: $name: exit $got, want $want"
		echo "$out" | sed 's/^/    /'
		fails=$((fails + 1))
	else
		echo "ok:   $name"
	fi
}

# drop_line FILE LINE OUT: the list without an exact entry.
drop_line() { grep -vxF "$2" "$1" >"$3"; }

expect "the real list passes" 0 --paths "$real"

drop_line "$real" internal/capsule "$tmp/no-capsule.txt"
cmp -s "$real" "$tmp/no-capsule.txt" && { echo "FAIL: setup: internal/capsule is not in the real list"; fails=$((fails + 1)); }
expect "a list missing internal/capsule fails" 1 --paths "$tmp/no-capsule.txt"

drop_line "$real" flake.nix "$tmp/no-flake.txt"
cmp -s "$real" "$tmp/no-flake.txt" && { echo "FAIL: setup: flake.nix is not in the real list"; fails=$((fails + 1)); }
expect "a list missing flake.nix fails" 1 --paths "$tmp/no-flake.txt"

drop_line "$real" flake.lock "$tmp/no-lock.txt"
expect "a list missing flake.lock fails" 1 --paths "$tmp/no-lock.txt"

drop_line "$real" nix/autoputer-vm.nix "$tmp/no-vmnix.txt"
expect "a list missing nix/autoputer-vm.nix fails" 1 --paths "$tmp/no-vmnix.txt"

{ cat "$real"; echo internal/does-not-exist; } >"$tmp/ghost.txt"
expect "a listed path that does not exist fails" 1 --paths "$tmp/ghost.txt"

# A package covered by a listed ancestor directory passes: replace the leaf
# entry internal/base/blob with its parent internal/base.
sed 's|^internal/base/blob$|internal/base|' "$real" | grep -vxE 'internal/base/(journal|model|tree)' >"$tmp/ancestor.txt"
expect "a package covered by a listed ancestor directory passes" 0 --paths "$tmp/ancestor.txt"

# Comments and blank lines are ignored.
{ echo "# a comment"; echo; cat "$real"; } >"$tmp/comments.txt"
expect "comments and blank lines are ignored" 0 --paths "$tmp/comments.txt"

expect "a missing list file fails" 1 --paths "$tmp/nope.txt"

if [ "$fails" -ne 0 ]; then
	echo "selftest-guest-floor-paths: $fails FAILED" >&2
	exit 1
fi
echo "selftest-guest-floor-paths: PASS"
