#!/usr/bin/env bash
# Node B host disk alarm: one journal line per run with root free space,
# btrfs unallocated space and metadata use
# (docs/problems/node-b-nix-store-and-host-disk-policy-2026-10-22.md).
# Read-only. The priority prefix carries the alarm (journald reads <N> on a
# unit's stdout): <4> warning when free space is under the deploy floor or
# unallocated space is under the metadata headroom line, <3> error under nix
# min-free or 10 GiB unallocated, or when a reading fails; <4> when the
# metadata line cannot be read (metadata use is informational: unallocated
# space is the alarm input for metadata headroom); <6> otherwise. Always
# exits 0: a failed unit is not the alarm. Alarms only:
#   journalctl -u go-choir-host-disk-alarm -p warning
# Every reading, the <6> ones included (a missing quarter-hour line in this
# view means the timer did not run):
#   journalctl -u go-choir-host-disk-alarm
set -u

warn_free="${HOST_DISK_WARN_FREE_GIB:-56}"
warn_unalloc="${HOST_DISK_WARN_UNALLOC_GIB:-20}"
err_free="${HOST_DISK_ERR_FREE_GIB:-24}"
err_unalloc="${HOST_DISK_ERR_UNALLOC_GIB:-10}"
mount="${HOST_DISK_MOUNT:-/}"
GiB=1073741824

if ! avail="$(df --output=avail -B1 "$mount" 2>/dev/null | tail -n 1 | tr -d ' ')" || ! [[ "$avail" =~ ^[0-9]+$ ]]; then
  echo "<3>host disk ERROR: cannot read free space on $mount"
  exit 0
fi
free_gib=$((avail / GiB))

usage="$(btrfs filesystem usage -b "$mount" 2>/dev/null)" || usage=""
unalloc="$(awk '/Device unallocated:/ {print $3; exit}' <<<"$usage")"
if ! [[ "$unalloc" =~ ^[0-9]+$ ]]; then
  echo "<3>host disk ERROR: cannot read btrfs unallocated space on $mount (free ${free_gib} GiB)"
  exit 0
fi
unalloc_gib=$((unalloc / GiB))
meta="$(awk -F'[:, ]+' '/^Metadata,/ {for (i = 1; i <= NF; i++) { if ($i == "Size") s = $(i+1); if ($i == "Used") u = $(i+1) } } END { if (s > 0) printf "metadata %.0f%% of %.1f GiB", u * 100 / s, s / 1073741824 }' <<<"$usage")"

err="" warn=""
[ "$free_gib" -lt "$err_free" ] && err+="free ${free_gib} GiB below ${err_free} GiB (nix min-free); "
[ "$unalloc_gib" -lt "$err_unalloc" ] && err+="btrfs unallocated ${unalloc_gib} GiB below ${err_unalloc} GiB; "
[ "$free_gib" -lt "$warn_free" ] && warn+="free ${free_gib} GiB below ${warn_free} GiB (the deploy floor); "
[ "$unalloc_gib" -lt "$warn_unalloc" ] && warn+="btrfs unallocated ${unalloc_gib} GiB below ${warn_unalloc} GiB (metadata headroom); "
if [ -z "$meta" ]; then
  meta="metadata unknown"
  warn="cannot read btrfs metadata use; ${warn}"
fi
facts="free ${free_gib} GiB, btrfs unallocated ${unalloc_gib} GiB, ${meta}"

if [ -n "$err" ]; then
  echo "<3>host disk ERROR: ${err}${facts}"
elif [ -n "$warn" ]; then
  echo "<4>host disk WARNING: ${warn}${facts}"
else
  echo "<6>host disk ok: ${facts}"
fi
exit 0
