#!/usr/bin/env python3
"""The native-store inventory gate (docs/design/phone-sign-out-and-server-client-in-exact-2026-11-27.md,
station E6.4, failure-list items G2 and D6). Sign-out wipes the native stores someone remembered to
register (AccountWipe.registerStandard); nothing used to fail when native code began to write a file,
a UserDefaults key or a Keychain item that no one registered. This is that failure.

It reads the Swift sources under mobile/AutoradioKit/ and mobile/exact-package/apple/ and
mobile/AutoradioLab/modules/ (Tests/ excluded; tracked and new files, not ignored ones) and counts, per
file, the lines that persist something: file writes (`.write(to:`, FileHandle(forWriting/forUpdating),
createFile, createDirectory, copyItem, moveItem, replaceItem, OutputStream, NSKeyedArchiver, sqlite3_open,
AVAudioFile(forWriting, AVAudioRecorder, AVAssetWriter), downloads (`.download(`, downloadTask),
UserDefaults sets and Keychain adds (SecItemAdd, SecItemUpdate). Comment lines do not count. Deletes and
reads do not count.

scripts/native-stores.txt owns every site. One line per store:
    <file under mobile/> | <token> | <ruling> | <sites>
  token    a string that appears in that file and names the store (a path constant, a key name)
  ruling   wiped:<registration>  the sign-out wipe covers it (the AccountWipe registration, or other code, that does)
           kept:<reason>         deliberately not wiped (device data, a cache, a dev tool), with the reason
           unruled               nobody has decided: counted and printed, a question, not a failure
  sites    how many persistence lines of that file the entry owns
It FAILS when a file has persistence lines the list does not own (the count of a file's entries differs
from the lines found), when a file has entries and no persistence line, when an entry's token is not in
its file, or when a line is malformed. A new site therefore changes this list in the same diff, whatever
its ruling, and the diff shows it.

  scripts/check-native-stores [--root D] [--list F] [--sites]     (--sites prints every line found)
  scripts/check-native-stores --selftest
Run with python3 -I (scripts/gates does).
"""
import argparse, os, re, subprocess, sys, tempfile

ROOTS = ("mobile/AutoradioKit/", "mobile/exact-package/apple/", "mobile/AutoradioLab/modules/")
PAT = re.compile(
    r"\.write\(to:|FileHandle\(for(Writing|Updating)|createFile\(|createDirectory\(|(?<![A-Za-z])copyItem\(|(?<![A-Za-z])moveItem\(|write\(toFile|"
    r"replaceItem(At)?\(|OutputStream|NSKeyedArchiver|sqlite3_open|AVAudioFile\(forWriting|AVAudioRecorder\(|"
    r"AVAssetWriter\(|\.download\(|downloadTask|SecItemAdd|SecItemUpdate|"
    r"(defaults|UserDefaults\.standard)\w*\.(set|setValue|register)\(")
RULING = re.compile(r"^(wiped:\S.*|kept:\S.*|unruled)$")


def die(msg):
    print("native-stores: " + msg, file=sys.stderr)
    sys.exit(2)


def tracked(root):
    out = subprocess.run(["git", "-C", root, "ls-files", "-z", "--cached", "--others", "--exclude-standard"],
                         capture_output=True, text=True, check=True).stdout
    return sorted(p for p in out.split("\0") if p and os.path.isfile(os.path.join(root, p)))


def code(line):
    s = line.strip()
    if s.startswith("//"):
        return ""
    return re.sub(r"\s//.*$", "", line)


def sites(root):
    found = {}
    for p in tracked(root):
        if not (p.endswith(".swift") and p.startswith(ROOTS) and "/Tests/" not in p):
            continue
        for n, raw in enumerate(open(os.path.join(root, p), encoding="utf-8", errors="replace"), 1):
            if PAT.search(code(raw)):
                found.setdefault(p, []).append((n, raw.strip()[:140]))
    return found


def parse(path):
    entries, bad = [], []
    for n, raw in enumerate(open(path, encoding="utf-8"), 1):
        line = raw.strip()
        if not line or line.startswith("#"):
            continue
        parts = [x.strip() for x in line.split(" | ")]
        if len(parts) != 4 or not parts[0] or not parts[1] or not RULING.match(parts[2]) or not parts[3].isdigit() or int(parts[3]) < 1:
            bad.append("%s:%d: want `file | token | wiped:<x>/kept:<why>/unruled | sites`: %s" % (path, n, line))
            continue
        entries.append((parts[0], parts[1], parts[2], int(parts[3]), n))
    return entries, bad


def check(root, listfile):
    found = sites(root)
    entries, bad = parse(listfile)
    owned = {}
    for f, tok, ruling, k, n in entries:
        owned[f] = owned.get(f, 0) + k
        full = os.path.join(root, f)
        if not os.path.isfile(full):
            bad.append("stale: %s names a file that no longer exists (line %d)" % (f, n))
        elif tok not in open(full, encoding="utf-8", errors="replace").read():
            bad.append("stale: token %r is not in %s (line %d)" % (tok, f, n))
    for f in sorted(set(found) | set(owned)):
        have, want = len(found.get(f, [])), owned.get(f, 0)
        if have == want:
            continue
        if want == 0:
            bad.append("unlisted: %s persists at %d line(s) and the list names none: %s" % (
                f, have, "; ".join("%d: %s" % x for x in found[f])))
        elif have == 0:
            bad.append("stale: %s has %d site(s) listed and no persistence line is left" % (f, want))
        else:
            bad.append("count: %s has %d persistence line(s) and the list owns %d: %s" % (
                f, have, want, "; ".join("%d: %s" % x for x in found[f])))
    return found, entries, bad


def summary(found, entries):
    t = {"wiped": 0, "kept": 0, "unruled": 0}
    for _, _, r, k, _ in entries:
        t[r.split(":")[0]] += k
    print("native stores: %d persistence lines in %d files, %d list entries: wiped %d, kept %d, unruled %d" % (
        sum(len(v) for v in found.values()), len(found), len(entries), t["wiped"], t["kept"], t["unruled"]))
    for f, tok, r, k, _ in entries:
        if r == "unruled":
            print("  unruled: %s (%s) x%d" % (f, tok, k))


def selftest():
    fails = []

    def case(name, want_bad, files, lst):
        d = tempfile.mkdtemp(prefix="native-stores-")
        for rel, text in files.items():
            p = os.path.join(d, rel)
            os.makedirs(os.path.dirname(p), exist_ok=True)
            open(p, "w").write(text)
        subprocess.run(["git", "init", "-q"], cwd=d, check=True)
        open(os.path.join(d, "list.txt"), "w").write(lst)
        _, _, bad = check(d, os.path.join(d, "list.txt"))
        ok = bool(bad) == want_bad
        print("%s %s%s" % ("ok  " if ok else "FAIL", name, "" if not bad else "  <- " + bad[0][:90]))
        if not ok:
            fails.append(name)

    K = "mobile/AutoradioKit/Sources/AutoradioKit/"
    base = {K + "A.swift": "let store = \"a.json\"\ntry? d.write(to: store)\n// try? x.write(to: u)\n"}
    lst = "%sA.swift | a.json | kept:test | 1\n" % K
    case("a listed site passes", False, base, lst)
    case("a planted unlisted file fails", True, dict(base, **{K + "B.swift": "try? d.write(to: u)\n"}), lst)
    case("a planted extra line in a listed file fails", True,
         {K + "A.swift": base[K + "A.swift"] + "UserDefaults.standard.set(1, forKey: \"k\")\n"}, lst)
    case("a planted keychain add fails", True, dict(base, **{K + "C.swift": "SecItemAdd(q, nil)\n"}), lst)
    case("a stale entry (no site left) fails", True, {K + "A.swift": "let x = 1\n"}, lst)
    case("a stale entry (token gone) fails", True, base, lst.replace("a.json", "gone.json"))
    case("a stale entry (file gone) fails", True, base, lst + "%sZ.swift | z | kept:x | 1\n" % K)
    case("a bad ruling fails", True, base, lst.replace("kept:test", "maybe"))
    case("Tests/ and comments are not sites", False,
         dict(base, **{"mobile/AutoradioKit/Tests/AutoradioKitTests/T.swift": "try? d.write(to: u)\n"}), lst)
    case("unruled is allowed", False, base, lst.replace("kept:test", "unruled"))
    print("%d failure(s)" % len(fails))
    return 1 if fails else 0


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--root")
    ap.add_argument("--list")
    ap.add_argument("--sites", action="store_true")
    ap.add_argument("--selftest", action="store_true")
    a = ap.parse_args()
    if a.selftest:
        return selftest()
    root = a.root or subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True,
                                    check=True).stdout.strip()
    lf = a.list or os.path.join(root, "scripts/native-stores.txt")
    if a.sites:
        for f, v in sites(root).items():
            for n, t in v:
                print("%s:%d: %s" % (f, n, t))
        return 0
    found, entries, bad = check(root, lf)
    summary(found, entries)
    for b in bad:
        print("FAIL: " + b)
    if bad:
        print("A native store that holds account data must be in the sign-out wipe or named kept with its reason: "
              "edit scripts/native-stores.txt in the same change (docs/evidence/native-stores-inventory-2026-11-27.md).")
        return 1
    print("native stores hold")
    return 0


sys.exit(main())
