#!/usr/bin/env python3
"""Fails when a directory under frontend/src/packages holding a
choir-package.json is not listed in base-packages.json, or a listed name has no
such directory (docs/design/package-operation-decision-2026-11-06.md 2.6).

Run by CI on main only, not by `npm run build` (the capsule's verifier): a
package a capsule adds is checked by check-packages.mjs like any other, but it
is not a base package until a platform change lists it here.
"""
import json
import os
import sys

root = os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "frontend", "src", "packages")
root = os.path.normpath(sys.argv[1] if len(sys.argv) > 1 else root)
with open(os.path.join(root, "base-packages.json")) as f:
    listed = json.load(f)["packages"]
present = sorted(
    n for n in os.listdir(root) if os.path.isfile(os.path.join(root, n, "choir-package.json"))
)
problems = []
for name in present:
    if name not in listed:
        problems.append(f"{name} holds a choir-package.json but is not in base-packages.json")
for name in listed:
    if name not in present:
        problems.append(f"base-packages.json lists {name}, which has no choir-package.json")
if len(set(listed)) != len(listed):
    problems.append("base-packages.json lists a package twice")
if problems:
    print("check-base-packages:\n  " + "\n  ".join(problems), file=sys.stderr)
    sys.exit(1)
print(f"check-base-packages: {len(listed)} base packages, all listed")
