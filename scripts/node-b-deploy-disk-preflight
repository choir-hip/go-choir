#!/usr/bin/env bash
set -euo pipefail

# 60 GiB (2026-10-22, docs/problems/node-b-nix-store-and-host-disk-policy-2026-10-22.md).
# A deploy that starts here must end above nix's min-free (24 GiB in
# nix/node-b.nix), where nix's auto-GC would delete the build's own unrooted
# inputs (the 2026-09-17 deploy loop), with everything that can overlap it:
#   60 >= 24 min-free + 8 deploy + 14 guest store compaction peak + 10 paper regrowth + 4 margin
# scripts/test_node_b_disk_policy.py checks this. The guard below keeps the
# floor above the *live* min-free whatever this default says.
# (Earlier: 100 GiB on 2026-08-26, 90 GiB on 2026-09-15 while min-free was 80.)
min_free_kib="${DEPLOY_MIN_FREE_KIB:-62914560}"

# Every number this script compares has at most 15 digits (999 TB even in
# bytes), so bash's 64-bit arithmetic cannot wrap; it is read as decimal
# (10#, a leading zero is not octal); and a [ that errors refuses the deploy
# instead of making its if false (review round 3, R3-F1).
is_count() { [[ "$1" =~ ^[0-9]{1,15}$ ]]; }
refuse() {
  echo "Deploy disk preflight failed: $*" >&2
  journalctl -u go-choir-host-disk-alarm -n 1 --no-pager >&2 || true
  exit 1
}
at_least() { # $1 >= $2; a comparison that errors refuses the deploy
  local rc=0
  [ "$1" -ge "$2" ] || rc=$?
  [ "$rc" -le 1 ] || refuse "cannot compare \"$1\" with \"$2\""
  return "$rc"
}

# Guard (docs/problems/node-b-nix-store-and-host-disk-policy-2026-10-22.md,
# review rounds 2 and 3): the floor must sit above the min-free nix runs
# with *now*, not the one this checkout will install at its switch, by the
# same terms as the default above (deploy 8 + compaction 14 + regrowth 10 +
# margin 4 = 36 GiB, R3-F2), so the work that can overlap a deploy fits
# whatever min-free is live. Below that, nix's auto-GC can fire inside the
# build and delete its unrooted inputs (2026-09-17). So the floor is the
# larger of the two. A min-free that cannot be read fails closed to the
# band before deploy 1 (80 GiB, node-b.nix's rollback value): 116 GiB. This
# keeps a lowered floor safe if it lands with, or outlives, the min-free
# change it depends on.
#
# The file, not the running nix-daemon, is the source (R3-F3): NixOS
# restarts nix-daemon whenever /etc/nix/nix.conf's store path changes at a
# switch (restartTriggers in nixos/modules/services/system/nix-daemon.nix),
# and a switch that cannot restart it fails the deploy. nix has no call that
# returns the daemon's settings; `nix config show` prints the client's own
# reading of this same file. The preflight runs before this deploy's switch,
# so it reads the file the last completed switch installed.
GiB_KIB=1048576
overlap_kib=$(((8 + 14 + 10 + 4) * GiB_KIB))
fallback_floor_kib=$((80 * GiB_KIB + overlap_kib))
nix_conf="${PREFLIGHT_NIX_CONF:-/etc/nix/nix.conf}"
if is_count "$min_free_kib"; then
  min_free_kib=$((10#$min_free_kib))
else
  echo "    DEPLOY_MIN_FREE_KIB=\"${min_free_kib}\" is not a number of KiB; the floor is at least 116 GiB"
  min_free_kib="$fallback_floor_kib"
fi
live_min_free="$(awk -F'[[:space:]]*=[[:space:]]*' '$1 ~ /^[[:space:]]*min-free$/ {v = $2} END {print v}' "$nix_conf" 2>/dev/null || true)"
if is_count "$live_min_free"; then
  live_min_free_kib=$((10#$live_min_free / 1024))
  guard_floor_kib=$((live_min_free_kib + overlap_kib))
else
  echo "    cannot read min-free from ${nix_conf} (\"${live_min_free}\"); the floor is at least 116 GiB"
  live_min_free_kib=unknown
  guard_floor_kib="$fallback_floor_kib"
fi
if ! at_least "$min_free_kib" "$guard_floor_kib"; then
  min_free_kib="$guard_floor_kib"
fi
avail_kib="$(df --output=avail -k / | tail -n 1 | tr -d ' ')"

echo "==> Deploy disk preflight"
df -h / /var/lib/go-choir 2>/dev/null || df -h /
echo "    root_available_kib=${avail_kib} live_min_free_kib=${live_min_free_kib} min_required_kib=${min_free_kib}"

# Every numeric read fails closed: a df that exits 0 with a non-numeric line
# would make the [ tests below error, and an if whose test errors is false,
# which let the script exit 0 (review round 2b, DS2b-1; length, R3-F1).
if ! is_count "$avail_kib"; then
  refuse "cannot read free space on / (df gave \"${avail_kib}\")"
fi

if at_least "$avail_kib" "$min_free_kib"; then
  echo "    Disk preflight ok"
  exit 0
fi

echo "    Low root disk headroom; running bounded reclaim before deploy build"
# Host-internal credential for vmctl's internal routes (internal/hostauth),
# sent as ci.yml's deploy sends it: curl reads the root-only header file, so
# the secret never appears on a command line. Without it the reclaim is
# refused once hostauth enforces
# (docs/problems/surface-broken-calls-2026-10-14.md, item 9).
choir_internal_auth=()
if [ -r /var/lib/go-choir/secrets/internal-service-token.header ]; then
  choir_internal_auth=(-H @/var/lib/go-choir/secrets/internal-service-token.header)
fi
if ! curl -fsS -X POST -H 'X-Internal-Caller: true' "${choir_internal_auth[@]}" http://127.0.0.1:8083/internal/vmctl/reclaim; then
  curl -fsS -X POST -H 'X-Internal-Caller: true' "${choir_internal_auth[@]}" http://127.0.0.1:8083/internal/vmctl/idle-check || true
fi
journalctl --vacuum-size=256M || true
# Which generations and builder-release roots stay is node-b-nix-retention's
# (docs/problems/node-b-nix-store-and-host-disk-policy-2026-10-22.md).
GO_CHOIR_NIX_RETENTION_MODE="${GO_CHOIR_NIX_RETENTION_MODE:-enforce}" \
  "$(dirname "$0")/node-b-nix-retention" || true
nix store gc || true

avail_kib="$(df --output=avail -k / | tail -n 1 | tr -d ' ')"
df -h / /var/lib/go-choir 2>/dev/null || df -h /
echo "    root_available_kib_after_reclaim=${avail_kib}"

if ! is_count "$avail_kib"; then
  refuse "cannot read free space after the reclaim (df gave \"${avail_kib}\")"
fi
if ! at_least "$avail_kib" "$min_free_kib"; then
  refuse "root filesystem still below required headroom (${min_free_kib} KiB)"
fi
echo "    Disk preflight ok after the reclaim"
