#!/usr/bin/env bash
# Jev entry-point gate (owner, 2026-11-15; docs/problems/jev-misuse-
# structural-assessment-2026-11-15.md; docs/design/jev-batched-questions-
# 2026-11-10.md section 10).
#
# A job asks Jev once: it builds one jevJob (internal/agentcore/jev_job.go),
# adds every question, and sends the job's calls, which are one call unless a
# vendor limit forces a split. A site that builds and sends its own request is
# the defect that was corrected five times. This gate fails a direct Jev call
# in a file that is neither the entry point nor on the list below.
#
# The list is the sites not yet moved onto the entry point, each with its
# calls per job today. It only shrinks: a site that moves is deleted from the
# list (the gate fails on a listed file that no longer calls Jev, so the list
# cannot go stale), and nothing may be added.
#
#   scripts/check-jev-entry
set -euo pipefail
cd "$(dirname "$0")/.."

# Files that may call Jev directly: the entry point's sender and the adapters
# that carry a call to the gateway.
entry=(
  internal/agentcore/intake_labels.go   # judgeCall and callJudgeWithin; sends the jevJob's calls
  internal/agentcore/intake_shadow.go   # the shadow comparison's usage wrapper
  cmd/intake-shadow/main.go             # the shadow tool's gateway adapter
  internal/autoputer/run.go             # the guest's gateway adapter
)

# Sites not yet moved, with calls per job. Delete a line when its site moves.
unmoved=(
  "internal/agentcore/event_layer.go|capture poll, events: 1 call per flush (every waiting capture, to choices_255; request_tokens_64k splits); runs after labels, so 2 calls per capture poll"
  "internal/agentcore/support_judge.go|support pass: 1 call per queued pass (every waiting revision's pairs); state_plus_question_tokens_32k splits"
  "internal/agentcore/subcall_judge.go|sub-call, desk-cast and inert passes: 1 call per round, tray or pass; state_plus_question_tokens_32k splits (inert: 2 for 43 records at the full clip)"
  "internal/agentcore/desk_cast_judge.go|desk-cast pass: 1 call per pass (via callSubCallJudge); state_plus_question_tokens_32k splits"
  "internal/agentcore/inert_judge.go|inert tray: 1 call per tray (via callSubCallJudge); state_plus_question_tokens_32k splits"
  "internal/agentcore/system1_verb.go|choir.System1: 1 call per verb call, at most 12 questions (our cap, yaegikernel.System1MaxQuestions); story analysis is 2 calls for 24 questions"
  "internal/agentcore/api_system1.go|System 1 API: 1 call per request"
  "internal/agentcore/oped_gate.go|op-ed gate: 1 call per verdict"
  "internal/deskjudge/choice.go|desk judge: 1 call per question (a job asking several questions makes several calls)"
)

pattern='(\<judgeCall\(|\<callJudgeWithin\(|\<callSubCallJudge\(|\.JudgeScoped\(|\.Judge\()'
mapfile -t hits < <(grep -rlE "$pattern" internal cmd --include='*.go' 2>/dev/null | grep -v '_test\.go$' | sort)

listed() { # file -> 0 when entry or unmoved
  local f="$1" e
  for e in "${entry[@]}"; do [[ "${e%% *}" == "$f" ]] && return 0; done
  for e in "${unmoved[@]}"; do [[ "${e%%|*}" == "$f" ]] && return 0; done
  return 1
}

fail=0
for f in "${hits[@]}"; do
  # Interface declarations and adapters in jev_job/jev_split are not calls.
  case "$f" in internal/agentcore/jev_job.go | internal/agentcore/jev_split.go) continue ;; esac
  if ! listed "$f"; then
    echo "check-jev-entry: $f calls Jev directly. Build one jevJob for the job and ask through it (docs/design/jev-batched-questions-2026-11-10.md section 10)." >&2
    fail=1
  fi
done
for e in "${unmoved[@]}"; do
  f="${e%%|*}"
  if ! printf '%s\n' "${hits[@]}" | grep -qx "$f"; then
    echo "check-jev-entry: $f is on the unmoved list but no longer calls Jev directly; delete its line from scripts/check-jev-entry." >&2
    fail=1
  fi
done
if [[ $fail -eq 0 ]]; then
  echo "check-jev-entry: ok; ${#unmoved[@]} sites not yet on the entry point:"
  for e in "${unmoved[@]}"; do echo "  ${e%%|*}: ${e#*|}"; done
fi
exit $fail
